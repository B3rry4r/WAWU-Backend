/// Reference/seed data, admin-managed later per registry note.
model PartnerService {
  id          String               @id @default(uuid())
  /// Stable routing key. The app used to match services by name to work out
  /// where a card should go, which only ever handled CAC and NEPC and broke
  /// silently for everything else.
  slug        String               @unique
  name        String
  tagline     String
  blurb       String
  icon        String
  status      PartnerServiceStatus
  turnaround  String?
  priceFrom   String?
  partner     String?
  comingNote  String?
  /// Carried over from the previous platform, which showed each partner
  /// service with what you need before applying and what you get.
  eligibility String[]             @default([])
  benefits    String[]             @default([])
  /// [label, description] pairs.
  steps       Json?
  ctaLabel    String?
  ctaHref     String?

  /// ── THE MARKETPLACE CARD ──────────────────────────────────────────────
  /// The "Featured Services" rail draws an image, a category label and a
  /// floor price. `icon` is a glyph name and cannot be a card image;
  /// `priceFrom` is free text ("₦25,000") a client cannot compare, sort or
  /// format, so it stays as the display string it always was and the numeric
  /// one below is what the rail reads. All four are nullable or defaulted,
  /// so every existing row keeps rendering exactly as it did.
  imageUrl       String?
  /// "Design", "Business" — the label under the name. Free text for the same
  /// reason `ProfessionalProfile.category` is: the taxonomy is app-defined
  /// and moves without a migration.
  category       String?
  /// Naira, and a FLOOR: what "From ₦10,000" means. Null when the service has
  /// no published starting price, and the card then shows no price rather
  /// than a zero.
  priceFromNaira Int?
  /// The editorial pick for the Featured Services rail. Admin-set, the same
  /// kind of flag as `Product.wawuPick` and `Event.featured`.
  featured       Boolean @default(false)

  @@index([featured])
}

/// `status` (free-text machine state, e.g. "submitted"/"in_review"/"issued")
/// and `statusLabel` (its human-readable display twin) are both typed as
/// plain `string` in the registry with no enumerated value set given, so
/// left as String rather than invented enums. `timeline` (registry:
/// "object[]") is kept as Json — no filter/query value in modeling a
/// free-form status-history array relationally, per the task brief's own
/// example (ServiceApplication.timeline).
model ServiceApplication {
  id                    String                 @id @default(uuid())
  applicantWawuId       String
  kind                  ServiceApplicationKind
  title                 String
  reference             String
  appliedDate           DateTime               @default(now())
  status                String
  statusLabel           String
  amountPaid            Int?
  certificateExpectedBy DateTime?              @db.Date
  timeline              Json
  rejection             String?
  /// URLs of supporting documents the applicant uploaded (ID, signature,
  /// passport photograph). Object-storage URLs produced by POST
  /// /uploads/presign — the application flow used to collect nothing.
  documents             String[]               @default([])

  @@index([applicantWawuId])
  @@index([kind])
}

model Mentor {
  id              String   @id @default(uuid())
  name            String
  handle          String   @unique
  field           String
  category        String
  tagline         String
  bio             String
  topics          String[]
  verification    String
  openForRequests Boolean  @default(true)
  fullUntil       String?
  yearsExperience Int
  sessions        Int      @default(0)
  languages       String[]

  requests MentorRequest[]

  @@index([category])

model DataExportRequest {
  id          String   @id @default(uuid())
  userWawuId  String
  status      String   @default("pending")
  requestedAt DateTime @default(now())

  @@index([userWawuId])
}

// ---------------------------------------------------------------------------
// Lifestyle Services — WAWUPay (bills), WAWUCare (health), WAWU Legal.
//
// All three follow the same shape: the user pays WAWU through Flutterwave
// checkout, the server verifies that payment, and only then does WAWU call the
// partner to fulfil. Fulfilment is therefore a second step that can fail on its
// own, which is why every one of these carries a status separate from the
// payment and keeps the provider's own reference for reconciliation.
// ---------------------------------------------------------------------------

/// Payment taken, fulfilment still owed. `paid` means WAWU has the money but
/// the partner has not called the biller yet. `processing` means the biller
/// ACCEPTED the request — Flutterwave's Bills API confirms receipt
/// synchronously but settles the actual top-up asynchronously, so acceptance
/// is not proof of delivery and must not be recorded as one. A row is a
/// refund candidate the moment it reaches `paid`, and stays one all the way
/// through `processing` until it resolves to `delivered` or `failed`.
enum FulfilmentStatus {
  pending
  paid
  processing
  delivered
  failed
  refunded
}

/// WAWUPay. One row per bill the user pays through Flutterwave's Bills API.
model BillPayment {
  id          String @id @default(uuid())
  buyerWawuId String
  /// Flutterwave bill category slug (AIRTIME, DATA_BUNDLE, POWER, CABLEBILLS…).
  category    String
  billerCode  String
  itemCode    String
  billerName  String
  /// Phone number, meter number or smartcard number, depending on the biller.
  customerRef String
  amount      Int
  fee         Int    @default(0)

  /// The user's card payment to WAWU.
  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  /// Flutterwave's reference for the bill we then paid on their behalf.
  providerReference String?
  providerStatus    String?
  failureReason     String?

  status      FulfilmentStatus @default(pending)
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?

  /// Set only by the operator refund endpoint, which RECORDS a refund that was
  /// actually paid back to the customer by hand. Nothing in this codebase can
  /// move money back to a card — there is no Flutterwave refund adapter — so
  /// `refundReference` is the real-world reference of that manual refund and
  /// `status = refunded` is never written without one.
  refundReference String?
  refundedAt      DateTime?

  @@index([buyerWawuId])
  @@index([status])
  @@index([status, createdAt])
}

/// WAWUCare. A WellaHealth (Zoi) health plan subscription bought in-app.
model HealthSubscription {
  id         String @id @default(uuid())
  wawuUserId String

  planCode String
  planName String
  price    Int

  /// WellaHealth keys the enrollee on phone number, so it is required here.
  phoneNumber String
  firstName   String
  lastName    String
  gender      String
  dateOfBirth String
  email       String?

  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  policyNumber      String?
  providerReference String?
  failureReason     String?

  status    FulfilmentStatus @default(pending)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime         @default(now())

  /// Same contract as BillPayment: written only when a human has actually
  /// refunded the customer, and never without the reference of that refund.
  refundReference String?
  refundedAt      DateTime?

  @@index([wawuUserId])
  @@index([status])
}

/// WAWU Legal routes on this. `simple` is form-in, document-out with no lawyer
/// in the loop; `consultation` requires a paid consultation before WAWU can
/// even quote the work.
enum LegalPath {
  simple
  consultation
}

enum ConsultationMedium {
  chat
  /// A video call. The value keeps the name the web already writes; the app
  /// calls it a video call (LegalConsultationOption, LEGAL-03).
  zoom
  physical
  /// A phone call (LEGAL-03). Only the app's booking route writes it.
  phone
}

/// The full lifecycle of a legal request. A `simple` request skips straight
/// from awaiting_payment to in_progress; a `consultation` one walks the whole
/// ladder, and can never reach in_progress without a signed contract.
enum LegalRequestStatus {
  draft
  /// Submitted, price to be agreed. Simple services whose fee WAWU sets after
  /// looking at the request rather than off a price list.
  awaiting_quote
  awaiting_consultation_payment
  consultation_scheduled
  consultation_done
  quoted
  contract_signed
  awaiting_service_payment
  in_progress
  delivered
  cancelled
}

model LegalRequest {
  id          String             @id @default(uuid())
  wawuUserId  String
  serviceCode String
  serviceName String
  category    String
  path        LegalPath
  status      LegalRequestStatus @default(draft)

  /// Whatever the service's intake form collected.
  details   Json?
  documents String[] @default([])

  consultationMedium  ConsultationMedium?
  consultationFee     Int?
  /// How long the booked consultation runs, copied from the medium's setting
  /// when the hour is held (LEGAL-03), so a later change in admin never moves
  /// an appointment that is already booked. Null on a booking made before
  /// then, which the calendar reads as the one-hour slot it always was.
  consultationMinutes Int?
  consultationTxRef   String?             @unique
  consultationPaidAt  DateTime?
  scheduledFor        DateTime?
  consultationNotes   String?

  /// What WAWU quotes after the consultation.
  quoteAmount Int?
  quoteNote   String?

  /// Signing is a liability record, so it keeps the exact text agreed to
  /// rather than a pointer to a template that may later change.
  contractText     String?
  contractSignedAs String?
  contractSignedAt DateTime?
  contractSignedIp String?

  serviceTxRef   String?   @unique
  servicePaidAt  DateTime?
  deliverableUrl String?
  deliveredAt    DateTime?

  /// Why WAWU closed the matter without delivering it. Required by the ops
  /// cancel endpoint, because "cancelled" with no reason is what strands a
  /// client who has already paid. It does NOT imply a refund: money already
  /// taken is refunded by hand, and nothing here claims otherwise.
  cancellationReason String?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wawuUserId])
  @@index([status])
  @@index([serviceCode])
}

// -----------------------------------------------------------------------------
// Admin identity (admin-surface-extension Phase 5) — ADDITIVE ONLY
//
// This is the first admin identity this backend has ever had. It is
// deliberately a table of its own rather than a role on any existing row:
// user identity lives in WAWU ID (SSO) and this backend has no local User
// table at all, so there is nothing to hang an `isAdmin` flag off even if we
// wanted to — and we do not. An operator account and a customer account are
// different things with different lifecycles, different credentials and
// different blast radius.
//
// Nothing above this line is touched by the migration that introduces these
// two enums and this table.
// -----------------------------------------------------------------------------

/// Operator sub-roles. See src/admin/auth/admin-auth.module.ts for the
/// capability matrix these map to — the matrix is the contract every later
/// admin resource gates against.
enum AdminRole {
  superadmin
  reviewer
  support
  finance
}

enum AdminUserStatus {
  active
  suspended
}

model AdminUser {
  id           String          @id @default(uuid())
  email        String          @unique
  /// argon2id. Never selected into any response — every read goes through
  /// toAdminUserView() in src/admin/auth/admin-user-view.type.ts.
  passwordHash String
  name         String
  role         AdminRole
  status       AdminUserStatus @default(active)

  /// Bumped to revoke every outstanding token for this admin without a
  /// session table: the value is stamped into both the access and the
  /// refresh token and re-checked on every request.
  tokenVersion Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([role])
  @@index([status])
}

enum AdminContentDecision {
  approved
  rejected
  /// A LIVE (or any non-removed) piece taken down by a moderator outside the
  /// pending-review flow — e.g. a creator's account was deleted before this
  /// backend removed content at deletion time, and the piece was left
  /// stranded live with nobody left to have rejected it from `pending`.
  removed
}

/// Moderation audit trail for ContentPiece — admin-surface-extension Phase 6.
///
/// A SIDE TABLE, not columns on ContentPiece, and that is not a style
/// preference: protected-surface hazard H-1 records that 28 of 39 wire types
/// in src/common/types are bare re-exports of their Prisma model returned by
/// spread, so a `moderationReason` column on ContentPiece would appear
/// verbatim in the shipped app's content responses the moment it existed.
///
/// No FK to ContentPiece or AdminUser, matching the idiom every
/// cross-boundary reference in this schema already uses (KycSubmission
/// .wawuUserId, Purchase.buyerWawuId): a relation field would have to be
/// added to the ContentPiece model block, and an audit row must outlive the
/// thing it audits anyway. Reviewer email and role are SNAPSHOTS for the same
/// reason — "who approved this" has to stay answerable after that admin is
/// renamed, suspended, or deleted.
model AdminContentReview {
  id            String @id @default(uuid())
  contentId     String
  /// Snapshot: which creator this decision landed on.
  creatorWawuId String

  decision       AdminContentDecision
  /// The status the piece held immediately before this decision, and the one
  /// written by it. Stored rather than inferred so the trail still reads
  /// correctly after a later decision moves the piece again.
  previousStatus ContentStatus
  newStatus      ContentStatus
  /// Required on a rejection (enforced in the DTO + service), null on approval.
  reason         String?
  /// Whether this decision handed the creator's upload slot back
  /// (CreatorState.slotsUsed decrement). Recorded per row so a slot ledger can
  /// be reconstructed from the audit trail alone.
  slotReturned   Boolean              @default(false)

  reviewedByAdminId    String
  reviewedByAdminEmail String
  reviewedByAdminRole  AdminRole
  reviewedAt           DateTime  @default(now())

  @@index([contentId])
  @@index([reviewedByAdminId])
  @@index([reviewedAt])
}

enum AdminKycAction {
  document_viewed
  identifiers_revealed
  approved
  rejected
}

/// Audit trail for the admin KYC-review surface — admin-surface-extension
/// Phase 6.
///
/// A SIDE TABLE for the same reason AdminContentReview is one: protected-
/// surface hazard H-1 records that 28 of 39 wire types in src/common/types
/// are bare re-exports of their Prisma model returned by spread, so a
/// `reviewedByAdminId` column on KycSubmission would appear verbatim in the
/// shipped app's `GET /kyc` response the moment it existed — and that
/// response goes to the creator, who has no business seeing which reviewer
/// looked at their file.
///
/// Unlike AdminContentReview this table records READS as well as decisions,
/// because a read here is a disclosure: `document_viewed` is someone opening
/// a government ID, and `identifiers_revealed` is someone unmasking a BVN,
/// NIN or payout account number. Those are the rows a breach investigation
/// needs, and they are exactly the ones a decision-only trail would not have.
/// `previousStatus` / `newStatus` / `reason` are therefore null on a read row.
///
/// No FK to KycSubmission or AdminUser, matching every cross-boundary
/// reference in this schema (KycSubmission.wawuUserId, Purchase.buyerWawuId).
/// Reviewer email and role are SNAPSHOTS: "who opened this ID" must stay
/// answerable after that admin is renamed, suspended, or deleted.
///
/// The signed URL itself is NEVER stored here. It is a bearer token for a
/// government ID; the audit records that a fetch happened, never the means to
/// repeat it.
model AdminKycAudit {
  id                String @id @default(uuid())
  submissionId      String
  /// Snapshot of whose earning gate this action touched.
  subjectWawuUserId String

  action         AdminKycAction
  /// Both null unless this row is a decision — a view or a reveal moves
  /// nothing. Stored rather than inferred so the trail still reads correctly
  /// after a later resubmission moves the creator on.
  previousStatus ReviewStatus?
  newStatus      ReviewStatus?
  /// Required on a rejection (enforced in the DTO and again by the existing
  /// KycSubmissionService.review); null on every other action.
  reason         String?

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([submissionId])
  @@index([subjectWawuUserId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

enum AdminVerificationAction {
  document_viewed
  approved
  rejected
}

/// Audit trail for the admin verification-TIER review surface —
/// admin-surface-extension Phase 6.
///
/// A SEPARATE table from AdminKycAudit, deliberately, and not a shared
/// "review audit" with a resource discriminator. CLAUDE.md's non-negotiables
/// and the derived-surface guardrails both say the earning gate (KYC) and the
/// public trust badge (this ladder) are two independent systems, and this has
/// already shipped as a bug once — the app described "Government ID submitted
/// and approved by hand" on a rung of this ladder. One table would put a BVN
/// disclosure and a business-certificate view in the same query, which is how
/// the two get conflated again.
///
/// There is no `identifiers_revealed` action here because this resource holds
/// no identifiers to reveal: a VerificationSubmission is a tier and a list of
/// document keys, nothing more.
model AdminVerificationAudit {
  id                String           @id @default(uuid())
  submissionId      String
  /// Snapshot of whose badge this action touched.
  subjectWawuUserId String
  /// Snapshot of the rung applied for. Stored because the row it describes is
  /// history the moment a later submission supersedes it.
  tier              VerificationTier

  action               AdminVerificationAction
  previousStatus       ReviewStatus?
  newStatus            ReviewStatus?
  reason               String?
  /// Which entry of VerificationSubmission.documents was fetched. Null on a
  /// decision row.
  documentIndex        Int?
  /// True only on an approval that actually reached WAWU ID. The existing
  /// VerificationSubmissionService elevates the tier BEFORE writing the local
  /// approval precisely so a failed callback leaves the submission pending and
  /// retryable — so an approval row can only exist once the elevation
  /// succeeded, and recording it makes that ordering auditable rather than
  /// merely commented.
  tierElevatedAtWawuId Boolean                 @default(false)

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([submissionId])
  @@index([subjectWawuUserId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

/// Inbound Flutterwave webhook deliveries — audit trail AND the exactly-once
/// claim for settlement driven by the provider rather than by the browser.
///
/// A NEW table on purpose. 28 of the 39 wire types are bare Prisma re-exports
/// returned by spread, so adding a column to Purchase / PendingCharge /
/// BillPayment to track webhook state would silently widen a live app
/// response. Nothing here is ever returned to the app.
model PaymentWebhookReceipt {
  id String @id @default(uuid())

  /// `${event}:${txRef}` — one settlement attempt per event per charge.
  /// UNIQUE, and the atomic `create` against it IS the claim: a duplicate
  /// delivery loses the insert race (P2002) and never reaches settlement.
  deliveryKey String @unique

  /// Flutterwave's event name, e.g. `charge.completed`.
  event         String
  /// The `tx_ref` this backend issued when the charge was opened.
  txRef         String
  /// Flutterwave's own transaction id from the payload. Only ever used as the
  /// id to re-verify AGAINST Flutterwave — never as proof of anything.
  transactionId String?

  /// received | settled | rejected | unmatched | ignored | failed.
  /// `received` and `failed` are non-terminal: a redelivery may reclaim them
  /// so a transient outage cannot permanently swallow a real payment.
  status String @default("received")

  /// Which money flow the tx_ref resolved to (`tip`, `credit-purchase`,
  /// `subscription`, `dm`, `bill`, `health`, `legal-consultation`, …).
  flow   String?
  /// Why it ended where it did — refusal reason, biller error, etc.
  detail String?

  /// The raw body as delivered, kept for reconciliation with Flutterwave.
  payload Json

  receivedAt DateTime  @default(now())
  settledAt  DateTime?

  @@index([txRef])
  @@index([status])
  @@index([receivedAt])
}

/// Which operator surface an AdminOpsAudit row belongs to.
enum AdminOpsResource {
  legal_request
  /// A legal price WAWU sets in admin (LEGAL-03, R-14).
  legal_price
  service_application
  bill_payment
  health_subscription
  /// A person's hold on a BVN during a Nuvion wallet opening (NUV-02 round 3).
  wallet_identity_hold
  /// A launch figure set in admin settings (TIER-06, R-65).
  plan_setting
}

/// Every consequential ops action that used to be anonymous behind
/// AdminKeyGuard, named for what it did rather than for the route that did it.
enum AdminOpsAction {
  legal_quoted
  legal_consultation_completed
  legal_delivered
  legal_cancelled
  /// A consultation price or length, or a fixed-price service's price, was set
  /// or cleared (LEGAL-03, R-14). `detail` carries the old and new values.
  legal_price_set
  application_progressed
  application_rejected
  application_approved
  /// The one READ that is audited on this surface. GET
  /// /services/ops/applications/:id hands an operator another person's
  /// uploaded ID, signature and passport photograph (see
  /// ServiceApplication.documents) plus the business details they typed —
  /// which is precisely what AdminKycAudit's `document_viewed` exists for.
  /// The QUEUE read is not audited: it carries no document URL and no
  /// intake answers, so it discloses nothing beyond "this person has an
  /// application", the same as the legal and bills queue reads.
  application_documents_viewed
  bill_reconciled
  bill_refund_recorded
  care_enrolment_retried
  care_refund_recorded
  /// Support released one person's BVN hold at once (NUV-02 round 3). `detail`
  /// carries the opening's state before and after, never a BVN or its hash.
  wallet_identity_hold_released
  /// One or more launch figures were set, or put back to their default
  /// (TIER-06, R-65). `detail` carries each key with its old and new value.
  plan_setting_set
}

/// Attribution for the operator surfaces that moved from AdminKeyGuard onto
/// the real admin identity — WAWU Legal, ServiceApplication, WAWUPay and
/// WAWUCare.
///
/// A SIDE TABLE, for the same reason AdminContentReview and AdminKycAudit are
/// side tables: protected-surface hazard H-1 records that most wire types in
/// src/common/types are bare Prisma re-exports returned by spread, so an
/// `actedByAdminId` column on LegalRequest, ServiceApplication, BillPayment or
/// HealthSubscription would appear verbatim in a live app response the moment
/// it existed. A client looking at their own legal matter has no business
/// seeing which WAWU staff member priced or cancelled it.
///
/// ONE table across four resources rather than four tables, and that is a
/// departure from AdminContentReview / AdminKycAudit. Those two carry
/// resource-specific TYPED columns (ContentStatus transitions, a slot-return
/// flag, an AdminKycAction) that only make sense for their own entity. These
/// eleven handlers share exactly one shape — "an admin did a named thing to
/// one row, and here is what changed" — so four near-identical tables would be
/// four places to look for one question ("what has this admin done?").
///
/// `detail` is the per-action payload as JSON rather than as columns: a quote
/// amount, a cancellation reason, a refund reference and a provider status are
/// not the same field, and inventing a nullable column for each would make the
/// table wider than the four it replaces.
///
/// No FK to the audited row or to AdminUser, matching every cross-boundary
/// reference in this schema (KycSubmission.wawuUserId, Purchase.buyerWawuId).
/// Admin email and role are SNAPSHOTS: "who cancelled this ₦120,000 matter"
/// has to stay answerable after that admin is renamed, suspended or deleted.
model AdminOpsAudit {
  id            String           @id @default(uuid())
  resource      AdminOpsResource
  resourceId    String
  /// Snapshot of whose money or matter this action touched. Empty string only
  /// where the audited row genuinely has no owner.
  subjectWawuId String

  action AdminOpsAction
  /// What actually changed — the quote amount, the refund reference, the new
  /// status. Shape varies by `action`; see src/common/audit.
  detail Json?

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([resource, resourceId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

// -----------------------------------------------------------------------------
// Events — reinstated 22 Aug 2026 by product-owner decision.
//
// WAWU-Web/CLAUDE.md and docs/00_PLATFORM_MAP.md previously listed Events under
// what was cut. Both documents have been amended with today's date to record
// the reversal rather than leaving them contradicting this schema.
//
// ── THE LINE THAT DOES NOT MOVE ──────────────────────────────────────────────
// What the spec cut was event TICKETS, and that stays cut. There is no price
// column, no currency, no ticket, no purchase, no payment reference, no revenue
// split and no credit cost anywhere in the three tables below, and none may be
// added. "Going" is an INTEREST SIGNAL: a row exists or it does not.
// Registration, if the organiser sells one at all, happens on their own site
// behind `Event.externalUrl` — off this platform, off this schema, and no money
// crosses this backend for it. That is precisely why reinstating Events is
// low-risk, so anything that starts to look like ticketing is a spec conflict
// (CLAUDE.md: "If a task conflicts with docs/01_SPEC.md, the spec wins").
//
// ── WHY THREE NEW TABLES AND NOT ONE COLUMN ANYWHERE ELSE ────────────────────
// Same reason AdminContentReview is a side table: protected-surface hazard H-1
// — most wire types in src/common/types are bare re-exports of their Prisma
// model returned by spread, so a new column on an EXISTING table silently
// widens a live app response. Everything here is new tables, and every wire
// shape is a DECLARED view in src/event/event-view.type.ts and
// src/admin/events/admin-event-view.type.ts. Nothing re-exports these models.
// -----------------------------------------------------------------------------

/// In-Person / Online in the UI. Hybrid is deliberately absent: the old admin
/// screen offered it, the old public filter chips never did, so an event
/// created as Hybrid was unreachable by every filter a user could tap.
enum EventFormat {
  in_person
  online
  /// In a room and streamed at once (the host wizard's third format, task
  /// EVENTS-02). Added after the first two, so a client that only knows
  /// in_person and online has never been sent it for an event it already had.
  hybrid
}

/// The kinds the filter rows offer. The first five are the web's chips (old
/// EVENT_FILTERS, minus the two format chips and the "All" chip); `conference`
/// and `concert` are the app's Kind chips (task EVENTS-02). A kind no filter
/// offers would be a chip nobody can tap, i.e. an event nobody can find.
enum EventType {
  workshop
  summit
  webinar
  meetup
  competition
  conference
  concert
}

/// Every state here has an exit, and that is a hard requirement rather than a
/// nicety — a `pending` row no endpoint can move is the worst bug this
/// codebase has shipped (see AdminContentReview's header).
///
///   pending   -> published   POST /admin/events/:id/approve
///   pending   -> rejected    POST /admin/events/:id/reject   (reason required)
///   rejected  -> pending     PATCH /events/:id               (host resubmits)
///   published -> pending     PATCH /events/:id               (host edits; see below)
///   published -> removed     POST /admin/events/:id/remove   (reason required)
///   removed   -> published   POST /admin/events/:id/restore
///
/// A host's edit ALWAYS returns the event to `pending`. One rule, no tiers of
/// "material" versus "cosmetic" fields: a two-tier policy is a bypass waiting
/// to be found (submit something benign, get approved, edit it into whatever
/// you actually wanted). `removed` is the one status a host cannot edit out
/// of — a takedown is an admin decision, and its exit is an admin restore.
enum EventStatus {
  pending
  published
  rejected
  removed
  /// Called off by the organiser after publication. Every ticket is voided
  /// and every order refunded; the event stays readable so a ticket holder
  /// can see what happened to the thing they paid for.
  cancelled
}

/// A user-submitted event. Created `pending`; invisible on every public read
/// until an admin approves it.
///
/// `hostWawuId` is the submitting WAWU ID user — a plain indexed String, never
/// a relation, exactly as every other cross-boundary reference in this schema.
/// Creation is NOT gated on the paid creator subscription: an event costs no
/// upload slot and earns nobody anything, so the moderation queue is the only
/// gate it needs.
model Event {
  id         String @id @default(uuid())
  hostWawuId String

  name        String
  description String
  /// The organisation running it ("org" in the old EventItem), and its blurb.
  hostOrg     String
  hostOrgBio  String?

  format EventFormat
  type   EventType

  /// The authoritative instant, and the only thing upcoming/past is decided
  /// on. The old shape stored month/day/dow as pre-rendered strings, which
  /// made "is this event over" unanswerable in SQL.
  startsAt  DateTime
  endsAt    DateTime?
  /// Host-supplied DISPLAY strings — "10:00 AM", "WAT". Deliberately not
  /// derived from `startsAt` server-side: rendering a local time needs the
  /// event's own zone, and guessing it in UTC is how a 9am Lagos workshop
  /// becomes an 8am one on every card.
  timeLabel String?
  timezone  String?

  /// City or venue name (always shown), and the street address (detail only).
  /// Optional on a submit since EVENTS-02 (the app's host wizard asks only
  /// for the street address): when a host leaves it out it is filled from
  /// `address`, and is the empty string when there is no address either, so
  /// the column and its wire type stay a string for every client.
  location String
  address  String?

  /// The VENUE, by name — "Eko Convention Centre". Separate from `location`,
  /// which conflated two facts: the card renders "Concert • Abuja" (category
  /// and city) while the hero renders the venue under a pin, and one column
  /// cannot be both. Nullable, because an online event has no venue and every
  /// event created before this column has only ever had `location`. A client
  /// with nothing here shows `location`, exactly as it did before.
  venueName String?

  /// The organiser's own page. Registration — including any paid registration
  /// the organiser runs — lives THERE, never here. This backend takes no
  /// money for an event.
  externalUrl String?

  /// Past-event recap, written by the host after the fact. `hasRecap` on the
  /// wire is derived from these, matching the old EventItem.recap boolean.
  recapUrl  String?
  recapText String?

  /// Admin-controlled pin. A host cannot set it — POST /admin/events/:id/feature
  /// is the only writer, and a takedown clears it (a featured-but-removed
  /// event is a rail pointing at a 404).
  featured Boolean     @default(false)
  status   EventStatus @default(pending)

  /// Why the last rejection or takedown happened, denormalised from the audit
  /// trail so the host's own GET /events/mine can show it without reading an
  /// admin table. The trail in AdminEventReview stays authoritative.
  lastDecisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  speakers EventSpeaker[]
  going    EventGoing[]
  saves    EventSave[]

  /// Ticketing. An event with no ticket types is exactly the free,
  /// interest-only event this table held before ticketing existed — the
  /// "Going" signal still works and nothing is charged.
  ticketTypes EventTicketType[]
  orders      EventOrder[]
  tickets     EventTicket[]
  referrals   EventReferral[]
  /// People the host lets scan tickets in at the door (EVENTS-05).
  doorStaff   EventDoorStaff[]
  doorScans   EventDoorScan[]

  /// Banner image. Object-storage URL from POST /uploads/presign.
  bannerUrl    String?
  /// What the event is ABOUT, as the Events section filters on.
  category     EventCategory @default(other)
  /// How to reach the organiser. Shown on the public page.
  contactEmail String?
  contactPhone String?

  /// Set when an organiser calls off a published event. Distinct from
  /// `removed`, which is a takedown by an admin: a cancellation refunds every
  /// ticket sold and the record stays visible to the people who bought one.
  cancelledAt  DateTime?
  cancelReason String?

  @@index([hostWawuId])
  @@index([status])
  /// The public list is always "published, ordered by when it starts".
  @@index([status, startsAt])
  @@index([status, featured])
  @@index([format])
  @@index([type])
}

/// A billed speaker on an event. A child table rather than a Json column, the
/// same shape CourseLesson has under ContentPiece, so the rows validate and
/// order like anything else here. Initials are derived on the wire from
/// `name`; storing them would be a second definition of the same fact.
model EventSpeaker {
  id       String  @id @default(uuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  title    String?
  /// Object-storage URL from POST /uploads/presign (folder "event/speaker").
  /// Optional — a speaker with no photo still renders, as initials.
  photoUrl String?
  order    Int

  @@index([eventId])
}

/// The interest signal, and NOT a ticket. One row per (event, user): the
/// unique constraint is the idempotency, so POSTing "going" ten times is the
/// same one signal, and DELETE withdraws it. No amount, no status, no
/// reference — there is nothing to pay for.
model EventGoing {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userWawuId String
  markedAt   DateTime @default(now())

  @@unique([eventId, userWawuId])
  @@index([eventId])
  @@index([userWawuId])
}

/// The bookmark on an event card, and NOT a second "Going".
///
/// The two answer different questions and a screen shows both at once: the
/// ribbon in the corner of the hero is "keep this for me to look at", the
/// heart under a card is the same bookmark on the same event, and "Going" is
/// a public interest signal that appears in the organiser's count. Folding
/// the bookmark into EventGoing would make saving an event for later
/// indistinguishable from telling the organiser you are coming.
///
/// Shaped exactly like EventGoing on purpose — one row per (event, user),
/// the unique constraint IS the idempotency, and a DELETE that matches
/// nothing is still the correct end state. Private: nothing publishes who
/// saved what, and the only count on the wire is the caller's own boolean.
/// ME-10. One person's saved creator: the "Creators" tab of Saved (M30).
/// A bookmark, not a follow: it sends nothing to the creator and changes no
/// count they see. Written by PUT and DELETE /me/saved/creators/:wawuId.
model SavedCreator {
  id            String   @id @default(uuid())
  userWawuId    String
  creatorWawuId String
  savedAt       DateTime @default(now())

  @@unique([userWawuId, creatorWawuId])
  @@index([userWawuId, savedAt])
  @@index([creatorWawuId])
}

model EventSave {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userWawuId String
  savedAt    DateTime @default(now())

  @@unique([eventId, userWawuId])
  @@index([eventId])
  @@index([userWawuId])
}

enum AdminEventAction {
  approved
  rejected
  featured
  unfeatured
  removed
  restored
}

/// Moderation audit trail for Event — the same side-table idiom as
/// AdminContentReview, deliberately not a second moderation idiom.
///
/// No FK to Event or AdminUser: an audit row has to outlive the thing it
/// audits, and every cross-boundary reference in this schema is already a
/// plain String. Admin email and role are SNAPSHOTS so "who took this event
/// down" stays answerable after that admin is renamed or deleted. Both the
/// status and the featured flag are recorded before/after, because
/// feature/unfeature changes no status and would otherwise leave an audit row
/// that appears to have done nothing.
model AdminEventReview {
  id         String @id @default(uuid())
  eventId    String
  /// Snapshot: whose event this decision landed on.
  hostWawuId String

  action           AdminEventAction
  previousStatus   EventStatus
  newStatus        EventStatus
  previousFeatured Boolean
  newFeatured      Boolean
  /// Required on `rejected` and `removed` (enforced in the DTO and again in
  /// the service); null on the others. The host is shown it.
  reason           String?

  reviewedByAdminId    String
  reviewedByAdminEmail String
  reviewedByAdminRole  AdminRole
  reviewedAt           DateTime  @default(now())

  @@index([eventId])
  @@index([reviewedByAdminId])
  @@index([reviewedAt])
}

// -----------------------------------------------------------------------------
// Professional profiles
// -----------------------------------------------------------------------------

/// What a professional is offering their credential as evidence OF.
///
/// The split is the whole point. Legal, health, finance and insurance have a
/// body that issues a licence and can be rung up to confirm it. Technology,
/// beauty and most other categories have no such body, and demanding a
/// licence there would mean reviewers either reject everyone in tech for
/// lacking a document that does not exist, or wave anyone through. So the
/// evidence a reviewer is looking for is recorded per application.
enum ProfessionalCredentialKind {
  /// A practising licence from a named issuing body. Required in a regulated
  /// category, and the reviewer's job is to confirm it with that body.
  licence
  /// A qualification or certification with no licensing regime behind it.
  qualification
  /// Work history and samples. The reviewer is exercising judgment, not
  /// checking a register — only ever acceptable outside regulated categories.
  portfolio
}

/// A creator's application to be listed as a professional in ONE category,
/// and once approved, the listing itself.
///
/// Per category, deliberately: a licence is field-specific, and a certified
/// nurse must not surface under Legal Services. The verification ladder's
/// `certified_professional` rung is global and answers "is this person a
/// qualified professional at all" — this answers "at WHAT", which is the
/// question a buyer browsing a category is actually asking.
///
/// Contact runs through paid DMs. There is no booking, no scheduling, no
/// escrow and no invoicing here: the conversation starts on WAWU and the
/// engagement itself is arranged between the two people. That keeps this a
/// directory plus a paid introduction rather than a marketplace holding money
/// against delivered professional work, which is a different product with
/// different obligations.
model ProfessionalProfile {
  id         String @id @default(uuid())
  wawuUserId String
  /// An explore category id (`legal_services`, `technology`, …). Not an enum:
  /// the taxonomy is app-defined and moves without a migration.
  category   String

  /// "Corporate lawyer, 11 years" — the one line under their name.
  headline String
  /// What they actually do, in their own words.
  about    String
  /// Discrete things they will take on. Shown as chips on the card.
  services String[] @default([])

  credentialKind ProfessionalCredentialKind
  /// Required when the category is regulated; enforced in the DTO, which owns
  /// the regulated list, not the database.
  licenceNumber  String?
  issuingBody    String?
  /// Object-storage URLs from POST /uploads/presign.
  documents      String[]                   @default([])

  status          ReviewStatus @default(pending)
  rejectionReason String?
  submittedAt     DateTime     @default(now())
  reviewedAt      DateTime?

  /// Hidden from the directory without deleting the record — a professional
  /// who is too busy to take work, or one an admin has pulled. Distinct from
  /// `status`: this is availability, that is whether they were ever approved.
  /// Which of the two hid it is ProfessionalTakedown (FIX-06): while an
  /// admin's takedown stands this is false and the person cannot set it.
  listed Boolean @default(true)

  reviews ProfessionalReview[]

  /// One application per person per category. A rejected application is
  /// edited and resubmitted in place rather than piling up duplicates, which
  /// is also what stops someone spamming a queue a human has to work.
  @@unique([wawuUserId, category])
  @@index([category, status])
  @@index([status])
}

/// Where a professional works: the city on their card ("Chartered
/// accountant · Ikeja", H10) and in the directory (PROS-02).
///
/// A SIDE TABLE, NOT A COLUMN. ProfessionalProfile rows go out whole on
/// routes the web calls today (POST /professionals/applications, GET
/// /professionals/applications/mine, PATCH .../listing), so a column there
/// would add a key to each of those answers (the protected route list,
/// hazard H-1).
///
/// One row per PERSON, not per listing: somebody listed in two fields works
/// from one place. Written by its owner through PUT /professionals/location
/// and read only by the professional directory routes. No row means the card
/// shows no city, never a guessed one.
model ProfessionalLocation {
  wawuUserId String   @id
  /// As the professional wrote it, trimmed: "Ikeja", "Port Harcourt".
  city       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// An admin's takedown of one professional listing, kept apart from the
/// person's own Hide (FIX-06).
///
/// Before this table, POST /admin/professionals/:id/unlist and the person's
/// Hide (PATCH /professionals/applications/:id/listing) wrote the same
/// `ProfessionalProfile.listed = false`, so the person's Show put back a
/// listing an admin had pulled. A row here whose `liftedAt` is null is a
/// takedown that stands: `listed` stays false, the person's Show is refused
/// (409, reason.code `listing_taken_down`), and only an admin lifts it
/// (POST /admin/professionals/:id/relist).
///
/// A SIDE TABLE, NOT A COLUMN, for ProfessionalLocation's reason:
/// ProfessionalProfile rows go out whole on routes the web calls today, so a
/// column there would add a key to each of those answers (the protected
/// route list, hazard H-1).
///
/// One row per listing: the latest takedown, and who lifted it and when. A
/// takedown after a lift replaces the row. Admin email and role are
/// SNAPSHOTS, as in AdminOpsAudit: "who took this down" has to stay
/// answerable after that admin is renamed, suspended or deleted. No FK,
/// matching ProfessionalLocation.
model ProfessionalTakedown {
  /// The listing: a ProfessionalProfile id.
  professionalId String  @id
  /// Whose listing (ProfessionalProfile.wawuUserId when it was taken down),
  /// so the account purge and the data export find the row by its owner.
  wawuUserId     String
  /// What the person themselves last chose: the listing's `listed` when the
  /// admin took it down, then false if they press Hide while it is down.
  /// Lifting the takedown puts the listing back to this.
  ownerListed    Boolean

  takenDownAt           DateTime  @default(now())
  takenDownByAdminId    String
  takenDownByAdminEmail String
  takenDownByAdminRole  AdminRole

  /// All null while the takedown stands.
  liftedAt           DateTime?
  liftedByAdminId    String?
  liftedByAdminEmail String?
  liftedByAdminRole  AdminRole?

  @@index([wawuUserId])
}

/// One client's rating of one professional listing.
///
/// The directory card draws stars and a review count next to a Book button,
/// and those two numbers are the whole reason somebody picks one lawyer over
/// another. So they come from rows, aggregated on read. There is no
/// `ratingAvg` column on ProfessionalProfile, deliberately: a stored average
/// is a second definition of the same fact, and a bare float that nothing
/// writes is how "4.8" ends up under every name on the platform.
///
/// WHO MAY WRITE ONE. The engagement itself happens off WAWU — this backend
/// takes no money for professional work and holds no booking. What it does
/// hold is the paid introduction: DirectMessage records that a client paid to
/// message this person and whether that person replied. So a review requires
/// a DM from the author to the professional that the professional RESPONDED
/// to. That is a real, checkable relationship, it costs money to manufacture,
/// and it excludes both the person who never made contact and the one whose
/// message was ignored and refunded.
///
/// Per LISTING, not per person. Someone listed in two categories is being
/// judged on two different pieces of work, and a review of their legal advice
/// does not transfer to their photography.
model ProfessionalReview {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  authorWawuId   String
  /// 1 to 5. Bounded in the DTO, not by a CHECK constraint: an out-of-range
  /// value has to come back as an explained 400, not as a database error the
  /// API cannot translate for the person who typed it.
  stars          Int
  body           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([professionalId, authorWawuId])
  @@index([professionalId])
  @@index([authorWawuId])
}

// -----------------------------------------------------------------------------
// Legal intake — profiling before anybody talks about money
// -----------------------------------------------------------------------------

enum LegalIntakeStatus {
  in_progress
  completed
  /// Turned into a LegalRequest. Kept rather than deleted: the brief is what
  /// the consultant read before the first message, and "what did we know when
  /// we advised" is a question that gets asked after things go wrong.
  converted
}

/// One person's answers to the legal profiling questions, and the brief those
/// answers produce.
///
/// The point of this table is ORDER. Before it, a client picked a service and
/// was quoted a consultation fee, so the first thing WAWU said to somebody
/// with a legal problem was a price. Now the profiling happens first, the
/// consultant reads a brief before the conversation starts, and the client
/// does not repeat their story to a human who has not been told it.
///
/// `answers` is Json because the question set is adaptive — a debt-recovery
/// intake and a trademark intake genuinely do not collect the same fields, and
/// modelling fourteen matter types as columns would be a table of nulls. The
/// SHAPE is not freeform though: every key is a question id from
/// legal-intake-questions.ts, and the service validates against it.
model LegalIntake {
  id         String            @id @default(uuid())
  wawuUserId String
  /// One of the fourteen matter types the first question offers. Not a
  /// catalogue service code — that is resolved when the request is created,
  /// because "Contract Drafting / Review" is one thing to a client and two
  /// priced services to operations.
  matter     String
  status     LegalIntakeStatus @default(in_progress)

  /// Question id -> answer. Answers are strings, string arrays, or null for a
  /// question the person chose to skip.
  answers   Json     @default("{}")
  /// Object-storage URLs for anything they attached.
  documents String[] @default([])

  /// The consultant-facing brief, assembled on completion. Stored rather than
  /// recomputed so it cannot drift from what the consultant actually read.
  brief Json?

  /// Set when this intake becomes a real request.
  legalRequestId String? @unique

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  /// How the intake is being filled. Null: the question form (the web's
  /// `/legal/intake` routes, every row written before LEGAL-01).
  /// `assistant`: the chat-first flow (`/legal/assistant`, LEGAL-01), where
  /// the assistant profiles the problem in conversation before any payment.
  channel String?

  /// The assistant's working brief while the conversation runs (LEGAL-01):
  /// `{ headline, facts: [{ label, value }], ready }`. Only what the client
  /// said, as the client is shown it to confirm. On "Send to a consultant"
  /// it becomes `brief` above, in the same shape the form writes.
  draftBrief Json?

  /// A short claim while one paid AI call is running for this conversation
  /// (a retry of the assistant's reply, or preparing the brief on Send), so
  /// a second one cannot start. Expires on its own if the process dies.
  assistantBusyUntil DateTime?
  // Also in the database, and NOT expressible here (Prisma has no partial
  // index): UNIQUE ("wawuUserId") WHERE "channel" = 'assistant' AND "status" =
  // 'in_progress', so a person has at most one open assistant conversation.
  // See migration 20261007200000_legal_assistant. `prisma migrate diff` does
  // not list it, so the schema and the migrations still agree.

  @@index([wawuUserId, status])
  @@index([status, completedAt])
}

/// Who wrote a message in the assistant conversation on an intake.
enum LegalIntakeAuthor {
  client
  /// The WAWU Legal assistant: Gemini, or a line the server writes itself
  /// (`scripted`). Never a person.
  assistant
}

/// One message in the assistant conversation on an UNPAID legal intake
/// (LEGAL-01: legal starts as a chat).
///
/// Kept apart from LegalChatMessage on purpose: that thread belongs to a
/// LegalRequest, which only exists once the client sends the brief to a
/// consultant. Everything said before that lives here; everything after it
/// (the consultant joining, the client's replies) lives on the request's
/// own thread, so the dashboard's consultant routes read it unchanged.
///
/// `wawuUserId` is carried so the account purge can delete these rows by
/// owner (account-data-map.ts), like the intake itself.
model LegalIntakeMessage {
  id            String            @id @default(uuid())
  legalIntakeId String
  wawuUserId    String
  authorRole    LegalIntakeAuthor
  /// Written by the server, not the model: the opener (which carries the
  /// client's first name) and the "sent to a consultant" line. Never sent to
  /// the model.
  scripted      Boolean           @default(false)
  body          String
  /// The answers offered as taps under this message: `[{ id, label }]`.
  /// Only the newest assistant message's are live.
  quickReplies  Json?
  createdAt     DateTime          @default(now())

  @@index([legalIntakeId, createdAt])
  @@index([wawuUserId, createdAt])
}

/// One paid AI call the assistant made that no new client message paid for:
/// asking again after a failed reply (`reply`) or preparing the brief on Send
/// (`brief`). Written in the same step that checks the limits, so the hourly
/// and per-conversation counts (client messages plus these) cannot be beaten
/// by parallel requests. Carries no words of the conversation.
model LegalAssistantCall {
  id            String   @id @default(uuid())
  legalIntakeId String
  wawuUserId    String
  /// `reply` or `brief`.
  kind          String
  createdAt     DateTime @default(now())

  @@index([legalIntakeId, createdAt])
  @@index([wawuUserId, createdAt])
}

/// Who said it.
enum LegalChatAuthor {
  client
  /// Gemini, answering before a human joins. Labelled as such in every
  /// surface — a client must always know whether they are reading a lawyer.
  ai
  /// A WAWU Legal consultant, from the dashboard.
  consultant
}

/// One message in the conversation attached to a legal matter.
///
/// The conversation runs in ONE thread across the handover: the AI opens it
/// after the client has paid for their consultation, works through what the
/// brief left unclear, and a consultant then continues in the same place. The
/// client is not moved to a different screen and does not repeat themselves,
/// which is the entire point of profiling first.
///
/// `authorRole` is never inferred at render time. A message a model wrote is
/// stored as having been written by a model, permanently, because "was this
/// legal advice from a person" is a question that gets asked long afterwards
/// and the answer has to come from the record rather than from styling.
model LegalChatMessage {
  id             String          @id @default(uuid())
  legalRequestId String
  authorRole     LegalChatAuthor
  /// The admin id, when a consultant wrote it. Null for client and AI.
  authorAdminId  String?
  body           String
  createdAt      DateTime        @default(now())

  @@index([legalRequestId, createdAt])
}

/// What one kind of legal consultation costs and how long it runs, set by WAWU
/// in admin (R-14, LEGAL-03). One row per medium. A medium with no row, or a
/// row with no price or no length, is not offered for booking: nothing here
/// has a built-in price, so nothing can be sold at a figure nobody set.
///
/// `priceKobo` is whole naira (a multiple of 100): the web still pays a
/// consultation through Flutterwave in whole naira until it is moved, and both
/// read this row. An in-person consultation carries neither price nor length:
/// it is arranged directly and priced per matter.
model LegalConsultationOption {
  id               String             @id @default(uuid())
  medium           ConsultationMedium @unique
  priceKobo        Int?
  minutes          Int?
  /// Staff can switch a medium off without losing its price.
  enabled          Boolean            @default(true)
  updatedAt        DateTime           @updatedAt
  updatedByAdminId String?
}

/// The price WAWU sets in admin for a fixed-price legal service (R-14,
/// LEGAL-03), for example business name registration. No row means the service
/// has no fixed price and is quoted by a consultant, as before. Whole naira, as
/// LegalConsultationOption.
model LegalServicePrice {
  serviceCode      String   @id
  priceKobo        Int
  updatedAt        DateTime @updatedAt
  updatedByAdminId String?
}

/// One file WAWU delivers on a legal request (LEGAL-03). A request can have
/// several; each is also posted into the matter's chat as its own message
/// (`chatMessageId`), so the client finds every document in the conversation
/// and the consultant's name stays on it. `LegalRequest.deliverableUrl` still
/// holds the first one for everything that reads a single file.
/// `wawuUserId` is the client, so an account purge finds the rows directly.
model LegalDeliverable {
  id              String   @id @default(uuid())
  legalRequestId  String
  wawuUserId      String
  fileName        String
  url             String
  /// Page count, when the consultant gave one.
  pages           Int?
  /// The chat message this file was posted as.
  chatMessageId   String?  @unique
  postedByAdminId String?
  createdAt       DateTime @default(now())

  /// The same file is never delivered twice on one request, so a repeated
  /// submit is a no-op rather than a second copy in the chat.
  @@unique([legalRequestId, url])
  @@index([legalRequestId, createdAt])
  @@index([wawuUserId])
}

/// One paid AI call that writes the assistant's opener on a matter's thread
/// (FIX-11). The opener is written on the first read of an empty, open thread
/// (`LegalChatService.getThread`), and reading a thread must never multiply
/// paid calls, so this row is two things at once:
///
/// - the CLAIM: it is written under the person's lock, only while the thread
///   is empty, no other opener call is running for it and none ended since
///   the read arrived, so parallel reads make one call between them and wait
///   for its answer;
/// - the METER: it is written in the same step that checks the person's
///   hourly limits and counts toward them, like a `LegalAssistantCall`.
///
/// One row per attempt (a failed call is still a paid call). Carries no
/// words of the conversation.
model LegalChatOpenerCall {
  id             String    @id @default(uuid())
  legalRequestId String
  wawuUserId     String
  /// When the claim stops holding. While the call runs: when it lapses, so
  /// a process that died mid-call does not hold the thread for good. Once
  /// the call has ended: when it ended. A read that arrived before this time
  /// never claims again for the thread.
  busyUntil      DateTime?
  /// How the call ended: `written` (the opener is in the thread), `failed`
  /// (the provider failed or answered nothing) or `superseded` (the thread
  /// was no longer empty when the answer came back, so it was not written).
  /// Null while it runs.
  outcome        String?
  createdAt      DateTime  @default(now())
  // Also in the database, and NOT expressible here (Prisma has no partial
  // index): UNIQUE ("legalRequestId") WHERE "outcome" = 'written', so a
  // thread has at most one opener on record whatever reaches the table. See
  // migration 20261015200000_legal_chat_opener.

  @@index([legalRequestId, createdAt])
  @@index([wawuUserId, createdAt])
}

// -----------------------------------------------------------------------------
// Event ticketing
// -----------------------------------------------------------------------------

/// The ten categories the Events section filters by. Distinct from
/// `EventType` (workshop/summit/webinar/meetup/competition), which describes
/// the FORMAT of a gathering; this describes its subject. Both are kept:
/// "a music summit" and "a fashion meetup" are different facts.
enum EventCategory {
  music
  business
  training
  conference
  church
  entertainment
  fashion
  community
  lifestyle
  other
}

/// Ticket tiers an organiser may offer. A closed set rather than free text so
/// the buyer-facing sort order is stable and a typo cannot create a tier
/// nobody can filter.
enum TicketTier {
  regular
  vip
  vvip
  early_bird
  group
  free
}

/// Where an order's MONEY is. Deliberately not merged with ticket status: an
/// order is paid or not, while each ticket inside it is separately valid,
/// checked in or void.
enum EventOrderStatus {
  /// Charge opened, nothing collected yet.
  pending
  paid
  /// The buyer has been refunded — organiser cancellation, or a manual one.
  refunded
  failed
}

/// Where one ticket IS. A refunded order voids its tickets; a checked-in
/// ticket cannot be checked in twice.
enum EventTicketStatus {
  valid
  checked_in
  /// The event was cancelled or the order refunded. Cannot be scanned in.
  void
}

/// One priced tier on one event.
///
/// `sold` is a stored counter rather than a count of rows, because it is read
/// on every page view of a popular event and incremented inside the purchase
/// transaction — a COUNT over tickets would be both slower and racier at
/// exactly the moment it matters, which is two people buying the last seat.
model EventTicketType {
  id           String     @id @default(uuid())
  eventId      String
  tier         TicketTier
  /// The organiser's own label — "Early bird", "Table of 10".
  name         String
  /// Naira. Zero for a `free` tier, and only for a free tier.
  priceNaira   Int
  /// How many exist. Not nullable: an unlimited tier is a venue with no
  /// capacity, which is a physical impossibility somebody has to answer for.
  quantity     Int
  sold         Int        @default(0)
  /// When this tier may be bought. Null start means "from publication",
  /// null end means "until the event begins".
  salesStartAt DateTime?
  salesEndAt   DateTime?
  /// EVENTS-11 (R-40, round 5 ruling): set when a host's PUT
  /// /events/:id/tickets drops or changes a tier that an order points at.
  /// Such a tier is never deleted (the order keeps its row and a pending
  /// one can still settle at the price its buyer saw); it is hidden from
  /// every public and admin read and cannot be bought. Null is on sale.
  retiredAt    DateTime?

  event      Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders     EventOrder[]
  tickets    EventTicket[]
  orderLines EventOrderLine[]

  @@index([eventId])
}

/// One purchase: N tickets of one tier, one payment.
model EventOrder {
  id           String @id @default(uuid())
  eventId      String
  ticketTypeId String
  buyerWawuId  String

  quantity       Int
  /// Naira the buyer was charged, in total. Snapshotted — a later price
  /// change must never alter what somebody already paid.
  amountNaira    Int
  /// WAWU's cut, snapshotted at purchase time for the same reason
  /// Purchase.commissionRate is: a creator who upgrades to Pro should not
  /// retroactively change the split on tickets already sold.
  commissionRate Decimal @db.Decimal(5, 4)

  status EventOrderStatus @default(pending)

  /// Payment lookup keys — see Purchase.flutterwaveTxRef and
  /// DirectMessage.flutterwaveTxId. The numeric id is REQUIRED to refund.
  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  /// Which referral link brought this sale, if any.
  referralCode String?

  refundedAt      DateTime?
  refundReference String?
  refundError     String?

  createdAt DateTime @default(now())

  /// EVENTS-07: the order paid from the buyer's WAWU wallet. All of these are
  /// null on an order the web paid through Flutterwave, whose reference stays
  /// `flutterwaveTxRef` above until the web follows (after launch). A wallet
  /// order still fills `flutterwaveTxRef` (the column is required and unique)
  /// with `wawu-event-wallet-<id>`, which no Flutterwave charge can match.
  ///
  /// `paymentProvider` is `wallet` for a wallet order, null for the web's.
  paymentProvider  String?
  /// The reference a person quotes, provider-neutral: WAW-EVT- and eight
  /// characters. Null on the web's orders.
  paymentReference String?  @unique
  /// The wallet payment (WalletPayment.id) that paid the order and the hold
  /// its price sits in until the event (R-19). Set when the payment is
  /// delivered; EVENTS-10 refunds, WALLET-17 releases, through the hold.
  walletPaymentId  String?  @unique
  holdId           String?
  paidAt           DateTime?
  /// Why a paid order could not be given its tickets (sold out in between,
  /// the event called off); the hold is refunded and the order is `failed`.
  failureReason    String?
  /// The buyer's optional Idempotency-Key on the order's creation: the same
  /// key for the same basket answers the same order, never a second one.
  requestKey       String?

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    EventTicket[]
  /// EVENTS-07: the basket. Empty on the web's orders, which hold one tier in
  /// `ticketTypeId` and `quantity` above. On a wallet order `ticketTypeId` is
  /// the first line's tier and `quantity` the tickets in all; the lines are
  /// the truth of what was bought.
  lines      EventOrderLine[]

  @@unique([buyerWawuId, requestKey])
  @@index([eventId, status])
  @@index([buyerWawuId])
  @@index([referralCode])
}

/// EVENTS-07: one tier of a basket order (E2: Regular and VIP in one payment).
/// The name and the price are snapshotted, like the order's total.
model EventOrderLine {
  id             String   @id @default(uuid())
  orderId        String
  ticketTypeId   String
  /// The tier's name when it was bought ("VIP").
  tierName       String
  /// Naira for one ticket when it was bought; 0 for a free tier.
  unitPriceNaira Int
  quantity       Int
  createdAt      DateTime @default(now())

  order      EventOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@unique([orderId, ticketTypeId])
  @@index([ticketTypeId])
}

/// One admittance. One row per seat, not per order, because each is scanned
/// separately and a group of five arriving at different times is normal.
model EventTicket {
  id           String @id @default(uuid())
  orderId      String
  eventId      String
  ticketTypeId String

  /// What the QR encodes. Opaque and unguessable — a sequential id would let
  /// anybody mint a valid-looking ticket by counting.
  code String @unique

  status      EventTicketStatus @default(valid)
  checkedInAt DateTime?
  /// The WAWU id of the organiser or staff member who scanned it.
  checkedInBy String?

  createdAt DateTime @default(now())

  order      EventOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([eventId, status])
  @@index([orderId])
}

/// A shareable link that attributes sales to whoever shared it.
///
/// Commission is deliberately NOT settled here. The brief says the reward is
/// configured later, so this records who drove what and stops short of
/// paying anybody — a payout path nobody has specified is a payout path that
/// will be wrong.
model EventReferral {
  id          String  @id @default(uuid())
  eventId     String
  /// The code in the URL. Unguessable, for the same reason a ticket code is.
  code        String  @unique
  /// Who this link is for — "Ada on Instagram". Free text, organiser-set.
  label       String
  /// The WAWU account it belongs to, when the referrer has one.
  ownerWawuId String?

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/// Someone the host lets check tickets in at the door (EVENTS-05, E19 to E24).
///
/// One row per (event, person). Removing someone sets `removedAt` rather than
/// deleting the row, so a ticket they already let in still reads "by Door 1"
/// (E23) after they stop working the door. Adding them again clears it.
/// `label` is what the door result prints after "by": the host's own name for
/// the door, "Door 1" by default.
model EventDoorStaff {
  id          String    @id @default(uuid())
  eventId     String
  staffWawuId String
  label       String
  addedAt     DateTime  @default(now())
  removedAt   DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, staffWawuId])
  @@index([staffWawuId])
}

/// The first answer to one scan at the door (EVENTS-09 round 2, D1).
///
/// A phone sends `Idempotency-Key` with a scan; the key is made once per scan
/// and sent again unchanged when the phone asks again after an answer was lost.
/// One row per (scanner, key). The row is written in the same transaction as
/// the check-in it answers, so either both exist or neither does: a repeat
/// finds the row and gets the first verdict ("let them in", with the holder's
/// name) instead of "already used" by the scanner's own door. The primary key
/// is the lock: two requests with one key, on one Hub process or two, leave
/// one row. `fingerprint` is the event and the text sent, so a key used for
/// another scan is refused. Rows are purged after `DOOR_SCAN_KEY_HOURS`.
model EventDoorScan {
  scannerWawuId String
  key           String
  eventId       String
  fingerprint   String
  /// The answer exactly as first sent (a `DoorCheckInResult` as JSON text, so
  /// a repeat is the same bytes: a JSON column would reorder its keys).
  response      String
  createdAt     DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([scannerWawuId, key])
  @@index([eventId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// WAWU Commerce — the first-party equipment storefront
//
// Added 30 Aug 2026 on product-owner brief. This is NOT the WAWUBasket /
// WAWUBeauty handoff that ShopKind and MarketplaceSave model: those are
// separate apps WAWU links out to, and this brief is explicit that WAWU sells
// this stock itself. Hence a real Product table rather than another save-only
// pointer at somebody else's catalogue.
//
// WHAT IS DELIBERATELY ABSENT IN THIS MVP, and why:
//
//   - No seller/vendor. Stock is uploaded from the admin dashboard, so WAWU is
//     the seller and there is no revenue split to snapshot. When third-party
//     sellers arrive they need a `sellerWawuId` and a commission rate ON THE
//     ORDER ITEM, for the same reason Purchase and EventOrder carry theirs.
//   - No delivery fee and no courier integration. The brief says logistics is
//     handled physically, off-platform. A fee computed with no rate card would
//     be a number invented at checkout, so the total IS the subtotal and the
//     dashboard tracks dispatch by hand.
//   - No product reviews, and therefore no rating. The brief's product card
//     shows a star rating; there is no review system to derive one from, and a
//     seeded 4.8 is fabricated social proof on something people spend real
//     money against. `ratingAvg` exists, stays null, and the card renders
//     nothing when it is null.
//   - No wallet. Orders are paid by card, like everything else here.
// -----------------------------------------------------------------------------

/// The eleven top-level aisles from the brief. A closed set so a browse-by-
/// category filter cannot be defeated by a typo in an admin form; the finer
/// grain ("Microphones", "Gimbals") is `Product.subcategory`, which is free
/// text because that list is long, uneven, and still moving.
enum ProductCategory {
  audio_music
  video_film
  lighting_studio
  photography
  computing
  art_design
  gaming_streaming
  content_creation
  live_events
  professional
  power_accessories
}

/// draft  — being written in the dashboard, invisible to shoppers
/// live   — on the storefront
/// hidden — pulled from the storefront WITHOUT deleting it, because an order
///          item points at it and a deleted product is an order nobody can
///          explain later
enum ProductStatus {
  draft
  live
  hidden
}

/// Where an order's MONEY is. Separate from fulfilment for the same reason
/// EventOrder splits order status from ticket status: a paid order that has
/// not shipped and a shipped order that was refunded are both normal, and one
/// column cannot say both.
enum ShopOrderStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

/// Where the GOODS are. Driven entirely by a human in the dashboard, because
/// the brief says logistics is physical and off-platform.
///
/// NOT the existing `FulfilmentStatus`, which despite the name is a PAYMENT
/// lifecycle for bills and insurance (pending/paid/failed/refunded with
/// `delivered` mixed in). Reusing it would put money states on a column that
/// answers "where is the package", and the two move independently — a paid
/// order that has not shipped and a shipped order that was refunded are both
/// ordinary.
enum ShopFulfilment {
  awaiting_dispatch
  dispatched
  delivered
}

model Product {
  id          String  @id @default(uuid())
  name        String
  /// Stable, human-readable, and unique — it is in the storefront URL, so it
  /// must not change under a link somebody shared.
  slug        String  @unique
  brand       String?
  description String

  category    ProductCategory
  /// e.g. "Microphones". Free text; see the ProductCategory comment.
  subcategory String

  priceNaira     Int
  /// The "was" price, for a product on offer. Null means not on offer — it is
  /// NOT allowed to equal or undercut priceNaira, which would be a fake
  /// discount, and the service refuses that.
  compareAtNaira Int?

  /// Units on hand. Decremented by a CONDITIONAL write inside the order
  /// transaction — two people buying the last one is the normal case for
  /// anything worth selling, and a read-then-write sells it twice.
  stock Int @default(0)

  /// Ordered. The first is the card image; the rest are the gallery.
  images String[]

  /// The brief's "WAWU VERIFIED ✓" — an editorial claim WAWU stands behind
  /// about the item being genuine, set by an admin. Not a creator badge and
  /// not related to the verification ladder.
  wawuVerified Boolean @default(false)
  /// The brief's "WAWU PICKS" shelf.
  wawuPick     Boolean @default(false)

  /// Null until a review system exists. See the header comment — this is not
  /// to be seeded.
  ratingAvg   Decimal? @db.Decimal(2, 1)
  ratingCount Int      @default(0)

  status ProductStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems ShopOrderItem[]

  @@index([status, category])
  @@index([status, wawuPick])
}

/// The brief calls this "ADD TO WOW". One row per product per person; adding
/// the same thing twice raises the quantity rather than making a second row.
model CartItem {
  id         String   @id @default(uuid())
  userWawuId String
  productId  String
  quantity   Int      @default(1)
  addedAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userWawuId, productId])
  @@index([userWawuId])
}

model ShopOrder {
  id          String          @id @default(uuid())
  buyerWawuId String
  status      ShopOrderStatus @default(pending)

  /// No delivery fee is charged, so these are equal today. Both exist because
  /// the day a fee is introduced, an order needs to record what the goods cost
  /// separately from what was charged — reconstructing that later is guesswork.
  subtotalNaira Int
  totalNaira    Int

  /// DELIVERY IS THE LOAD-BEARING PART OF THIS TABLE.
  /// Logistics is manual: a person reads these fields and physically takes the
  /// package somewhere. An order missing a phone number is a package that
  /// cannot be delivered, so name, phone and address are required columns
  /// rather than an optional blob.
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryCity    String
  deliveryState   String
  /// "Gate is behind the pharmacy." Optional, and often the difference.
  deliveryNote    String?

  fulfilment   ShopFulfilment @default(awaiting_dispatch)
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  /// Free text a human types: courier and waybill. Not a tracking integration.
  trackingNote String?

  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?
  /// Set when a refund could not be sent and needs a person. Internal — this
  /// must never reach a shipped app response.
  refundError      String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  items ShopOrderItem[]

  @@index([buyerWawuId, status])
  @@index([status, fulfilment])
}

/// One line. Everything a buyer was shown is SNAPSHOTTED here, because a
/// product's name and price are edited in the dashboard and an order has to
/// keep saying what was actually bought and what was actually paid.
model ShopOrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String

  nameSnapshot       String
  priceNairaSnapshot Int
  quantity           Int

  order   ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// One object in bucket storage, so a per-account storage quota can be a
/// MEASURED figure rather than a guess.
///
/// Nothing recorded bytes before this. `contentLength` was signed into the
/// presigned PUT (so storage rejects a file of any other size) and then
/// thrown away, which caps a single upload and caps a total of nothing.
///
/// A row is written at PRESIGN, before the bytes exist, because that is the
/// only moment the API is in the loop — the browser PUTs straight to storage
/// and never calls back. `pending` rows therefore include uploads that were
/// abandoned, so they are reconciled against the bucket (HeadObject) once
/// their presign window has closed: present -> confirmed, absent ->
/// abandoned. Counting pending rows toward the quota until then is
/// deliberate; the alternative is a window in which a user can presign
/// unlimited space at once.
model StorageObject {
  id          String              @id @default(uuid())
  wawuUserId  String
  /// The object key. Unique so a reconcile is idempotent.
  key         String              @unique
  bytes       Int
  contentType String
  folder      String
  status      StorageObjectStatus @default(pending)
  createdAt   DateTime            @default(now())
  /// When the object was proven to exist in the bucket. Null while pending.
  confirmedAt DateTime?
  /// When the person gave the file up (POST /uploads/release). Null otherwise.
  /// A released row stays released: a late file never counts it again.
  releasedAt  DateTime?
  /// When the Hub's sweep first looked at a given-up file after its upload
  /// link had expired (ME-04 round 3). Null until then.
  sweptAt     DateTime?
  /// When that sweep deleted a file it found (a file the person released and
  /// no listing uses). Null when it found none. A file it found on a row the
  /// person never released is counted instead: the row becomes `confirmed`.
  sweptRemovedAt DateTime?
  /// The second look, an hour or more after the first, for a file that
  /// arrived late. Null until then (ME-04 round 4).
  sweptHourAt DateTime?
  /// The third and last look, a day or more after the first. Null until then.
  sweptDayAt  DateTime?
  /// When a removal of this file from the bucket began (a release, or the
  /// sweep). Set under the person's lock, cleared under it when the removal
  /// ends; no lock or transaction is held while the bucket is called (ME-04
  /// round 5). A row with this set is also released and `abandoned`, so no
  /// listing can name its key. Null when no removal is under way.
  removingAt  DateTime?

  @@index([wawuUserId, status])
  @@index([status, createdAt])
}

enum StorageObjectStatus {
  pending
  confirmed
  abandoned
}

/// A Pro Max creator's explicit opt-in to Ditto Music distribution.
///
/// Its own row rather than a flag on CreatorState because opting in is NOT a
/// property of the plan. Pro Max INCLUDES distribution; it does not enrol
/// anybody in a third party's service, and paying must never be read as
/// consent to be signed up elsewhere. So the row exists only when the creator
/// pressed the button, and its absence on a paid Pro Max account is the
/// normal state, not missing data.
///
/// `emailedAt` is null when the invite could not be emailed — a phone-OTP
/// signup has no address. The link is always shown in the app as well, so a
/// null here means "no copy in their inbox", never "they cannot reach it".
model DittoOptIn {
  wawuUserId String    @id
  optedInAt  DateTime  @default(now())
  emailedAt  DateTime?
}

// REMOVED WITH SUBSCRIPTIONS: ReferralCode / ReferralRedemption.
//
// A referral code was a percentage discount on ONE subscription plan, keyed
// to a CreatorTier and priced off the plan table. With subscriptions removed
// (brief B1) there is no plan and no price for a code to take a percentage
// of, so the feature has no target left rather than merely no callers.
//
// This is a CONSEQUENCE of the authorized removal, not a separate product
// decision, and it leaves a real open question: verification (N4,999 creator
// / N9,999 professional) is now the primary paid action, and a discount code
// pointed at THAT would be the natural successor. Re-pointing it means
// choosing what a code applies to and what it costs, which is the product
// owner's call, so nothing here guesses at it. See DECISIONS.md.

/// Platform-wide switches an admin can flip without a deploy.
///
/// A single row, pinned to id 1. Typed columns rather than a key/value table:
/// a stringly-typed settings bag means every reader parses it its own way and
/// a typo becomes a silent default.
model PlatformSettings {
  id Int @id @default(1)

  /// When false, a REGULAR (non-creator) account cannot be created — the
  /// product is onboarding creators first. Creator signup is unaffected.
  ///
  /// Named for the half it actually gates. "publicSignupEnabled" read as
  /// though it closed the whole door, which would have been the wrong thing
  /// for the next person to implement against.
  ///
  /// Flipped from the dashboard, not from a deploy.
  userSignupEnabled Boolean @default(true)

  /// What the two ticks cost, in whole naira, per year.
  ///
  /// Columns rather than constants because a price is a commercial decision
  /// that changes without a deploy, and this table already exists to be
  /// flipped from the dashboard. The defaults are the launch prices; the
  /// single place they are written down in code is
  /// src/common/verification/verification-pricing.ts, which is also the only
  /// thing that reads these.
  ///
  /// Naira only. There is no second currency in this product.
  creatorVerificationPriceNgn      Int @default(2000)
  professionalVerificationPriceNgn Int @default(2000)

  updatedAt DateTime @updatedAt
}

/// A launch figure an admin has set (TIER-06, R-65): one row per setting key,
/// holding only the keys somebody changed. A key with no row reads its default
/// from the seed (`plans.config.json` and `plan-settings.defaults.json`).
///
/// Key and value are checked by the registry in src/plan-settings before they
/// are written and again when they are read, so the JSON column is not a
/// free-form bag: an unknown key or a value of the wrong kind never reaches
/// a reader. Deleting the row puts the setting back to its default.
model PlanSetting {
  key   String @id
  value Json

  /// Snapshot of the admin who last set it (no foreign key, as AdminOpsAudit).
  updatedByAdminId String?
  updatedAt        DateTime @updatedAt

  @@index([updatedAt])
}

/// The code somebody arrived with, remembered against their account.
///
// REMOVED WITH SUBSCRIPTIONS: ReferralClaim.
//
// This held a code between sign-up and subscription checkout, so the tier
// screen still knew about it after a detour through an email client. There is
// no tier screen and no checkout to carry it to. See the ReferralCode note
// above for the open question this leaves.

/// ─────────────────────────────────────────────────────────────────────────
/// WALLETS
///
/// A creator's wallet is an account at FLUTTERWAVE MFB, opened in their name
/// through Flutterwave's Payout Subaccount API. Flutterwave custodies the
/// money under their own CBN banking licence; WAWU never holds it, and never
/// operates a balance of its own. That distinction is the whole reason this
/// can exist at all - see docs and the wallet scope.
///
/// So none of these tables ARE the balance. Flutterwave's is authoritative;
/// these record what WAWU asked for and what it was told happened, which is
/// what makes "where did this money go" answerable.
/// ─────────────────────────────────────────────────────────────────────────
model CreatorWallet {
  wawuUserId       String   @id
  /// Flutterwave's PSA… identifier. Used to DEBIT the wallet on withdrawal.
  accountReference String   @unique
  /// Flutterwave's internal id. Used to CREDIT the wallet from our balance.
  barterId         String   @unique
  /// The creator's own account number at Flutterwave MFB. Anyone can pay into
  /// it directly, which is the wallet's second purpose.
  nuban            String?
  bankName         String?
  bankCode         String?
  status           String   @default("active")
  createdAt        DateTime @default(now())

  @@index([status])
}

enum WalletEntryKind {
  /// A creator's share of a sale, moved from WAWU's balance into their wallet.
  earning
  /// Money leaving the wallet for their bank account.
  withdrawal
  /// An earning taken back, e.g. a refunded purchase.
  reversal
}

enum WalletEntryStatus {
  pending
  completed
  failed
}

/// Every movement WAWU initiated, one row each, before it is attempted.
///
/// `reference` is the idempotency key and it is UNIQUE: a retried request
/// finds the row rather than moving the money twice. Nothing here is trusted
/// as a balance - it is the record of an instruction and its outcome.
model WalletLedgerEntry {
  id            String            @id @default(uuid())
  wawuUserId    String
  kind          WalletEntryKind
  /// Whole naira, like every other amount in this codebase.
  amount        Int
  status        WalletEntryStatus @default(pending)
  /// Our own reference, sent to Flutterwave and echoed back on the webhook.
  reference     String            @unique
  /// Flutterwave's transfer id, once it has one.
  transferId    String?
  /// What produced this entry: purchase, direct_message, credit_spend.
  sourceType    String?
  sourceId      String?
  failureReason String?
  createdAt     DateTime          @default(now())
  settledAt     DateTime?

  @@index([wawuUserId, createdAt])
  @@index([status])
  @@index([sourceType, sourceId])
}

/// A withdrawal's banking details, kept beside its ledger entry.
///
/// Separate from WalletLedgerEntry because only withdrawals have a
/// destination, and an account number belongs with the one movement that used
/// it rather than nullable on every earning row.
model WalletWithdrawal {
  id            String   @id @default(uuid())
  wawuUserId    String
  /// The ledger entry this discharges.
  entryId       String   @unique
  amount        Int
  bankCode      String
  accountNumber String
  /// Resolved from the bank before sending, never typed by the creator.
  accountName   String
  createdAt     DateTime @default(now())

  @@index([wawuUserId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE TRANSACTION PIN (task MONEY-09)
///
/// The four digits every movement of money asks for (W11, W36). Fintava has
/// no wallet PIN, so this one is WAWU's: it guards WAWU's API, not the account
/// at the bank. One row per person, created when they set their first PIN, so
/// everyone who existed before this table has no PIN (no row) until they set
/// one. docs/contract/CONVENTIONS.md section 5 is the contract.
/// ─────────────────────────────────────────────────────────────────────────
model TransactionPin {
  wawuUserId   String    @id
  /// argon2id, encoded with its own random salt (a fresh one on every set or
  /// change, so no two people share one). The PIN itself is never stored,
  /// logged or returned.
  pinHash      String
  /// Wrong tries in a row, counted when the comparison is over. Back to 0 on
  /// a right PIN, a new PIN, or once a lock has ended.
  failedTries  Int       @default(0)
  /// Set when the last allowed try was wrong; null when not locked. A lock
  /// that has passed is treated as no lock (and cleared on the next try).
  lockedUntil  DateTime?
  /// Checks reserved and not yet finished (MONEY-17 round 3). A check takes a
  /// slot in one conditional update (`failedTries + pendingTries` below the
  /// limit) BEFORE the hash is compared, compares with no transaction and no
  /// row lock open, and gives the slot back in one more update. So wrong PINs
  /// sent at the same moment cannot be compared past the limit, a right PIN
  /// never uses up a try, and no database connection waits on argon2.
  pendingTries Int       @default(0)
  /// When the newest slot was taken. A slot older than 30 seconds belongs to a
  /// check that died (a restart mid-compare) and counts as free.
  pendingSince DateTime?
  /// When the PIN was set or last changed (W35 "last changed").
  setAt        DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// ─────────────────────────────────────────────────────────────────────────
/// RESETTING THE TRANSACTION PIN BY A CODE TO THE PHONE (task MONEY-14, W37)
///
/// One row per code texted (or about to be texted) to the phone the BVN
/// check proved (WalletIdentity.verifiedPhone, G-11). Its id is the
/// `resetId` the app sends back with the code. The code itself is never
/// stored: only its argon2id hash, like the PIN. Rows are kept for the
/// rolling 24 hours the daily text limit counts over, and go with the
/// account (account purge, OWNED).
///
/// `sendState`:
///   sending   the row is written; the text is being sent
///   sent      Fintava accepted the text
///   unknown   Fintava's answer was lost: the text may have gone, so the
///             code stays usable and the row counts toward the limit; it is
///             never sent again blindly
///   failed    Fintava refused or nothing was sent: the code never works and
///             the row does not count
/// ─────────────────────────────────────────────────────────────────────────
model TransactionPinReset {
  id                String    @id @default(uuid())
  wawuUserId        String
  /// E.164, the proved phone the code went to (WalletIdentity.verifiedPhone).
  phone             String
  /// argon2id of the code. The code itself is never stored or logged.
  codeHash          String
  /// Wrong codes on this reset. Counted before the code is compared, so codes
  /// sent at the same moment cannot get past the limit together.
  failedTries       Int       @default(0)
  sendState         String    @default("sending")
  expiresAt         DateTime
  /// When a new code may be asked for (W37's countdown).
  resendAvailableAt DateTime
  /// Set once the code was right and the new PIN stored: a code works once.
  usedAt            DateTime?
  /// Set when a newer code replaced this one: only the newest code works.
  supersededAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([wawuUserId, createdAt])
  @@index([phone, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE PHONE THAT MAY APPROVE WITH A FINGERPRINT OR A FACE (task MONEY-14)
///
/// W11, W35 (R-26): a biometric approval on a known phone counts as the PIN.
/// The phone makes a P-256 key pair whose private half only its biometric
/// unlocks, and registers the public half here with the PIN. An approval is
/// that key's signature over a one-time challenge and the exact request
/// (DeviceApprovalChallenge): the server checks the signature, never a
/// client "true". One phone per person: the primary key is the person, so
/// registering another phone replaces this one (and its `deviceId`, so the
/// old phone's challenges stop working). Turning it off deletes the row, and
/// so does a PIN reset by code. Holds no secret: a public key.
/// ─────────────────────────────────────────────────────────────────────────
model ApprovalDevice {
  wawuUserId String    @id
  /// New on every registration; the app keeps it to know this phone is the one.
  deviceId   String    @unique @default(uuid())
  /// SubjectPublicKeyInfo (DER) of a P-256 key, base64url.
  publicKey  String
  /// What the phone approves with: `fingerprint` or `face` (W35's label).
  biometric  String
  /// The last approval that passed.
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// One challenge for one biometric approval (task MONEY-14): random, short
/// lived, tied to the person and the phone it was issued for, and used up by
/// the first approval that names it, right or wrong.
model ApprovalChallenge {
  id         String    @id @default(uuid())
  wawuUserId String
  /// ApprovalDevice.deviceId when the challenge was issued.
  deviceId   String
  /// 32 random bytes, base64url. Not a secret: only the phone's key can sign it.
  challenge  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([wawuUserId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE NAIRA WALLET AT FINTAVA (table added by task MONEY-11)
///
/// WAWU's pointer to a person's account at Fintava (Loma Bank's licence,
/// R-1): which Fintava wallet is theirs. It is NOT the balance and holds no
/// money figure at all: the balance is read from Fintava on every request
/// (GET /money/wallet/balance, MONEY-11) and never stored or summed here.
///
/// No row means no wallet yet (R-6): the money routes answer
/// `409 wallet_not_open` and the app leads to Open your wallet. MONEY-12
/// writes the row when Fintava's `POST /create/customer` answers, with the
/// three ids it returns (mobile repo `docs/fintava/naira-api.md`,
/// "Identifiers": they are not interchangeable), and adds what it needs for
/// the opening state. One wallet per person, one person per wallet.
/// ─────────────────────────────────────────────────────────────────────────
model FintavaWallet {
  wawuUserId    String   @id
  /// `userInfo.id`: history (`/txn?customerId=`) and the bank-send `sourceId`.
  customerId    String   @unique
  /// `wallet.id`: the balance, freeze and unfreeze.
  walletId      String   @unique
  /// The NUBAN at Loma Bank: wallet-to-wallet sends and name checks.
  accountNumber String   @unique
  /// `wallet.accountName` as Fintava answered when the account opened
  /// (MONEY-12, W1, A8). Null on a row written before the column existed.
  accountName   String?
  /// Which wallet provider this row belongs to (NUV-01): `fintava` or
  /// `nuvion`; null is Fintava (a row from before the column). A server acts
  /// only on rows of the provider it runs, so after a rollback one
  /// provider's ids are never sent to the other (MONEY-20 finding 2).
  provider      String?  @default("fintava")
  /// The provider's own name for the account's level (`TIER_2`), as its last
  /// balance read said it (WALLET-23). For ops only: the app is never shown it.
  accountTier   String?
  /// What the account may send in a Lagos day, in kobo, as of `limitsReadAt`
  /// (WALLET-23); null when the provider named no limit. A copy for the
  /// limit check and the W35 row, refreshed on every balance read; the
  /// provider stays the one that enforces it.
  dailyLimitKobo BigInt?
  /// When `accountTier` and `dailyLimitKobo` were last read. Null: never read.
  limitsReadAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// ─────────────────────────────────────────────────────────────────────────
/// OPENING A PERSON'S FINTAVA ACCOUNT (task MONEY-12)
///
/// One row per person who asked to open a wallet: the record that makes
/// opening safe to retry. Fintava's `POST /create/customer` refuses neither
/// a repeated BVN nor a repeated call (mobile repo
/// `docs/fintava/sandbox/07-create-customer.md`), so nothing at Fintava
/// stops a second account: this row does. Its primary key is the claim (one
/// opening in flight per person, whatever the number of taps or servers),
/// and the two unique keys stop a second WAWU account opening another
/// Fintava account for the same BVN or phone.
///
/// `state`:
///   opening   create was sent (or is about to be) under this attempt
///   unknown   the answer was lost: reconciled with Fintava, never resent
///             blindly (wallet-opening.service.ts)
///   failed    Fintava refused, or reconciling proved nothing was created:
///             a new attempt may start
///   open      FintavaWallet holds the account
///   conflict  Fintava has an account for this phone that another WAWU
///             account already holds: needs a person to look at it
///
/// Never the BVN, the NIN, the name, the date of birth or the address: the
/// keyed hash of the BVN (as WalletIdentity keeps it) and the phone that the
/// BVN check proved, which is how a lost answer is found again.
/// ─────────────────────────────────────────────────────────────────────────
model FintavaWalletOpening {
  wawuUserId       String    @id
  state            String    @default("opening")
  /// WalletIdentity.bvnHash of the passed check this opening was tied to.
  bvnHash          String    @unique
  /// WalletIdentity.bvnVerifiedAt of that check.
  bvnVerifiedAt    DateTime
  /// WalletIdentity.verifiedPhone (E.164): sent to Fintava, and how a lost
  /// answer is looked up (`/customers/details?phone=`).
  phone            String    @unique
  /// Create requests sent so far (each one a new attempt).
  attempts         Int       @default(1)
  /// When the current attempt started: no resend before the money timeout
  /// plus the resend safety window has passed since then.
  attemptStartedAt DateTime  @default(now())
  /// Why the last attempt did not open the account: our own word, never
  /// Fintava's text.
  failure          String?
  /// When Fintava was last asked about a lost answer.
  checkedAt        DateTime?
  /// Which wallet provider this opening is with (NUV-01): `fintava` or
  /// `nuvion`; null is Fintava. The opening sweep reconciles only openings
  /// of the provider the server runs.
  provider         String?   @default("fintava")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([state, attemptStartedAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// FINTAVA WEBHOOK EVENTS (task MONEY-07)
///
/// Every signed delivery Fintava sends to `POST /api/hub/webhooks/fintava`,
/// recorded once and acknowledged. Nothing here moves money or touches a
/// balance: the ledger (MONEY-10) and the pending sweep (MONEY-08) read the
/// `pending` rows and mark them `processed` or `failed`. Fintava's balance
/// stays the only balance.
///
/// Fintava sends no event id and no timestamp (mobile repo
/// `docs/fintava/naira-api.md`, "Webhooks"), so a delivery is identified by
/// its event, the transaction reference it carries and the status it
/// reports. The unique constraint over those three IS the replay protection:
/// the insert is `ON CONFLICT DO NOTHING`, so a retry, a replayed capture or
/// two copies arriving at the same moment leave one row.
/// ─────────────────────────────────────────────────────────────────────────
enum FintavaWebhookProcessing {
  /// Recorded; waiting for the task that consumes this event.
  pending
  /// The consuming task handled it.
  processed
  /// The consuming task tried and could not; `note` says why.
  failed
  /// The delivery named no event we know (or none). Kept for review.
  unrecognised
}

model FintavaWebhookEvent {
  id String @id @default(uuid())

  /// The event name, trimmed and lower case (`VIRTUAL_WALLET_PAYMENT` is
  /// `virtual_wallet_payment`), read from the body's `event` field or, when
  /// that is missing, its `type` field. Empty when the delivery named none.
  event    String
  /// The event name exactly as sent, when there was one.
  eventRaw String?

  /// The transaction reference this delivery is keyed on, read from `data`
  /// in the order the event's entry in FINTAVA_WEBHOOK_EVENTS
  /// (src/fintava/webhook/fintava-webhook-event.ts) lists. When the
  /// delivery carries none, the SHA-256 of its raw body (`sha256:<hex>`),
  /// so a byte-identical retry still lands on the same row.
  reference      String
  /// Where `reference` came from: `data.reference`, `data.customerReference`,
  /// `data.reversalRef`, ..., or `body.sha256`. Every text column here has
  /// any NUL replaced by U+FFFD (Postgres text cannot hold one), the same way
  /// every time, so a replay still lands on the same key.
  referenceField String
  /// Fintava's own status for the transaction (`data.status`, else
  /// `data.paymentStatus`), upper case; empty when it sent none.
  fintavaStatus  String

  /// `data.reference` and `data.customerReference` (or `CustomerReference`)
  /// as sent, so a consumer can match either to what it stored. A transfer
  /// RESPONSE swaps these two names (`sandbox/11-`); whether a delivery does
  /// too is unconfirmed until a real one is recorded (OPS-10), so neither
  /// is assumed to be ours.
  dataReference         String?
  dataCustomerReference String?

  /// The body exactly as delivered: the bytes the signature covers, kept
  /// byte for byte (`bytea`, so a NUL or any other byte fits). Personal data
  /// lives here and in `payload`, never in a log. Empty once `bodyClearedAt`
  /// is set (FIX-20: src/webhook-retention/).
  rawBody Bytes
  /// The same body parsed, with every NUL (`\u0000`) in a key or a string
  /// replaced by U+FFFD: Postgres json cannot hold a NUL, and a delivery it
  /// refused would be retried and lost. `rawBody` keeps the original. JSON
  /// null once `bodyClearedAt` is set.
  payload Json

  /// The key (MONEY-08 round 3): the SHA-256, hex, of `rawBody`, the exact
  /// bytes Fintava signed. A retry or replay of the same delivery is the
  /// same bytes and lands on the same row; any other body, even for the same
  /// transaction and status (another amount, say), is a delivery of its own
  /// and reaches its consumer. Filled for every row; nullable only because
  /// it was added to a table that already had rows.
  bodySha256 String? @unique

  processingStatus FintavaWebhookProcessing @default(pending)
  /// Set by the consuming task: what it did, or why it could not.
  note             String?
  receivedAt       DateTime                 @default(now())
  processedAt      DateTime?

  /// When the retention job cleared `rawBody` and `payload` (FIX-20): the
  /// delivery's personal data is not kept for ever. Null until then. What
  /// stays is everything the repeat check and the readers need: the id, the
  /// event, the references, `bodySha256` (the key a delivery sent again
  /// lands on), the outcome and the times. Only a `processed` row is ever
  /// cleared (src/webhook-retention/webhook-retention-config.ts says which
  /// states are held and why). A row where this is set always has an empty
  /// body, a JSON null `payload` and a `bodySha256`
  /// (`FintavaWebhookEvent_body_cleared_check`). Partial index
  /// `FintavaWebhookEvent_body_retention_idx` (processingStatus,
  /// receivedAt) WHERE bodyClearedAt IS NULL is in the migration only:
  /// Prisma cannot write a partial index.
  bodyClearedAt DateTime?

  /// Was the unique key until MONEY-08 round 3; now only an index.
  @@index([event, reference, fintavaStatus])
  @@index([processingStatus, receivedAt])
  @@index([dataReference])
  @@index([dataCustomerReference])
}

/// ─────────────────────────────────────────────────────────────────────────
/// WHO OPENS A WALLET (tables added by task KYC-01)
///
/// The BVN check that starts Open your wallet (R-6: identity is checked when
/// someone opens a wallet, never at sign-up). Fintava's
/// `GET /compliance/verify/bvn` answers name, date of birth, phone, gender
/// and a photo; the name, date of birth and gender go back to the app once,
/// in the check's answer, for A5. None of it is kept here.
///
/// What is kept, and nothing more:
/// - when the BVN passed, a KEYED hash of it (HMAC-SHA256 under
///   IDENTITY_HASH_KEY, never a plain or salted hash: a BVN has only 10^11
///   values, so anything without a server secret can be walked in minutes)
///   and its last 4 digits;
/// - the same for the NIN taken on the same screen (A26), which Fintava
///   needs to open the account (MONEY-12);
/// - the account phone that matched the BVN's phone, E.164 (BACKEND_GAPS
///   G-11: the one phone number identity checks have proved);
/// - the occupation typed on A5.
/// The full BVN and NIN are never stored and never logged: the app sends
/// them again to the steps that need them (KYC-02's selfie, MONEY-12's
/// account opening), which check them against these hashes. The address is
/// not held at all: it goes straight to account opening.
/// ─────────────────────────────────────────────────────────────────────────
model WalletIdentity {
  wawuUserId    String    @id
  /// HMAC-SHA256 of the BVN under IDENTITY_HASH_KEY, hex. Null until a check passes.
  bvnHash       String?
  bvnLast4      String?
  /// When the BVN check last passed (the phone matched).
  bvnVerifiedAt DateTime?
  /// HMAC-SHA256 of the NIN under IDENTITY_HASH_KEY, hex.
  ninHash       String?
  ninLast4      String?
  /// The account's phone, E.164, when it matched the BVN's phone.
  verifiedPhone String?
  /// Typed on A5.
  occupation    String?
  /// The BVN record's first and last name as keyed hashes, one per word
  /// (WALLET-14): `{ "v": 2, "check": hex, "first": [hex...], "last":
  /// [hex...] }`, each word HMAC-SHA256 under IDENTITY_HASH_KEY over
  /// `name:<wawuUserId>:<bvnVerifiedAt>:<WORD>`, so the same word differs
  /// across people and checks and no hash can be matched to a name stored
  /// elsewhere without the key. Written with every passed check, null when
  /// Fintava gave no first or last name in a form we read. Never the name
  /// itself. Read only to compare a payout account's name with the BVN name
  /// (A21, `PayoutAccountView.matchesBvnName`); any other shape, or a
  /// `check` that does not recompute, reads as no BVN name.
  bvnNameKeys   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// One row per BVN check sent (or about to be sent) to Fintava, which charges
/// for each one even when it says no (mobile repo
/// `docs/fintava/sandbox/04-bvn-check.md`). It is how the per-person daily
/// limit is counted; it holds no part of the BVN.
model BvnCheckAttempt {
  id         String   @id @default(uuid())
  wawuUserId String
  /// `pending` while Fintava is being asked; then `verified`,
  /// `phone_mismatch`, `refused` or `unavailable`.
  outcome    String   @default("pending")
  /// NUV-02 round 3 (migration 20261019110000): under a provider that
  /// reviews the person, the opening tries are counted per address too (at
  /// most OPEN_ATTEMPTS_PER_ADDRESS_PER_HOUR from one place an hour). A keyed
  /// hash of the caller's address, never the address; null for a Fintava
  /// check and for a try with no client address.
  addressKey String?
  createdAt  DateTime @default(now())

  @@index([wawuUserId, createdAt])
  @@index([addressKey, createdAt])
}

/// One row per selfie match sent (or about to be sent) to Fintava (task
/// KYC-02): Fintava's `POST /compliance/verify/bvn/selfie` compares a selfie
/// with the BVN record's photo, a face match and not a liveness check. Each
/// one is charged even when the faces do not match (mobile repo
/// `docs/fintava/sandbox/05-bvn-selfie.md`), so this is how the per-person
/// daily limit is counted, and it is the record of the result. It never
/// holds the selfie, the BVN photo or any part of the BVN: only the outcome,
/// when, and Fintava's confidence score when it gives one.
model SelfieMatchAttempt {
  id            String    @id @default(uuid())
  wawuUserId    String
  /// `pending` while Fintava is being asked; then `matched`, `not_matched`
  /// or `unavailable`.
  outcome       String    @default("pending")
  /// Fintava's confidence score for this match, as sent, when it sends one.
  confidence    Float?
  /// When Fintava's answer came back; null while pending.
  settledAt     DateTime?
  createdAt     DateTime  @default(now())
  /// The passed BVN check this selfie was compared against, read once at the
  /// start of the request (migration 20261002230000): when that check passed
  /// (WalletIdentity.bvnVerifiedAt) and its BVN's keyed hash
  /// (WalletIdentity.bvnHash, never the BVN). A match counts only while both
  /// still equal the person's current check, so a selfie matched to one BVN
  /// never counts for another checked meanwhile. Null on a row written
  /// before the columns existed: such a row never counts as a match.
  bvnVerifiedAt DateTime?
  bvnHash       String?

  @@index([wawuUserId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
/// FREE CHAT BETWEEN TWO USERS (task INBOX-06, DECISIONS R-13)
///
/// Any two people can chat for free with text, photos, videos and PDFs. This
/// is not the paid DirectMessage (a fan's paid question to a creator, with a
/// reply deadline): nothing here costs anything or touches money. A block in
/// either direction (BlockedAccount) stops new messages and new chats; the
/// history stays readable by both people.
///
/// One row per pair of people: the two ids are stored sorted (userAWawuId is
/// the smaller), so opening a chat with someone twice, from either side,
/// finds the same row.
// ─────────────────────────────────────────────────────────────────────────
model ChatConversation {
  id             String            @id @default(uuid())
  userAWawuId    String
  userBWawuId    String
  createdAt      DateTime          @default(now())
  /// When the newest message was sent, or when the chat was opened if it has
  /// none yet. The chat list is ordered by it.
  lastActivityAt DateTime          @default(now())
  participants   ChatParticipant[]
  messages       ChatMessage[]
  moneyRequests  MoneyRequest[]

  @@unique([userAWawuId, userBWawuId])
}

/// One row for each of the two people in a chat, holding how far that person
/// has read. The other person's read mark is what turns "sent" into "read"
/// on a message the caller sent.
model ChatParticipant {
  conversationId    String
  wawuUserId        String
  /// The time of the newest message this person has read. Null: nothing read
  /// yet. Only ever moves forward.
  lastReadAt        DateTime?
  /// The message that mark points at.
  lastReadMessageId String?
  /// When the mark last moved (INBOX-02). The live catch-up reads it to tell
  /// which read marks changed since a cursor. Null on a row that has never
  /// moved, and on every row from before this column.
  readAt            DateTime?
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, wawuUserId])
  @@index([wawuUserId])
}

/// One message. Text, an attachment, or both. An attachment is an object the
/// sender uploaded through POST /chats/:id/attachments (StorageObject, folder
/// chat/media or chat/file); the key is stored, never a link, and every read
/// signs a fresh link.
model ChatMessage {
  id                    String           @id @default(uuid())
  conversationId        String
  senderWawuId          String
  /// text | image | video | file
  kind                  String
  text                  String?
  attachmentKey         String?
  attachmentContentType String?
  attachmentBytes       Int?
  /// The file's own name, shown on a PDF bubble. Null for text and media.
  attachmentName        String?
  /// The sender app's own id for this message, so a resend after a lost
  /// answer returns the first message instead of posting it twice.
  clientMessageId       String?
  createdAt             DateTime         @default(now())
  conversation          ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderWawuId, clientMessageId])
  @@index([conversationId, createdAt, id])
}

/// One ask for money written into a chat (task INBOX-15, R-13): the requester
/// asks the other person in the chat for an amount, with a reason. The ask is
/// also a chat message (`messageId`, kind `money_request`), so it sits in the
/// conversation and in the inbox like any other bubble.
///
/// `status` is pending, paid, declined or cancelled, and each of the last
/// three is final. Paying is a send to the requester through the wallet send
/// (WALLET-07). `transferId` is the send that is paying it: set in the same
/// transaction that claims the send, so two taps, or a replay, can never
/// start two sends for one request; cleared when that send failed or was
/// reversed (nothing moved, so it can be paid again); and, once the send
/// completed, kept beside `status = paid`. A pending request with a
/// `transferId` is being paid: it cannot be declined or cancelled.
model MoneyRequest {
  id              String           @id @default(uuid())
  conversationId  String
  requesterWawuId String
  payerWawuId     String
  /// What the requester asks for, in kobo. What the payer pays on top is
  /// quoted by the send's fee quote, never stored here.
  amountKobo      BigInt
  memo            String?
  status          String           @default("pending")
  /// The chat message that carries the request. Unique: one bubble each.
  messageId       String?          @unique
  /// The requester app's own id, so a resend after a lost answer returns the
  /// first request instead of asking twice.
  clientRequestId String?
  /// The WalletTransfer that is paying (or paid) this request.
  transferId      String?          @unique
  /// When `status` last changed (null while still pending, never touched).
  /// The live catch-up and the inbox rank by it.
  changedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, requesterWawuId, clientRequestId])
  @@index([requesterWawuId, createdAt])
  @@index([payerWawuId, createdAt])
  @@index([status, transferId])
  @@index([changedAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE LEDGER (task MONEY-10)
///
/// WAWU's own record of every movement of money on a Fintava wallet it
/// knows (a person's FintavaWallet, or WAWU's merchant wallet), mirrored
/// from Fintava in integer kobo. One row per wallet side of a movement: a
/// send from A to B is A's `out` row and B's `in` row.
///
/// It is NEVER a balance. The balance is Fintava's, read on every request
/// (MONEY-11); nothing adds these rows up and shows the result as money a
/// person has. MONEY-15 serves these rows as the history (W26 to W28) and
/// MONEY-16 checks them against Fintava every night.
///
/// Exactly once: a movement is known by several references, and which one a
/// webhook carries is unconfirmed (BACKEND_GAPS G-19). Every reference a
/// row is known by is a FintavaLedgerReference row whose primary key is
/// (accountNumber, direction, value). A second sighting of the same
/// movement on the same side collides on that key and is merged into the
/// first row; there is no read before the write.
/// ─────────────────────────────────────────────────────────────────────────
enum FintavaLedgerWallet {
  /// A person's wallet (FintavaWallet); wawuUserId is set.
  user
  /// WAWU's merchant wallet (R-19); wawuUserId is null.
  merchant
}

enum FintavaLedgerDirection {
  in
  out
}

/// Same values as TransferStatus in the wallet contract (src/money).
enum FintavaLedgerStatus {
  pending
  completed
  failed
  reversed
}

/// Same values as TransactionCategory in the wallet contract (src/money).
enum FintavaLedgerCategory {
  transfer
  top_up
  earning
  purchase
  bill
  hold
  refund
  reversal
}

/// Same values as TransactionCounterpartyView.kind in the wallet contract.
enum FintavaLedgerCounterpartyKind {
  wawu_user
  bank_account
  biller
  wawu
}

model FintavaLedgerEntry {
  id String @id @default(uuid())

  walletKind    FintavaLedgerWallet
  /// The person whose wallet this is; null on WAWU's merchant wallet.
  wawuUserId    String?
  /// The Fintava wallet (NUBAN) this row is on.
  accountNumber String
  direction     FintavaLedgerDirection
  status        FintavaLedgerStatus
  category      FintavaLedgerCategory

  /// What moved, before fees, in kobo. BIGINT: never a float, never naira.
  amountKobo      BigInt
  /// What Fintava reported it took on top of the amount (out rows; 0 on in rows).
  feeKobo         BigInt  @default(0)
  /// Fintava's charge and WAWU's fee as quoted to the person (R-10), set by
  /// the task that made the movement; null when only Fintava's total is known.
  providerFeeKobo BigInt?
  wawuFeeKobo     BigInt?
  /// Out: what left the wallet (amount + fees). In: what arrived.
  totalKobo       BigInt

  counterpartyKind          FintavaLedgerCounterpartyKind?
  counterpartyName          String?
  counterpartyWawuUserId    String?
  counterpartyAccountNumber String?
  counterpartyBankCode      String?
  counterpartyBankName      String?

  /// What the movement paid for (W27 "On"), set by the paying feature:
  /// a PaymentKind from the wallet contract, its target and its title.
  linkKind     String?
  linkTargetId String?
  linkTitle    String?
  /// The person's own note on a send.
  note         String?
  /// Fintava's narration or description, as sent.
  narration    String?

  /// OUR CustomerReference: shown on the receipt, and the one a lookup finds.
  customerReference    String?
  /// Fintava's `reference` (findable by lookup).
  fintavaReference     String?
  /// The transfer response's `reference` (not findable by lookup).
  tagapayTransRef      String?
  fintavaTransactionId String?
  sessionId            String?

  /// The feature's own records, when a transfer or payment made this row.
  transferId String?
  paymentId  String?

  /// A debit that came back (`debit_transfer_reversal`): the row's status
  /// becomes `reversed` and these hold what Fintava reported. Never a
  /// second row.
  reversalReference   String?
  reversalAmountKobo  BigInt?
  reversalChargesKobo BigInt?
  reversalTotalKobo   BigInt?
  reversedAt          DateTime?

  /// Why a movement failed, when Fintava said so.
  failureReason String?
  /// Set when a later sighting of this movement disagreed with what is
  /// stored (an amount, or a status Fintava gave both ways): the stored
  /// figure is kept, the status is not moved by that sighting, the sweep
  /// leaves the row alone, and MONEY-16 reports it (a stop: WORKFLOW 10).
  discrepancy   String?

  /// How the ledger first learned of it: send, webhook, lookup or history.
  source        String
  /// The webhook event that created the row, when one did.
  sourceEventId String?

  /// When the money moved: Fintava's time when it gave one, else first seen.
  occurredAt  DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// MONEY-08, the pending sweep's schedule, kept on the row so that a
  /// restart or a second server keeps it. When Fintava is next asked about
  /// this `pending` row; null until the first check, which is due at
  /// createdAt (or revivedAt) plus LEDGER_STATUS_CHECK_AFTER_MINUTES.
  nextCheckAt  DateTime?
  /// How many times the sweep has asked about it. The rest before the next
  /// check doubles with each one, 1, 2, 4 ... minutes, at most 60.
  statusChecks Int       @default(0)
  /// MONEY-08: when a row failed because Fintava had no record of it
  /// (LEDGER_ABSENT_FAILURE) was seen again and taken back to its sighting's
  /// status, and which kind of sighting did it (send, webhook, lookup or
  /// history). A revival is not a disagreement with Fintava, so it is never
  /// written on `discrepancy`, and the row stays in the sweep.
  revivedAt    DateTime?
  revivedBy    String?

  /// Which wallet provider recorded this movement (NUV-01): `fintava` or
  /// `nuvion`; null is Fintava. The pending sweep and the ledger consumer
  /// act only on rows of the provider the server runs.
  provider String? @default("fintava")

  references FintavaLedgerReference[]

  /// WALLET-10: the answer to "was the person told about this credit": one
  /// row once the money-in notice sweep has dealt with it. Only `in` rows of
  /// a person's wallet ever get one: a bank transfer in (`top_up`), money from
  /// another person (`transfer`), earnings landed (`earning`) and refunds
  /// (`refund`), since WALLET-39.
  moneyInNotice MoneyInNotice?

  @@index([wawuUserId, occurredAt])
  @@index([accountNumber, occurredAt])
  @@index([status, occurredAt])
  @@index([customerReference])
  @@index([status, nextCheckAt])
  /// WALLET-10: the money-in notice sweep reads the credits the Hub learned of
  /// lately (`direction`, `category`, then `createdAt`), every few seconds.
  @@index([direction, category, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// MONEY IN, TOLD ONCE (task WALLET-10, BACKEND_GAPS G-33)
///
/// One row per credited ledger row (`direction` in, `category` top_up, transfer,
/// earning or refund since WALLET-39, on a person's wallet) that the money-in
/// notice sweep has dealt with: the
/// primary key is the exactly-once rule. The row is written in the same
/// transaction as the Notification it answers (NotificationService.emit takes
/// the transaction), so there is never a notification without its row here,
/// nor a row here claiming one that was not written: a stop between the two
/// writes undoes both, and the next sweep does them again. Two Hub processes,
/// a replayed delivery or a ledger row seen twice meet on this key.
///
/// Notified from the ledger rows, never from the webhook event (G-33): the
/// event table has one `processingStatus` for every consumer, and the ledger
/// marks an `account_funded` delivery processed once it is a ledger row.
///
/// `outcome`:
///   sent    a `money_in` notification was written (the push sender takes it
///           from the Notification table, INBOX-03)
///   muted   the person's "Money in" switch (Z3) was off: nothing was written
///           and nothing waits to be sent if they switch it on
///   before  the credit was in the ledger when this table was made: it is not
///           news (the migration marks every such row)
///
/// `notificationId` is the Notification written when `sent`. It is not a
/// foreign key: the person may delete the notification, and the answer here
/// must stay. No column here names a person; the row goes with its ledger row
/// (cascade) when an account is deleted.
/// ─────────────────────────────────────────────────────────────────────────
enum MoneyInNoticeOutcome {
  sent
  muted
  before
}

model MoneyInNotice {
  entryId        String               @id
  entry          FintavaLedgerEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  outcome        MoneyInNoticeOutcome
  notificationId String?
  createdAt      DateTime             @default(now())

  /// WALLET-39: when the person was told the credit was taken back (the
  /// ledger row went `reversed` after a `sent` notice). Null until then, and
  /// always null on a `muted` or `before` mark: nothing was said, so nothing
  /// needs correcting. The mark and the correction notification are written in
  /// one transaction, so a reversal is corrected once.
  correctedAt              DateTime?
  /// The correction notification written then; null when `correctedAt` was
  /// set by the migration for a reversal that was already in the ledger.
  correctionNotificationId String?
}

/// Every reference one ledger row is known by. The primary key is the
/// exactly-once rule: one movement, one side, one row.
model FintavaLedgerReference {
  /// The side: the row's wallet and direction.
  accountNumber String
  direction     FintavaLedgerDirection
  /// The reference text, exactly as Fintava or WAWU wrote it.
  value         String
  /// ours, fintava, tagapay, transaction_id, session, delivery
  kind          String
  entryId       String
  entry         FintavaLedgerEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now())

  @@id([accountNumber, direction, value])
  @@index([entryId])
  @@index([value])
}

/// ─────────────────────────────────────────────────────────────────────────
/// IDEMPOTENCY KEYS ON MONEY-MOVING REQUESTS (task MONEY-17)
///
/// One row per (person, method, route, Idempotency-Key): the primary key is
/// the lock (docs/contract/CONVENTIONS.md section 4). The row is written in
/// the same transaction as the payment it guards, once every check made
/// before money moves has passed (wallet, PIN, body, quote, funds), so a
/// refusal before that point stores nothing and the key can be sent again.
/// `fingerprint` is the SHA-256 of the request body as canonical JSON (keys
/// sorted); headers are not part of it, so the PIN is not either.
///
/// `state`:
///   in_progress  the request that wrote it is still running (or died after
///                writing it: `resourceId` names the payment, and a later
///                request answers from that payment's record)
///   done         `responseStatus` and `responseBody` are the answer, sent
///                again byte for byte to every repeat
/// Kept at least 24 hours (IDEMPOTENCY_KEY_HOURS), then purged.
/// ─────────────────────────────────────────────────────────────────────────
model MoneyIdempotencyKey {
  wawuUserId     String
  method         String
  route          String
  key            String
  fingerprint    String
  state          String
  /// Which request holds the key (a random id per claim), so a request that
  /// gives a key back never frees a later request's claim on it.
  claimId        String?
  /// The payment (or transfer) this request made.
  resourceId     String?
  responseStatus Int?
  /// The JSON answer as sent, kept as text so a replay is the same bytes.
  responseBody   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([wawuUserId, method, route, key])
  @@index([updatedAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// A PAYMENT FROM A WALLET (task MONEY-17)
///
/// One row per payment for anything WAWU sells: the buyer's wallet pays WAWU's
/// Fintava merchant wallet (R-19) the price, and Fintava takes its
/// balance-transfer charge on top (R-10), as quoted. The split is recorded
/// here with the payment, of the price only (R-10, R-5: one 85/15 split):
/// `payeeShareKobo` is the creator's 85% (floor), `wawuShareKobo` WAWU's 15%
/// (the rest); with no payee (WAWU itself is paid) the whole price is WAWU's.
/// Nothing here moves the payee's share: WALLET-16 lands it in their wallet
/// (R-11) and sets `payeeSettledAt`.
///
/// The ledger rows of the movement (FintavaLedgerEntry, buyer `out` and
/// merchant `in`) carry this row's id as `paymentId` and its
/// `customerReference`. `status` follows Fintava: `pending` until the debit is
/// confirmed (the answer was lost: the ledger's status check settles it,
/// never a blind resend), `completed`, `failed` (no money left the wallet),
/// `reversed`. Every figure is integer kobo.
/// ─────────────────────────────────────────────────────────────────────────
model WalletPayment {
  id                    String    @id @default(uuid())
  /// Null once the payer's account is deleted: the payment stays (the
  /// payee's share may be unpaid), the payer side is anonymised.
  payerWawuUserId       String?
  /// A PaymentKind of the wallet contract and the owning feature's id for it.
  kind                  String
  targetId              String
  title                 String
  /// Who the price is for; null when WAWU itself is paid.
  payeeWawuUserId       String?
  priceKobo             BigInt
  /// Fintava's charge as quoted, WAWU's fee (0 on a purchase) and the total.
  providerFeeKobo       BigInt
  wawuFeeKobo           BigInt
  totalKobo             BigInt
  /// The 85/15 split of the price (R-5).
  payeeShareKobo        BigInt
  wawuShareKobo         BigInt
  payeeSettledAt        DateTime?
  /// OUR reference at the wallet provider, derived from this row's id.
  customerReference     String    @unique
  payerAccountNumber    String?
  /// WAWU's own account at the provider the money went to (Fintava's
  /// merchant wallet, Nuvion's operational account).
  merchantAccountNumber String
  /// The wallet provider that took the payment (WALLET_PROVIDER at the time:
  /// `fintava` or `nuvion`). The sweep asks only the provider the server
  /// runs about its own payments, so a rollback never asks one provider
  /// about the other's transfers (MONEY-20 finding 2).
  provider              String    @default("fintava")
  status                String
  /// `<payer>:<kind>:<targetId>` while the payment is `pending`, null once
  /// it is settled: the unique key is the rule "one open payment per buyer
  /// and item" (a second answers `409 payment_in_progress`).
  openKey               String?   @unique
  /// The sweep's schedule for a `pending` payment: when Fintava is next
  /// asked, how many times it has been, and when it went to manual review
  /// (past PAYMENT_REVIEW_AFTER_HOURS with no answer; still pending, never
  /// "no money moved").
  nextCheckAt           DateTime?
  checks                Int       @default(0)
  reviewSince           DateTime?
  failureReason         String?
  /// Fintava's record of the debit disagreed with the quote (a fee, an
  /// amount): kept for review, as on the ledger row (MONEY-16 reports it).
  discrepancy           String?
  /// When the provider was found to have debited more than the quoted total
  /// (lead ruling 5, 8 Oct 2026): the payment then records and answers the
  /// real fee and total, `discrepancy` names both figures, and NUV-08
  /// reconciles it with the provider. Null: the debit was as quoted or less.
  debitReviewSince      DateTime?
  /// When the provider's charge was found not to be believable (MONEY-18, N2):
  /// below 0, or above the quoted fee by more than PAYMENT_CHARGE_REVIEW_ABOVE_KOBO.
  /// The payment is then held for a person with both figures on `discrepancy`:
  /// no path completes or delivers it (`reviewSince` is set with it while it is
  /// `pending`). Null: the charge was believable.
  chargeReviewSince     DateTime?
  /// A tip's message.
  note                  String?
  /// What the item was quoted with, kept from the claim for the delivery
  /// (TIER-06 round 2): a tier purchase's goods. A flat JSON object the kind
  /// wrote (`PayableTarget.terms`); null for a kind that sets none and for
  /// payments claimed before this column.
  terms                 Json?
  /// When the debit was first sent to Fintava (the reconcile window).
  sentAt                DateTime?
  completedAt           DateTime?
  /// When the owning feature delivered what was paid for.
  fulfilledAt           DateTime?
  /// The sweep's schedule for a `completed` payment not yet delivered (MONEY-17
  /// round 4): the same capped backoff as the check (1, 2, 4 ... 60 minutes),
  /// its own attempt count and next attempt; past PAYMENT_REVIEW_AFTER_HOURS it
  /// goes to review (`reviewSince`), still claimed, and the sweep stops.
  deliveryAttempts      Int       @default(0)
  nextDeliveryAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  /// Set for a held kind (paid DM, ticket, bill) once the payment completes (MONEY-18).
  hold                  WalletHold?
  /// The payee's 85% of an ordinary sale, owed to their wallet until it lands (WALLET-16).
  earning               EarningSettlement?

  @@index([payerWawuUserId, createdAt])
  @@index([status, createdAt])
  @@index([kind, targetId])
  @@index([status, reviewSince, nextCheckAt, id])
  @@index([status, fulfilledAt, reviewSince, nextDeliveryAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// MONEY HELD BETWEEN PAYER AND PAYEE (task MONEY-18, R-19)
///
/// A paid DM, an event ticket and a bill are paid into WAWU's own account at
/// the wallet provider (a WalletPayment), and the price then waits there
/// until something happens: it is RELEASED to the payee (the payee's 85%; the
/// other 15% is WAWU's and stays) or REFUNDED to the payer (the price, never
/// the provider's charge on the original payment, R-10). The provider cannot
/// reserve part of a balance, so a hold is a row here plus money in WAWU's
/// account; the provider's balance is still the only balance (MONEY-11).
///
/// One row per completed held payment, written in the same transaction as the
/// payment's completion. `status` is what a person sees: `held` until the
/// provider has CONFIRMED the move out of WAWU's account, then `released` or
/// `refunded`. `action` is what was decided (the owning feature asked for it,
/// once, and it never changes): while it is set and `status` is still `held`
/// the move is waiting, in flight or in review. The money moves under OUR
/// reference (`customerReference`, `wawu-rel-<id>` or `wawu-ref-<id>`, a
/// number added after a proven failure), so a repeat can never move it twice
/// at the provider, and a lost answer is looked up by that reference, never
/// sent again. Every figure is integer kobo.
/// ─────────────────────────────────────────────────────────────────────────
model WalletHold {
  id                       String        @id @default(uuid())
  paymentId                String        @unique
  payment                  WalletPayment @relation(fields: [paymentId], references: [id])
  /// Null once the payer's account is deleted: the hold stays (WAWU still holds the money).
  payerWawuUserId          String?
  /// Null when WAWU itself is the payee (a bill).
  payeeWawuUserId          String?
  /// What was paid for: the payment's kind, its target and its title.
  kind                     String
  targetId                 String
  title                    String
  /// dm_answered, event_took_place or bill_delivered.
  releaseCondition         String
  /// The held price.
  amountKobo               BigInt
  /// The 85/15 split of the price (R-5); a release moves only the payee's share.
  payeeShareKobo           BigInt
  wawuShareKobo            BigInt
  /// WAWU's own account at the provider the price is held in.
  merchantAccountNumber    String
  /// The wallet provider that holds it (WALLET_PROVIDER when the payment was taken).
  provider                 String        @default("fintava")
  /// held, released or refunded.
  status                   String        @default("held")
  heldAt                   DateTime
  /// When the provider confirmed the move out of WAWU's account.
  settledAt                DateTime?
  /// Set when refunded: what came back to the payer (the price).
  refundedKobo             BigInt?

  /// What was decided: `release` or `refund`. Set once, by the owning feature.
  action                   String?
  actionReason             String?
  actionAt                 DateTime?
  /// What the chosen action moves out of WAWU's account.
  transferKobo             BigInt?
  /// Which try this is: 1, 2 ... A new try (and a new reference) follows only a
  /// move the provider's own record proved failed.
  attempt                  Int           @default(1)
  customerReference        String?       @unique
  destinationAccountNumber String?
  /// When the current try was handed to the provider. Set means "a record may
  /// exist at the provider": it is asked, never sent again, until it says.
  sentAt                   DateTime?
  /// The provider's own charge on the move (WAWU's, R-31); null when its record did not say.
  providerFeeKobo          BigInt?
  /// The schedule: the next try or the next question to the provider, and how
  /// many questions have been asked. `waiting` says why nothing has moved
  /// (payee_wallet, payer_wallet, recipient_frozen, funds, provider, refused);
  /// a hold waiting for a wallet rests a minute to an hour (it doubles with the
  /// hold's age), and the first sweep after the person HAS a wallet wakes it
  /// whatever its rest (MONEY-18 round 2, F4).
  nextAttemptAt            DateTime?
  attempts                 Int           @default(0)
  checks                   Int           @default(0)
  waiting                  String?
  /// A person has to look (no answer from the provider past the review bound,
  /// a reversed move, an amount that is not the price). Out of the sweep.
  reviewSince              DateTime?
  discrepancy              String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([status, action, reviewSince, nextAttemptAt])
  @@index([payerWawuUserId, heldAt])
  @@index([payeeWawuUserId, heldAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// A SEND FROM ONE WALLET TO ANOTHER (task WALLET-07)
///
/// One row per send of money from a person's wallet to another WAWU user's
/// (W7 to W12): one wallet-to-wallet transfer at the wallet provider
/// (Fintava, or Nuvion's book transfer) of `amountKobo`, under our reference
/// `wawu-send-<id>`. The sender's balance falls by `totalKobo` (the amount
/// plus the provider's charge and WAWU's fee, both quoted, R-10); the
/// receiver's rises by exactly `amountKobo`. WAWU's fee is collected by the
/// provider in the same transfer (Fintava's dashboard "Merchant charges",
/// docs/fintava/fees.md), so there is no second transfer and no second
/// provider charge.
///
/// `status` follows the provider: `pending` until the send is confirmed
/// (the answer was lost, or the provider accepted it and has not finished:
/// asked about by our reference, never sent again), `completed`, `failed`
/// (no money left the wallet: the provider's own refusal or its failed
/// record) and `reversed`. The ledger rows (FintavaLedgerEntry) carry this
/// row's id as `transferId`: the sender's `out` row from the claim on, the
/// receiver's `in` row once the send is confirmed. `kind` is `wawu_user`, or
/// `bank_account` for a send to a bank (WALLET-09), which has no receiver's
/// `in` row and carries the bank columns below, nullable, beside the others.
///
/// Both people's sides are anonymised when their account is purged (the row
/// is the other person's record too): see src/account-purge.
/// ─────────────────────────────────────────────────────────────────────────
model WalletTransfer {
  id                     String    @id @default(uuid())
  /// wawu_user (WALLET-07) or bank_account (WALLET-09).
  kind                   String    @default("wawu_user")
  /// Null once the payer's account is deleted.
  payerWawuUserId        String?
  /// Null once the receiver's account is deleted.
  recipientWawuUserId    String?
  /// The names as the people had them when the send was made (the ledger
  /// rows' counterparty names): the receipt reads the live ones first.
  payerName              String?
  recipientName          String?
  /// What the receiver gets.
  amountKobo             BigInt
  /// The provider's charge and WAWU's fee as quoted (R-10), and the total.
  providerFeeKobo        BigInt
  wawuFeeKobo            BigInt
  totalKobo              BigInt
  /// Whether a transfer of WAWU's fee was due when the send was made (that
  /// moment's fee schedule). Null: no such transfer, or a send before this column.
  feeTransferDue         Boolean?
  /// The sender's own note (W9).
  note                   String?
  /// OUR reference at the wallet provider, derived from this row's id.
  customerReference      String    @unique
  payerAccountNumber     String?
  recipientAccountNumber String?
  /// A send to a bank account (kind `bank_account`, WALLET-09): the bank's
  /// code in the running provider's list and its name there, the account
  /// number, and the holder's name as the bank gave it on the name check made
  /// just before the send (never a name the app typed). All null on a send to
  /// a WAWU user. `sentToBankAt` is when the provider took the send (W19's
  /// "sent to your bank").
  bankCode               String?
  bankName               String?
  bankAccountNumber      String?
  bankAccountName        String?
  sentToBankAt           DateTime?
  /// The wallet provider that took the send (WALLET_PROVIDER at the time).
  provider               String    @default("fintava")
  status                 String
  /// The sweep's schedule for a `pending` send: when the provider is next
  /// asked, how many times it has been, and when it went to manual review.
  nextCheckAt            DateTime?
  checks                 Int       @default(0)
  reviewSince            DateTime?
  failureReason          String?
  /// The provider's record disagreed with the quote (a fee, an amount): kept
  /// for review, as on the ledger row.
  discrepancy            String?
  /// The provider debited more than the quoted total (a believable charge):
  /// the send records the real figures and is flagged for NUV-08.
  debitReviewSince       DateTime?
  /// When the send was first handed to the provider (the reconcile window).
  sentAt                 DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  reversedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([payerWawuUserId, createdAt])
  @@index([recipientWawuUserId, createdAt])
  @@index([status, reviewSince, nextCheckAt, id])
}

/// ─────────────────────────────────────────────────────────────────────────
/// A SALE'S 85% LANDING IN THE PAYEE'S WALLET (task WALLET-16, R-11)
///
/// An ordinary sale (an unlock, a tip, a legal fee, school fees: any kind that
/// is not held) is paid into WAWU's own account at the wallet provider
/// (WalletPayment, MONEY-17), and the payee's 85% (R-5) then has to reach the
/// payee's wallet. One row per such payment, made when the payment is
/// finished (completed, delivered, not in review) and owed until the provider
/// CONFIRMS the move: `owed`, then `landed`. A held kind never has one: the
/// hold's release lands its share (MONEY-18), and the database refuses a row
/// for a payment that has a hold, so the same 85% cannot land twice.
///
/// A person with no wallet yet keeps earning: the row waits (`waiting:
/// payee_wallet`) and lands within a minute of the wallet opening. The
/// provider's balance is still the only balance; nothing here is added up
/// into one (the earnings read says "earned" and "waiting", never "balance").
///
/// Exactly once, whoever asks: the payment id is unique, and so is the
/// reference the provider sees (`wawu-earn-<payment id>`, one per earning).
/// The move is handed over by a lease (`sentAt`) only one caller wins; a lost
/// answer is found again by that reference and never sent under another. Only
/// the provider's own record that a move FAILED starts a new try, under a new
/// reference (`attempt`). `amountKobo` is the payment's `payeeShareKobo`
/// frozen when the row is made. Every figure is integer kobo.
/// ─────────────────────────────────────────────────────────────────────────
model EarningSettlement {
  id                       String        @id @default(uuid())
  /// The sale this earning is the payee's share of. Null for a community host's
  /// share of spent credits (WALLET-17): exactly one of `paymentId` and
  /// `creditSpendEarningId` is set.
  paymentId                String?       @unique
  payment                  WalletPayment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// The host's share of one spent credit (CreditSpendEarning.hostShareKobo),
  /// paid once; it travels in the host's daily move like a sale's share.
  creditSpendEarningId     String?       @unique
  creditSpendEarning       CreditSpendEarning? @relation(fields: [creditSpendEarningId], references: [id], onDelete: Restrict)
  /// Who is owed it. COUNTERPARTY at account deletion: the payer's record survives.
  payeeWawuUserId          String
  /// What was paid for: the payment's kind, its target and its title.
  kind                     String
  targetId                 String
  title                    String
  /// When the sale completed: the month an earning counts in.
  earnedAt                 DateTime
  /// What moves out of WAWU's account to the payee: the payee's 85%. Positive.
  amountKobo               BigInt
  /// WAWU's own account at the provider the sale was paid into.
  merchantAccountNumber    String
  /// The wallet provider that took the sale (the payment's own).
  provider                 String        @default("fintava")
  /// owed or landed.
  status                   String        @default("owed")
  /// When the provider confirmed the move into the payee's wallet.
  settledAt                DateTime?
  /// OUR reference at the provider for the current try: `wawu-earn-<payment id>`,
  /// with the try's number added after a proven failure.
  customerReference        String        @unique
  attempt                  Int           @default(1)
  destinationAccountNumber String?
  /// When the current try was handed to the provider. Set means "a record may
  /// exist at the provider": it is asked, never sent again, until it says.
  sentAt                   DateTime?
  /// The provider's own charge on the move (WAWU's, R-31); null when its record did not say.
  providerFeeKobo          BigInt?
  /// The schedule: the next try or the next question to the provider. `waiting`
  /// says why nothing has moved (payee_wallet, recipient_frozen, funds,
  /// provider, not_supported, refused).
  nextAttemptAt            DateTime?
  attempts                 Int           @default(0)
  checks                   Int           @default(0)
  waiting                  String?
  /// A person has to look (no answer past the review bound, a reversed move,
  /// an amount that is not the share). Out of the sweep; the money stays put.
  reviewSince              DateTime?
  discrepancy              String?
  /// The daily move this earning travels in (R-55): null until the creator's
  /// move for the day takes it. The transfer, its reference and its state are
  /// the move's; this row keeps what was earned, and lands with the move.
  moveId                   String?
  move                     EarningMove?  @relation(fields: [moveId], references: [id])
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@index([status, reviewSince, nextAttemptAt])
  @@index([payeeWawuUserId, earnedAt])
  @@index([moveId])
}

/// ─────────────────────────────────────────────────────────────────────────
/// ONE MOVE A DAY PER CREATOR (task WALLET-16 round 3, R-55, owner 16 Oct 2026)
///
/// A creator's earnings go to their wallet once a day, in ONE transfer. The
/// move takes every earning of the creator that is owed and not yet in a move
/// (`EarningSettlement.moveId` null) when the day's move is made, if their
/// total is at least the floor (EARNINGS_MOVE_MIN_KOBO, 20000 kobo = N200);
/// under it they wait and are added to the next day's. `dayKey` is the
/// Africa/Lagos date the move was made on; (payee, dayKey) is unique, so two
/// servers on one day make one move, and its reference names the creator and
/// the day, so the provider sees it once. The earnings in a move never change
/// after it is made, except that an earning whose sale stopped being a
/// finished one leaves it before anything is sent (the amount and the
/// reference then change with it).
///
/// An earning the wallet REFUSES (waiting `refused`) is put in front of a
/// person 72 hours after the FIRST refusal (`firstRefusedAt`, EARNINGS_
/// REFUSED_REVIEW_AFTER_HOURS): later refusals do not move that time, and the
/// review (`reviewSince`) is set once.
model EarningMove {
  id                       String              @id @default(uuid())
  payeeWawuUserId          String
  /// YYYY-MM-DD in Africa/Lagos: the day this move was made on.
  dayKey                   String
  /// The wallet provider that took the sales (their own).
  provider                 String              @default("fintava")
  /// WAWU's own account at the provider the sales were paid into.
  merchantAccountNumber    String
  /// The sum of the earnings in it, in kobo. Positive.
  amountKobo               BigInt
  /// How many earnings it holds.
  earnings                 Int
  /// owed or landed.
  status                   String              @default("owed")
  settledAt                DateTime?
  /// OUR reference at the provider: names the creator and the day, with the
  /// try's number added after a proven failure.
  customerReference        String              @unique
  attempt                  Int                 @default(1)
  destinationAccountNumber String?
  sentAt                   DateTime?
  providerFeeKobo          BigInt?
  nextAttemptAt            DateTime?
  attempts                 Int                 @default(0)
  checks                   Int                 @default(0)
  waiting                  String?
  /// When the wallet FIRST refused this move. Set once; never moved.
  firstRefusedAt           DateTime?
  /// A person has to look. Set once.
  reviewSince              DateTime?
  discrepancy              String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  members                  EarningSettlement[]
  /// INBOX-25: what this move left with WAWU to take back a refunded pass's host share.
  deductionTakes           EarningDeductionTake[]

  @@unique([payeeWawuUserId, dayKey])
  @@index([status, reviewSince, nextAttemptAt])
}

/// INBOX-25 (R-71). A sum WAWU takes back from a creator's earnings: the
/// host's 85% of the days of a pass paid back to a member the host removed
/// (`CommunityPassRefund.hostShareKobo`). It is never taken from the host's
/// wallet. The creator's next daily move (R-55) leaves it with WAWU, as much
/// as that move can spare while staying at the move floor; what the move
/// cannot spare is still owed and comes out of the next move. What is still
/// owed is `amountKobo` less the takes. One per refund.
model EarningDeduction {
  id              String                 @id @default(uuid())
  payeeWawuUserId String
  passRefundId    String                 @unique
  amountKobo      BigInt
  /// The provider whose moves it comes out of (the passes' own).
  provider        String                 @default("fintava")
  createdAt       DateTime               @default(now())
  takes           EarningDeductionTake[]

  @@index([payeeWawuUserId])
}

/// INBOX-25. What one daily move took of one deduction. The move is smaller by
/// exactly this. A move withdrawn before it was sent takes its takes with it
/// (the deduction is owed again).
model EarningDeductionTake {
  id          String           @id @default(uuid())
  deductionId String
  deduction   EarningDeduction @relation(fields: [deductionId], references: [id], onDelete: Restrict)
  moveId      String
  move        EarningMove      @relation(fields: [moveId], references: [id], onDelete: Cascade)
  amountKobo  BigInt
  createdAt   DateTime         @default(now())

  @@unique([deductionId, moveId])
  @@index([moveId])
}

/// ─────────────────────────────────────────────────────────────────────────
/// WHEN THE EARNINGS SWEEP STARTS PAYING (task WALLET-16, lead ruling 17 Oct 2026)
///
/// One row (id 1). The earnings sweep pays only sales completed on or after
/// `startedAt`; an older sale that was never settled is never paid by the
/// sweep and is listed for an admin to look at. The row is written by the
/// migration, so `startedAt` is the moment this code reached the environment
/// (the default); the setting EARNINGS_SWEEP_START, when set, takes the place
/// of it. Never changed by code once written.
model EarningSweepStart {
  id        Int      @id @default(1)
  startedAt DateTime
  createdAt DateTime @default(now())
}

/// ─────────────────────────────────────────────────────────────────────────
/// RECEIPTS (task WALLET-18)
///
/// A receipt is one ledger row (FintavaLedgerEntry) its owner chose to
/// share, under a short code anyone can check at wawu/r/<code> (W41 to W43,
/// W12, W27). One code per row, made the first time the owner asks and the
/// same every time after. The code is 12 characters drawn at random
/// (60 bits, never sequential and never derived from an id), so the public
/// page cannot be walked by guessing.
///
/// Nothing about the movement is copied here: the public page and the image
/// and PDF read the ledger row when they are asked, so a status Fintava
/// moves (pending to completed, a reversal) shows on the receipt as it
/// stands. A row that is gone, or no longer on its owner's wallet, makes
/// its code a plain miss.
/// ─────────────────────────────────────────────────────────────────────────
model MoneyReceipt {
  id            String   @id @default(uuid())
  /// The public code: 12 characters of Crockford base 32, upper case.
  code          String   @unique
  /// The ledger row this receipt shows (FintavaLedgerEntry.id).
  entryId       String   @unique
  /// Whose row it is: the wallet's owner, who made the code.
  wawuUserId    String
  /// The wallet (NUBAN) the row is on, as the row says.
  accountNumber String
  createdAt     DateTime @default(now())

  @@index([wawuUserId])
}

/// ─────────────────────────────────────────────────────────────────────────
/// SAVED BENEFICIARIES AND THE PAYOUT ACCOUNT (task WALLET-14)
///
/// A beneficiary is a place this person sends money to again (W8, W12 "Save
/// as beneficiary", W35's count): another WAWU user with a wallet, or a bank
/// account whose name the bank confirmed through Fintava's name check when it
/// was saved. The account name is the bank's, never one the person typed.
/// One row per place per person (the two unique keys); saving it again
/// answers the row already there.
/// ─────────────────────────────────────────────────────────────────────────
model MoneyBeneficiary {
  id              String   @id @default(uuid())
  /// Whose list this is.
  ownerWawuId     String
  /// `wawu_user` or `bank_account`.
  kind            String
  /// Set when kind is wawu_user: who the money goes to.
  recipientWawuId String?
  /// Set when kind is bank_account. Fintava's bank code (`GET /banks`).
  bankCode        String?
  /// The bank's name from Fintava's list when the account was saved.
  bankName        String?
  /// NUBAN, 10 digits.
  accountNumber   String?
  /// The name the bank returned on the name check.
  accountName     String?
  /// NUV-06 (migration 20261021280000): the bank's code in Nuvion's list,
  /// once this account has been matched to it (by code, else by the bank's
  /// name; `bankCode` above is Fintava's when the row was saved in the
  /// Fintava days).
  nuvionBankCode  String?
  /// When the holder's name was last confirmed through Nuvion
  /// (`POST /counterparty-lookups`). Null on a row saved in the Fintava days:
  /// it is checked by name again before its first Nuvion send.
  nuvionCheckedAt DateTime?
  /// Nuvion's counterparty and its bank payment detail for this account,
  /// under the owner's entity. Made by the first send and reused by every
  /// later one; provider ids, never a personal detail.
  nuvionCounterpartyId  String?
  nuvionPaymentDetailId String?
  createdAt       DateTime @default(now())

  @@unique([ownerWawuId, recipientWawuId])
  @@unique([ownerWawuId, bankCode, accountNumber])
  @@index([ownerWawuId, createdAt])
}

/// The account a person's withdrawals go to by default (A21, W17). One per
/// person; saving another replaces it. The bank code is Fintava's and the
/// name is the one the bank returned on the name check, never typed. Whether
/// that name matches the BVN name is worked out on every read, from
/// `WalletIdentity.bvnNameKeys`, so it is never stale.
model MoneyPayoutAccount {
  wawuUserId    String   @id
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  /// NUV-06 (migration 20261021280000): as on MoneyBeneficiary, the bank's
  /// code in Nuvion's list and when the name was last confirmed through
  /// Nuvion (null in the Fintava days).
  nuvionBankCode  String?
  nuvionCheckedAt DateTime?
  /// Nuvion's counterparty and payment detail for this account under the
  /// PERSON's entity (their own withdrawal to it).
  nuvionCounterpartyId  String?
  nuvionPaymentDetailId String?
  /// The same account as a payee of WAWU's OPERATIONAL account (WAWU's own
  /// payouts to this person, R-31): a counterparty belongs to the entity that
  /// pays, so these are not the same ids.
  nuvionOperationalCounterpartyId  String?
  nuvionOperationalPaymentDetailId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Schools (task SCHOOLS-01): schools, their courses and each course's dated
// intakes with a seat limit. Added from the dashboard (SCHOOLS-02), read by the
// app's SC1-SC3 and SC10 (SCHOOLS-04), enrolled into by SCHOOLS-07.
//
// Not the Learn tables above: LearnCourse / CourseEnrollment are WAWU's own
// courses hosted elsewhere and their enrol gate references the removed
// subscription. School enrolments never read them (SCHOOLS-07).
//
// No rating column on School: nothing writes a school rating and no screen
// collects one, so it is left off at launch until the owner rules (R-32).
// -----------------------------------------------------------------------------

/// SC1's category chips, exactly: Tech, Business, Creative, Languages,
/// Vocational. "All" is the absence of a filter, not a category.
enum SchoolCategory {
  tech
  business
  creative
  languages
  vocational
}

/// How a course is taught. SC2 lists it beside the length ("12 weeks ·
/// Online"); where the classes meet is the intake's `location`.
enum SchoolCourseMode {
  online
  in_person
  hybrid
}

model School {
  id          String         @id @default(uuid())
  name        String
  category    SchoolCategory
  /// Display place, as SC2 prints it: "Yaba, Lagos". SC1 shows it on the card.
  location    String
  /// SC2's "Since 2016". Null when the school has not said.
  foundedYear Int?
  /// SC2's expertise chips, in the order the dashboard set them.
  expertise   String[]
  /// SC2's blurb.
  about       String
  /// The school's logo image (a storage URL). Null: the app draws initials.
  logo        String?
  /// The school's own application page, for "Or apply on the school's
  /// website" (SC9, SCHOOLS-10). Null: the school takes no outside sign-ups.
  applyUrl    String?
  /// Where the enrolment report goes: the student's details, course and
  /// intake (SCHOOLS-09). Never shown in the app.
  reportEmail String
  /// SCHOOLS-02: when the dashboard hid this school. Null: shown. SCHOOLS-04 serves only unhidden rows.
  hiddenAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses    SchoolCourse[]
  enrolments SchoolEnrolment[]
  /// SCHOOLS-10: the code this school's apply link carries. Made the first
  /// time the link is asked for.
  link       SchoolLink?
  clicks     SchoolLinkClick[]
  /// SCHOOLS-11: the bank account the school's share is paid to.
  payee       SchoolPayee?
  settlements SchoolSettlement[]

  @@index([category])
  @@index([name])
}

model SchoolCourse {
  id        String           @id @default(uuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  /// SC3's "Length 12 weeks".
  weeks     Int
  mode      SchoolCourseMode
  /// SC3's numbered syllabus, in order.
  syllabus  String[]
  /// SC3's "You get": "Certificate", "mentor", "portfolio".
  outcomes  String[]
  /// The course fee in integer kobo (docs/contract/CONVENTIONS.md section 1).
  /// Int carries up to 21,474,836.47 naira, above the 10,000,000 naira
  /// merchant cap any one payment is bounded by.
  priceKobo Int
  /// SCHOOLS-02: when the dashboard hid this course. Null: shown. SCHOOLS-04 serves only unhidden rows.
  hiddenAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intakes    CourseIntake[]
  clicks     SchoolLinkClick[]
  enrolments SchoolEnrolment[]
  savedBy    SavedSchoolCourse[]

  @@index([schoolId])
}

/// FIX-107 (G-627): one person's bookmark on one school course (SC3). Mirrors SavedCreator: a join row with a unique
/// (person, course) pair, so a repeat save is a no-op and "did THIS person save THIS course" has an answer. It goes with
/// the course (cascade) and with the person's account (account-data-map).
model SavedSchoolCourse {
  id         String       @id @default(uuid())
  userWawuId String
  courseId   String
  course     SchoolCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  savedAt    DateTime     @default(now())

  @@unique([userWawuId, courseId])
  @@index([userWawuId, savedAt])
  @@index([courseId])
}

/// One dated class of a course. Seats are claimed by a CONDITIONAL write
/// (seatsTaken < capacity) inside the enrolment transaction, the
/// Product.stock pattern (SCHOOLS-07); the database also refuses a row whose
/// seatsTaken is negative or above capacity.
model CourseIntake {
  id         String       @id @default(uuid())
  courseId   String
  course     SchoolCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The day classes start (SC3's "Starts Mon 3 November"). A calendar date,
  /// not an instant, so no time zone moves it.
  startDate  DateTime     @db.Date
  /// SC4's "Weekend class", SC3's "Saturdays".
  schedule   String
  /// Where this intake meets ("Yaba"). Null for an online intake.
  location   String?
  capacity   Int
  seatsTaken Int          @default(0)
  /// SCHOOLS-02: when the dashboard hid this intake. Null: shown. SCHOOLS-04 serves only unhidden rows.
  hiddenAt   DateTime?
  /// SCHOOLS-11: when the class was called off. A cancelled class is hidden at
  /// the same moment (`hiddenAt`), takes no enrolments, and every fee paid for
  /// it goes back to the student's wallet instead of to the school.
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrolments SchoolEnrolment[]

  @@index([courseId, startDate])
}

/// SCHOOLS-10: the code on a school's apply link (SC9's `?ref=wawu-7KQ2`), one
/// per school. It names the school and nobody else: the school's own site sees
/// this code and never a person (DATA-SAFETY AA-10). It is made the first time
/// the link is asked for, so a school added by the dashboard needs no step.
/// SCHOOLS-12 finds the school a sign-up came from by this code.
model SchoolLink {
  id        String   @id @default(uuid())
  schoolId  String   @unique
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// "wawu-" and four letters or digits, upper case, no 0, O, 1 or I.
  code      String   @unique
  createdAt DateTime @default(now())
}

/// SCHOOLS-10: one row per tap on "Continue to their site" (SC9): who tapped,
/// for which course, when. Kept for the commission count (SCHOOLS-12); the
/// school never sees it. The person's own row, so the account purge deletes it
/// and the data export lists it. A course removed later leaves the row with no
/// course (SetNull), so the school's count stays.
model SchoolLinkClick {
  id         String        @id @default(uuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseId   String?
  course     SchoolCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  userWawuId String
  clickedAt  DateTime      @default(now())

  @@index([schoolId, clickedAt])
  @@index([courseId])
  @@index([userWawuId, clickedAt])
}

/// SCHOOLS-07: one student's place in one intake, and the order that pays for
/// it. It is the target of a `school_fee` wallet payment (MONEY-17): the
/// payment's id is `paymentId`, the fee waits in WAWU's merchant wallet in a
/// hold (R-19) until the intake starts, then goes to the school at 85/15
/// (R-12, SCHOOLS-11).
///
/// `status`: reserved (the seat is claimed, `reservedUntil` is how long it is
/// kept for an unpaid order), enrolled (paid), released (the reservation was
/// given up, or ran out, and its seat went back), refunded (paid, but the
/// class filled in the gap and the fee went back through the hold).
///
/// The seat is claimed by one conditional write on CourseIntake
/// (`seatsTaken < capacity`), the Product.stock pattern, and given back once
/// when a reserved order is released. The course, school and intake are copied
/// onto the order, so the receipt reads as it was when the person enrolled
/// even if the school edits them later. The figures are integer kobo:
/// `priceKobo` is the course fee that was quoted; `schoolShareKobo` and
/// `wawuShareKobo` are its 85/15 split (R-12) at that time, `commissionBps`
/// WAWU's part of it.
///
/// A partial unique index (migration SQL, not modelled here) allows one live
/// order (reserved or enrolled) per student and course, so sending the same
/// enrol request twice makes one order and takes one seat.
model SchoolEnrolment {
  id              String       @id @default(uuid())
  /// The student. Null once their account is deleted: the money record stays
  /// (the school's share may still be owed), the person goes.
  wawuUserId      String?
  schoolId        String
  school          School       @relation(fields: [schoolId], references: [id])
  courseId        String
  course          SchoolCourse @relation(fields: [courseId], references: [id])
  intakeId        String
  intake          CourseIntake @relation(fields: [intakeId], references: [id])
  status          String       @default("reserved")
  /// What a person quotes: WAW- and two groups of four characters.
  reference       String       @unique
  courseTitle     String
  schoolName      String
  intakeStartDate DateTime     @db.Date
  intakeSchedule  String
  intakeLocation  String?
  priceKobo       Int
  schoolShareKobo Int
  wawuShareKobo   Int
  commissionBps   Int
  reservedUntil   DateTime
  /// The wallet payment that paid it (WalletPayment.id) and its hold.
  paymentId       String?      @unique
  holdId          String?
  enrolledAt      DateTime?
  releasedAt      DateTime?
  refundedAt      DateTime?
  failureReason   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  report          SchoolEnrolmentReport?
  settlement      SchoolSettlement?

  @@index([wawuUserId, createdAt])
  @@index([intakeId, status])
  @@index([status, reservedUntil])
}

/// SCHOOLS-11: the bank account a school's share of course fees is paid to. A
/// school is not a WAWU user, so it is paid by bank transfer (R-12, R-31). The
/// row exists only for an account the bank confirmed (the dashboard's
/// `PUT /admin/schools/{id}/payee` asks the provider's name check and stores
/// nothing when it does not match): `accountName` is the holder's name as the
/// bank gave it, `verifiedAt` the time it did. Changing the account is the
/// same call, so the row never holds an account nobody checked. The payee ids
/// are the provider's (Nuvion's counterparty and payment detail), kept so a
/// second payout to the same account reuses them.
model SchoolPayee {
  schoolId        String   @id
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bankCode        String
  bankName        String
  accountNumber   String
  accountName     String
  verifiedAt      DateTime
  counterpartyId  String?
  paymentDetailId String?
  /// The admin who set it.
  setBy           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// SCHOOLS-11: what becomes of one paid enrolment's fee. The fee waits in
/// WAWU's merchant wallet in a hold (R-19). When the class starts the school's
/// 85% is paid to its bank account (`action payout`); when the class is called
/// off the student's fee goes back to their wallet (`action refund`, the R-10
/// refund default). One row per enrolment (`enrolmentId` is unique), made by an
/// insert that loses to any row already there, so the first decision stands:
/// a payout that has been handed to the provider (`sentAt` set) is never turned
/// into a refund, and a refund is never turned into a payout.
///
/// A payout is one bank send from WAWU's account under `customerReference`
/// (`wawu-bank-sch-<id>`; a second try after the provider's own record proved
/// the first failed adds `-2`, and there is no third). `status`: pending (not
/// handed over yet; `waiting` says why), sent (handed over, not confirmed),
/// paid / refunded (the provider confirmed), review (a person looks; the money
/// stays where it is). The figures are integer kobo and the database holds
/// `schoolShareKobo + wawuShareKobo = priceKobo`.
model SchoolSettlement {
  id                    String          @id @default(uuid())
  enrolmentId           String          @unique
  enrolment             SchoolEnrolment @relation(fields: [enrolmentId], references: [id])
  schoolId              String
  school                School          @relation(fields: [schoolId], references: [id])
  /// The hold (WalletHold.id) that carries the fee.
  holdId                String
  /// The wallet provider whose hold this is; a server acts only on its own.
  provider              String
  action                String
  status                String          @default("pending")
  priceKobo             Int
  schoolShareKobo       Int
  wawuShareKobo         Int
  /// The account paid, copied from the payee when the payout is handed over.
  bankCode              String?
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  counterpartyId        String?
  paymentDetailId       String?
  /// Which reference this try goes under (1, then 2 after a proved failure).
  attempt               Int             @default(1)
  /// Times a send was handed over (for the rest between tries).
  attempts              Int             @default(0)
  /// Questions asked of the provider about a send whose outcome was unknown.
  checks                Int             @default(0)
  customerReference     String?         @unique
  /// Set when a send is handed to the provider (the lease only one caller wins).
  sentAt                DateTime?
  nextAttemptAt         DateTime?
  /// Why nothing has moved yet: no_payee, provider, funds, refused.
  waiting               String?
  providerFeeKobo       BigInt?
  providerTransactionId String?
  reviewNote            String?
  decidedAt             DateTime        @default(now())
  paidAt                DateTime?
  refundedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status, nextAttemptAt])
  @@index([schoolId, status])
}

/// SCHOOLS-09: the enrolment report that goes to the school (SC7: the school
/// gets the student's name, email and phone, the course and the intake). One
/// row per order, made in the same transaction as the order, when the student
/// taps Continue on SC4 (the screen that says the school gets these details):
/// `consentAt` is that moment. The contact details are a copy of the student's
/// sign-in token at that moment, kept only until the report is sent; the send
/// clears them. The report goes when the order is `enrolled` (paid, or a
/// course with no fee), through the mail relay under the key
/// `school-report-<enrolmentId>`, so a retry or a second server cannot send a
/// second mail. `leaseUntil` is the claim on a try in flight, `nextAttemptAt`
/// the rest before the next try, `gaveUpAt` when the tries ran out.
model SchoolEnrolmentReport {
  enrolmentId   String          @id
  enrolment     SchoolEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  /// The student. Set to null with the contact details when the account is deleted.
  wawuUserId    String?
  studentName   String?
  studentEmail  String?
  studentPhone  String?
  consentAt     DateTime
  attempts      Int             @default(0)
  nextAttemptAt DateTime?
  leaseUntil    DateTime?
  sentAt        DateTime?
  /// The mail relay's id for the mail it took.
  messageId     String?
  /// Why the last try failed (a status or a name, never an address).
  lastError     String?
  gaveUpAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([sentAt, gaveUpAt, nextAttemptAt])
}

/// SETTINGS-02: the owner's legal text, one row per document ("terms",
/// "privacy"), served by GET /policies/:slug and written by the superadmin
/// route PUT /admin/policies/:slug. No row means the owner has not filled it
/// in yet, and the app says so; nothing here is ever seeded with wording.
model LegalDocument {
  /// "terms" or "privacy".
  slug          String   @id
  title         String
  /// The date the owner gives the text. Shown as "Updated 1 September 2026".
  effectiveDate DateTime @db.Date
  /// [{ heading, body }]; a body's paragraphs are separated by a blank line.
  sections      Json
  updatedAt     DateTime @updatedAt
}

/// One person's reaction to one TGIF card on one day (HOME-10). The unique
/// (person, day, card) key is what makes a reaction count once: two taps at
/// once race on the key and one row exists. Counts are always the number of
/// rows (no counter column), so a count can never drift from its rows. `kind`
/// is "amen" today; the migration holds it to that with a CHECK.
model TgifReaction {
  id         String   @id @default(uuid())
  userWawuId String
  /// The calendar day the card belongs to (a date, not an instant).
  day        DateTime @db.Date
  card       String
  kind       String   @default("amen")
  createdAt  DateTime @default(now())

  @@unique([userWawuId, day, card])
  @@index([day, card])
}

/// One person opened TGIF on one day (HOME-10). "Readers today" is the number
/// of rows for the day: one person is one row however often they open it.
model TgifRead {
  id         String   @id @default(uuid())
  userWawuId String
  day        DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([userWawuId, day])
  @@index([day])
}

/// One person shared TGIF on one day (HOME-10). The share count for a day is
/// the number of rows, as ContentShare's is for a piece.
model TgifShare {
  id         String   @id @default(uuid())
  userWawuId String
  day        DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([userWawuId, day])
  @@index([day])
}

/// HOME-11: whether this person wants TGIF on Today. One row per person, made
/// the first time they change it; no row means the default (shown). Nothing
/// else references it.
model TgifPreference {
  userWawuId String   @id
  /// false = the person turned TGIF off. HOME-16 (R-59): the switch now means
  /// "send me TGIF each morning" (Z2); the column and the values are kept.
  show       Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

/// HOME-16: the marker that today's TGIF notice was made for this person. One
/// row per person per day (the primary key), made in the same transaction as the
/// notification, so a notice is made once per person per day however many hub
/// instances run the job or however often it runs. `day` is the Lagos calendar
/// day. Rows older than a few days are deleted by the job itself. Holds no
/// words: the notice is the Notification row (kind `tgif_daily`).
model TgifDailyNotice {
  userWawuId String
  day        DateTime @db.Date
  createdAt  DateTime @default(now())

  @@id([userWawuId, day])
  @@index([day])
}

/// EXPLORE-03: a creator an admin has chosen to show in Explore's "Featured
/// creators" rail. One row per featured creator; no row means not featured.
/// `position` orders the rail (lowest first). Set only by the superadmin
/// route PUT /admin/featured-creators/:wawuId and removed by DELETE.
model FeaturedCreator {
  wawuUserId        String   @id
  position          Int      @default(0)
  /// The admin who featured them (an audit record, kept when a creator goes).
  featuredByAdminId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([position])
}

// -----------------------------------------------------------------------------
// Sponsored cards (ADS-03, R-15)
//
// Ads at launch are booked by the WAWU team and invoiced by hand, so nothing
// here records a price, an advertiser account or a payment. Money lives in the
// team's invoices, not in this schema.
//
// Holds no personal data: no column names a WAWU user, so
// src/account-purge/account-data-map.ts has nothing to classify here. (ADS-05's
// per-viewer rows will, and classify themselves in that task.)
//
// CHECK constraints are in the migration, because Prisma does not model them:
//   AdCampaign: endsAt > startsAt; weight between 1 and 100 (the range
//   is AD_WEIGHT_MIN and AD_WEIGHT_MAX in src/ads/ads-limits.ts); advertiser
//   is not blank.
//   AdCreative: headline, CTA label and destination id are not blank, and a
//   subline is absent or not blank; artworkUrl is absent or an http(s) link.
//   "Blank" means empty or only white space, control, zero-width or other
//   invisible characters, spelled out in the migration so it does not depend
//   on the server's locale.
// -----------------------------------------------------------------------------

/// Where a sponsored card shows: inside the TGIF reader before the takeaway
/// (`tgif_card`), in TGIF's place on Today (`today_slot`), or as a slide in
/// the Explore slider, which takes turns with events (`explore_slider`, ADS-07,
/// R-59). Adding a placement is an `ALTER TYPE ... ADD VALUE`.
enum AdPlacement {
  tgif_card
  today_slot
  explore_slider
}

/// Where the team has put a campaign. The window (`startsAt`, `endsAt`) decides
/// when it may run; this decides whether it may run at all. Only `scheduled`
/// and `live` are ever served; `draft`, `paused` and `ended` never are.
enum AdCampaignStatus {
  draft
  scheduled
  live
  paused
  ended
}

/// What the card's button opens. THE ALLOW-LIST: a card can only open one of
/// these, so a destination outside it cannot be stored. `event` opens the event
/// detail screen for `AdCreative.ctaDestinationId` (H33 "Get tickets", H36
/// "Tickets"). The only destination the design draws is the event; a new kind
/// is an additive `ALTER TYPE ... ADD VALUE` that the task needing it names.
enum AdCtaDestination {
  event
}

/// One booking: who it is for, where it shows, when, and how it ranks against
/// another booking for the same placement. The card itself is the AdCreative.
model AdCampaign {
  id String @id @default(uuid())

  /// The advertiser's name as the card shows it ("SPONSORED · <advertiser>").
  /// A name, not an account: advertisers have no accounts (R-15).
  advertiser String

  placement AdPlacement
  status    AdCampaignStatus @default(draft)

  /// The window the card may be served in: startsAt <= now < endsAt. Instants
  /// (UTC); the dashboard turns "Saturday 18 October" into instants.
  startsAt DateTime
  endsAt   DateTime

  /// Ranks bookings that overlap on one placement, so one is served: the
  /// higher weight wins, and ADS-04 breaks a tie. 1 to 100, whole numbers. Range: src/ads/ads-limits.ts.
  weight Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// At most one (AdCreative.campaignId is unique). Removing a campaign
  /// removes its card.
  creative AdCreative?

  /// Counts (ADS-05). Back-relations only; no column is added.
  events      AdEvent[]
  dailyTotals AdDailyTotal[]

  /// The serving query (ADS-04): one placement, a servable status, a window
  /// that contains now.
  @@index([placement, status, startsAt, endsAt])
}

/// The card a campaign shows. Everything on H33 and H36 is here and nothing
/// else: the advertiser's name is the campaign's, the "SPONSORED" label and
/// "Ads keep TGIF free" are the app's own words, and the event's date and
/// price are typed into `subline` by the team (the app never invents them).
model AdCreative {
  id String @id @default(uuid())

  campaignId String     @unique
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// "Gospel Night Live".
  headline String
  /// "Abuja · Sat 18 October", exactly as the team wrote it, price and all.
  /// Optional: a card with only a headline is allowed.
  subline  String?

  /// The button's words ("Get tickets", "Tickets").
  ctaLabel         String
  /// What the button opens: a kind from the allow-list (AdCtaDestination) and
  /// the id of the thing of that kind. For `event`, an Event id. No foreign
  /// key: the id's table depends on the kind, and an FK onto Event would stop
  /// an event being deleted. Serving checks the target is still open.
  ctaDestination   AdCtaDestination
  ctaDestinationId String

  /// The picture. An http(s) URL from POST /uploads/presign, the same as
  /// Event.bannerUrl and NotificationCampaign.imageUrl. REQUIRED for every
  /// campaign saved from ADS-07 on (R-59): POST and PATCH /admin/ads refuse a
  /// campaign without it. The column stays nullable for the campaigns saved
  /// before that; serving skips a campaign whose artwork is null, so no card
  /// is ever drawn without a picture, and the admin list shows those for fixing.
  artworkUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Admin ad management audit (ADS-06, R-15)
//
// One row for every change an admin makes to an ad campaign, written in the
// same transaction as the change. Same side-table idiom as AdminEventReview:
// no foreign key to AdCampaign (a deleted draft keeps its history) or to
// AdminUser (the admin's email and role are snapshots, so "who paused this"
// stays answerable after that admin is renamed or removed).
//
// No column names a WAWU user, so src/account-purge/account-data-map.ts has
// nothing to classify here. `changes` can hold the advertiser's name, which
// may be a named person who is not a user; erasing it is a manual job, as for
// AdCampaign itself.
// -----------------------------------------------------------------------------

enum AdminAdAction {
  created
  updated
  scheduled
  paused
  resumed
  ended
  deleted
}

/// What an admin did to a campaign, who did it, and the before and after.
model AdminAdAudit {
  id String @id @default(uuid())

  /// Gives the history one exact order even when two rows share a timestamp.
  seq Int @default(autoincrement())

  /// The campaign. Not a foreign key: a deleted draft keeps its rows.
  campaignId String

  action AdminAdAction

  /// The campaign's status before and after. `previousStatus` is null on
  /// `created`; `newStatus` is null on `deleted`.
  previousStatus AdCampaignStatus?
  newStatus      AdCampaignStatus?

  /// `{ field: { from, to } }` for the fields the action changed. On `created`
  /// and `deleted` every field, with `from` or `to` null.
  changes Json?

  /// Snapshots of who acted.
  adminId    String
  adminEmail String
  adminRole  AdminRole

  createdAt DateTime @default(now())

  @@index([campaignId, seq])
  @@index([adminId])
}

// -----------------------------------------------------------------------------
// Counting ad views, taps and skips (ADS-05, R-15)
//
// Ads are invoiced by hand, so these are reporting figures, not a ledger of
// money. Two tables, one rule: a person's view, tap or skip of a campaign is
// counted ONCE per UTC day.
//
//   AdEvent       the raw record: one row per (campaign, person, kind, day).
//                 Its primary key IS the dedupe rule, so a double tap, a
//                 retry or fifty parallel requests leave one row.
//   AdDailyTotal  the daily totals: one row per (campaign, day). Moved in the
//                 same SQL statement that creates an AdEvent row, and only
//                 when that row was new, so the totals equal the raw rows.
//
// The totals hold no person, so they outlive a purged account; the raw rows
// name a person (viewerWawuId) and are classified in
// src/account-purge/account-data-map.ts.
//
// Both tables reference AdCampaign with ON DELETE RESTRICT: a campaign that
// has been counted cannot be deleted, because its counts are what the owner
// invoices from. A campaign is ended or paused, never deleted, once it ran.
// CHECK constraints (counts are not negative) are in the migration.
// -----------------------------------------------------------------------------

/// What a person did with a sponsored card.
enum AdEventType {
  view
  tap
  skip
}

/// One person, one kind of action, one campaign, one UTC day. Never updated.
model AdEvent {
  campaignId   String
  campaign     AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  viewerWawuId String
  type         AdEventType
  /// The UTC calendar day of `createdAt`.
  day          DateTime    @db.Date
  createdAt    DateTime    @default(now())

  @@id([campaignId, viewerWawuId, type, day])
  /// The report: one campaign over a span of days.
  @@index([campaignId, day])
  /// Removing an account's rows.
  @@index([viewerWawuId])
}

/// A campaign's counts for one UTC day. Written only by the statement that
/// also writes the AdEvent row it counts.
model AdDailyTotal {
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  day        DateTime   @db.Date
  views      Int        @default(0)
  taps       Int        @default(0)
  skips      Int        @default(0)

  @@id([campaignId, day])
}

// -----------------------------------------------------------------------------
// Phone push (INBOX-03)
// -----------------------------------------------------------------------------

/// One phone's Expo push token. The token is the address of a phone, so it is
/// personal data and never leaves the server: no route returns it and no log
/// line carries it. `expoPushToken` is unique: a phone belongs to one person
/// at a time, so when somebody else signs in on it the row moves to them
/// (userWawuId and createdAt change; see PushTokenService). `createdAt` means
/// "this person has owned the token since": the sender never pushes a
/// notification written before it.
model PushToken {
  id              String    @id @default(uuid())
  userWawuId      String
  /// `ExponentPushToken[...]` or `ExpoPushToken[...]`, as the app gives it.
  expoPushToken   String    @unique
  /// `android` or `ios`.
  platform        String
  /// The phone's own id and a name for it, both optional and app-supplied.
  deviceId        String?
  deviceLabel     String?
  createdAt       DateTime  @default(now())
  /// Set by every registration; the oldest-seen token goes first when a
  /// person is over the cap.
  lastSeenAt      DateTime  @default(now())
  /// Set when Expo says the phone no longer takes pushes (DeviceNotRegistered).
  /// A disabled token is never sent to; a fresh registration of the same token
  /// clears it.
  disabledAt      DateTime?
  disabledReason  String?

  deliveries PushDelivery[]

  @@index([userWawuId])
  @@index([disabledAt])
}

/// One notification going to one phone. The notification table is the outbox:
/// a row here is made for a Notification the notification service already
/// wrote, once per phone (the unique key), so two hub instances can never push
/// the same notification to the same phone twice. `pending` -> `claimed` (an
/// instance took it to check it) -> `sending` (set just before the request to
/// Expo) -> `sent` (Expo accepted it and gave a ticket) -> `delivered` (the
/// receipt says ok); or `failed`, `skipped` or `expired` with a `reason`.
/// Every time column holds UTC, written and compared on the database's clock.
model PushDelivery {
  id              String    @id @default(uuid())
  notificationId  String
  userWawuId      String
  pushTokenId     String
  pushToken       PushToken @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)
  status          String    @default("pending")
  reason          String?
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  /// Set while an instance holds the row (`claimed` or `sending`).
  lockedAt        DateTime?
  /// The batch an instance claimed this row in. Only that batch may move it
  /// on to `sending`, so a row the reaper put back cannot be sent twice.
  claimId         String?
  /// True once the reaper found this row mid-send and put it back in the
  /// queue. It is put back once only; the second time it is failed.
  interruptedSend Boolean   @default(false)
  /// Expo's receipt id for this send.
  ticketId        String?
  sentAt          DateTime?
  /// When to ask Expo for the receipt next, and how many times it was asked.
  receiptDueAt    DateTime?
  receiptChecks   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([notificationId, pushTokenId])
  @@index([status, nextAttemptAt])
  @@index([status, receiptDueAt])
  @@index([userWawuId])
}

/// An account whose deletion is scheduled (`DELETE /account`). Its push
/// tokens were deleted when the deletion was asked for, a token it registers
/// afterwards is not stored, and the sender sends it nothing. Deleted with
/// the account at purge.
model PushStoppedAccount {
  userWawuId String   @id
  createdAt  DateTime @default(now())
}

/// ─────────────────────────────────────────────────────────────────────────
/// A DELETION THAT WAITS 30 DAYS (task SETTINGS-06, R-17)
///
/// One row per account that asked to be deleted (`DELETE /account`). The
/// request is refused while money is in the person's wallet, a hold is open or
/// earnings are waiting (Z6, R-11, R-19); otherwise the person's Naira wallet
/// is frozen at the provider (it can neither send nor receive, so nothing new
/// reaches it), their content is hidden, and `purgeAfter` is 30 days out.
/// `POST /account/cancel-deletion` (WAWU ID calls it when the person signs in
/// during the 30 days, SETTINGS-08) unfreezes the wallet, brings the content
/// back and sets `status` to cancelled. After `purgeAfter` the purge sweep
/// looks at the money once more (a balance, a hold or an earning that
/// appeared keeps the account, `purgeBlockedBy` says why), releases any held
/// points, deletes the Hub's data (AccountPurgeService), asks WAWU ID to
/// anonymise the identity and sets `status` to purged. The row is kept after
/// the purge as the record that it ran (it holds no personal detail).
///
/// `status`: scheduled, cancelled or purged. No balance is stored here: the
/// provider's balance is the only balance (R-1).
/// ─────────────────────────────────────────────────────────────────────────
model AccountDeletion {
  wawuUserId      String    @id
  /// freezing: asked, the wallet is being frozen (not in force yet; a cancel
  /// or a retry lets the wallet go). scheduled: in force for the 30 days.
  /// purging: the sweep took it and is deleting (no cancel any more).
  /// cancelled, purged: the end.
  status          String    @default("scheduled")
  scheduledAt     DateTime  @default(now())
  /// The end of the 30 days: the earliest the purge runs.
  purgeAfter      DateTime
  /// The wallet frozen for the 30 days, and who froze it. Null: the person had
  /// no wallet, or the provider cannot freeze (nothing was frozen).
  walletId        String?
  walletProvider  String?
  walletFrozenAt  DateTime?
  cancelledAt     DateTime?
  purgedAt        DateTime?
  /// The purge sweep's last look found money (or the provider unreachable):
  /// when it first did, what it found, how many looks have been made.
  purgeBlockedAt  DateTime?
  purgeBlockedBy  String?
  purgeAttempts   Int       @default(0)
  /// What the purge kept on purpose, once it ran: for example content that
  /// buyers paid for, hidden and stripped of the person's words. No personal
  /// detail. Null: nothing was kept.
  purgeNote       String?
  /// SETTINGS-06 round 6. Set on a cancelled row when a reconcile confirmed the
  /// person's wallet is unfrozen, so the hourly pass does not ask the provider
  /// about it again. Null: a confirmation is still owed (a cancelled row is
  /// checked every hour until it is set; a row in force is checked every hour
  /// whatever this says). Cleared when a request takes the row over or a
  /// reconcile of a cancelled row could not be confirmed.
  walletSyncedAt  DateTime?
  /// SETTINGS-06 round 7. The hourly pass claims a row before it asks the
  /// provider about it. Future: a pass holds it until then (a second server
  /// leaves it alone). Past: when the last pass finished with it, so the pass
  /// takes the rows checked longest ago first. Null: never claimed.
  reconcileClaimedUntil DateTime?
  /// SETTINGS-08 (G-SETTINGS-08-1). When WAWU ID confirmed the Hub's
  /// mark-deletion call for this deletion (the call carries `purgeAfter`).
  /// Null: not confirmed yet. The hourly pass asks again (after
  /// `identityMarkNextAt`, with a wait that grows with `identityMarkAttempts`)
  /// and the purge does not start while this is null. Cleared when a new
  /// request takes the row over.
  identityMarkedAt DateTime?
  /// Failed mark-deletion calls in a row, and the earliest the next one is
  /// made (a pass also sets it a few minutes ahead while it holds the row).
  identityMarkAttempts Int @default(0)
  identityMarkNextAt DateTime?
  /// SETTINGS-05. Why the person is leaving, as the app's list gives it (one of
  /// `LEAVING_REASONS` in src/account/dto/delete-account.dto.ts; a string, so a
  /// new choice needs no migration). Optional: null when they did not say. Set
  /// when a request records the deletion and replaced when a later request
  /// takes over a cancelled one. A choice from a list, never free text, so it
  /// holds no personal detail.
  leavingReason   String?
  /// SETTINGS-09 (R-73). The daily sweep that deletes a purged account's
  /// set-aside ID documents once the days kept (admin setting
  /// `id_docs_keep_days`) have passed since `purgedAt`.
  /// idDocsClaimedUntil: future, a server holds this account until then (a
  /// second server leaves it alone); past or null, free. A crash frees it.
  /// idDocsErasedAt: when the sweep found none left; this is the audit line,
  /// and an account with it set is never looked at again.
  /// idDocsErased: files deleted (object, then row), counts only.
  /// idDocsKeepDays: the days kept in force when the sweep finished.
  idDocsClaimedUntil DateTime?
  idDocsErasedAt  DateTime?
  idDocsErased    Int       @default(0)
  idDocsKeepDays  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, purgeAfter])
}

/// The content pieces a scheduled deletion hid, with the status each had, so
/// a cancelled deletion puts back exactly those pieces and no others (a piece
/// the person had already removed is not listed, so it stays removed). Deleted
/// when the deletion is cancelled or the account is purged, except the rows of
/// pieces the purge keeps for their buyers or strips (round 9): those move to
/// the deleted account (`wawuUserId` = 'deleted-account') with the piece, and
/// stay, so a reader always finds what the piece was. Only `priorStatus` =
/// 'live' lets a buyer open a hidden piece.
model AccountDeletionContent {
  id             String   @id @default(uuid())
  wawuUserId     String
  contentPieceId String
  /// The piece's `status` before the deletion hid it.
  priorStatus    String
  createdAt      DateTime @default(now())

  @@unique([wawuUserId, contentPieceId])
  @@index([wawuUserId])
  @@index([contentPieceId])
}

/// ─────────────────────────────────────────────────────────────────────────
/// NUVION WEBHOOK EVENTS (task NUV-01)
///
/// Every signed delivery Nuvion sends to `POST /api/hub/webhooks/nuvion`,
/// stored once and acknowledged (Nuvion retries anything but a 2xx for 15
/// minutes, then drops it). Nothing here moves money or touches a balance:
/// the handler registry (src/nuvion/handlers/, one file per task NUV-02 to
/// NUV-08) reads the `pending` rows of the events it handles and marks them
/// `processed` or `failed`. Nuvion's balance stays the only balance.
///
/// Exactly once, twice over: `eventId` (`x-nuvion-event-id`) is unique, so a
/// retry of the same event lands on the same row; and the signed pair
/// (`signedAt`, `bodySha256`) is unique, so a captured delivery replayed
/// inside the time window under another event id (the id is not signed)
/// lands on the same row too. The insert is `ON CONFLICT DO NOTHING`; there
/// is no read before the write.
/// ─────────────────────────────────────────────────────────────────────────
enum NuvionWebhookProcessing {
  /// Stored; waiting for the handlers of its event (or for a handler to exist).
  pending
  /// Every handler of its event finished with it.
  processed
  /// A handler could not use it; `note` says why. Kept for review.
  failed
  /// Not one of Nuvion's documented events (or none). Kept for review.
  unrecognised
  /// Nuvion's own test delivery (`POST /webhook-tests`): `{event_group,
  /// event_name}`, no data. Proves the signature works; nothing acts on it.
  test
}

model NuvionWebhookEvent {
  id String @id @default(uuid())

  /// `x-nuvion-event-id` as sent: the event's own id.
  eventId    String  @unique
  /// The body's `event` (`inflows.completed`), trimmed and lower case; for a
  /// test delivery `<event_group>.<event_name>`. Empty when it named none.
  event      String
  /// The id the event is about: `data.id`, else `data.account.id` or
  /// `data.account_details.id` (accounts.created, account_details.created
  /// wrap their object). Null when the delivery carries none.
  resourceId String?
  /// The entity the event is about (`data.entity_id`, or the wrapped
  /// object's): which person, through NuvionEntity.
  entityId   String?

  /// `x-nuvion-event-timestamp` exactly as sent: the signature covers it.
  signedAt   String
  /// The SHA-256, hex, of `rawBody`.
  bodySha256 String
  /// The body exactly as delivered (the bytes the signature covers). Its
  /// personal data stays here and in `payload`, never in a log. Empty once
  /// `bodyClearedAt` is set (FIX-20: src/webhook-retention/).
  rawBody    Bytes
  /// The same body parsed, every NUL in a key or string replaced by U+FFFD
  /// (Postgres json cannot hold one). JSON null once `bodyClearedAt` is set.
  payload    Json

  processingStatus NuvionWebhookProcessing @default(pending)
  /// What the handlers did, or why they could not.
  note             String?
  /// Tries by the dispatcher so far.
  attempts         Int                     @default(0)
  /// Not tried again before this (backing off after a handler waited).
  nextAttemptAt    DateTime?
  /// A dispatcher holds the row until then: one worker at a time.
  claimedUntil     DateTime?
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?

  /// When the retention job cleared `rawBody` and `payload` (FIX-20); null
  /// until then. What stays is what the repeat check reads (`eventId`, and
  /// `signedAt` with `bodySha256`) and the outcome and times; a delivery
  /// sent again after clearing is still a repeat. Only a `processed` or a
  /// `test` row is ever cleared (src/webhook-retention/). A row where this
  /// is set always has an empty body and a JSON null `payload`
  /// (`NuvionWebhookEvent_body_cleared_check`). Partial index
  /// `NuvionWebhookEvent_body_retention_idx` (processingStatus, receivedAt)
  /// WHERE bodyClearedAt IS NULL is in the migration only.
  bodyClearedAt    DateTime?

  @@unique([signedAt, bodySha256])
  @@index([processingStatus, event, receivedAt])
  @@index([event, resourceId])
  @@index([entityId])
}

/// ─────────────────────────────────────────────────────────────────────────
/// ONE PERSON AT NUVION (task NUV-01; written by NUV-02 to NUV-04 and NUV-09)
///
/// The person as Nuvion knows them: their individual entity (a child of
/// WAWU's parent entity), its review, and the one account opened for them
/// once approved, with its account details. One row per person.
///
/// Never the BVN, the NIN, a document, an image, the date of birth or the
/// address: Nuvion holds those; the rejection reasons are Nuvion's own
/// words with digits masked to their last 4. The balance is never here: it
/// is Nuvion's `available`, read when it is shown.
/// ─────────────────────────────────────────────────────────────────────────
model NuvionEntity {
  wawuUserId           String    @id
  /// Nuvion's entity id (`POST /individual-entities`), once created.
  entityId             String?   @unique
  /// The entity's person record (`person.id`): documents link to it.
  personId             String?
  /// Nuvion's review state: incomplete, pending, approved, rejected,
  /// failed or suspended (Nuvion's own words).
  status               String    @default("incomplete")
  /// When Nuvion approved or rejected it.
  decidedAt            DateTime?
  /// Why Nuvion said no, in its words (masked); empty otherwise.
  rejectionReasons     String[]  @default([])
  /// The account opened after approval (`POST /accounts`).
  accountId            String?   @unique
  /// The account's `nuvion_ban`: book transfers go to it.
  nuvionBan            String?   @unique
  /// The account details (`POST /account-details`), provisioned later.
  accountDetailsId     String?   @unique
  /// `pending` until Nuvion makes the account number `active`.
  accountDetailsStatus String?
  /// The number people send money to, once active.
  accountNumber        String?
  /// The bank that issued it (`issuer.name`, `issuer.code`).
  issuerBankName       String?
  issuerBankCode       String?
  /// The account's currency: NGN, or USD for people billed in dollars (NUV-09).
  currency             String?
  /// NUV-02 (migration 20261019110000): each check of Nuvion's review, in
  /// Nuvion's own words (`identification.identity_numbers[].verification_status`
  /// for the BVN and the NIN, `identification.document` and
  /// `identification.proof_of_address` for the two documents, and the
  /// identification's overall status), as the last `GET /entities/{id}`
  /// read them. Never the numbers themselves.
  bvnStatus            String?
  ninStatus            String?
  documentStatus       String?
  addressProofStatus   String?
  identificationStatus String?
  /// When the entity was last read back from Nuvion (`GET /entities/{id}`).
  reviewReadAt         DateTime?
  /// When the person last sent corrected details after a refusal
  /// (`PATCH /individual-entities/{id}`): the review starts again from the
  /// documents (NUV-03) while this is after `decidedAt`.
  correctedAt          DateTime?
  /// Nuvion's own `updated` time for the entity (its clock) as last read
  /// back, and as the correction's answer gave it: a decision read with a
  /// later time than this, after a correction, is a new decision, not the
  /// echo of the correction itself (NUV-02 round 2, D3).
  entityUpdatedAt      DateTime?
  /// NUV-02 round 3: when the person last submitted something for Nuvion's
  /// review: corrected details sent after a refusal (here) or the submit
  /// call (NUV-03 sets it). A refusal read again is a new decision only
  /// when it came after this and Nuvion's check words moved to a verdict
  /// (N4): `isNewDecision`, src/money/opening/review-stage.ts.
  submittedAt          DateTime?
  /// NUV-02 round 3: when the person last did something that moves the
  /// opening along (sent details, corrected them, uploaded a document,
  /// submitted: NUV-03 calls `recordOpeningProgress`). An opening idle for
  /// IDENTITY_HOLD_DAYS has its BVN hold released (N3).
  progressAt           DateTime?
  /// NUV-02 round 3: when the opening was marked expired (idle too long, or
  /// support released the hold): its BVN is let go, the person is told once
  /// and starts again. Nothing is deleted at Nuvion.
  holdExpiredAt        DateTime?
  /// The one naira account's claim: set just before `POST /accounts` is
  /// sent, so two deliveries never open two; the account is looked for
  /// (`GET /accounts`) before any second request.
  accountRequestedAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([accountNumber])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE DOCUMENTS SENT TO NUVION (task NUV-03, R-42)
///
/// One row per person and kind (`identity`: the ID document; `proof_of_
/// address`). The file goes to Nuvion and nowhere else: this table keeps
/// which kind and which sides went in the one call, the state, Nuvion's
/// document id, the time, and a SHA-256 fingerprint of the bytes so the
/// same file sent twice (a double tap, a retry after a lost answer) is
/// forwarded once. Never the file, a base64 copy of it, a number read off
/// it, or a file name.
///
/// `state`: `sending` (claimed, the call is out), `uploaded` (Nuvion
/// accepted it), `unknown` (the call went out and no answer came back: it
/// is looked for at Nuvion before anything is sent again), `failed`
/// (Nuvion refused it; nothing was made).
/// ─────────────────────────────────────────────────────────────────────────
model NuvionDocument {
  wawuUserId       String
  /// `identity` or `proof_of_address` (Nuvion's `key`).
  kind             String
  /// The Nuvion entity the file was sent for.
  entityId         String
  /// Which sides went in the call: `front`, and `back` when there was one.
  sides            String[]  @default([])
  state            String
  /// Nuvion's id for the document (`data.document.id`), once it answered.
  nuvionDocumentId String?
  /// Every Nuvion document id this row has ever recorded, so a look for an
  /// upload whose answer was lost never takes an earlier one for it.
  knownDocumentIds String[]  @default([])
  /// HMAC-SHA256 (hex) of the bytes sent, keyed by IDENTITY_HASH_KEY as the
  /// BVN's hash is, so the same file sent twice is forwarded once. Not the
  /// file, and not a bare hash of it: nobody who can read this table can test
  /// whether a person sent a given file. Cleared (null) once the opening is
  /// submitted: after that nothing compares a file with it.
  fingerprint      String?
  /// Calls made so far for this kind (each a new attempt).
  attempts         Int       @default(1)
  /// When the current attempt started: nothing is sent again before the
  /// money timeout plus the resend safety has passed since then.
  attemptStartedAt DateTime
  uploadedAt       DateTime?
  /// When Nuvion's review was seen to refuse this upload (its word for the
  /// document after the file was sent). It stays through a correction of the
  /// person's details, which Nuvion may answer with the check back at
  /// pending; only a new upload of this kind clears it. While it is set the
  /// document reads `needs_new` and the opening is not submitted.
  reviewRefusedAt  DateTime?
  /// Why the last attempt made nothing: our own word, never Nuvion's text.
  failure          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@id([wawuUserId, kind])
  @@index([entityId])
  @@index([state, attemptStartedAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE SUBMISSION AND THE HOSTED SELFIE (task NUV-03, R-39, R-42)
///
/// One row per person. `submitRequestedAt` is the claim taken before
/// `POST /onboarding-submissions` is sent, so two uploads at once, a
/// replayed delivery and a retry send it once; `submittedAt` is when Nuvion
/// is known to have it (its answer, or the entity moving past `incomplete`).
/// A submission older than the person's last correction (NuvionEntity.
/// correctedAt) is no longer current, and the review starts again.
///
/// The selfie is Nuvion's hosted page: `livenessSessionId` is its session
/// (`query_id`), saved on the entity as `meta.liveness_check_id`
/// (`livenessLinkedAt`). Whether the selfie is a step at all is the
/// server's one switch (NUVION_HOSTED_LIVENESS, and Nuvion saying the API is
/// not available to us), never a row of one person: a refusal about one
/// person's request or entity leaves the step required for them, and no one
/// skips it. Never an image or a face; the result is one word.
/// ─────────────────────────────────────────────────────────────────────────
model NuvionOnboarding {
  wawuUserId        String    @id
  entityId          String
  submitRequestedAt DateTime?
  submittedAt       DateTime?
  submitAttempts    Int       @default(0)
  /// Nuvion read the last submission and refused it (nothing was made): not
  /// sent again for a minute, or until a document changes.
  submitRefusedAt   DateTime?
  /// Nuvion's liveness session (`query_id`); null until one was started.
  livenessSessionId String?
  /// Taken just before a session is started, so two starts at once make one.
  livenessClaimedAt DateTime?
  livenessStartedAt DateTime?
  /// When the session id was saved on the entity (`meta.liveness_check_id`).
  livenessLinkedAt  DateTime?
  /// `pending`, `passed` or `not_passed`, in our words, from Nuvion's.
  livenessState     String?
  livenessCheckedAt DateTime?
  /// Sessions started for this person so far.
  livenessSessions  Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([submittedAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// BOOK TRANSFERS ON NUVION (task NUV-05, R-42)
///
/// The log of every book transfer this server sends on Nuvion: a payment from
/// a person's wallet into WAWU's operational account, a release or a refund
/// out of it, a send between two people. Nuvion has no lookup by our
/// reference (`GET /transfers/{id}` is the only read of one transfer), so the
/// id of every transfer whose answer was read is kept here beside our
/// reference, and a transfer whose answer was LOST is found again by walking
/// the sender's transfers (each carries its `unique_reference`).
///
/// The row is written BEFORE the send (`sending`), so a crash or a lost
/// answer still leaves the record of what was attempted: which accounts,
/// which amount, since when. `reference` is unique, so one reference is one
/// row on every server; a reference is never sent for other accounts or
/// another amount (the log refuses it before Nuvion is asked), and Nuvion's
/// own idempotency on `unique_reference` returns the original for a repeat.
///
/// `status` is Nuvion's word as last read (`pending`, `processing`,
/// `successful`, `failed`, `reversed`), `sending` while no answer was read
/// (the request may or may not have reached Nuvion), or `refused` when
/// Nuvion answered that it made nothing (the reference may be sent again).
/// A status only moves forward; `successful` is never undone by a late
/// `pending`. Never a balance: the balance is Nuvion's `available`.
///
/// `fromEntityId` / `toEntityId` are null for WAWU's operational account
/// (its transfers carry no entity: it is the authenticating entity's own).
/// No person column: a person's wallet is named by the account number their
/// `FintavaWallet` row holds, which WAWU's records already decide.
/// ─────────────────────────────────────────────────────────────────────────
model NuvionBookTransfer {
  id                String    @id @default(uuid())
  /// Our reference, sent as `unique_reference` (at most 64 characters).
  reference         String    @unique
  /// Nuvion's transfer id, once an answer or a read gave it.
  nuvionId          String?   @unique
  /// The account debited (Nuvion's id) and its entity.
  fromAccountId     String
  fromEntityId      String?
  /// True for WAWU's operational account.
  fromOperational   Boolean   @default(false)
  /// The number WAWU's records name the sending side by (a person's account
  /// number, or the operational account's `nuvion_ban`).
  fromAccountNumber String
  /// The account credited, and the `nuvion_ban` the transfer named it by.
  toAccountId       String
  toEntityId        String?
  toOperational     Boolean   @default(false)
  toAccountNumber   String
  toNuvionBan       String
  amountKobo        BigInt
  /// Nuvion's `applicable_fee` once its record says (kobo).
  feeKobo           BigInt?
  narration         String?
  status            String    @default("sending")
  /// Nuvion's `status_reason`, masked, or our note.
  statusReason      String?
  sentAt            DateTime  @default(now())
  /// When an answer to the send was read.
  answeredAt        DateTime?
  /// When Nuvion's record of the transfer was last read.
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([fromAccountId, sentAt])
  @@index([toAccountId])
}

// -----------------------------------------------------------------------------
// POINTS (task POINTS-01, R-43)
//
// Points are their own balance for the AI tools, always a count of points,
// never naira or dollars, and separate from WAWU Credits (R-43 leaves open
// whether they replace credits; the round 2 brief draws them apart). They are
// WAWU's own instrument, not money a provider holds, so these lots are the
// authority for a person's points.
//
// Points come in lots that expire (PointLot). Spending takes the
// soonest-expiring lot first, through a hold (PointHold) that is committed or
// released. Every change to a lot's points is one row in PointLedger, which
// is append-only: the migration's triggers refuse an UPDATE of a ledger row,
// and any DELETE but the account purge's (one person, all of their rows, in a
// transaction that set wawu.points_purge to the person's id and its own
// transaction id). A hold moves once, from held to
// committed or released. CHECK constraints in the migration keep a lot
// between 0 and what it was granted, so the balance can never go below zero,
// and its end between 2000 and 2100 (UTC).
// -----------------------------------------------------------------------------

/// Where a lot of points came from. The task that grants each one owns its
/// reference: TIER-03 (`tier_bonus`, `bump`), POINTS-02 (`pack`), REF-01
/// (`referral`), POINTS-03 (`shortfall`), and points given back after a spend
/// (`returned`).
enum PointLotSource {
  tier_bonus
  pack
  bump
  referral
  shortfall
  returned
}

/// Why a ledger row moved a lot: a grant adds, a hold takes, a release gives
/// back to the same lot, an expiry takes what a lapsed lot still had.
enum PointLedgerReason {
  grant
  hold
  release
  expire
}

/// What held points are for: an AI tool's job (POINTS-03) or turning points
/// into wallet cash (POINTS-04).
enum PointHoldPurpose {
  ai_job
  cash_out
}

/// A hold is `held` until its job ends: `committed` (the points are spent) or
/// `released` (every point went back to the lot it came from). Both are final.
enum PointHoldState {
  held
  committed
  released
}

/// One grant of points: how many, how many are left, and when they end.
model PointLot {
  id         String         @id @default(uuid())
  wawuUserId String
  source     PointLotSource
  /// The granting task's own reference (a purchase, a referral, a job). One
  /// lot per source and reference: the same grant twice grants once.
  sourceRef  String
  /// Points granted. Never changes.
  quantity   Int
  /// Points still in the lot. Taken by holds, put back by releases, set to 0
  /// by the expiry job. CHECK: 0 <= remaining <= quantity.
  remaining  Int
  expiresAt  DateTime
  /// When the expiry job took what the lot still had; null while it has not.
  lapsedAt   DateTime?
  createdAt  DateTime       @default(now())

  ledger PointLedger[]

  @@unique([source, sourceRef])
  /// A person's live lots, soonest-expiring first.
  @@index([wawuUserId, expiresAt])
  /// The expiry job's search.
  @@index([expiresAt])
}

/// Points taken from a person's lots for one job, until it is committed or
/// released. Which lots, and how many from each, are the hold's ledger rows.
model PointHold {
  id         String           @id @default(uuid())
  wawuUserId String
  purpose    PointHoldPurpose
  /// The job or conversion this hold pays for. One hold per purpose and
  /// reference: the same hold asked for twice holds once.
  reference  String
  /// What the movement list calls it ("VoiceOver"), from the calling task's
  /// own table, never from what a person typed.
  title      String?
  quantity   Int
  state      PointHoldState   @default(held)
  createdAt  DateTime         @default(now())
  /// When it was committed or released.
  settledAt  DateTime?

  ledger PointLedger[]

  @@unique([purpose, reference])
  @@index([wawuUserId, createdAt])
  /// POINTS-03's sweep of stale AI holds: the `held` ones older than the job's
  /// longest run time, oldest first.
  @@index([state, createdAt])
}

/// One person's choices about points (task POINTS-03, PT3). A row exists only
/// once the person has chosen; no row reads as the defaults (`useWallet` off).
model PointsSetting {
  wawuUserId String   @id
  /// "Use wallet": when points run short, the quote shows the wallet money
  /// that would buy the shortfall. It never spends anything by itself; the
  /// money moves only on `POST /points/shortfall` with the PIN.
  useWallet  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

/// Append-only: one row per change to one lot's points. Never updated; a
/// person's rows are deleted only by the account purge, all together.
model PointLedger {
  id         String            @id @default(uuid())
  wawuUserId String
  lotId      String
  lot        PointLot          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  /// Points added (positive) or taken (negative); never 0. CHECK: a grant
  /// and a release add, a hold and an expiry take.
  delta      Int
  reason     PointLedgerReason
  /// The hold a `hold` or `release` row belongs to.
  holdId     String?
  hold       PointHold?        @relation(fields: [holdId], references: [id], onDelete: Restrict)
  /// The job or purchase reference: the lot's for a grant, the hold's for a
  /// hold or a release; null for an expiry.
  reference  String?
  /// When the row was written (the app's clock at each INSERT, so the rows
  /// of one hold can differ by milliseconds; `seq` orders them).
  at         DateTime          @default(now())
  /// The order rows were written in: a person's movements, newest first, are
  /// read by this, never by `at`.
  seq        BigInt            @default(autoincrement())

  /// A person's last movements, newest first.
  @@index([wawuUserId, seq])
  @@index([lotId])
  @@index([holdId])
}

/// ─────────────────────────────────────────────────────────────────────────
/// POINTS CONVERTED TO CASH (task POINTS-04, R-43, R-31)
///
/// A person turns points into naira in their wallet at the config rate
/// (plans.config.json `cash_out`, TIER-01). One row per request. The row and
/// the points hold it rests on (POINTS-01, purpose `cash_out`, reference =
/// this row's id) are written in ONE transaction, so there is no row without
/// held points and no held points without a row.
///
/// `held` until the provider CONFIRMS the cash in the person's wallet; then
/// `paid` (the hold is committed, in the same transaction) or, when the
/// provider's own record says nothing moved, `cancelled` (the hold is
/// released, back to the lots it came from). An unknown outcome (a lost
/// answer, a transfer accepted and not finished) stays `held` and is asked
/// about by our reference, never sent again and never read as "nothing
/// moved"; past PAYMENT_REVIEW_AFTER_HOURS it goes to a person
/// (`reviewSince`) with the points still held. The cash leaves WAWU's own
/// account at the provider (`merchantAccountNumber`, R-19, R-42) and the
/// provider's charge on the move is WAWU's (R-31).
///
/// Exactly once, whoever asks: the Idempotency-Key links to this row (one
/// request, one row), the reference the provider sees is `wawu-pts-<id>`
/// (unique, so a repeat is refused by the provider and by our table), and the
/// move is handed over by a lease (`sentAt`) only one caller wins. Every
/// figure is integer kobo or whole points; `cashKobo` is exactly the rate
/// applied to the points (the migration's CHECK), rounded down.
///
/// `wawuUserId` is null once the account is deleted (ANONYMISED): the row
/// stays for the provider's record of the move.
/// ─────────────────────────────────────────────────────────────────────────
model PointConversion {
  id                       String    @id @default(uuid())
  /// Whose points. Null after the account is deleted.
  wawuUserId               String?
  points                   Int
  /// What is paid into the wallet, in kobo: floor(points x rate / 1,000).
  cashKobo                 BigInt
  /// The rate it was worked out at: kobo paid for 1,000 points, frozen with the row.
  per1000PointsKobo        BigInt
  /// WAWU's own account at the provider the cash leaves.
  merchantAccountNumber    String
  /// The wallet provider that moves it (the running one when it was asked).
  provider                 String    @default("fintava")
  /// held, paid or cancelled.
  status                   String    @default("held")
  /// When the provider confirmed the cash (paid) or the points went back (cancelled).
  settledAt                DateTime?
  /// OUR reference at the provider: `wawu-pts-<id>`. One conversion, one reference.
  customerReference        String    @unique
  destinationAccountNumber String?
  /// When the move was handed to the provider. Set means "a record may exist
  /// at the provider": it is asked, never sent again, until it says.
  sentAt                   DateTime?
  /// The provider's own charge on the move (WAWU's, R-31); null when its record did not say.
  providerFeeKobo          BigInt?
  /// The schedule: a lease on a call in flight, or the next question to the provider.
  nextAttemptAt            DateTime?
  attempts                 Int       @default(0)
  checks                   Int       @default(0)
  /// A person has to look (no answer past the review bound, a reversed move,
  /// another amount than asked). Out of the sweep; the points stay held.
  reviewSince              DateTime?
  discrepancy              String?
  /// Why a cancelled conversion ended, in words for the person.
  failureReason            String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([status, reviewSince, nextAttemptAt])
  @@index([wawuUserId, createdAt])
}

enum WaitlistStatus {
  pending
  paid
  failed
}

/// One person's registration for an event offer, paid by Flutterwave checkout
/// (JOIN-01, R-48). A waiting list, not an account: nothing here is a WAWU ID
/// account, and no row names one until the person signs up in the app and
/// claims it (JOIN-03 writes `claimedByWawuId` and `claimedAt`).
///
/// `reference` is the Flutterwave tx_ref, random and at least 128 bits. The
/// price is copied into `amountKobo` when the person registers, so a later
/// change to the offer never decides whether their payment counts. `phone` is
/// E.164 and `email` lower case, both normalised by the server.
///
/// Also in the database, and NOT expressible here (Prisma has no partial
/// unique index): at most one `paid` row per offer and phone, and one per
/// offer and email (`WaitlistRegistration_one_paid_phone_key`,
/// `WaitlistRegistration_one_paid_email_key`), and the CHECKs in the
/// migration. `failed` is only ever a second payment for a person who is
/// already registered (kept so it can be refunded); a payment Flutterwave
/// does not confirm leaves the row `pending`.
model WaitlistRegistration {
  id              String         @id @default(uuid())
  offerId         String
  fullName        String
  phone           String
  email           String
  state           String?
  makes           String?
  /// What the person makes or does, one of `WAITLIST_CRAFTS` (the owner's
  /// redesign of /join, JOIN-V2). NULL from a client that does not send it.
  craft           String?
  /// The conference city they will attend, one of `WAITLIST_CITIES`: Lagos,
  /// Abuja, Port Harcourt, Enugu or Online (JOIN-V2). NULL from a client that
  /// does not send it.
  city            String?
  /// Whether they asked for launch and conference updates (JOIN-V2): true
  /// accepted, false declined, NULL not asked.
  updatesOptIn    Boolean?
  consentAt       DateTime
  reference       String         @unique
  /// The launch access code the payer sees as "XXXX XXXX": the first 8
  /// characters of the reference after `wawu-join-`, upper-case. A column the
  /// database computes from `reference` (GENERATED ALWAYS ... STORED), so it
  /// can never disagree with the reference and the code never writes it; the
  /// unique index is what makes it unique across ALL registrations.
  accessCode      String         @unique @default(dbgenerated())
  status          WaitlistStatus @default(pending)
  amountKobo      Int
  currency        String         @default("NGN")
  /// Flutterwave's transaction id; set once, when the payment is accepted
  /// (or recorded as a duplicate), and never shared by two rows.
  flutterwaveTxId String?        @unique
  /// What Flutterwave confirmed was paid, in kobo.
  paidKobo        Int?
  paidAt          DateTime?
  /// The WAWU ID account that claimed this payment in the app (JOIN-03).
  claimedByWawuId String?
  claimedAt       DateTime?
  /// What the claim told its claimer (JOIN-03 round 2): the offer's name, the
  /// days given, whether they were added to a running plan, and the points
  /// lot. Written in the claim's own transaction. The SAME account repeating
  /// the SAME code is answered from it, as a 200, so a lost answer can be
  /// replayed; nobody else ever sees it. Never carries another person's
  /// details. NULL on an unclaimed row.
  claimResult     Json?
  /// The referral code this registration is counted under (REF-01): set only
  /// when the code was active and under its limit at the moment of registering.
  /// NULL for every row made before REF-01 and for everyone who used no code,
  /// or whose code was switched off or full (they pay the standard price and are
  /// not counted under the code).
  referralCode      String?
  /// The code's community name at that moment (REF-01); NULL with `referralCode`.
  referralCommunity String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([offerId, status, createdAt])
  @@index([phone])
  @@index([email])
  @@index([claimedByWawuId])
  @@index([referralCode, status, createdAt])
}

/// A referral code for the paid registration page /join (REF-01, owner, 14 Oct
/// 2026). It names the community a registrant came from and sets the price its
/// users pay (0 to the offer's price; 0 is free), with an optional limit on
/// how many people may use it. Created and changed by admins only. Never
/// deleted: switched off (`active` false). A price or limit change affects only
/// registrations started after it (each registration keeps its own
/// `amountKobo`).
model ReferralCode {
  id         String   @id @default(uuid())
  /// Upper case letters and digits, 3 to 20. Matched case-insensitively.
  code       String   @unique
  /// The label the owner tracks by.
  community  String
  /// What a person using the code pays, in whole kobo; 0 means free.
  priceKobo  Int
  /// How many people may use the code; NULL means no limit.
  usageLimit Int?
  active     Boolean  @default(true)
  /// The admin who created it (admin id); NULL for the code the migration inserted.
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// EMAIL-01: the email campaign tool in the admin dashboard. Additive: four
// new tables, nothing existing is touched. Sent through Resend by the Hub
// (src/admin/notifications/email/), only to people who consented.
// ---------------------------------------------------------------------------

enum EmailCampaignStatus {
  /// Built and counted, nothing sent yet.
  ready
  /// The background job is working through the recipients.
  sending
  /// Every recipient has a result (sent, failed or skipped).
  sent
}

enum EmailRecipientStatus {
  queued
  sent
  failed
  skipped
}

enum EmailSuppressionReason {
  unsubscribed
  bounced
  complained
}

/// A saved email: the body is Markdown or simple text with {{first_name}} and
/// {{join_link}}. `version` goes up on every save.
model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  previewText String   @default("")
  body        String
  version     Int      @default(1)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

/// One send. The template is copied in (a snapshot), so editing or deleting the
/// template later never changes what a campaign sent.
model EmailCampaign {
  id               String              @id @default(uuid())
  templateId       String?
  templateName     String
  subject          String
  previewText      String              @default("")
  body             String
  /// `csv` or `registrants`.
  audienceKind     String
  /// A sentence for the dashboard: "CSV upload (people.csv)" or
  /// "Join registrants: paid, first 500".
  audienceNote     String
  status           EmailCampaignStatus @default(ready)
  totalCount       Int                 @default(0)
  sentCount        Int                 @default(0)
  failedCount      Int                 @default(0)
  skippedCount     Int                 @default(0)
  /// CSV rows that were not an email address, and repeats of one already in.
  invalidCount     Int                 @default(0)
  duplicateCount   Int                 @default(0)
  createdBy        String
  createdAt        DateTime            @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  updatedAt        DateTime            @updatedAt
  recipients       EmailRecipient[]

  @@index([createdAt])
  @@index([status])
}

model EmailRecipient {
  id         String               @id @default(uuid())
  campaignId String
  campaign   EmailCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Lower case.
  email      String
  firstName  String?
  status     EmailRecipientStatus @default(queued)
  /// Set the moment one worker takes the row, before anything is sent. A row
  /// with a claim and no result is never sent again (no double send).
  claimedAt  DateTime?
  providerId String?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime             @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

/// Addresses that must not be emailed again.
model EmailSuppression {
  email  String                 @id
  reason EmailSuppressionReason
  at     DateTime               @default(now())
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE NIGHTLY CHECK AGAINST THE WALLET PROVIDER (task MONEY-16)
///
/// One row per run of the nightly check: it compares WAWU's ledger with the
/// provider's own record (every wallet's debits and balance, WAWU's own
/// account, the money held for payers and payees, the merchant charge on each
/// fee-bearing send) and reports a difference the same night. A run only
/// reads and reports: it never changes a ledger row, a hold, a payment or a
/// balance. The provider's balance is the truth.
///
/// The unique key is the lock: `night` is the Lagos calendar date the run
/// belongs to, `sequence` is 1 for the scheduled run and counts up for a run
/// made again by hand, so two Hub processes cannot both run one night. A run
/// that dies leaves `running` with an old `leaseUntil`; any process may take
/// it over after that (`attempt` counts the tries). A run never ends as
/// clean unless every comparison was made: `verdict` says so, and `report`
/// holds the counts and the references a person looks at (kobo as decimal
/// text; never a name, a phone number or an account number).
///
/// `emailedTo` lists the WAWU ids the report was handed to WAWU ID for;
/// `emailedAt` is set when every recipient has been; a failed hand-over is
/// tried again (`nextEmailAt`).
/// ─────────────────────────────────────────────────────────────────────────
model MoneyCheckRun {
  id             String    @id @default(uuid())
  /// The wallet provider whose rows were checked: `fintava` or `nuvion`.
  provider       String    @default("fintava")
  /// The Lagos date this run belongs to, `YYYY-MM-DD`.
  night          String
  /// 1 for the scheduled run; a run made again by hand takes the next number.
  sequence       Int       @default(1)
  /// running, failed (this try threw; another may take it after `leaseUntil`)
  /// or finished (`verdict` and `report` are set).
  status         String    @default("running")
  attempt        Int       @default(1)
  byHand         Boolean   @default(false)
  startedAt      DateTime
  /// Until when the process that holds this run keeps it. Extended while it
  /// works; any process may take a `running` or `failed` run after it.
  leaseUntil     DateTime
  finishedAt     DateTime?
  /// What the movement comparison looked at: from (null: no lower bound) to.
  windowFrom     DateTime?
  windowTo       DateTime?
  /// clean, needs_a_look, differences, incomplete or not_checked.
  verdict        String?
  walletsTotal   Int?
  walletsChecked Int?
  mismatchCount  Int?
  lookCount      Int?
  report         Json?
  /// Why the last try failed, in words with no provider text in them.
  failure        String?
  emailedTo      String[]  @default([])
  emailAttempts  Int       @default(0)
  nextEmailAt    DateTime?
  emailedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([provider, night, sequence])
  @@index([provider, status, finishedAt])
  @@index([emailedAt, finishedAt])
}

/// EXPLORE-05. One person's recent search, kept so the Search landing can show
/// "Recent" and clear it. One row per person and normalised text: searching the
/// same thing again moves the row to the top (`searchedAt`), it does not add a
/// second one. A person keeps their newest few (see search-history.config.ts).
///
/// `queryKey` is the text trimmed, with runs of spaces made one, and lowercased:
/// "Tax  Filing" and "tax filing" are one search. `query` is what the person
/// last typed, in their own case, and is what the app shows.
///
/// "People are searching" is read from this table, never from a count of its
/// own: a query is popular when enough different people searched it lately.
/// So Clear takes a person's text out of that too, and nothing about who
/// searched is stored anywhere else.
model SearchHistory {
  userWawuId String
  queryKey   String
  query      String
  searchedAt DateTime @default(now())

  @@id([userWawuId, queryKey])
  @@index([userWawuId, searchedAt])
  @@index([searchedAt, queryKey])
}

/// BILLS-04. A bill paid from the wallet: electricity, airtime, data or cable
/// TV. One row per bill, made before it is paid (`draft`, the target the pay
/// sheet quotes), paid with a `bill` WalletPayment into WAWU's own account
/// (R-19), and then bought from the biller at Fintava out of that account.
/// The row is the feature's own record of the bill; the money is the payment's
/// and the hold's, and the provider's balance stays the only balance.
///
/// `status`: draft (made, not paid), buying (paid; the purchase is not made yet
/// or its outcome is not known), delivered (the biller delivered; the hold is
/// released) or failed (the biller did not; the hold is refunded to the payer).
/// `purchaseSentAt` set means a record may exist at the biller: the purchase is
/// asked about and never sent again until Fintava's own record says. Fintava's
/// bill calls take no reference of ours, so this column is the only guard
/// against buying twice.
///
/// Every figure is integer kobo. `amountKobo` is the bill's own amount (what the
/// biller gets); the payment's price is `amountKobo + billChargeKobo +
/// serviceFeeKobo`, all moved into WAWU's account in one transfer (R-31).
model WalletBill {
  id                   String    @id @default(uuid())
  /// The buyer. Null once their account is deleted: the money record stays,
  /// the meter or number and the name on it go with the account.
  wawuUserId           String?
  /// electricity, airtime, data or cable.
  category             String
  /// The disco code, the mobile network or the cable provider, as Fintava names it.
  billerCode           String
  /// What a person reads for the biller ("Ikeja Electric", "MTN", "DStv").
  title                String
  /// prepaid or postpaid (electricity only).
  planType             String?
  /// A data bundle's or a cable plan's code at Fintava.
  productCode          String?
  /// What that code is called ("1.5GB", "Compact").
  productLabel         String?
  /// The meter, phone or smartcard number.
  accountNumber        String?
  /// The name Fintava holds for the meter, when the buyer had it checked.
  accountName          String?
  amountKobo           BigInt
  billChargeKobo       BigInt
  serviceFeeKobo       BigInt
  status               String    @default("draft")
  /// The reference a person quotes: WAW-BIL- and eight characters.
  reference            String    @unique
  /// The wallet payment that paid it (WalletPayment.id) and its hold.
  paymentId            String?   @unique
  holdId               String?
  /// When the purchase was handed to Fintava (see above).
  purchaseSentAt       DateTime?
  /// How many times Fintava has been asked what became of an unknown purchase.
  checks               Int       @default(0)
  /// Fintava's record of the purchase. Unique, so one history record settles
  /// at most one bill (a lost purchase is never settled with another bill's).
  fintavaTransactionId String?   @unique
  fintavaReference     String?   @unique
  /// The electricity token and the units bought, as Fintava answered them.
  token                String?
  units                String?
  failureReason        String?
  paidAt               DateTime?
  deliveredAt          DateTime?
  failedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([wawuUserId, createdAt])
  @@index([status, purchaseSentAt])
  /// FIX-42: the half-hourly late-success look reads failed bills, newest first.
  @@index([status, failedAt])
}

// ---------------------------------------------------------------------------
// REFERRAL POINTS (task REF-02, R-43, R-65)
//
// A person has one code and shares it; a new person claims it once; when that
// person's first paid tier is granted, the person who invited them earns
// points (never cash) after a hold. Nothing here is money and none of it is
// the points balance: the points are lots in POINTS-01 (source `referral`),
// these tables only say who invited whom and what each reward is waiting for.
//
// The names start with Person or Referral because ReferralCode is REF-01's
// table for the /join registration link (a different thing: a price for a
// community, not a person's own code). The two never share a row.
// ---------------------------------------------------------------------------

/// Where a reward is: `pending` through the hold, `granted` once its points
/// are a lot, `cancelled` when it will never be (a refund inside the hold, a
/// referrer without a tier). Granted and cancelled are final.
enum ReferralRewardState {
  pending
  granted
  cancelled
}

/// A person's own code, made the first time they ask for it. One per person.
/// Upper case letters and digits, 3 to 20; the link is `wawu/r/<code>`.
model PersonReferralCode {
  id         String   @id @default(uuid())
  wawuUserId String   @unique
  code       String   @unique
  createdAt  DateTime @default(now())
}

/// One person who claimed another's code. One row per invited person, so a
/// person claims once (unique `referredWawuUserId`), and never their own.
model PersonReferral {
  id                 String   @id @default(uuid())
  referrerWawuUserId String
  referredWawuUserId String   @unique
  /// The code as it was claimed (upper case).
  code               String
  claimedAt          DateTime @default(now())

  reward ReferralReward?

  /// The referrer's list and counts.
  @@index([referrerWawuUserId, claimedAt])
}

/// What one invited person's first paid tier earns the person who invited
/// them. At most one row per referral (unique `referralId`), whatever number
/// of tier payments or repeated confirmations arrive: the first insert wins.
/// The figures are copied here when the reward is made, so a setting changed
/// during the hold changes nothing already pending. The multiplier is kept in
/// thousandths (1.25 is 1250), points are whole, never money.
///
/// `pending` until `availableAt` (the hold), then the sweep makes it
/// `granted` (a POINTS-01 lot, `sourceRef` = `reward:<id>`) or `cancelled`.
model ReferralReward {
  id                 String              @id @default(uuid())
  referralId         String              @unique
  referral           PersonReferral      @relation(fields: [referralId], references: [id], onDelete: Restrict)
  referrerWawuUserId String
  referredWawuUserId String
  /// The tier payment this rests on (MakerPurchase.paymentRef).
  paymentRef         String
  tierId             String
  basePoints         Int
  multiplierMilli    Int
  points             Int
  state              ReferralRewardState @default(pending)
  availableAt        DateTime
  createdAt          DateTime            @default(now())
  /// When it became granted or cancelled.
  settledAt          DateTime?
  /// Why it was cancelled: `purchase_refunded`, `referrer_no_tier`, `no_points`.
  cancelReason       String?

  /// The sweep: pending rewards that are due.
  @@index([state, availableAt])
  /// The referrer's counts and list.
  @@index([referrerWawuUserId, state])
}

/// A milestone a person reached (5 verified, and so on): points granted once
/// per person and count (unique), as a POINTS-01 lot with `sourceRef` =
/// `milestone:<referrer>:<count>`.
model ReferralMilestone {
  id                 String   @id @default(uuid())
  referrerWawuUserId String
  /// Verified referrals the milestone is for.
  count              Int
  points             Int
  grantedAt          DateTime @default(now())

  @@unique([referrerWawuUserId, count])
}

// -----------------------------------------------------------------------------
// NUV-08: what the reconciliation with Nuvion found and could not settle itself
// -----------------------------------------------------------------------------

/// One thing the reconciliation reports for a person at WAWU to look at
/// (task NUV-08): a difference between Nuvion's fee simulation and the fee
/// setting (both figures kept, the setting is never changed), a webhook
/// subscription that is missing or could not be renewed, a sweep that could
/// not read everything. One row per (kind, subject): seen again, it is
/// updated; no longer true, it is resolved, and a later sighting reopens it.
/// No person column, no name, no account number, no Nuvion text: our own
/// words and kobo figures.
model NuvionReconcileFinding {
  id           String    @id @default(uuid())
  /// `fee_differs`, `subscription_missing`, `subscription_renewal_failed`,
  /// `subscription_expiring`, `sweep_incomplete`.
  kind         String
  /// What it is about: a fee setting's name, a subscription id, `sweep`.
  subject      String
  detail       String
  /// The figure on WAWU's side (the setting), in kobo, when there is one.
  settingKobo  BigInt?
  /// The figure on Nuvion's side (the simulation), in kobo, when there is one.
  providerKobo BigInt?
  /// The amount the two figures were compared at, in kobo.
  amountKobo   BigInt?
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  seenCount    Int       @default(1)
  resolvedAt   DateTime?

  @@unique([kind, subject])
  @@index([resolvedAt, lastSeenAt])
}

/// Where an AI tool job is (AITOOLS-01, PT2). `working` until the voice provider
/// answers; then `done` (the points were kept) or `failed` (every held point
/// went back).
enum AiJobState {
  working
  done
  failed
}

/// One run of an AI tool for one person (AITOOLS-01, R-43). The points it
/// costs are held by POINTS-03 (`PointHold`, purpose `ai_job`, reference
/// `<id>:1`) before the provider is asked, kept when the audio is stored, and
/// given back when it is not. The text a person typed is NEVER stored: it
/// lives in the request that runs the job. `requestHash` is an HMAC of the
/// request, so the same Idempotency-Key with other words is refused and a read
/// of this table reveals no text.
model AiToolJob {
  id             String     @id @default(uuid())
  wawuUserId     String
  /// The plan's action id (`voiceover_per_min`), which names the cost.
  tool           String
  /// The person's Idempotency-Key for this job: a lost answer and a retry run one job.
  idempotencyKey String
  requestHash    String
  /// The WAWU voice id the person chose (never the provider's own id).
  voiceId        String
  characters     Int
  /// What the job was priced in (minutes, for VoiceOver) and the points it costs.
  units          Int
  costPoints     Int
  state          AiJobState @default(working)
  /// The hold that pays for the job, once taken.
  holdId         String?
  /// `provider_failed`, `provider_unavailable`, `points_gone`, `timed_out` or `store_failed`, for a failed job.
  failureCode    String?
  /// The stored audio's key (a `StorageObject` row), once the job is done.
  audioKey       String?
  /// What the job made, once done (AITOOLS-02): a list of `{ kind: audio | text | subtitles, key?, text? }`.
  outputs        Json?
  /// The provider's own id for a long job (dubbing), for a later look-up. Never shown to a person.
  providerRef    String?
  /// The key of the file the person uploaded for the job (captions, clean audio, dubbing).
  inputRef       String?
  /// When the person saved the result to their library (AITOOLS-07); null until they do.
  savedAt        DateTime?
  createdAt      DateTime   @default(now())
  finishedAt     DateTime?

  @@unique([wawuUserId, idempotencyKey])
  @@index([wawuUserId, createdAt])
  @@index([state, createdAt])
}

/// A person's voice: how their name is said and their Voice Intro (VOICE-01,
/// R-43, R-66). One row per person, made the first time they save a spelling,
/// a script, a consent or a sample. The sample is a file the person uploaded
/// themselves (`StorageObject`, folder `voice/sample`); `consentAt` and
/// `consentLine` are the words they agreed to and when. Only the person reads
/// or changes it; the public profile reads `audioKey` alone.
model VoiceProfile {
  wawuUserId      String    @id
  /// How the person's name is said ("Ah-DEH-oh-lah"), when they set one.
  namePhonetic    String?
  nameSavedAt     DateTime?
  /// The words of the Voice Intro, as the person wrote them.
  introText       String?
  introTextAt     DateTime?
  /// The person's agreement that WAWU may make an AI copy of their own voice.
  consentAt       DateTime?
  /// The exact words they agreed to (the line the Hub served).
  consentLine     String?
  /// The 30 second recording (a `StorageObject` key of the person's own), and the time it was set.
  sampleKey       String?
  sampleAt        DateTime?
  /// The time of the consent in force when the sample was set.
  sampleConsentAt DateTime?
  /// The person's separate agreement that WAWU may speak their VoiceOver in an AI version of their own voice (AITOOLS-07). The Voice Intro consent covers intros only.
  ownVoiceConsentAt   DateTime?
  /// The exact words they agreed to for VoiceOver (the line the Hub served).
  ownVoiceConsentLine String?
  /// The current Voice Intro audio (a `StorageObject` key), once a run is done.
  audioKey        String?
  audioAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// One try at making a Voice Intro (VOICE-01). Free when the person's tier
/// still gives the first one (`includedUsed`, no hold) and otherwise paid in
/// points held by POINTS-03 (`PointHold`, purpose `ai_job`, reference
/// `<id>:1`): kept when the audio is stored, given back when it is not. The
/// script is NEVER stored here; the same Idempotency-Key answers the first run
/// being used twice. At most one `working` run per person (a partial unique
/// index in the migration).
model VoiceIntroRun {
  id             String     @id @default(uuid())
  wawuUserId     String
  idempotencyKey String
  characters     Int
  /// 0 when the tier's included first one paid for it.
  costPoints     Int
  /// True when the tier's included first Voice Intro was used for this run;
  /// a run that fails puts it back.
  includedUsed   Boolean    @default(false)
  state          AiJobState @default(working)
  holdId         String?
  /// `provider_failed`, `provider_unavailable`, `store_failed`, `sample_unreadable` or `timed_out`.
  failureCode    String?
  audioKey       String?
  createdAt      DateTime   @default(now())
  finishedAt     DateTime?

  @@unique([wawuUserId, idempotencyKey])
  @@index([wawuUserId, createdAt])
  @@index([state, createdAt])
}

/// One "hear your name" preview a person asked for (VOICE-01). Only counted,
/// so the free preview has a per-hour limit; it holds no name and no audio.
model VoiceNamePreview {
  id         String   @id @default(uuid())
  wawuUserId String
  createdAt  DateTime @default(now())

  @@index([wawuUserId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// FLIX MOVIES (task FLIX-01, R-74, R-75). Four additive tables.
/// ─────────────────────────────────────────────────────────────────────────

/// The Hub's copy of the movie partner's catalog (FLIX-01). The screens read
/// only this table, so the partner is never called for a screen and its
/// request limit (1,000 per 15 minutes) is never near. `provider` is the
/// adapter that wrote the row (`standin`, later `flixora`): a server reads
/// only the rows of the provider it runs. Kept up to date by the sync job
/// (incremental with `updatedSince`, a full pass now and then that also drops
/// titles the partner no longer lists). Holds no person's data.
model MoviePartnerMovie {
  id              String    @id @default(uuid())
  provider        String
  /// The partner's id for the title; also the `movieId` the Hub's routes take.
  partnerMovieId  String
  title           String
  /// Lower case `title`, what "sort by title" orders on.
  titleSort       String
  originalTitle   String?
  synopsis        String
  tagline         String?
  genre           String[]
  language        String?
  countryOfOrigin String?
  year            Int?
  runtimeMinutes  Int?
  ageRating       String?
  posterImage     String?
  backdropImage   String?
  trailerUrl      String?
  /// `file` (plays in the app) or `youtube` (opens in YouTube or the browser); null with no trailer.
  trailerKind     String?
  /// `[{ name, character }]`
  castMembers     Json
  rating          Float
  ratingCount     Int
  views           Int
  premiering      Boolean
  premierDate     DateTime?
  /// When the partner added the title.
  partnerAddedAt  DateTime
  /// The title's path on the partner's site (`redirect` in a signed-in link).
  partnerPath     String
  partnerUrl      String
  /// The start of the last sync pass that saw this title. A full pass removes
  /// the rows it did not see.
  seenAt          DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, partnerMovieId])
  @@index([provider, partnerAddedAt])
  @@index([provider, views])
  @@index([provider, rating])
  @@index([provider, titleSort])
  @@index([provider, seenAt])
}

/// Where the sync job is for one provider (FLIX-01): when the last pass that
/// finished began (the next incremental pass asks for what changed since),
/// when the last full pass began, and the lease one server holds while it
/// runs. `lastError` is a short code, never a response body.
model MoviePartnerSync {
  provider          String    @id
  lastPassStartedAt DateTime?
  lastFullPassAt    DateTime?
  lastPassAt        DateTime?
  claimedUntil      DateTime?
  lastError         String?
  lastCount         Int       @default(0)
  updatedAt         DateTime  @updatedAt
}

/// A person's account on the movie partner's side (FLIX-01, R-75): it exists
/// from the first signed-in link, so there is one row per person and provider
/// from their first "Watch on Flixora". The link itself is never stored.
/// `accountDeletedAt` is set when the person's WAWU account is purged: no more
/// links are given, and the row is the note that their account on the
/// partner's side is closed by hand (G-FLIX-2). AUDIT in the purge map.
model MoviePartnerLink {
  id               String    @id @default(uuid())
  provider         String
  wawuUserId       String
  firstLinkAt      DateTime
  lastLinkAt       DateTime
  linkCount        Int       @default(1)
  accountDeletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([provider, wawuUserId])
  @@index([wawuUserId])
}

/// A person's agreement to the terms that name the movie partner (FLIX-01,
/// R-75): `signup` (they signed up on or after FLIXORA_TERMS_FROM) or `mv4`
/// (they ticked the box before "Open Flixora"). One row per person and
/// provider. OWNED in the purge map.
model MoviePartnerConsent {
  id         String   @id @default(uuid())
  provider   String
  wawuUserId String
  agreedAt   DateTime @default(now())
  how        String

  @@unique([provider, wawuUserId])
  @@index([wawuUserId])
}

/// Which store a purchase was made in (IAP-01, R-86).
enum StorePlatform {
  android
  ios
}

/// What a store product grants (IAP-01): points (a points pack), credits (a
/// WAWU Credits pack), tier (a maker tier, a subscription in the store) or
/// pass (a community pass, a subscription in the store).
enum StoreProductKind {
  points
  credits
  tier
  pass
}

/// granted: the purchase gave what it sold. refunded: the store paid the
/// buyer back, and what it gave was taken back. revoked: the store withdrew
/// it (family sharing ended, a chargeback), taken back the same way.
enum StorePurchaseStatus {
  granted
  refunded
  revoked
}

/// The store product map (IAP-01, R-86): one row per product id in a store,
/// edited by an admin. `grants` says what ONE purchase gives, by kind:
/// points `{ packId }` (a pack of the live plan), credits `{ pack }`
/// (starter, popular or pro), tier `{ tierId }`, pass `{ days }`. Nothing is
/// granted for a product id that has no active row here. Rows are never
/// deleted once a purchase names them (`StorePurchase.productId` restricts).
model StoreProduct {
  id             String           @id @default(uuid())
  platform       StorePlatform
  storeProductId String
  kind           StoreProductKind
  title          String
  grants         Json
  /// What one purchase is worth in kobo BEFORE the store's share (Default
  /// (lead), owner may override): the 85/15 split on credits and passes works
  /// from this less the platform's store fee. Null for points and tiers,
  /// which pay no creator.
  referenceKobo  Int?
  active         Boolean          @default(true)
  sortOrder      Int              @default(0)
  /// The admin who last wrote the row (their id).
  updatedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  purchases StorePurchase[]

  @@unique([platform, storeProductId])
  @@index([platform, active, sortOrder])
}

/// A store's switch (IAP-01): whether the Hub takes purchases from that store
/// at all, and the store's cut in basis points (1500 = 15%) a purchase
/// records when it is made. A missing row means on, with the config's cut.
model StorePlatformSetting {
  platform    StorePlatform @id
  enabled     Boolean       @default(true)
  /// Null means the config's `STORE_FEE_BPS_*` (default 1500).
  storeFeeBps Int?
  updatedBy   String?
  updatedAt   DateTime      @updatedAt
}

/// One store transaction, granted once (IAP-01, R-86). `storeTransactionId` is
/// the store's own id for it (Apple's transactionId; Google's orderId, which a
/// renewal changes; the purchase token for a one-time product with no order
/// id): unique with the platform, so a replay, a restore and a webhook that
/// races the app can each ask and only the first grants. `subscriptionKey`
/// ties the renewals of one subscription together (Apple's
/// originalTransactionId; Google's first purchase token).
model StorePurchase {
  id                 String              @id @default(uuid())
  wawuUserId         String
  platform           StorePlatform
  storeTransactionId String
  subscriptionKey    String?
  productId          String
  product            StoreProduct        @relation(fields: [productId], references: [id], onDelete: Restrict)
  storeProductId     String
  kind               StoreProductKind
  status             StorePurchaseStatus @default(granted)
  /// `production` or `sandbox`, as the store said.
  environment        String
  /// The room a pass was bought for.
  communityId        String?
  /// What was granted, as written when it was: the take-back reads this and
  /// never the product map, which may have changed since.
  grant              Json
  /// What the product was worth before the store's share, the store's cut in
  /// basis points as it stood then, and what is left (the 85/15 split base).
  referenceKobo      Int?
  storeFeeBps        Int
  netKobo            Int?
  /// The room's host and their 85% of `netKobo`, for a pass. Recorded here;
  /// paying it needs WAWU's store proceeds in the merchant account (BACKEND_GAPS).
  creatorWawuUserId  String?
  creatorShareKobo   Int?
  /// What the store charged, in the buyer's own currency (display only).
  currency           String?
  priceMicros        BigInt?
  purchasedAt        DateTime
  /// When a subscription period ends, as the store last said.
  expiresAt          DateTime?
  endedAt            DateTime?
  endReason          String?
  /// What the take-back actually took (a spent point is not taken back).
  takenBack          Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([platform, storeTransactionId])
  @@index([wawuUserId, createdAt])
  @@index([platform, subscriptionKey])
  @@index([status, createdAt])
  @@index([productId])
}

/// A store notification, kept once (IAP-01): Google's Pub/Sub message id or
/// Apple's notificationUUID, unique with the platform, so a redelivery is
/// answered and not acted on twice. `outcome` says what the Hub did.
model StoreNotification {
  id         String        @id @default(uuid())
  platform   StorePlatform
  externalId String
  kind       String
  outcome    String
  receivedAt DateTime      @default(now())

  @@unique([platform, externalId])
  @@index([receivedAt])
}

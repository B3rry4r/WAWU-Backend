/// FREE — mentors volunteer their time, no payment step (product-truths.json,
/// per registry note). `status` left as plain String — no enumerated value
/// set given in the registry.
model MentorRequest {
  id              String   @id @default(uuid())
  mentorId        String
  mentor          Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  requesterWawuId String
  topics          String[]
  note            String
  slot            String
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@index([mentorId])
  @@index([requesterWawuId])
}


model DataExportRequest {
  id          String   @id @default(uuid())
  userWawuId  String
  status      String   @default("pending")
  requestedAt DateTime @default(now())

  @@index([userWawuId])
}

// ---------------------------------------------------------------------------
// Lifestyle Services — WAWUPay (bills), WAWUCare (health), WAWU Legal.
//
// All three follow the same shape: the user pays WAWU through Flutterwave
// checkout, the server verifies that payment, and only then does WAWU call the
// partner to fulfil. Fulfilment is therefore a second step that can fail on its
// own, which is why every one of these carries a status separate from the
// payment and keeps the provider's own reference for reconciliation.
// ---------------------------------------------------------------------------

/// Payment taken, fulfilment still owed. `paid` means WAWU has the money but
/// the partner has not called the biller yet. `processing` means the biller
/// ACCEPTED the request — Flutterwave's Bills API confirms receipt
/// synchronously but settles the actual top-up asynchronously, so acceptance
/// is not proof of delivery and must not be recorded as one. A row is a
/// refund candidate the moment it reaches `paid`, and stays one all the way
/// through `processing` until it resolves to `delivered` or `failed`.
enum FulfilmentStatus {
  pending
  paid
  processing
  delivered
  failed
  refunded
}

/// WAWUPay. One row per bill the user pays through Flutterwave's Bills API.
model BillPayment {
  id          String @id @default(uuid())
  buyerWawuId String
  /// Flutterwave bill category slug (AIRTIME, DATA_BUNDLE, POWER, CABLEBILLS…).
  category    String
  billerCode  String
  itemCode    String
  billerName  String
  /// Phone number, meter number or smartcard number, depending on the biller.
  customerRef String
  amount      Int
  fee         Int    @default(0)

  /// The user's card payment to WAWU.
  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  /// Flutterwave's reference for the bill we then paid on their behalf.
  providerReference String?
  providerStatus    String?
  failureReason     String?

  status      FulfilmentStatus @default(pending)
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?

  /// Set only by the operator refund endpoint, which RECORDS a refund that was
  /// actually paid back to the customer by hand. Nothing in this codebase can
  /// move money back to a card — there is no Flutterwave refund adapter — so
  /// `refundReference` is the real-world reference of that manual refund and
  /// `status = refunded` is never written without one.
  refundReference String?
  refundedAt      DateTime?

  @@index([buyerWawuId])
  @@index([status])
  @@index([status, createdAt])
}

/// WAWUCare. A WellaHealth (Zoi) health plan subscription bought in-app.
model HealthSubscription {
  id         String @id @default(uuid())
  wawuUserId String

  planCode String
  planName String
  price    Int

  /// WellaHealth keys the enrollee on phone number, so it is required here.
  phoneNumber String
  firstName   String
  lastName    String
  gender      String
  dateOfBirth String
  email       String?

  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  policyNumber      String?
  providerReference String?
  failureReason     String?

  status    FulfilmentStatus @default(pending)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime         @default(now())

  /// Same contract as BillPayment: written only when a human has actually
  /// refunded the customer, and never without the reference of that refund.
  refundReference String?
  refundedAt      DateTime?

  @@index([wawuUserId])
  @@index([status])
}

/// WAWU Legal routes on this. `simple` is form-in, document-out with no lawyer
/// in the loop; `consultation` requires a paid consultation before WAWU can
/// even quote the work.
enum LegalPath {
  simple
  consultation
}

enum ConsultationMedium {
  chat
  zoom
  physical
}

/// The full lifecycle of a legal request. A `simple` request skips straight
/// from awaiting_payment to in_progress; a `consultation` one walks the whole
/// ladder, and can never reach in_progress without a signed contract.
enum LegalRequestStatus {
  draft
  /// Submitted, price to be agreed. Simple services whose fee WAWU sets after
  /// looking at the request rather than off a price list.
  awaiting_quote
  awaiting_consultation_payment
  consultation_scheduled
  consultation_done
  quoted
  contract_signed
  awaiting_service_payment
  in_progress
  delivered
  cancelled
}

model LegalRequest {
  id          String             @id @default(uuid())
  wawuUserId  String
  serviceCode String
  serviceName String
  category    String
  path        LegalPath
  status      LegalRequestStatus @default(draft)

  /// Whatever the service's intake form collected.
  details   Json?
  documents String[] @default([])

  consultationMedium ConsultationMedium?
  consultationFee    Int?
  consultationTxRef  String?             @unique
  consultationPaidAt DateTime?
  scheduledFor       DateTime?
  consultationNotes  String?

  /// What WAWU quotes after the consultation.
  quoteAmount Int?
  quoteNote   String?

  /// Signing is a liability record, so it keeps the exact text agreed to
  /// rather than a pointer to a template that may later change.
  contractText     String?
  contractSignedAs String?
  contractSignedAt DateTime?
  contractSignedIp String?

  serviceTxRef   String?   @unique
  servicePaidAt  DateTime?
  deliverableUrl String?
  deliveredAt    DateTime?

  /// Why WAWU closed the matter without delivering it. Required by the ops
  /// cancel endpoint, because "cancelled" with no reason is what strands a
  /// client who has already paid. It does NOT imply a refund: money already
  /// taken is refunded by hand, and nothing here claims otherwise.
  cancellationReason String?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wawuUserId])
  @@index([status])
  @@index([serviceCode])
}

// -----------------------------------------------------------------------------
// Admin identity (admin-surface-extension Phase 5) — ADDITIVE ONLY
//
// This is the first admin identity this backend has ever had. It is
// deliberately a table of its own rather than a role on any existing row:
// user identity lives in WAWU ID (SSO) and this backend has no local User
// table at all, so there is nothing to hang an `isAdmin` flag off even if we
// wanted to — and we do not. An operator account and a customer account are
// different things with different lifecycles, different credentials and
// different blast radius.
//
// Nothing above this line is touched by the migration that introduces these
// two enums and this table.
// -----------------------------------------------------------------------------

/// Operator sub-roles. See src/admin/auth/admin-auth.module.ts for the
/// capability matrix these map to — the matrix is the contract every later
/// admin resource gates against.
enum AdminRole {
  superadmin
  reviewer
  support
  finance
}

enum AdminUserStatus {
  active
  suspended
}

model AdminUser {
  id           String          @id @default(uuid())
  email        String          @unique
  /// argon2id. Never selected into any response — every read goes through
  /// toAdminUserView() in src/admin/auth/admin-user-view.type.ts.
  passwordHash String
  name         String
  role         AdminRole
  status       AdminUserStatus @default(active)

  /// Bumped to revoke every outstanding token for this admin without a
  /// session table: the value is stamped into both the access and the
  /// refresh token and re-checked on every request.
  tokenVersion Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([role])
  @@index([status])
}

enum AdminContentDecision {
  approved
  rejected
  /// A LIVE (or any non-removed) piece taken down by a moderator outside the
  /// pending-review flow — e.g. a creator's account was deleted before this
  /// backend removed content at deletion time, and the piece was left
  /// stranded live with nobody left to have rejected it from `pending`.
  removed
}

/// Moderation audit trail for ContentPiece — admin-surface-extension Phase 6.
///
/// A SIDE TABLE, not columns on ContentPiece, and that is not a style
/// preference: protected-surface hazard H-1 records that 28 of 39 wire types
/// in src/common/types are bare re-exports of their Prisma model returned by
/// spread, so a `moderationReason` column on ContentPiece would appear
/// verbatim in the shipped app's content responses the moment it existed.
///
/// No FK to ContentPiece or AdminUser, matching the idiom every
/// cross-boundary reference in this schema already uses (KycSubmission
/// .wawuUserId, Purchase.buyerWawuId): a relation field would have to be
/// added to the ContentPiece model block, and an audit row must outlive the
/// thing it audits anyway. Reviewer email and role are SNAPSHOTS for the same
/// reason — "who approved this" has to stay answerable after that admin is
/// renamed, suspended, or deleted.
model AdminContentReview {
  id            String @id @default(uuid())
  contentId     String
  /// Snapshot: which creator this decision landed on.
  creatorWawuId String

  decision       AdminContentDecision
  /// The status the piece held immediately before this decision, and the one
  /// written by it. Stored rather than inferred so the trail still reads
  /// correctly after a later decision moves the piece again.
  previousStatus ContentStatus
  newStatus      ContentStatus
  /// Required on a rejection (enforced in the DTO + service), null on approval.
  reason         String?
  /// Whether this decision handed the creator's upload slot back
  /// (CreatorState.slotsUsed decrement). Recorded per row so a slot ledger can
  /// be reconstructed from the audit trail alone.
  slotReturned   Boolean              @default(false)

  reviewedByAdminId    String
  reviewedByAdminEmail String
  reviewedByAdminRole  AdminRole
  reviewedAt           DateTime  @default(now())

  @@index([contentId])
  @@index([reviewedByAdminId])
  @@index([reviewedAt])
}

enum AdminKycAction {
  document_viewed
  identifiers_revealed
  approved
  rejected
}

/// Audit trail for the admin KYC-review surface — admin-surface-extension
/// Phase 6.
///
/// A SIDE TABLE for the same reason AdminContentReview is one: protected-
/// surface hazard H-1 records that 28 of 39 wire types in src/common/types
/// are bare re-exports of their Prisma model returned by spread, so a
/// `reviewedByAdminId` column on KycSubmission would appear verbatim in the
/// shipped app's `GET /kyc` response the moment it existed — and that
/// response goes to the creator, who has no business seeing which reviewer
/// looked at their file.
///
/// Unlike AdminContentReview this table records READS as well as decisions,
/// because a read here is a disclosure: `document_viewed` is someone opening
/// a government ID, and `identifiers_revealed` is someone unmasking a BVN,
/// NIN or payout account number. Those are the rows a breach investigation
/// needs, and they are exactly the ones a decision-only trail would not have.
/// `previousStatus` / `newStatus` / `reason` are therefore null on a read row.
///
/// No FK to KycSubmission or AdminUser, matching every cross-boundary
/// reference in this schema (KycSubmission.wawuUserId, Purchase.buyerWawuId).
/// Reviewer email and role are SNAPSHOTS: "who opened this ID" must stay
/// answerable after that admin is renamed, suspended, or deleted.
///
/// The signed URL itself is NEVER stored here. It is a bearer token for a
/// government ID; the audit records that a fetch happened, never the means to
/// repeat it.
model AdminKycAudit {
  id                String @id @default(uuid())
  submissionId      String
  /// Snapshot of whose earning gate this action touched.
  subjectWawuUserId String

  action         AdminKycAction
  /// Both null unless this row is a decision — a view or a reveal moves
  /// nothing. Stored rather than inferred so the trail still reads correctly
  /// after a later resubmission moves the creator on.
  previousStatus ReviewStatus?
  newStatus      ReviewStatus?
  /// Required on a rejection (enforced in the DTO and again by the existing
  /// KycSubmissionService.review); null on every other action.
  reason         String?

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([submissionId])
  @@index([subjectWawuUserId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

enum AdminVerificationAction {
  document_viewed
  approved
  rejected
}

/// Audit trail for the admin verification-TIER review surface —
/// admin-surface-extension Phase 6.
///
/// A SEPARATE table from AdminKycAudit, deliberately, and not a shared
/// "review audit" with a resource discriminator. CLAUDE.md's non-negotiables
/// and the derived-surface guardrails both say the earning gate (KYC) and the
/// public trust badge (this ladder) are two independent systems, and this has
/// already shipped as a bug once — the app described "Government ID submitted
/// and approved by hand" on a rung of this ladder. One table would put a BVN
/// disclosure and a business-certificate view in the same query, which is how
/// the two get conflated again.
///
/// There is no `identifiers_revealed` action here because this resource holds
/// no identifiers to reveal: a VerificationSubmission is a tier and a list of
/// document keys, nothing more.
model AdminVerificationAudit {
  id                String           @id @default(uuid())
  submissionId      String
  /// Snapshot of whose badge this action touched.
  subjectWawuUserId String
  /// Snapshot of the rung applied for. Stored because the row it describes is
  /// history the moment a later submission supersedes it.
  tier              VerificationTier

  action               AdminVerificationAction
  previousStatus       ReviewStatus?
  newStatus            ReviewStatus?
  reason               String?
  /// Which entry of VerificationSubmission.documents was fetched. Null on a
  /// decision row.
  documentIndex        Int?
  /// True only on an approval that actually reached WAWU ID. The existing
  /// VerificationSubmissionService elevates the tier BEFORE writing the local
  /// approval precisely so a failed callback leaves the submission pending and
  /// retryable — so an approval row can only exist once the elevation
  /// succeeded, and recording it makes that ordering auditable rather than
  /// merely commented.
  tierElevatedAtWawuId Boolean                 @default(false)

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([submissionId])
  @@index([subjectWawuUserId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

/// Inbound Flutterwave webhook deliveries — audit trail AND the exactly-once
/// claim for settlement driven by the provider rather than by the browser.
///
/// A NEW table on purpose. 28 of the 39 wire types are bare Prisma re-exports
/// returned by spread, so adding a column to Purchase / PendingCharge /
/// BillPayment to track webhook state would silently widen a live app
/// response. Nothing here is ever returned to the app.
model PaymentWebhookReceipt {
  id String @id @default(uuid())

  /// `${event}:${txRef}` — one settlement attempt per event per charge.
  /// UNIQUE, and the atomic `create` against it IS the claim: a duplicate
  /// delivery loses the insert race (P2002) and never reaches settlement.
  deliveryKey String @unique

  /// Flutterwave's event name, e.g. `charge.completed`.
  event         String
  /// The `tx_ref` this backend issued when the charge was opened.
  txRef         String
  /// Flutterwave's own transaction id from the payload. Only ever used as the
  /// id to re-verify AGAINST Flutterwave — never as proof of anything.
  transactionId String?

  /// received | settled | rejected | unmatched | ignored | failed.
  /// `received` and `failed` are non-terminal: a redelivery may reclaim them
  /// so a transient outage cannot permanently swallow a real payment.
  status String @default("received")

  /// Which money flow the tx_ref resolved to (`tip`, `credit-purchase`,
  /// `subscription`, `dm`, `bill`, `health`, `legal-consultation`, …).
  flow   String?
  /// Why it ended where it did — refusal reason, biller error, etc.
  detail String?

  /// The raw body as delivered, kept for reconciliation with Flutterwave.
  payload Json

  receivedAt DateTime  @default(now())
  settledAt  DateTime?

  @@index([txRef])
  @@index([status])
  @@index([receivedAt])
}

/// Which operator surface an AdminOpsAudit row belongs to.
enum AdminOpsResource {
  legal_request
  service_application
  bill_payment
  health_subscription
}

/// Every consequential ops action that used to be anonymous behind
/// AdminKeyGuard, named for what it did rather than for the route that did it.
enum AdminOpsAction {
  legal_quoted
  legal_consultation_completed
  legal_delivered
  legal_cancelled
  application_progressed
  application_rejected
  application_approved
  /// The one READ that is audited on this surface. GET
  /// /services/ops/applications/:id hands an operator another person's
  /// uploaded ID, signature and passport photograph (see
  /// ServiceApplication.documents) plus the business details they typed —
  /// which is precisely what AdminKycAudit's `document_viewed` exists for.
  /// The QUEUE read is not audited: it carries no document URL and no
  /// intake answers, so it discloses nothing beyond "this person has an
  /// application", the same as the legal and bills queue reads.
  application_documents_viewed
  bill_reconciled
  bill_refund_recorded
  care_enrolment_retried
  care_refund_recorded
}

/// Attribution for the operator surfaces that moved from AdminKeyGuard onto
/// the real admin identity — WAWU Legal, ServiceApplication, WAWUPay and
/// WAWUCare.
///
/// A SIDE TABLE, for the same reason AdminContentReview and AdminKycAudit are
/// side tables: protected-surface hazard H-1 records that most wire types in
/// src/common/types are bare Prisma re-exports returned by spread, so an
/// `actedByAdminId` column on LegalRequest, ServiceApplication, BillPayment or
/// HealthSubscription would appear verbatim in a live app response the moment
/// it existed. A client looking at their own legal matter has no business
/// seeing which WAWU staff member priced or cancelled it.
///
/// ONE table across four resources rather than four tables, and that is a
/// departure from AdminContentReview / AdminKycAudit. Those two carry
/// resource-specific TYPED columns (ContentStatus transitions, a slot-return
/// flag, an AdminKycAction) that only make sense for their own entity. These
/// eleven handlers share exactly one shape — "an admin did a named thing to
/// one row, and here is what changed" — so four near-identical tables would be
/// four places to look for one question ("what has this admin done?").
///
/// `detail` is the per-action payload as JSON rather than as columns: a quote
/// amount, a cancellation reason, a refund reference and a provider status are
/// not the same field, and inventing a nullable column for each would make the
/// table wider than the four it replaces.
///
/// No FK to the audited row or to AdminUser, matching every cross-boundary
/// reference in this schema (KycSubmission.wawuUserId, Purchase.buyerWawuId).
/// Admin email and role are SNAPSHOTS: "who cancelled this ₦120,000 matter"
/// has to stay answerable after that admin is renamed, suspended or deleted.
model AdminOpsAudit {
  id            String           @id @default(uuid())
  resource      AdminOpsResource
  resourceId    String
  /// Snapshot of whose money or matter this action touched. Empty string only
  /// where the audited row genuinely has no owner.
  subjectWawuId String

  action AdminOpsAction
  /// What actually changed — the quote amount, the refund reference, the new
  /// status. Shape varies by `action`; see src/common/audit.
  detail Json?

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([resource, resourceId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

// -----------------------------------------------------------------------------
// Events — reinstated 22 Aug 2026 by product-owner decision.
//
// WAWU-Web/CLAUDE.md and docs/00_PLATFORM_MAP.md previously listed Events under
// what was cut. Both documents have been amended with today's date to record
// the reversal rather than leaving them contradicting this schema.
//
// ── THE LINE THAT DOES NOT MOVE ──────────────────────────────────────────────
// What the spec cut was event TICKETS, and that stays cut. There is no price
// column, no currency, no ticket, no purchase, no payment reference, no revenue
// split and no credit cost anywhere in the three tables below, and none may be
// added. "Going" is an INTEREST SIGNAL: a row exists or it does not.
// Registration, if the organiser sells one at all, happens on their own site
// behind `Event.externalUrl` — off this platform, off this schema, and no money
// crosses this backend for it. That is precisely why reinstating Events is
// low-risk, so anything that starts to look like ticketing is a spec conflict
// (CLAUDE.md: "If a task conflicts with docs/01_SPEC.md, the spec wins").
//
// ── WHY THREE NEW TABLES AND NOT ONE COLUMN ANYWHERE ELSE ────────────────────
// Same reason AdminContentReview is a side table: protected-surface hazard H-1
// — most wire types in src/common/types are bare re-exports of their Prisma
// model returned by spread, so a new column on an EXISTING table silently
// widens a live app response. Everything here is new tables, and every wire
// shape is a DECLARED view in src/event/event-view.type.ts and
// src/admin/events/admin-event-view.type.ts. Nothing re-exports these models.
// -----------------------------------------------------------------------------

/// In-Person / Online in the UI. Hybrid is deliberately absent: the old admin
/// screen offered it, the old public filter chips never did, so an event
/// created as Hybrid was unreachable by every filter a user could tap.
enum EventFormat {
  in_person
  online
}

/// Exactly the five the public filter row offers (old EVENT_FILTERS, minus the
/// two format chips and the "All" chip). A sixth kind would be a chip nobody
/// can tap, i.e. an event nobody can find.
enum EventType {
  workshop
  summit
  webinar
  meetup
  competition
}

/// Every state here has an exit, and that is a hard requirement rather than a
/// nicety — a `pending` row no endpoint can move is the worst bug this
/// codebase has shipped (see AdminContentReview's header).
///
///   pending   -> published   POST /admin/events/:id/approve
///   pending   -> rejected    POST /admin/events/:id/reject   (reason required)
///   rejected  -> pending     PATCH /events/:id               (host resubmits)
///   published -> pending     PATCH /events/:id               (host edits; see below)
///   published -> removed     POST /admin/events/:id/remove   (reason required)
///   removed   -> published   POST /admin/events/:id/restore
///
/// A host's edit ALWAYS returns the event to `pending`. One rule, no tiers of
/// "material" versus "cosmetic" fields: a two-tier policy is a bypass waiting
/// to be found (submit something benign, get approved, edit it into whatever
/// you actually wanted). `removed` is the one status a host cannot edit out
/// of — a takedown is an admin decision, and its exit is an admin restore.
enum EventStatus {
  pending
  published
  rejected
  removed
  /// Called off by the organiser after publication. Every ticket is voided
  /// and every order refunded; the event stays readable so a ticket holder
  /// can see what happened to the thing they paid for.
  cancelled
}

/// A user-submitted event. Created `pending`; invisible on every public read
/// until an admin approves it.
///
/// `hostWawuId` is the submitting WAWU ID user — a plain indexed String, never
/// a relation, exactly as every other cross-boundary reference in this schema.
/// Creation is NOT gated on the paid creator subscription: an event costs no
/// upload slot and earns nobody anything, so the moderation queue is the only
/// gate it needs.
model Event {
  id         String @id @default(uuid())
  hostWawuId String

  name        String
  description String
  /// The organisation running it ("org" in the old EventItem), and its blurb.
  hostOrg     String
  hostOrgBio  String?

  format EventFormat
  type   EventType

  /// The authoritative instant, and the only thing upcoming/past is decided
  /// on. The old shape stored month/day/dow as pre-rendered strings, which
  /// made "is this event over" unanswerable in SQL.
  startsAt  DateTime
  endsAt    DateTime?
  /// Host-supplied DISPLAY strings — "10:00 AM", "WAT". Deliberately not
  /// derived from `startsAt` server-side: rendering a local time needs the
  /// event's own zone, and guessing it in UTC is how a 9am Lagos workshop
  /// becomes an 8am one on every card.
  timeLabel String?
  timezone  String?

  /// City or venue name (always shown), and the street address (detail only).
  location String
  address  String?

  /// The VENUE, by name — "Eko Convention Centre". Separate from `location`,
  /// which conflated two facts: the card renders "Concert • Abuja" (category
  /// and city) while the hero renders the venue under a pin, and one column
  /// cannot be both. Nullable, because an online event has no venue and every
  /// event created before this column has only ever had `location`. A client
  /// with nothing here shows `location`, exactly as it did before.
  venueName String?

  /// The organiser's own page. Registration — including any paid registration
  /// the organiser runs — lives THERE, never here. This backend takes no
  /// money for an event.
  externalUrl String?

  /// Past-event recap, written by the host after the fact. `hasRecap` on the
  /// wire is derived from these, matching the old EventItem.recap boolean.
  recapUrl  String?
  recapText String?

  /// Admin-controlled pin. A host cannot set it — POST /admin/events/:id/feature
  /// is the only writer, and a takedown clears it (a featured-but-removed
  /// event is a rail pointing at a 404).
  featured Boolean     @default(false)
  status   EventStatus @default(pending)

  /// Why the last rejection or takedown happened, denormalised from the audit
  /// trail so the host's own GET /events/mine can show it without reading an
  /// admin table. The trail in AdminEventReview stays authoritative.
  lastDecisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  speakers EventSpeaker[]
  going    EventGoing[]
  saves    EventSave[]

  /// Ticketing. An event with no ticket types is exactly the free,
  /// interest-only event this table held before ticketing existed — the
  /// "Going" signal still works and nothing is charged.
  ticketTypes EventTicketType[]
  orders      EventOrder[]
  tickets     EventTicket[]
  referrals   EventReferral[]

  /// Banner image. Object-storage URL from POST /uploads/presign.
  bannerUrl    String?
  /// What the event is ABOUT, as the Events section filters on.
  category     EventCategory @default(other)
  /// How to reach the organiser. Shown on the public page.
  contactEmail String?
  contactPhone String?

  /// Set when an organiser calls off a published event. Distinct from
  /// `removed`, which is a takedown by an admin: a cancellation refunds every
  /// ticket sold and the record stays visible to the people who bought one.
  cancelledAt  DateTime?
  cancelReason String?

  @@index([hostWawuId])
  @@index([status])
  /// The public list is always "published, ordered by when it starts".
  @@index([status, startsAt])
  @@index([status, featured])
  @@index([format])
  @@index([type])
}

/// A billed speaker on an event. A child table rather than a Json column, the
/// same shape CourseLesson has under ContentPiece, so the rows validate and
/// order like anything else here. Initials are derived on the wire from
/// `name`; storing them would be a second definition of the same fact.
model EventSpeaker {
  id       String  @id @default(uuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  title    String?
  /// Object-storage URL from POST /uploads/presign (folder "event/speaker").
  /// Optional — a speaker with no photo still renders, as initials.
  photoUrl String?
  order    Int

  @@index([eventId])
}

/// The interest signal, and NOT a ticket. One row per (event, user): the
/// unique constraint is the idempotency, so POSTing "going" ten times is the
/// same one signal, and DELETE withdraws it. No amount, no status, no
/// reference — there is nothing to pay for.
model EventGoing {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userWawuId String
  markedAt   DateTime @default(now())

  @@unique([eventId, userWawuId])
  @@index([eventId])
  @@index([userWawuId])
}

/// The bookmark on an event card, and NOT a second "Going".
///
/// The two answer different questions and a screen shows both at once: the
/// ribbon in the corner of the hero is "keep this for me to look at", the
/// heart under a card is the same bookmark on the same event, and "Going" is
/// a public interest signal that appears in the organiser's count. Folding
/// the bookmark into EventGoing would make saving an event for later
/// indistinguishable from telling the organiser you are coming.
///
/// Shaped exactly like EventGoing on purpose — one row per (event, user),
/// the unique constraint IS the idempotency, and a DELETE that matches
/// nothing is still the correct end state. Private: nothing publishes who
/// saved what, and the only count on the wire is the caller's own boolean.
model EventSave {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userWawuId String
  savedAt    DateTime @default(now())

  @@unique([eventId, userWawuId])
  @@index([eventId])
  @@index([userWawuId])
}

enum AdminEventAction {
  approved
  rejected
  featured
  unfeatured
  removed
  restored
}

/// Moderation audit trail for Event — the same side-table idiom as
/// AdminContentReview, deliberately not a second moderation idiom.
///
/// No FK to Event or AdminUser: an audit row has to outlive the thing it
/// audits, and every cross-boundary reference in this schema is already a
/// plain String. Admin email and role are SNAPSHOTS so "who took this event
/// down" stays answerable after that admin is renamed or deleted. Both the
/// status and the featured flag are recorded before/after, because
/// feature/unfeature changes no status and would otherwise leave an audit row
/// that appears to have done nothing.
model AdminEventReview {
  id         String @id @default(uuid())
  eventId    String
  /// Snapshot: whose event this decision landed on.
  hostWawuId String

  action           AdminEventAction
  previousStatus   EventStatus
  newStatus        EventStatus
  previousFeatured Boolean
  newFeatured      Boolean
  /// Required on `rejected` and `removed` (enforced in the DTO and again in
  /// the service); null on the others. The host is shown it.
  reason           String?

  reviewedByAdminId    String
  reviewedByAdminEmail String
  reviewedByAdminRole  AdminRole
  reviewedAt           DateTime  @default(now())

  @@index([eventId])
  @@index([reviewedByAdminId])
  @@index([reviewedAt])
}

// -----------------------------------------------------------------------------
// Professional profiles
// -----------------------------------------------------------------------------

/// What a professional is offering their credential as evidence OF.
///
/// The split is the whole point. Legal, health, finance and insurance have a
/// body that issues a licence and can be rung up to confirm it. Technology,
/// beauty and most other categories have no such body, and demanding a
/// licence there would mean reviewers either reject everyone in tech for
/// lacking a document that does not exist, or wave anyone through. So the
/// evidence a reviewer is looking for is recorded per application.
enum ProfessionalCredentialKind {
  /// A practising licence from a named issuing body. Required in a regulated
  /// category, and the reviewer's job is to confirm it with that body.
  licence
  /// A qualification or certification with no licensing regime behind it.
  qualification
  /// Work history and samples. The reviewer is exercising judgment, not
  /// checking a register — only ever acceptable outside regulated categories.
  portfolio
}

/// A creator's application to be listed as a professional in ONE category,
/// and once approved, the listing itself.
///
/// Per category, deliberately: a licence is field-specific, and a certified
/// nurse must not surface under Legal Services. The verification ladder's
/// `certified_professional` rung is global and answers "is this person a
/// qualified professional at all" — this answers "at WHAT", which is the
/// question a buyer browsing a category is actually asking.
///
/// Contact runs through paid DMs. There is no booking, no scheduling, no
/// escrow and no invoicing here: the conversation starts on WAWU and the
/// engagement itself is arranged between the two people. That keeps this a
/// directory plus a paid introduction rather than a marketplace holding money
/// against delivered professional work, which is a different product with
/// different obligations.
model ProfessionalProfile {
  id         String @id @default(uuid())
  wawuUserId String
  /// An explore category id (`legal_services`, `technology`, …). Not an enum:
  /// the taxonomy is app-defined and moves without a migration.
  category   String

  /// "Corporate lawyer, 11 years" — the one line under their name.
  headline String
  /// What they actually do, in their own words.
  about    String
  /// Discrete things they will take on. Shown as chips on the card.
  services String[] @default([])

  credentialKind ProfessionalCredentialKind
  /// Required when the category is regulated; enforced in the DTO, which owns
  /// the regulated list, not the database.
  licenceNumber  String?
  issuingBody    String?
  /// Object-storage URLs from POST /uploads/presign.
  documents      String[]                   @default([])

  status          ReviewStatus @default(pending)
  rejectionReason String?
  submittedAt     DateTime     @default(now())
  reviewedAt      DateTime?

  /// Hidden from the directory without deleting the record — a professional
  /// who is too busy to take work, or one an admin has pulled. Distinct from
  /// `status`: this is availability, that is whether they were ever approved.
  listed Boolean @default(true)

  reviews ProfessionalReview[]

  /// One application per person per category. A rejected application is
  /// edited and resubmitted in place rather than piling up duplicates, which
  /// is also what stops someone spamming a queue a human has to work.
  @@unique([wawuUserId, category])
  @@index([category, status])
  @@index([status])
}

/// One client's rating of one professional listing.
///
/// The directory card draws stars and a review count next to a Book button,
/// and those two numbers are the whole reason somebody picks one lawyer over
/// another. So they come from rows, aggregated on read. There is no
/// `ratingAvg` column on ProfessionalProfile, deliberately: a stored average
/// is a second definition of the same fact, and a bare float that nothing
/// writes is how "4.8" ends up under every name on the platform.
///
/// WHO MAY WRITE ONE. The engagement itself happens off WAWU — this backend
/// takes no money for professional work and holds no booking. What it does
/// hold is the paid introduction: DirectMessage records that a client paid to
/// message this person and whether that person replied. So a review requires
/// a DM from the author to the professional that the professional RESPONDED
/// to. That is a real, checkable relationship, it costs money to manufacture,
/// and it excludes both the person who never made contact and the one whose
/// message was ignored and refunded.
///
/// Per LISTING, not per person. Someone listed in two categories is being
/// judged on two different pieces of work, and a review of their legal advice
/// does not transfer to their photography.
model ProfessionalReview {
  id             String              @id @default(uuid())
  professionalId String
  professional   ProfessionalProfile @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  authorWawuId   String
  /// 1 to 5. Bounded in the DTO, not by a CHECK constraint: an out-of-range
  /// value has to come back as an explained 400, not as a database error the
  /// API cannot translate for the person who typed it.
  stars          Int
  body           String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([professionalId, authorWawuId])
  @@index([professionalId])
  @@index([authorWawuId])
}

// -----------------------------------------------------------------------------
// Legal intake — profiling before anybody talks about money
// -----------------------------------------------------------------------------

enum LegalIntakeStatus {
  in_progress
  completed
  /// Turned into a LegalRequest. Kept rather than deleted: the brief is what
  /// the consultant read before the first message, and "what did we know when
  /// we advised" is a question that gets asked after things go wrong.
  converted
}

/// One person's answers to the legal profiling questions, and the brief those
/// answers produce.
///
/// The point of this table is ORDER. Before it, a client picked a service and
/// was quoted a consultation fee, so the first thing WAWU said to somebody
/// with a legal problem was a price. Now the profiling happens first, the
/// consultant reads a brief before the conversation starts, and the client
/// does not repeat their story to a human who has not been told it.
///
/// `answers` is Json because the question set is adaptive — a debt-recovery
/// intake and a trademark intake genuinely do not collect the same fields, and
/// modelling fourteen matter types as columns would be a table of nulls. The
/// SHAPE is not freeform though: every key is a question id from
/// legal-intake-questions.ts, and the service validates against it.
model LegalIntake {
  id         String            @id @default(uuid())
  wawuUserId String
  /// One of the fourteen matter types the first question offers. Not a
  /// catalogue service code — that is resolved when the request is created,
  /// because "Contract Drafting / Review" is one thing to a client and two
  /// priced services to operations.
  matter     String
  status     LegalIntakeStatus @default(in_progress)

  /// Question id -> answer. Answers are strings, string arrays, or null for a
  /// question the person chose to skip.
  answers   Json     @default("{}")
  /// Object-storage URLs for anything they attached.
  documents String[] @default([])

  /// The consultant-facing brief, assembled on completion. Stored rather than
  /// recomputed so it cannot drift from what the consultant actually read.
  brief Json?

  /// Set when this intake becomes a real request.
  legalRequestId String? @unique

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([wawuUserId, status])
  @@index([status, completedAt])
}

/// Who said it.
enum LegalChatAuthor {
  client
  /// Gemini, answering before a human joins. Labelled as such in every
  /// surface — a client must always know whether they are reading a lawyer.
  ai
  /// A WAWU Legal consultant, from the dashboard.
  consultant
}

/// One message in the conversation attached to a legal matter.
///
/// The conversation runs in ONE thread across the handover: the AI opens it
/// after the client has paid for their consultation, works through what the
/// brief left unclear, and a consultant then continues in the same place. The
/// client is not moved to a different screen and does not repeat themselves,
/// which is the entire point of profiling first.
///
/// `authorRole` is never inferred at render time. A message a model wrote is
/// stored as having been written by a model, permanently, because "was this
/// legal advice from a person" is a question that gets asked long afterwards
/// and the answer has to come from the record rather than from styling.
model LegalChatMessage {
  id             String          @id @default(uuid())
  legalRequestId String
  authorRole     LegalChatAuthor
  /// The admin id, when a consultant wrote it. Null for client and AI.
  authorAdminId  String?
  body           String
  createdAt      DateTime        @default(now())

  @@index([legalRequestId, createdAt])
}

// -----------------------------------------------------------------------------
// Event ticketing
// -----------------------------------------------------------------------------

/// The ten categories the Events section filters by. Distinct from
/// `EventType` (workshop/summit/webinar/meetup/competition), which describes
/// the FORMAT of a gathering; this describes its subject. Both are kept:
/// "a music summit" and "a fashion meetup" are different facts.
enum EventCategory {
  music
  business
  training
  conference
  church
  entertainment
  fashion
  community
  lifestyle
  other
}

/// Ticket tiers an organiser may offer. A closed set rather than free text so
/// the buyer-facing sort order is stable and a typo cannot create a tier
/// nobody can filter.
enum TicketTier {
  regular
  vip
  vvip
  early_bird
  group
  free
}

/// Where an order's MONEY is. Deliberately not merged with ticket status: an
/// order is paid or not, while each ticket inside it is separately valid,
/// checked in or void.
enum EventOrderStatus {
  /// Charge opened, nothing collected yet.
  pending
  paid
  /// The buyer has been refunded — organiser cancellation, or a manual one.
  refunded
  failed
}

/// Where one ticket IS. A refunded order voids its tickets; a checked-in
/// ticket cannot be checked in twice.
enum EventTicketStatus {
  valid
  checked_in
  /// The event was cancelled or the order refunded. Cannot be scanned in.
  void
}

/// One priced tier on one event.
///
/// `sold` is a stored counter rather than a count of rows, because it is read
/// on every page view of a popular event and incremented inside the purchase
/// transaction — a COUNT over tickets would be both slower and racier at
/// exactly the moment it matters, which is two people buying the last seat.
model EventTicketType {
  id           String     @id @default(uuid())
  eventId      String
  tier         TicketTier
  /// The organiser's own label — "Early bird", "Table of 10".
  name         String
  /// Naira. Zero for a `free` tier, and only for a free tier.
  priceNaira   Int
  /// How many exist. Not nullable: an unlimited tier is a venue with no
  /// capacity, which is a physical impossibility somebody has to answer for.
  quantity     Int
  sold         Int        @default(0)
  /// When this tier may be bought. Null start means "from publication",
  /// null end means "until the event begins".
  salesStartAt DateTime?
  salesEndAt   DateTime?

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders  EventOrder[]
  tickets EventTicket[]

  @@index([eventId])
}

/// One purchase: N tickets of one tier, one payment.
model EventOrder {
  id           String @id @default(uuid())
  eventId      String
  ticketTypeId String
  buyerWawuId  String

  quantity       Int
  /// Naira the buyer was charged, in total. Snapshotted — a later price
  /// change must never alter what somebody already paid.
  amountNaira    Int
  /// WAWU's cut, snapshotted at purchase time for the same reason
  /// Purchase.commissionRate is: a creator who upgrades to Pro should not
  /// retroactively change the split on tickets already sold.
  commissionRate Decimal @db.Decimal(5, 4)

  status EventOrderStatus @default(pending)

  /// Payment lookup keys — see Purchase.flutterwaveTxRef and
  /// DirectMessage.flutterwaveTxId. The numeric id is REQUIRED to refund.
  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  /// Which referral link brought this sale, if any.
  referralCode String?

  refundedAt      DateTime?
  refundReference String?
  refundError     String?

  createdAt DateTime @default(now())

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id])
  tickets    EventTicket[]

  @@index([eventId, status])
  @@index([buyerWawuId])
  @@index([referralCode])
}

/// One admittance. One row per seat, not per order, because each is scanned
/// separately and a group of five arriving at different times is normal.
model EventTicket {
  id           String @id @default(uuid())
  orderId      String
  eventId      String
  ticketTypeId String

  /// What the QR encodes. Opaque and unguessable — a sequential id would let
  /// anybody mint a valid-looking ticket by counting.
  code String @unique

  status      EventTicketStatus @default(valid)
  checkedInAt DateTime?
  /// The WAWU id of the organiser or staff member who scanned it.
  checkedInBy String?

  createdAt DateTime @default(now())

  order      EventOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id])

  @@index([eventId, status])
  @@index([orderId])
}

/// A shareable link that attributes sales to whoever shared it.
///
/// Commission is deliberately NOT settled here. The brief says the reward is
/// configured later, so this records who drove what and stops short of
/// paying anybody — a payout path nobody has specified is a payout path that
/// will be wrong.
model EventReferral {
  id          String  @id @default(uuid())
  eventId     String
  /// The code in the URL. Unguessable, for the same reason a ticket code is.
  code        String  @unique
  /// Who this link is for — "Ada on Instagram". Free text, organiser-set.
  label       String
  /// The WAWU account it belongs to, when the referrer has one.
  ownerWawuId String?

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// -----------------------------------------------------------------------------
// WAWU Commerce — the first-party equipment storefront
//
// Added 30 Aug 2026 on product-owner brief. This is NOT the WAWUBasket /
// WAWUBeauty handoff that ShopKind and MarketplaceSave model: those are
// separate apps WAWU links out to, and this brief is explicit that WAWU sells
// this stock itself. Hence a real Product table rather than another save-only
// pointer at somebody else's catalogue.
//
// WHAT IS DELIBERATELY ABSENT IN THIS MVP, and why:
//
//   - No seller/vendor. Stock is uploaded from the admin dashboard, so WAWU is
//     the seller and there is no revenue split to snapshot. When third-party
//     sellers arrive they need a `sellerWawuId` and a commission rate ON THE
//     ORDER ITEM, for the same reason Purchase and EventOrder carry theirs.
//   - No delivery fee and no courier integration. The brief says logistics is
//     handled physically, off-platform. A fee computed with no rate card would
//     be a number invented at checkout, so the total IS the subtotal and the
//     dashboard tracks dispatch by hand.
//   - No product reviews, and therefore no rating. The brief's product card
//     shows a star rating; there is no review system to derive one from, and a
//     seeded 4.8 is fabricated social proof on something people spend real
//     money against. `ratingAvg` exists, stays null, and the card renders
//     nothing when it is null.
//   - No wallet. Orders are paid by card, like everything else here.
// -----------------------------------------------------------------------------

/// The eleven top-level aisles from the brief. A closed set so a browse-by-
/// category filter cannot be defeated by a typo in an admin form; the finer
/// grain ("Microphones", "Gimbals") is `Product.subcategory`, which is free
/// text because that list is long, uneven, and still moving.
enum ProductCategory {
  audio_music
  video_film
  lighting_studio
  photography
  computing
  art_design
  gaming_streaming
  content_creation
  live_events
  professional
  power_accessories
}

/// draft  — being written in the dashboard, invisible to shoppers
/// live   — on the storefront
/// hidden — pulled from the storefront WITHOUT deleting it, because an order
///          item points at it and a deleted product is an order nobody can
///          explain later
enum ProductStatus {
  draft
  live
  hidden
}

/// Where an order's MONEY is. Separate from fulfilment for the same reason
/// EventOrder splits order status from ticket status: a paid order that has
/// not shipped and a shipped order that was refunded are both normal, and one
/// column cannot say both.
enum ShopOrderStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

/// Where the GOODS are. Driven entirely by a human in the dashboard, because
/// the brief says logistics is physical and off-platform.
///
/// NOT the existing `FulfilmentStatus`, which despite the name is a PAYMENT
/// lifecycle for bills and insurance (pending/paid/failed/refunded with
/// `delivered` mixed in). Reusing it would put money states on a column that
/// answers "where is the package", and the two move independently — a paid
/// order that has not shipped and a shipped order that was refunded are both
/// ordinary.
enum ShopFulfilment {
  awaiting_dispatch
  dispatched
  delivered
}

model Product {
  id          String  @id @default(uuid())
  name        String
  /// Stable, human-readable, and unique — it is in the storefront URL, so it
  /// must not change under a link somebody shared.
  slug        String  @unique
  brand       String?
  description String

  category    ProductCategory
  /// e.g. "Microphones". Free text; see the ProductCategory comment.
  subcategory String

  priceNaira     Int
  /// The "was" price, for a product on offer. Null means not on offer — it is
  /// NOT allowed to equal or undercut priceNaira, which would be a fake
  /// discount, and the service refuses that.
  compareAtNaira Int?

  /// Units on hand. Decremented by a CONDITIONAL write inside the order
  /// transaction — two people buying the last one is the normal case for
  /// anything worth selling, and a read-then-write sells it twice.
  stock Int @default(0)

  /// Ordered. The first is the card image; the rest are the gallery.
  images String[]

  /// The brief's "WAWU VERIFIED ✓" — an editorial claim WAWU stands behind
  /// about the item being genuine, set by an admin. Not a creator badge and
  /// not related to the verification ladder.
  wawuVerified Boolean @default(false)
  /// The brief's "WAWU PICKS" shelf.
  wawuPick     Boolean @default(false)

  /// Null until a review system exists. See the header comment — this is not
  /// to be seeded.
  ratingAvg   Decimal? @db.Decimal(2, 1)
  ratingCount Int      @default(0)

  status ProductStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems  CartItem[]
  orderItems ShopOrderItem[]

  @@index([status, category])
  @@index([status, wawuPick])
}

/// The brief calls this "ADD TO WOW". One row per product per person; adding
/// the same thing twice raises the quantity rather than making a second row.
model CartItem {
  id         String   @id @default(uuid())
  userWawuId String
  productId  String
  quantity   Int      @default(1)
  addedAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userWawuId, productId])
  @@index([userWawuId])
}

model ShopOrder {
  id          String          @id @default(uuid())
  buyerWawuId String
  status      ShopOrderStatus @default(pending)

  /// No delivery fee is charged, so these are equal today. Both exist because
  /// the day a fee is introduced, an order needs to record what the goods cost
  /// separately from what was charged — reconstructing that later is guesswork.
  subtotalNaira Int
  totalNaira    Int

  /// DELIVERY IS THE LOAD-BEARING PART OF THIS TABLE.
  /// Logistics is manual: a person reads these fields and physically takes the
  /// package somewhere. An order missing a phone number is a package that
  /// cannot be delivered, so name, phone and address are required columns
  /// rather than an optional blob.
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryCity    String
  deliveryState   String
  /// "Gate is behind the pharmacy." Optional, and often the difference.
  deliveryNote    String?

  fulfilment   ShopFulfilment @default(awaiting_dispatch)
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  /// Free text a human types: courier and waybill. Not a tracking integration.
  trackingNote String?

  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?
  /// Set when a refund could not be sent and needs a person. Internal — this
  /// must never reach a shipped app response.
  refundError      String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  items ShopOrderItem[]

  @@index([buyerWawuId, status])
  @@index([status, fulfilment])
}

/// One line. Everything a buyer was shown is SNAPSHOTTED here, because a
/// product's name and price are edited in the dashboard and an order has to
/// keep saying what was actually bought and what was actually paid.
model ShopOrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String

  nameSnapshot       String
  priceNairaSnapshot Int
  quantity           Int

  order   ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product   @relation(fields: [productId], references: [id])

  @@index([orderId])
}

/// One object in bucket storage, so a per-account storage quota can be a
/// MEASURED figure rather than a guess.
///
/// Nothing recorded bytes before this. `contentLength` was signed into the
/// presigned PUT (so storage rejects a file of any other size) and then
/// thrown away, which caps a single upload and caps a total of nothing.
///
/// A row is written at PRESIGN, before the bytes exist, because that is the
/// only moment the API is in the loop — the browser PUTs straight to storage
/// and never calls back. `pending` rows therefore include uploads that were
/// abandoned, so they are reconciled against the bucket (HeadObject) once
/// their presign window has closed: present -> confirmed, absent ->
/// abandoned. Counting pending rows toward the quota until then is
/// deliberate; the alternative is a window in which a user can presign
/// unlimited space at once.
model StorageObject {
  id          String              @id @default(uuid())
  wawuUserId  String
  /// The object key. Unique so a reconcile is idempotent.
  key         String              @unique
  bytes       Int
  contentType String
  folder      String
  status      StorageObjectStatus @default(pending)
  createdAt   DateTime            @default(now())
  /// When the object was proven to exist in the bucket. Null while pending.
  confirmedAt DateTime?

  @@index([wawuUserId, status])
  @@index([status, createdAt])
}

enum StorageObjectStatus {
  pending
  confirmed
  abandoned
}

/// A Pro Max creator's explicit opt-in to Ditto Music distribution.
///
/// Its own row rather than a flag on CreatorState because opting in is NOT a
/// property of the plan. Pro Max INCLUDES distribution; it does not enrol
/// anybody in a third party's service, and paying must never be read as
/// consent to be signed up elsewhere. So the row exists only when the creator
/// pressed the button, and its absence on a paid Pro Max account is the
/// normal state, not missing data.
///
/// `emailedAt` is null when the invite could not be emailed — a phone-OTP
/// signup has no address. The link is always shown in the app as well, so a
/// null here means "no copy in their inbox", never "they cannot reach it".
model DittoOptIn {
  wawuUserId String    @id
  optedInAt  DateTime  @default(now())
  emailedAt  DateTime?
}

// REMOVED WITH SUBSCRIPTIONS: ReferralCode / ReferralRedemption.
//
// A referral code was a percentage discount on ONE subscription plan, keyed
// to a CreatorTier and priced off the plan table. With subscriptions removed
// (brief B1) there is no plan and no price for a code to take a percentage
// of, so the feature has no target left rather than merely no callers.
//
// This is a CONSEQUENCE of the authorized removal, not a separate product
// decision, and it leaves a real open question: verification (N4,999 creator
// / N9,999 professional) is now the primary paid action, and a discount code
// pointed at THAT would be the natural successor. Re-pointing it means
// choosing what a code applies to and what it costs, which is the product
// owner's call, so nothing here guesses at it. See DECISIONS.md.

/// Platform-wide switches an admin can flip without a deploy.
///
/// A single row, pinned to id 1. Typed columns rather than a key/value table:
/// a stringly-typed settings bag means every reader parses it its own way and
/// a typo becomes a silent default.
model PlatformSettings {
  id Int @id @default(1)

  /// When false, a REGULAR (non-creator) account cannot be created — the
  /// product is onboarding creators first. Creator signup is unaffected.
  ///
  /// Named for the half it actually gates. "publicSignupEnabled" read as
  /// though it closed the whole door, which would have been the wrong thing
  /// for the next person to implement against.
  ///
  /// Flipped from the dashboard, not from a deploy.
  userSignupEnabled Boolean @default(true)

  /// What the two ticks cost, in whole naira, per year.
  ///
  /// Columns rather than constants because a price is a commercial decision
  /// that changes without a deploy, and this table already exists to be
  /// flipped from the dashboard. The defaults are the launch prices; the
  /// single place they are written down in code is
  /// src/common/verification/verification-pricing.ts, which is also the only
  /// thing that reads these.
  ///
  /// Naira only. There is no second currency in this product.
  creatorVerificationPriceNgn      Int @default(2000)
  professionalVerificationPriceNgn Int @default(2000)

  updatedAt DateTime @updatedAt
}

/// The code somebody arrived with, remembered against their account.
///
// REMOVED WITH SUBSCRIPTIONS: ReferralClaim.
//
// This held a code between sign-up and subscription checkout, so the tier
// screen still knew about it after a detour through an email client. There is
// no tier screen and no checkout to carry it to. See the ReferralCode note
// above for the open question this leaves.

/// ─────────────────────────────────────────────────────────────────────────
/// WALLETS
///
/// A creator's wallet is an account at FLUTTERWAVE MFB, opened in their name
/// through Flutterwave's Payout Subaccount API. Flutterwave custodies the
/// money under their own CBN banking licence; WAWU never holds it, and never
/// operates a balance of its own. That distinction is the whole reason this
/// can exist at all - see docs and the wallet scope.
///
/// So none of these tables ARE the balance. Flutterwave's is authoritative;
/// these record what WAWU asked for and what it was told happened, which is
/// what makes "where did this money go" answerable.
/// ─────────────────────────────────────────────────────────────────────────
model CreatorWallet {
  wawuUserId       String   @id
  /// Flutterwave's PSA… identifier. Used to DEBIT the wallet on withdrawal.
  accountReference String   @unique
  /// Flutterwave's internal id. Used to CREDIT the wallet from our balance.
  barterId         String   @unique
  /// The creator's own account number at Flutterwave MFB. Anyone can pay into
  /// it directly, which is the wallet's second purpose.
  nuban            String?
  bankName         String?
  bankCode         String?
  status           String   @default("active")
  createdAt        DateTime @default(now())

  @@index([status])
}

enum WalletEntryKind {
  /// A creator's share of a sale, moved from WAWU's balance into their wallet.
  earning
  /// Money leaving the wallet for their bank account.
  withdrawal
  /// An earning taken back, e.g. a refunded purchase.
  reversal
}

enum WalletEntryStatus {
  pending
  completed
  failed
}

/// Every movement WAWU initiated, one row each, before it is attempted.
///
/// `reference` is the idempotency key and it is UNIQUE: a retried request
/// finds the row rather than moving the money twice. Nothing here is trusted
/// as a balance - it is the record of an instruction and its outcome.
model WalletLedgerEntry {
  id            String            @id @default(uuid())
  wawuUserId    String
  kind          WalletEntryKind
  /// Whole naira, like every other amount in this codebase.
  amount        Int
  status        WalletEntryStatus @default(pending)
  /// Our own reference, sent to Flutterwave and echoed back on the webhook.
  reference     String            @unique
  /// Flutterwave's transfer id, once it has one.
  transferId    String?
  /// What produced this entry: purchase, direct_message, credit_spend.
  sourceType    String?
  sourceId      String?
  failureReason String?
  createdAt     DateTime          @default(now())
  settledAt     DateTime?

  @@index([wawuUserId, createdAt])
  @@index([status])
  @@index([sourceType, sourceId])
}

/// A withdrawal's banking details, kept beside its ledger entry.
///
/// Separate from WalletLedgerEntry because only withdrawals have a
/// destination, and an account number belongs with the one movement that used
/// it rather than nullable on every earning row.
model WalletWithdrawal {
  id            String   @id @default(uuid())
  wawuUserId    String
  /// The ledger entry this discharges.
  entryId       String   @unique
  amount        Int
  bankCode      String
  accountNumber String
  /// Resolved from the bank before sending, never typed by the creator.
  accountName   String
  createdAt     DateTime @default(now())

  @@index([wawuUserId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE TRANSACTION PIN (task MONEY-09)
///
/// The four digits every movement of money asks for (W11, W36). Fintava has
/// no wallet PIN, so this one is WAWU's: it guards WAWU's API, not the account
/// at the bank. One row per person, created when they set their first PIN, so
/// everyone who existed before this table has no PIN (no row) until they set
/// one. docs/contract/CONVENTIONS.md section 5 is the contract.
/// ─────────────────────────────────────────────────────────────────────────
model TransactionPin {
  wawuUserId  String    @id
  /// argon2id, encoded with its own random salt (a fresh one on every set or
  /// change, so no two people share one). The PIN itself is never stored,
  /// logged or returned.
  pinHash     String
  /// Wrong tries in a row. A try is counted before the hash is compared, so
  /// tries sent at the same moment cannot get past the limit together. Back
  /// to 0 on a right PIN, a new PIN, or once a lock has ended.
  failedTries Int       @default(0)
  /// Set when the last allowed try was wrong; null when not locked. A lock
  /// that has passed is treated as no lock (and cleared on the next try).
  lockedUntil DateTime?
  /// When the PIN was set or last changed (W35 "last changed").
  setAt       DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// ─────────────────────────────────────────────────────────────────────────
/// RESETTING THE TRANSACTION PIN BY A CODE TO THE PHONE (task MONEY-14, W37)
///
/// One row per code texted (or about to be texted) to the phone the BVN
/// check proved (WalletIdentity.verifiedPhone, G-11). Its id is the
/// `resetId` the app sends back with the code. The code itself is never
/// stored: only its argon2id hash, like the PIN. Rows are kept for the
/// rolling 24 hours the daily text limit counts over, and go with the
/// account (account purge, OWNED).
///
/// `sendState`:
///   sending   the row is written; the text is being sent
///   sent      Fintava accepted the text
///   unknown   Fintava's answer was lost: the text may have gone, so the
///             code stays usable and the row counts toward the limit; it is
///             never sent again blindly
///   failed    Fintava refused or nothing was sent: the code never works and
///             the row does not count
/// ─────────────────────────────────────────────────────────────────────────
model TransactionPinReset {
  id                String    @id @default(uuid())
  wawuUserId        String
  /// E.164, the proved phone the code went to (WalletIdentity.verifiedPhone).
  phone             String
  /// argon2id of the code. The code itself is never stored or logged.
  codeHash          String
  /// Wrong codes on this reset. Counted before the code is compared, so codes
  /// sent at the same moment cannot get past the limit together.
  failedTries       Int       @default(0)
  sendState         String    @default("sending")
  expiresAt         DateTime
  /// When a new code may be asked for (W37's countdown).
  resendAvailableAt DateTime
  /// Set once the code was right and the new PIN stored: a code works once.
  usedAt            DateTime?
  /// Set when a newer code replaced this one: only the newest code works.
  supersededAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([wawuUserId, createdAt])
  @@index([phone, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE PHONE THAT MAY APPROVE WITH A FINGERPRINT OR A FACE (task MONEY-14)
///
/// W11, W35 (R-26): a biometric approval on a known phone counts as the PIN.
/// The phone makes a P-256 key pair whose private half only its biometric
/// unlocks, and registers the public half here with the PIN. An approval is
/// that key's signature over a one-time challenge and the exact request
/// (DeviceApprovalChallenge): the server checks the signature, never a
/// client "true". One phone per person: the primary key is the person, so
/// registering another phone replaces this one (and its `deviceId`, so the
/// old phone's challenges stop working). Turning it off deletes the row, and
/// so does a PIN reset by code. Holds no secret: a public key.
/// ─────────────────────────────────────────────────────────────────────────
model ApprovalDevice {
  wawuUserId  String    @id
  /// New on every registration; the app keeps it to know this phone is the one.
  deviceId    String    @unique @default(uuid())
  /// SubjectPublicKeyInfo (DER) of a P-256 key, base64url.
  publicKey   String
  /// What the phone approves with: `fingerprint` or `face` (W35's label).
  biometric   String
  /// The last approval that passed.
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// One challenge for one biometric approval (task MONEY-14): random, short
/// lived, tied to the person and the phone it was issued for, and used up by
/// the first approval that names it, right or wrong.
model ApprovalChallenge {
  id          String    @id @default(uuid())
  wawuUserId  String
  /// ApprovalDevice.deviceId when the challenge was issued.
  deviceId    String
  /// 32 random bytes, base64url. Not a secret: only the phone's key can sign it.
  challenge   String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([wawuUserId, createdAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE NAIRA WALLET AT FINTAVA (table added by task MONEY-11)
///
/// WAWU's pointer to a person's account at Fintava (Loma Bank's licence,
/// R-1): which Fintava wallet is theirs. It is NOT the balance and holds no
/// money figure at all: the balance is read from Fintava on every request
/// (GET /money/wallet/balance, MONEY-11) and never stored or summed here.
///
/// No row means no wallet yet (R-6): the money routes answer
/// `409 wallet_not_open` and the app leads to Open your wallet. MONEY-12
/// writes the row when Fintava's `POST /create/customer` answers, with the
/// three ids it returns (mobile repo `docs/fintava/naira-api.md`,
/// "Identifiers": they are not interchangeable), and adds what it needs for
/// the opening state. One wallet per person, one person per wallet.
/// ─────────────────────────────────────────────────────────────────────────
model FintavaWallet {
  wawuUserId    String   @id
  /// `userInfo.id`: history (`/txn?customerId=`) and the bank-send `sourceId`.
  customerId    String   @unique
  /// `wallet.id`: the balance, freeze and unfreeze.
  walletId      String   @unique
  /// The NUBAN at Loma Bank: wallet-to-wallet sends and name checks.
  accountNumber String   @unique
  /// `wallet.accountName` as Fintava answered when the account opened
  /// (MONEY-12, W1, A8). Null on a row written before the column existed.
  accountName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// ─────────────────────────────────────────────────────────────────────────
/// OPENING A PERSON'S FINTAVA ACCOUNT (task MONEY-12)
///
/// One row per person who asked to open a wallet: the record that makes
/// opening safe to retry. Fintava's `POST /create/customer` refuses neither
/// a repeated BVN nor a repeated call (mobile repo
/// `docs/fintava/sandbox/07-create-customer.md`), so nothing at Fintava
/// stops a second account: this row does. Its primary key is the claim (one
/// opening in flight per person, whatever the number of taps or servers),
/// and the two unique keys stop a second WAWU account opening another
/// Fintava account for the same BVN or phone.
///
/// `state`:
///   opening   create was sent (or is about to be) under this attempt
///   unknown   the answer was lost: reconciled with Fintava, never resent
///             blindly (wallet-opening.service.ts)
///   failed    Fintava refused, or reconciling proved nothing was created:
///             a new attempt may start
///   open      FintavaWallet holds the account
///   conflict  Fintava has an account for this phone that another WAWU
///             account already holds: needs a person to look at it
///
/// Never the BVN, the NIN, the name, the date of birth or the address: the
/// keyed hash of the BVN (as WalletIdentity keeps it) and the phone that the
/// BVN check proved, which is how a lost answer is found again.
/// ─────────────────────────────────────────────────────────────────────────
model FintavaWalletOpening {
  wawuUserId       String    @id
  state            String    @default("opening")
  /// WalletIdentity.bvnHash of the passed check this opening was tied to.
  bvnHash          String    @unique
  /// WalletIdentity.bvnVerifiedAt of that check.
  bvnVerifiedAt    DateTime
  /// WalletIdentity.verifiedPhone (E.164): sent to Fintava, and how a lost
  /// answer is looked up (`/customers/details?phone=`).
  phone            String    @unique
  /// Create requests sent so far (each one a new attempt).
  attempts         Int       @default(1)
  /// When the current attempt started: no resend before the money timeout
  /// plus the resend safety window has passed since then.
  attemptStartedAt DateTime  @default(now())
  /// Why the last attempt did not open the account: our own word, never
  /// Fintava's text.
  failure          String?
  /// When Fintava was last asked about a lost answer.
  checkedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([state, attemptStartedAt])
}

/// ─────────────────────────────────────────────────────────────────────────
/// FINTAVA WEBHOOK EVENTS (task MONEY-07)
///
/// Every signed delivery Fintava sends to `POST /api/hub/webhooks/fintava`,
/// recorded once and acknowledged. Nothing here moves money or touches a
/// balance: the ledger (MONEY-10) and the pending sweep (MONEY-08) read the
/// `pending` rows and mark them `processed` or `failed`. Fintava's balance
/// stays the only balance.
///
/// Fintava sends no event id and no timestamp (mobile repo
/// `docs/fintava/naira-api.md`, "Webhooks"), so a delivery is identified by
/// its event, the transaction reference it carries and the status it
/// reports. The unique constraint over those three IS the replay protection:
/// the insert is `ON CONFLICT DO NOTHING`, so a retry, a replayed capture or
/// two copies arriving at the same moment leave one row.
/// ─────────────────────────────────────────────────────────────────────────
enum FintavaWebhookProcessing {
  /// Recorded; waiting for the task that consumes this event.
  pending
  /// The consuming task handled it.
  processed
  /// The consuming task tried and could not; `note` says why.
  failed
  /// The delivery named no event we know (or none). Kept for review.
  unrecognised
}

model FintavaWebhookEvent {
  id String @id @default(uuid())

  /// The event name, trimmed and lower case (`VIRTUAL_WALLET_PAYMENT` is
  /// `virtual_wallet_payment`), read from the body's `event` field or, when
  /// that is missing, its `type` field. Empty when the delivery named none.
  event    String
  /// The event name exactly as sent, when there was one.
  eventRaw String?

  /// The transaction reference this delivery is keyed on, read from `data`
  /// in the order the event's entry in FINTAVA_WEBHOOK_EVENTS
  /// (src/fintava/webhook/fintava-webhook-event.ts) lists. When the
  /// delivery carries none, the SHA-256 of its raw body (`sha256:<hex>`),
  /// so a byte-identical retry still lands on the same row.
  reference      String
  /// Where `reference` came from: `data.reference`, `data.customerReference`,
  /// `data.reversalRef`, ..., or `body.sha256`. Every text column here has
  /// any NUL replaced by U+FFFD (Postgres text cannot hold one), the same way
  /// every time, so a replay still lands on the same key.
  referenceField String
  /// Fintava's own status for the transaction (`data.status`, else
  /// `data.paymentStatus`), upper case; empty when it sent none.
  fintavaStatus  String

  /// `data.reference` and `data.customerReference` (or `CustomerReference`)
  /// as sent, so a consumer can match either to what it stored. A transfer
  /// RESPONSE swaps these two names (`sandbox/11-`); whether a delivery does
  /// too is unconfirmed until a real one is recorded (OPS-10), so neither
  /// is assumed to be ours.
  dataReference         String?
  dataCustomerReference String?

  /// The body exactly as delivered: the bytes the signature covers, kept
  /// byte for byte (`bytea`, so a NUL or any other byte fits). Personal data
  /// lives here and in `payload`, never in a log.
  rawBody Bytes
  /// The same body parsed, with every NUL (`\u0000`) in a key or a string
  /// replaced by U+FFFD: Postgres json cannot hold a NUL, and a delivery it
  /// refused would be retried and lost. `rawBody` keeps the original.
  payload Json

  /// The key (MONEY-08 round 3): the SHA-256, hex, of `rawBody`, the exact
  /// bytes Fintava signed. A retry or replay of the same delivery is the
  /// same bytes and lands on the same row; any other body, even for the same
  /// transaction and status (another amount, say), is a delivery of its own
  /// and reaches its consumer. Filled for every row; nullable only because
  /// it was added to a table that already had rows.
  bodySha256 String? @unique

  processingStatus FintavaWebhookProcessing @default(pending)
  /// Set by the consuming task: what it did, or why it could not.
  note             String?
  receivedAt       DateTime                 @default(now())
  processedAt      DateTime?

  /// Was the unique key until MONEY-08 round 3; now only an index.
  @@index([event, reference, fintavaStatus])
  @@index([processingStatus, receivedAt])
  @@index([dataReference])
  @@index([dataCustomerReference])
}

/// ─────────────────────────────────────────────────────────────────────────
/// WHO OPENS A WALLET (tables added by task KYC-01)
///
/// The BVN check that starts Open your wallet (R-6: identity is checked when
/// someone opens a wallet, never at sign-up). Fintava's
/// `GET /compliance/verify/bvn` answers name, date of birth, phone, gender
/// and a photo; the name, date of birth and gender go back to the app once,
/// in the check's answer, for A5. None of it is kept here.
///
/// What is kept, and nothing more:
/// - when the BVN passed, a KEYED hash of it (HMAC-SHA256 under
///   IDENTITY_HASH_KEY, never a plain or salted hash: a BVN has only 10^11
///   values, so anything without a server secret can be walked in minutes)
///   and its last 4 digits;
/// - the same for the NIN taken on the same screen (A26), which Fintava
///   needs to open the account (MONEY-12);
/// - the account phone that matched the BVN's phone, E.164 (BACKEND_GAPS
///   G-11: the one phone number identity checks have proved);
/// - the occupation typed on A5.
/// The full BVN and NIN are never stored and never logged: the app sends
/// them again to the steps that need them (KYC-02's selfie, MONEY-12's
/// account opening), which check them against these hashes. The address is
/// not held at all: it goes straight to account opening.
/// ─────────────────────────────────────────────────────────────────────────
model WalletIdentity {
  wawuUserId    String    @id
  /// HMAC-SHA256 of the BVN under IDENTITY_HASH_KEY, hex. Null until a check passes.
  bvnHash       String?
  bvnLast4      String?
  /// When the BVN check last passed (the phone matched).
  bvnVerifiedAt DateTime?
  /// HMAC-SHA256 of the NIN under IDENTITY_HASH_KEY, hex.
  ninHash       String?
  ninLast4      String?
  /// The account's phone, E.164, when it matched the BVN's phone.
  verifiedPhone String?
  /// Typed on A5.
  occupation    String?
  /// The BVN record's first and last name as keyed hashes, one per word
  /// (WALLET-14): `{ "v": 2, "check": hex, "first": [hex...], "last":
  /// [hex...] }`, each word HMAC-SHA256 under IDENTITY_HASH_KEY over
  /// `name:<wawuUserId>:<bvnVerifiedAt>:<WORD>`, so the same word differs
  /// across people and checks and no hash can be matched to a name stored
  /// elsewhere without the key. Written with every passed check, null when
  /// Fintava gave no first or last name in a form we read. Never the name
  /// itself. Read only to compare a payout account's name with the BVN name
  /// (A21, `PayoutAccountView.matchesBvnName`); any other shape, or a
  /// `check` that does not recompute, reads as no BVN name.
  bvnNameKeys   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// One row per BVN check sent (or about to be sent) to Fintava, which charges
/// for each one even when it says no (mobile repo
/// `docs/fintava/sandbox/04-bvn-check.md`). It is how the per-person daily
/// limit is counted; it holds no part of the BVN.
model BvnCheckAttempt {
  id         String   @id @default(uuid())
  wawuUserId String
  /// `pending` while Fintava is being asked; then `verified`,
  /// `phone_mismatch`, `refused` or `unavailable`.
  outcome    String   @default("pending")
  createdAt  DateTime @default(now())

  @@index([wawuUserId, createdAt])
}

/// One row per selfie match sent (or about to be sent) to Fintava (task
/// KYC-02): Fintava's `POST /compliance/verify/bvn/selfie` compares a selfie
/// with the BVN record's photo, a face match and not a liveness check. Each
/// one is charged even when the faces do not match (mobile repo
/// `docs/fintava/sandbox/05-bvn-selfie.md`), so this is how the per-person
/// daily limit is counted, and it is the record of the result. It never
/// holds the selfie, the BVN photo or any part of the BVN: only the outcome,
/// when, and Fintava's confidence score when it gives one.
model SelfieMatchAttempt {
  id         String    @id @default(uuid())
  wawuUserId String
  /// `pending` while Fintava is being asked; then `matched`, `not_matched`
  /// or `unavailable`.
  outcome    String    @default("pending")
  /// Fintava's confidence score for this match, as sent, when it sends one.
  confidence Float?
  /// When Fintava's answer came back; null while pending.
  settledAt  DateTime?
  createdAt  DateTime  @default(now())
  /// The passed BVN check this selfie was compared against, read once at the
  /// start of the request (migration 20261002230000): when that check passed
  /// (WalletIdentity.bvnVerifiedAt) and its BVN's keyed hash
  /// (WalletIdentity.bvnHash, never the BVN). A match counts only while both
  /// still equal the person's current check, so a selfie matched to one BVN
  /// never counts for another checked meanwhile. Null on a row written
  /// before the columns existed: such a row never counts as a match.
  bvnVerifiedAt DateTime?
  bvnHash       String?

  @@index([wawuUserId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
/// FREE CHAT BETWEEN TWO USERS (task INBOX-06, DECISIONS R-13)
///
/// Any two people can chat for free with text, photos, videos and PDFs. This
/// is not the paid DirectMessage (a fan's paid question to a creator, with a
/// reply deadline): nothing here costs anything or touches money. A block in
/// either direction (BlockedAccount) stops new messages and new chats; the
/// history stays readable by both people.
///
/// One row per pair of people: the two ids are stored sorted (userAWawuId is
/// the smaller), so opening a chat with someone twice, from either side,
/// finds the same row.
// ─────────────────────────────────────────────────────────────────────────
model ChatConversation {
  id             String            @id @default(uuid())
  userAWawuId    String
  userBWawuId    String
  createdAt      DateTime          @default(now())
  /// When the newest message was sent, or when the chat was opened if it has
  /// none yet. The chat list is ordered by it.
  lastActivityAt DateTime          @default(now())
  participants   ChatParticipant[]
  messages       ChatMessage[]

  @@unique([userAWawuId, userBWawuId])
}

/// One row for each of the two people in a chat, holding how far that person
/// has read. The other person's read mark is what turns "sent" into "read"
/// on a message the caller sent.
model ChatParticipant {
  conversationId    String
  wawuUserId        String
  /// The time of the newest message this person has read. Null: nothing read
  /// yet. Only ever moves forward.
  lastReadAt        DateTime?
  /// The message that mark points at.
  lastReadMessageId String?
  conversation      ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, wawuUserId])
  @@index([wawuUserId])
}

/// One message. Text, an attachment, or both. An attachment is an object the
/// sender uploaded through POST /chats/:id/attachments (StorageObject, folder
/// chat/media or chat/file); the key is stored, never a link, and every read
/// signs a fresh link.
model ChatMessage {
  id                    String           @id @default(uuid())
  conversationId        String
  senderWawuId          String
  /// text | image | video | file
  kind                  String
  text                  String?
  attachmentKey         String?
  attachmentContentType String?
  attachmentBytes       Int?
  /// The file's own name, shown on a PDF bubble. Null for text and media.
  attachmentName        String?
  /// The sender app's own id for this message, so a resend after a lost
  /// answer returns the first message instead of posting it twice.
  clientMessageId       String?
  createdAt             DateTime         @default(now())
  conversation          ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderWawuId, clientMessageId])
  @@index([conversationId, createdAt, id])
}

/// ─────────────────────────────────────────────────────────────────────────
/// THE LEDGER (task MONEY-10)
///
/// WAWU's own record of every movement of money on a Fintava wallet it
/// knows (a person's FintavaWallet, or WAWU's merchant wallet), mirrored
/// from Fintava in integer kobo. One row per wallet side of a movement: a
/// send from A to B is A's `out` row and B's `in` row.
///
/// It is NEVER a balance. The balance is Fintava's, read on every request
/// (MONEY-11); nothing adds these rows up and shows the result as money a
/// person has. MONEY-15 serves these rows as the history (W26 to W28) and
/// MONEY-16 checks them against Fintava every night.
///
/// Exactly once: a movement is known by several references, and which one a
/// webhook carries is unconfirmed (BACKEND_GAPS G-19). Every reference a
/// row is known by is a FintavaLedgerReference row whose primary key is
/// (accountNumber, direction, value). A second sighting of the same
/// movement on the same side collides on that key and is merged into the
/// first row; there is no read before the write.
/// ─────────────────────────────────────────────────────────────────────────
enum FintavaLedgerWallet {
  /// A person's wallet (FintavaWallet); wawuUserId is set.
  user
  /// WAWU's merchant wallet (R-19); wawuUserId is null.
  merchant
}

enum FintavaLedgerDirection {
  in
  out
}

/// Same values as TransferStatus in the wallet contract (src/money).
enum FintavaLedgerStatus {
  pending
  completed
  failed
  reversed
}

/// Same values as TransactionCategory in the wallet contract (src/money).
enum FintavaLedgerCategory {
  transfer
  top_up
  earning
  purchase
  bill
  hold
  refund
  reversal
}

/// Same values as TransactionCounterpartyView.kind in the wallet contract.
enum FintavaLedgerCounterpartyKind {
  wawu_user
  bank_account
  biller
  wawu
}

model FintavaLedgerEntry {
  id String @id @default(uuid())

  walletKind    FintavaLedgerWallet
  /// The person whose wallet this is; null on WAWU's merchant wallet.
  wawuUserId    String?
  /// The Fintava wallet (NUBAN) this row is on.
  accountNumber String
  direction     FintavaLedgerDirection
  status        FintavaLedgerStatus
  category      FintavaLedgerCategory

  /// What moved, before fees, in kobo. BIGINT: never a float, never naira.
  amountKobo      BigInt
  /// What Fintava reported it took on top of the amount (out rows; 0 on in rows).
  feeKobo         BigInt  @default(0)
  /// Fintava's charge and WAWU's fee as quoted to the person (R-10), set by
  /// the task that made the movement; null when only Fintava's total is known.
  providerFeeKobo BigInt?
  wawuFeeKobo     BigInt?
  /// Out: what left the wallet (amount + fees). In: what arrived.
  totalKobo       BigInt

  counterpartyKind          FintavaLedgerCounterpartyKind?
  counterpartyName          String?
  counterpartyWawuUserId    String?
  counterpartyAccountNumber String?
  counterpartyBankCode      String?
  counterpartyBankName      String?

  /// What the movement paid for (W27 "On"), set by the paying feature:
  /// a PaymentKind from the wallet contract, its target and its title.
  linkKind     String?
  linkTargetId String?
  linkTitle    String?
  /// The person's own note on a send.
  note         String?
  /// Fintava's narration or description, as sent.
  narration    String?

  /// OUR CustomerReference: shown on the receipt, and the one a lookup finds.
  customerReference    String?
  /// Fintava's `reference` (findable by lookup).
  fintavaReference     String?
  /// The transfer response's `reference` (not findable by lookup).
  tagapayTransRef      String?
  fintavaTransactionId String?
  sessionId            String?

  /// The feature's own records, when a transfer or payment made this row.
  transferId String?
  paymentId  String?

  /// A debit that came back (`debit_transfer_reversal`): the row's status
  /// becomes `reversed` and these hold what Fintava reported. Never a
  /// second row.
  reversalReference   String?
  reversalAmountKobo  BigInt?
  reversalChargesKobo BigInt?
  reversalTotalKobo   BigInt?
  reversedAt          DateTime?

  /// Why a movement failed, when Fintava said so.
  failureReason String?
  /// Set when a later sighting of this movement disagreed with what is
  /// stored (an amount, or a status Fintava gave both ways): the stored
  /// figure is kept, the status is not moved by that sighting, the sweep
  /// leaves the row alone, and MONEY-16 reports it (a stop: WORKFLOW 10).
  discrepancy   String?

  /// How the ledger first learned of it: send, webhook, lookup or history.
  source        String
  /// The webhook event that created the row, when one did.
  sourceEventId String?

  /// When the money moved: Fintava's time when it gave one, else first seen.
  occurredAt  DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// MONEY-08, the pending sweep's schedule, kept on the row so that a
  /// restart or a second server keeps it. When Fintava is next asked about
  /// this `pending` row; null until the first check, which is due at
  /// createdAt (or revivedAt) plus LEDGER_STATUS_CHECK_AFTER_MINUTES.
  nextCheckAt  DateTime?
  /// How many times the sweep has asked about it. The rest before the next
  /// check doubles with each one, 1, 2, 4 ... minutes, at most 60.
  statusChecks Int       @default(0)
  /// MONEY-08: when a row failed because Fintava had no record of it
  /// (LEDGER_ABSENT_FAILURE) was seen again and taken back to its sighting's
  /// status, and which kind of sighting did it (send, webhook, lookup or
  /// history). A revival is not a disagreement with Fintava, so it is never
  /// written on `discrepancy`, and the row stays in the sweep.
  revivedAt    DateTime?
  revivedBy    String?

  references FintavaLedgerReference[]

  @@index([wawuUserId, occurredAt])
  @@index([accountNumber, occurredAt])
  @@index([status, occurredAt])
  @@index([customerReference])
  @@index([status, nextCheckAt])
}

/// Every reference one ledger row is known by. The primary key is the
/// exactly-once rule: one movement, one side, one row.
model FintavaLedgerReference {
  /// The side: the row's wallet and direction.
  accountNumber String
  direction     FintavaLedgerDirection
  /// The reference text, exactly as Fintava or WAWU wrote it.
  value         String
  /// ours, fintava, tagapay, transaction_id, session, delivery
  kind          String
  entryId       String
  entry         FintavaLedgerEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt     DateTime               @default(now())

  @@id([accountNumber, direction, value])
  @@index([entryId])
  @@index([value])
}

/// ─────────────────────────────────────────────────────────────────────────
/// RECEIPTS (task WALLET-18)
///
/// A receipt is one ledger row (FintavaLedgerEntry) its owner chose to
/// share, under a short code anyone can check at wawu/r/<code> (W41 to W43,
/// W12, W27). One code per row, made the first time the owner asks and the
/// same every time after. The code is 12 characters drawn at random
/// (60 bits, never sequential and never derived from an id), so the public
/// page cannot be walked by guessing.
///
/// Nothing about the movement is copied here: the public page and the image
/// and PDF read the ledger row when they are asked, so a status Fintava
/// moves (pending to completed, a reversal) shows on the receipt as it
/// stands. A row that is gone, or no longer on its owner's wallet, makes
/// its code a plain miss.
/// ─────────────────────────────────────────────────────────────────────────
model MoneyReceipt {
  id            String   @id @default(uuid())
  /// The public code: 12 characters of Crockford base 32, upper case.
  code          String   @unique
  /// The ledger row this receipt shows (FintavaLedgerEntry.id).
  entryId       String   @unique
  /// Whose row it is: the wallet's owner, who made the code.
  wawuUserId    String
  /// The wallet (NUBAN) the row is on, as the row says.
  accountNumber String
  createdAt     DateTime @default(now())

  @@index([wawuUserId])
}

/// ─────────────────────────────────────────────────────────────────────────
/// SAVED BENEFICIARIES AND THE PAYOUT ACCOUNT (task WALLET-14)
///
/// A beneficiary is a place this person sends money to again (W8, W12 "Save
/// as beneficiary", W35's count): another WAWU user with a wallet, or a bank
/// account whose name the bank confirmed through Fintava's name check when it
/// was saved. The account name is the bank's, never one the person typed.
/// One row per place per person (the two unique keys); saving it again
/// answers the row already there.
/// ─────────────────────────────────────────────────────────────────────────
model MoneyBeneficiary {
  id              String   @id @default(uuid())
  /// Whose list this is.
  ownerWawuId     String
  /// `wawu_user` or `bank_account`.
  kind            String
  /// Set when kind is wawu_user: who the money goes to.
  recipientWawuId String?
  /// Set when kind is bank_account. Fintava's bank code (`GET /banks`).
  bankCode        String?
  /// The bank's name from Fintava's list when the account was saved.
  bankName        String?
  /// NUBAN, 10 digits.
  accountNumber   String?
  /// The name the bank returned on the name check.
  accountName     String?
  createdAt       DateTime @default(now())

  @@unique([ownerWawuId, recipientWawuId])
  @@unique([ownerWawuId, bankCode, accountNumber])
  @@index([ownerWawuId, createdAt])
}

/// The account a person's withdrawals go to by default (A21, W17). One per
/// person; saving another replaces it. The bank code is Fintava's and the
/// name is the one the bank returned on the name check, never typed. Whether
/// that name matches the BVN name is worked out on every read, from
/// `WalletIdentity.bvnNameKeys`, so it is never stale.
model MoneyPayoutAccount {
  wawuUserId    String   @id
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Schools (task SCHOOLS-01): schools, their courses and each course's dated
// intakes with a seat limit. Added from the dashboard (SCHOOLS-02), read by the
// app's SC1-SC3 and SC10 (SCHOOLS-04), enrolled into by SCHOOLS-07.
//
// Not the Learn tables above: LearnCourse / CourseEnrollment are WAWU's own
// courses hosted elsewhere and their enrol gate references the removed
// subscription. School enrolments never read them (SCHOOLS-07).
//
// No rating column on School: nothing writes a school rating and no screen
// collects one, so it is left off at launch until the owner rules (R-32).
// -----------------------------------------------------------------------------

/// SC1's category chips, exactly: Tech, Business, Creative, Languages,
/// Vocational. "All" is the absence of a filter, not a category.
enum SchoolCategory {
  tech
  business
  creative
  languages
  vocational
}

/// How a course is taught. SC2 lists it beside the length ("12 weeks ·
/// Online"); where the classes meet is the intake's `location`.
enum SchoolCourseMode {
  online
  in_person
  hybrid
}

model School {
  id          String         @id @default(uuid())
  name        String
  category    SchoolCategory
  /// Display place, as SC2 prints it: "Yaba, Lagos". SC1 shows it on the card.
  location    String
  /// SC2's "Since 2016". Null when the school has not said.
  foundedYear Int?
  /// SC2's expertise chips, in the order the dashboard set them.
  expertise   String[]
  /// SC2's blurb.
  about       String
  /// The school's logo image (a storage URL). Null: the app draws initials.
  logo        String?
  /// The school's own application page, for "Or apply on the school's
  /// website" (SC9, SCHOOLS-10). Null: the school takes no outside sign-ups.
  applyUrl    String?
  /// Where the enrolment report goes: the student's details, course and
  /// intake (SCHOOLS-09). Never shown in the app.
  reportEmail String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses SchoolCourse[]

  @@index([category])
  @@index([name])
}

model SchoolCourse {
  id        String           @id @default(uuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  /// SC3's "Length 12 weeks".
  weeks     Int
  mode      SchoolCourseMode
  /// SC3's numbered syllabus, in order.
  syllabus  String[]
  /// SC3's "You get": "Certificate", "mentor", "portfolio".
  outcomes  String[]
  /// The course fee in integer kobo (docs/contract/CONVENTIONS.md section 1).
  /// Int carries up to 21,474,836.47 naira, above the 10,000,000 naira
  /// merchant cap any one payment is bounded by.
  priceKobo Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intakes CourseIntake[]

  @@index([schoolId])
}

/// One dated class of a course. Seats are claimed by a CONDITIONAL write
/// (seatsTaken < capacity) inside the enrolment transaction, the
/// Product.stock pattern (SCHOOLS-07); the database also refuses a row whose
/// seatsTaken is negative or above capacity.
model CourseIntake {
  id         String       @id @default(uuid())
  courseId   String
  course     SchoolCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// The day classes start (SC3's "Starts Mon 3 November"). A calendar date,
  /// not an instant, so no time zone moves it.
  startDate  DateTime     @db.Date
  /// SC4's "Weekend class", SC3's "Saturdays".
  schedule   String
  /// Where this intake meets ("Yaba"). Null for an online intake.
  location   String?
  capacity   Int
  seatsTaken Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, startDate])
}

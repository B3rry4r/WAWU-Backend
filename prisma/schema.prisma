// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// WAWU Hub API — Prisma schema
//
// Built from .pipeline/registry.json (frozen, 39 resources) + dep-graph.json
// + conventions.md. See the schema-agent report for the full rationale;
// summarized judgment calls are called out inline as `// JUDGMENT:` comments.
//
// Auth model: this backend has NO local User table. Every `*WawuId` /
// `*WawuUserId` field below is a plain, indexed String holding WAWU ID's own
// `sub` claim — never a Prisma relation() to a local model, even where the
// referenced concept (e.g. CreatorState) happens to be keyed by wawuUserId.
// Identity lives in WAWU ID; this backend only stores WAWUAfrica-specific
// state keyed by that foreign identity string. Relations are only modeled
// between resources this backend actually owns end-to-end (ContentPiece ->
// CourseLesson, Community -> CommunityMessage, etc).
//
// Four resources in the registry are NOT modeled as tables here:
//   - SearchResponse: fields: [] — pure computed aggregate, no storage.
//   - Account: fields: [] — DELETE /account acts on wawuUserId directly,
//     nothing to store; BlockedAccount does not need a real FK to it.
//   - CreatorEarnings: registry's own endpoint note says explicitly "not a
//     running ledger balance" — it's a flat aggregate computed at request
//     time across Purchase + DirectMessage + CreditSpend + CreatorSubscription.
//     Modeled as a wire-response interface only (src/common/types/).
//   - LearnEntitlement: every field (tier, freeCoursesTotal, freeCoursesUsed,
//     enrolledCourseIds) is fully derivable from CreatorState.tier +
//     CourseEnrollment rows — no independent state to persist. Wire-response
//     interface only.
// =============================================================================

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum AccountType {
  user
  creator
}

enum CreatorTier {
  basic
  pro
}

/// Shared by CreatorState.kycStatus, KycSubmission.status and
/// VerificationSubmission.status — all three are the same pending/approved/
/// rejected review lifecycle.
enum ReviewStatus {
  pending
  approved
  rejected
}

enum VerificationTier {
  basic
  verified_user
  verified_business
  certified_professional
  trusted_partner
}

enum ContentType {
  video
  course
  audio
  pdf
  image
  template
}

enum AccessType {
  free
  paid
}

enum ContentStatus {
  pending
  live
  rejected
}

enum PurchaseType {
  content
  tip
}

/// Shared by Purchase.status and CreditPurchase.status.
enum TransactionStatus {
  pending
  completed
  failed
}

enum DmStatus {
  awaiting_response
  responded
  refunded
}

/// Where a paid DM's MONEY is, as distinct from where the message is.
/// `DmStatus.refunded` only ever meant "the entitlement was reversed" — the
/// creator stops being owed it and the thread renders as refunded. It said
/// nothing about whether the payer's card was actually credited, because
/// nothing in this codebase could do that. These two facts are now tracked
/// separately, because they genuinely can disagree: Flutterwave can refuse a
/// refund on a transaction it has already settled, and a system that treats
/// "I decided to refund you" as "you have your money" is one that lies to
/// the payer at exactly the moment they are owed the truth.
enum DmRefundStatus {
  /// The default. Nothing is owed back — the DM was answered, or is still
  /// inside its window.
  not_owed
  /// Owed and not yet sent. The sweep sets this; the refund executor works
  /// through them.
  owed
  /// Flutterwave accepted it but has not confirmed settlement.
  submitted
  /// Money is back with the payer. Only now is the payer told.
  settled
  /// Flutterwave refused, or we ran out of attempts. Needs a human — this is
  /// what the finance queue lists.
  failed
}

enum PenaltyState {
  none
  warned
  disabled_7d
  disabled_30d
}

enum CommunityKind {
  open
  private
}

enum MembershipStatus {
  joined
  pending
}

enum CreditPack {
  starter
  popular
  pro
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  expired
}

enum PartnerServiceStatus {
  live
  coming
}

enum ServiceApplicationKind {
  cac
  nepc
  mentor_request @map("mentor-request")
  /// Carried over from the previous platform. Each is a short request a
  /// partner then reviews (ARM Pension, WEMA Bank, WAWUAfrica).
  ///
  /// `easybuy` is retained only because dropping a Postgres enum value means
  /// rewriting the type and every column using it. The CredPal partnership
  /// behind it has ended and no code path accepts it any more.
  easybuy
  pension
  banking
  grants
  loans
}

enum GuideKind {
  country
  article
  template
}

enum ShopKind {
  basket
  beauty
}

// -----------------------------------------------------------------------------
// Identity / profile / creator gates
// -----------------------------------------------------------------------------

/// One row per WAWU user who has completed onboarding on this app. Created on
/// first PATCH /users/me (post-signup onboarding), updated thereafter.
model UserProfile {
  wawuUserId      String      @id
  accountType     AccountType
  handle          String?     @unique
  bio             String?
  interests       String[]
  instagramHandle String?
  whatsappHandle  String?
  websiteUrl      String?
  /// Where else a creator can be reached. Handles are stored without the "@";
  /// the full URLs are stored as given.
  xHandle         String?
  tiktokHandle    String?
  youtubeUrl      String?
  facebookUrl     String?
  linkedinUrl     String?
  createdAt       DateTime    @default(now())

  @@index([accountType])
}

/// Creator-only entitlement/gate state. Two independent gates per CLAUDE.md:
/// subscriptionPaid gates uploading, kycStatus=approved gates earning.
/// `slotsTotal` is deliberately NOT a column — it derives from `tier`
/// (registry's own example of a derived field) and is computed in the wire
/// response / service layer, never stored.
model CreatorState {
  wawuUserId       String       @id
  tier             CreatorTier
  subscriptionPaid Boolean      @default(false)
  kycStatus        ReviewStatus @default(pending)
  slotsUsed        Int          @default(0)
  dmPrice          Int?
  dmEnabled        Boolean      @default(false)
  /// Hours the creator has to reply before the payer is refunded. 24 was
  /// hardcoded, which is right for a fan message and wrong for a
  /// professional quoting on a case. Bounded in the DTO, not here.
  dmResponseHours  Int          @default(24)

  @@index([tier])
  @@index([kycStatus])
}

/// WAWU ID verification-tier ladder (Basic -> Verified User -> Verified
/// Business -> Certified Professional -> Trusted Partner). This backend owns
/// only the submission/review workflow; the resulting tier value is written
/// back to WAWU ID (conventions.md § Auth model) and is NOT this table's
/// concern to keep in sync. Multiple rows per user over time are expected
/// (resubmission), so no unique on wawuUserId — history is a business
/// requirement.
model VerificationSubmission {
  id              String           @id @default(uuid())
  wawuUserId      String
  tier            VerificationTier
  status          ReviewStatus     @default(pending)
  documents       String[]
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([wawuUserId])
  @@index([status])
}

/// Creator KYC (BVN/NIN or national-ID equivalent + payout bank details).
/// Fully owned by this backend, entirely separate from verification tier
/// (CLAUDE.md non-negotiable — never collapse the two). One "active"
/// submission per wawuUserId is a business rule enforced in service logic,
/// NOT a DB unique — resubmission needs history, per the task brief.
model KycSubmission {
  id                   String       @id @default(uuid())
  wawuUserId           String
  country              String
  bvn                  String?
  nin                  String?
  nationalIdEquivalent String?
  idDocumentType       String
  idDocumentUrl        String
  payoutBankName       String
  payoutAccountNumber  String
  status               ReviewStatus @default(pending)
  rejectionReason      String?
  submittedAt          DateTime     @default(now())
  reviewedAt           DateTime?

  @@index([wawuUserId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Content
// -----------------------------------------------------------------------------

/// `fullAssetLocked` (registry: "derived") is intentionally not a column —
/// it's computed at read time from accessType/price + whether the requester
/// has a completed Purchase. `fullAssetUrl` IS a real stored column (the
/// actual asset location); the derivation only governs whether it's *returned*
/// to a given requester, which is a wire-layer / service-layer concern.
///
/// JUDGMENT: `tags: String[]` is added even though it's absent from this
/// resource's top-level `fields` array in registry.json — it appears in the
/// POST /content request body (`tags: string[], nullable: true`) with no
/// other place to land it. Treated as a registry omission (endpoint contract
/// vs. resource field list drift), not a deliberate exclusion.
model ContentPiece {
  id                     String        @id @default(uuid())
  slug                   String        @unique
  creatorWawuId          String
  contentType            ContentType
  title                  String
  description            String
  category               String
  tags                   String[]      @default([])
  accessType             AccessType
  price                  Int
  durationLabel          String?
  pageCount              Int?
  previewAssetUrl        String
  fullAssetUrl           String?
  creatorFirstUploadFree Boolean       @default(false)
  status                 ContentStatus @default(pending)
  views                  Int           @default(0)
  ratingPct              Int?
  commentCount           Int           @default(0)
  likes                  Int           @default(0)
  createdAt              DateTime      @default(now())

  lessons   CourseLesson[]
  comments  Comment[]
  purchases Purchase[]
  savedBy   SavedItem[]

  @@index([creatorWawuId])
  @@index([status])
  @@index([category])
  @@index([contentType])
  /// Feed/explore reads are always "approved content, newest first" — the
  /// single-column status index still left Postgres sorting the whole
  /// approved set.
  @@index([status, createdAt])
}

/// `locked` (registry: "derived from purchase state") intentionally not a
/// column — computed per-requester at read time.
model CourseLesson {
  id            String       @id @default(uuid())
  contentId     String
  content       ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  title         String
  order         Int
  durationLabel String?

  @@index([contentId])
}

model Comment {
  id           String       @id @default(uuid())
  contentId    String
  content      ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorWawuId String
  text         String
  replyToId    String?
  /// onDelete: SetNull — `NoAction` meant deleting a parent comment blew up
  /// on the FK from its own replies (a 500 on a perfectly ordinary delete).
  /// `replyToId` is already nullable, so an orphaned reply simply becomes a
  /// top-level comment rather than disappearing with the parent.
  replyTo      Comment?     @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Comment[]    @relation("CommentReplies")
  likes        Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([contentId])
  @@index([authorWawuId])
}

// -----------------------------------------------------------------------------
// Transactions
// -----------------------------------------------------------------------------

/// Covers both content purchases and tips (`contentId` null for tips, per
/// registry note). `commissionRate` is snapshotted at transaction time —
/// never recomputed from the creator's current tier later (conventions.md).
model Purchase {
  id               String            @id @default(uuid())
  contentId        String?
  /// Restrict, not SetNull: a Purchase is a financial record of what a buyer
  /// paid for. SetNull let a content deletion silently blank that link on
  /// every buyer's row — the payment survived but no longer said what it
  /// bought, breaking entitlement checks and receipts. Content that has been
  /// sold must be unpublished, never hard-deleted.
  content          ContentPiece?     @relation(fields: [contentId], references: [id], onDelete: Restrict)
  type             PurchaseType
  buyerWawuId      String
  creatorWawuId    String
  amount           Int
  commissionRate   Decimal           @db.Decimal(5, 4)
  /// Payment lookup key — every Flutterwave verify/webhook finds the row by
  /// this. Unique both because a duplicate here means a double-credited
  /// payment, and because the lookup was a sequential scan without it.
  flutterwaveTxRef String            @unique
  flutterwaveTxId  String?
  status           TransactionStatus @default(pending)
  note             String?
  purchasedAt      DateTime          @default(now())

  @@index([buyerWawuId])
  @@index([creatorWawuId])
  @@index([contentId])
  @@index([status])
  @@index([type])
}

model SavedItem {
  id         String       @id @default(uuid())
  userWawuId String
  contentId  String
  content    ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  savedAt    DateTime     @default(now())

  @@unique([userWawuId, contentId])
  @@index([userWawuId])
  @@index([contentId])
}

model FollowRelationship {
  id              String   @id @default(uuid())
  followerWawuId  String
  followingWawuId String
  createdAt       DateTime @default(now())

  @@unique([followerWawuId, followingWawuId])
  @@index([followerWawuId])
  @@index([followingWawuId])
}

// -----------------------------------------------------------------------------
// Direct messages (paid DMs)
// -----------------------------------------------------------------------------

model DirectMessage {
  id               String    @id @default(uuid())
  creatorWawuId    String
  senderWawuId     String
  text             String
  amount           Int
  status           DmStatus  @default(awaiting_response)
  sentAt           DateTime  @default(now())
  deadlineAt       DateTime
  respondedAt      DateTime?
  responseText     String?
  /// Payment lookup key — see Purchase.flutterwaveTxRef.
  flutterwaveTxRef String    @unique
  /// Flutterwave's own numeric transaction id, captured at verify time.
  /// REQUIRED to refund: POST /v3/transactions/:id/refund is keyed by this,
  /// not by tx_ref. It was being discarded, which is the concrete reason no
  /// expired DM could ever be refunded even once an adapter existed.
  /// Nullable because rows created before this column shipped never had it.
  flutterwaveTxId  String?

  /// How long the creator had to reply, snapshotted in hours at the moment
  /// the payer was charged. Stored rather than recomputed so that changing
  /// the setting never moves a deadline someone has already paid against.
  responseWindowHours Int    @default(24)

  refundStatus     DmRefundStatus @default(not_owed)
  /// Flutterwave's refund id, for reconciliation against their dashboard.
  refundReference  String?
  /// When the money was confirmed back with the payer — NOT when we decided.
  refundedAt       DateTime?
  refundAttempts   Int       @default(0)
  /// Why the last attempt failed, verbatim from Flutterwave where possible.
  /// Read by a human working the finance queue, so it keeps their wording.
  refundError      String?
  /// Set when a refund attempt is in flight, cleared when it resolves. Two
  /// schedulers (or a scheduler and a hand-run retry) must never both be
  /// calling Flutterwave for the same transaction — a double refund is real
  /// money out the door and Flutterwave will happily process one.
  refundLockedAt   DateTime?

  reports DmReport[]

  @@index([creatorWawuId])
  @@index([senderWawuId])
  @@index([status, deadlineAt])
  @@index([refundStatus, refundLockedAt])
}

/// Rolling per-creator stats maintained by the DM-deadline-sweep cron job
/// (conventions.md § Scheduled/background jobs). Single evolving row per
/// creator, not a history log.
model CreatorNoResponseTracker {
  creatorWawuId     String       @id
  noResponseRatePct Decimal      @default(0) @db.Decimal(5, 2)
  penaltyState      PenaltyState @default(none)
  dmDisabledUntil   DateTime?
}

/// JUDGMENT: added `@@unique([threadId, reporterWawuId])` — not specified in
/// the registry, but a sensible constraint (one report per reporter per
/// thread) consistent with the "sensible uniques" instruction.
model DmReport {
  id             String        @id @default(uuid())
  threadId       String
  thread         DirectMessage @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reporterWawuId String
  createdAt      DateTime      @default(now())

  @@unique([threadId, reporterWawuId])
  @@index([threadId])
  @@index([reporterWawuId])
}

// -----------------------------------------------------------------------------
// Communities & credits
// -----------------------------------------------------------------------------

/// `memberCount` / `messagesToday` (registry: "derived") intentionally not
/// columns — computed via count() over CommunityMembership / CommunityMessage
/// at read time.
model Community {
  id          String        @id @default(uuid())
  name        String
  description String
  hostWawuId  String
  kind        CommunityKind
  /// Room cover image — the URL returned by POST /uploads/presign for the
  /// `community/image` folder. Nullable: every community that existed before
  /// this column has none, and a host is never forced to pick one. Clients
  /// keep their placeholder tile as the fallback.
  imageUrl    String?

  memberships  CommunityMembership[]
  messages     CommunityMessage[]
  creditSpends CreditSpend[]

  @@index([hostWawuId])
  @@index([kind])
}

model CommunityMembership {
  id          String           @id @default(uuid())
  userWawuId  String
  communityId String
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  status      MembershipStatus @default(joined)
  /// When the row was created, i.e. when the user asked to join. Distinct from
  /// `joinedAt`, which stays null until a private community's host approves.
  /// The host's review queue (GET /communities/:id/requests) is ordered by
  /// this, so "who has been waiting longest" is answerable; without it a
  /// pending row carried no timestamp at all and the queue could only be
  /// ordered by a random uuid.
  requestedAt DateTime         @default(now())
  joinedAt    DateTime?

  @@unique([userWawuId, communityId])
  @@index([userWawuId])
  @@index([communityId])
  @@index([communityId, status])
}

/// A message is TEXT, an IMAGE, or both — never neither. `text` was
/// NOT NULL, so a member could not post a photo at all on a platform whose
/// categories are fashion, food, crafts, art and beauty. Both columns are
/// nullable so either half can be absent; the "not both null" invariant is
/// enforced in CommunityMessageService.create and again by the
/// `CommunityMessage_text_or_image` CHECK constraint in the migration.
model CommunityMessage {
  id            String    @id @default(uuid())
  communityId   String
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  senderWawuId  String
  text          String?
  /// Photo posted in the room — a `community/message` presigned upload URL.
  imageUrl      String?
  costInCredits Int       @default(1)
  sentAt        DateTime  @default(now())

  @@index([communityId])
  @@index([senderWawuId])
}

model CreditsState {
  userWawuId    String   @id
  creditBalance Int      @default(0)
  trialEndsAt   DateTime
}

model CreditPurchase {
  id               String            @id @default(uuid())
  userWawuId       String
  pack             CreditPack
  creditsGranted   Int
  /// Payment lookup key — see Purchase.flutterwaveTxRef.
  flutterwaveTxRef String            @unique
  amount           Int
  status           TransactionStatus @default(pending)
  purchasedAt      DateTime          @default(now())
  /// The cost-basis lot this purchase opens. Created ONLY when the charge is
  /// verified `completed` — see CreditLot.
  lot              CreditLot?

  @@index([userWawuId])
  @@index([status])
}

/// JUDGMENT: registry lists no `id` field for CreditSpend (append-only
/// per-message ledger row, analogous to Purchase). A synthetic UUID PK is
/// added since there is no natural key — (userWawuId, communityId, spentAt)
/// is not guaranteed unique to the second.
model CreditSpend {
  id            String              @id @default(uuid())
  userWawuId    String
  communityId   String
  community     Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creditsSpent  Int                 @default(1)
  creatorWawuId String
  spentAt       DateTime            @default(now())
  /// What the host actually earned for this spend. Written in the same
  /// transaction as the row above — see CreditSpendEarning.
  earning       CreditSpendEarning?

  @@index([userWawuId])
  @@index([communityId])
  @@index([creatorWawuId])
}

/// ONE PURCHASED PACK OF CREDITS, AS A COST-BASIS LOT.
///
/// Why this table exists at all: docs/01_SPEC.md §1 row 4 sells community
/// credits at "Creator 90% / WAWU 10%", and §3 calls that "deliberately a
/// better split than every other stream". Nothing could pay it, because a
/// credit is bought in a PACK and spent one at a time, and CreditSpend had
/// no way to say what naira a single spent credit represented. The three
/// packs are NOT the same price per credit — ₦500/50 = ₦10.00,
/// ₦1,000/120 = ₦8.33…, ₦2,000/300 = ₦6.66… — so "the" per-credit price
/// does not exist platform-wide; it only exists per purchase.
///
/// So each completed CreditPurchase opens a lot carrying the exact money
/// WAWU actually collected (`grossKobo`) and the credits it bought
/// (`creditsGranted`). Spends draw the lot down oldest-first (FIFO) and
/// each drawn credit carries its own lot's cost basis into
/// CreditSpendEarning. See src/credit-spend/credit-spend.service.ts for
/// the full reasoning, including why FIFO and not a blended rate.
///
/// INVARIANT: `allocatedKobo <= grossKobo` and
/// `creditsRemaining + creditsConsumed = creditsGranted` for every lot, so
/// the sum of every host share ever computed can never exceed 90% of the
/// money WAWU actually banked. That is the whole point of the model.
model CreditLot {
  id               String         @id @default(uuid())
  /// One lot per completed purchase. The @unique is the idempotency key:
  /// a re-verified purchase cannot open a second lot and mint free money.
  creditPurchaseId String         @unique
  creditPurchase   CreditPurchase @relation(fields: [creditPurchaseId], references: [id], onDelete: Cascade)
  userWawuId       String
  creditsGranted   Int
  /// Credits in this lot not yet consumed by a spend. Drawn down by a
  /// conditional UPDATE guarded on `creditsRemaining >= n`, so two
  /// concurrent sends can never consume the same credit.
  creditsRemaining Int
  /// Integer minor units (kobo). The naira WAWU actually collected for this
  /// pack — never a list price, never a per-credit rate.
  grossKobo        Int
  /// Kobo of `grossKobo` already attributed to spends. Distributed by
  /// largest-remainder so a fully consumed lot allocates EXACTLY grossKobo:
  /// no kobo invented, none lost.
  allocatedKobo    Int            @default(0)
  purchasedAt      DateTime       @default(now())

  @@index([userWawuId, purchasedAt])
}

/// WHAT ONE COMMUNITY HOST EARNED FROM ONE SPENT CREDIT.
///
/// Materialised at spend time rather than derived at read time, because it
/// is NOT derivable later: the answer depends on which lots were open at
/// that moment, and lots get consumed. This is the same reason
/// Purchase.commissionRate is snapshotted rather than recomputed.
///
/// This table is a HOST EARNINGS ledger, not a wallet and not a balance.
/// It never grants anybody a spendable naira figure, it is never summed
/// into anything a member sees, and no user-facing surface turns a credit
/// COUNT into naira because of it (CLAUDE.md, non-negotiable). It exists so
/// GET /content/mine/earnings can tell a host the truth about the 90% the
/// product already promised them on six screens.
model CreditSpendEarning {
  id                String      @id @default(uuid())
  creditSpendId     String      @unique
  creditSpend       CreditSpend @relation(fields: [creditSpendId], references: [id], onDelete: Cascade)
  /// Denormalised from CreditSpend so the earnings rollup is one indexed
  /// read, matching how Purchase/DirectMessage are aggregated.
  creatorWawuId     String
  communityId       String
  /// Credits this message cost (CommunityMessage.costInCredits).
  creditsSpent      Int
  /// How many of those credits were backed by a completed purchase.
  /// `creditsSpent - creditsFunded` were trial-covered or otherwise
  /// unbacked, and are worth exactly ₦0 to the host because WAWU collected
  /// exactly ₦0 for them.
  creditsFunded     Int
  /// Kobo WAWU collected for the funded credits. Sum of the largest-
  /// remainder allocations taken out of `lots`.
  grossKobo         Int
  /// 90% of grossKobo, floored to the kobo (docs/01_SPEC.md §1 row 4).
  hostShareKobo     Int
  /// grossKobo - hostShareKobo. Always >= 10% — the floor above rounds the
  /// residual kobo to WAWU, so a payout can never exceed what was banked.
  platformShareKobo Int
  /// Which lot(s) funded this spend, oldest first. Audit trail: a host
  /// share can always be traced back to the Flutterwave charge that paid
  /// for it. A plain id array rather than a relation — this is read by
  /// humans doing a reconciliation, never joined in a hot path, and an
  /// implicit m2m join table would be three tables of machinery for that.
  lotIds            String[]
  earnedAt          DateTime    @default(now())

  @@index([creatorWawuId])
  @@index([creatorWawuId, earnedAt])
}

// -----------------------------------------------------------------------------
// Creator subscription / earnings / scoring
// -----------------------------------------------------------------------------

/// Single evolving row per creator (not a billing-history ledger — that's
/// GET /creator-subscription/billing-history, served from CreditPurchase-
/// shaped rows / Flutterwave data, not modeled as its own table since the
/// registry gives it no dedicated resource).
/// A charge that has been initiated with Flutterwave but not yet verified.
///
/// This bridge used to be a process-local `Map` in CreatorSubscriptionService
/// and DirectMessageService. Any deploy, crash or second replica between the
/// checkout popup opening and its callback firing lost the record entirely:
/// the customer was charged at Flutterwave and this backend had nothing to
/// reconcile against. Railway scales by default, so that window was real.
///
/// Rows are short-lived — deleted on successful verify, and safe to sweep
/// after a day or so once reconciled.
model PendingCharge {
  /// The Flutterwave tx_ref. One charge, one row.
  txRef          String   @id
  /// Which flow created it: 'subscribe' | 'upgrade' | 'dm'.
  kind           String
  /// The caller the charge belongs to. Verify must match this.
  wawuUserId     String
  /// Naira the SERVER intended to charge. Verification enforces
  /// `amount >= expectedAmount` — the client supplies the amount to the
  /// inline SDK, so this is what stops a ₦1 payment buying a ₦18,999 tier.
  expectedAmount Int
  /// Flow-specific context (tier + planId for subscriptions, threadId/text
  /// for a paid DM). Kept as JSON so one table serves every money flow.
  context        Json
  createdAt      DateTime @default(now())

  @@index([wawuUserId])
  @@index([createdAt])
}

model CreatorSubscription {
  creatorWawuId          String             @id
  tier                   CreatorTier
  status                 SubscriptionStatus @default(active)
  commissionRateOverride Decimal?           @db.Decimal(5, 4)
  flutterwaveCustomerRef String?
  flutterwavePlanId      String?
  currentPeriodEnd       DateTime
  renewalAttempts        Int                @default(0)
  cancelsAt              DateTime?
  cardLast4              String?
  /// Scheduled tier change. A downgrade (Pro -> Basic) does NOT take effect
  /// on the day it is requested: the annual term has already been paid in
  /// full and DELETE/downgrade give no refund, so revoking Pro immediately
  /// would confiscate something the creator bought. `pendingTier` records
  /// the tier the subscription moves to, and `tierChangesAt` records when
  /// (always the end of the paid term). Both are cleared the moment the
  /// change is applied. Null/null means "no change scheduled".
  pendingTier            CreatorTier?
  tierChangesAt          DateTime?

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([tierChangesAt])
}

/// `score` is a periodically-recomputed cache (views + purchases*weight +
/// comments, per registry note) — the row itself IS stored (hence
/// `updatedAt`), even though the computation reads across multiple tables.
model EvgScore {
  creatorWawuId String   @id
  score         Int      @default(0)
  updatedAt     DateTime @updatedAt
}


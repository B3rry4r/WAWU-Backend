// ---------------------------------------------------------------------------
// Lifestyle Services — WAWUPay (bills), WAWUCare (health), WAWU Legal.
//
// All three follow the same shape: the user pays WAWU through Flutterwave
// checkout, the server verifies that payment, and only then does WAWU call the
// partner to fulfil. Fulfilment is therefore a second step that can fail on its
// own, which is why every one of these carries a status separate from the
// payment and keeps the provider's own reference for reconciliation.
// ---------------------------------------------------------------------------

/// Payment taken, fulfilment still owed. `paid` means WAWU has the money but
/// the partner has not delivered yet — the state a refund sweep looks for.
enum FulfilmentStatus {
  pending
  paid
  delivered
  failed
  refunded
}

/// WAWUPay. One row per bill the user pays through Flutterwave's Bills API.
model BillPayment {
  id          String @id @default(uuid())
  buyerWawuId String
  /// Flutterwave bill category slug (AIRTIME, DATA_BUNDLE, POWER, CABLEBILLS…).
  category    String
  billerCode  String
  itemCode    String
  billerName  String
  /// Phone number, meter number or smartcard number, depending on the biller.
  customerRef String
  amount      Int
  fee         Int    @default(0)

  /// The user's card payment to WAWU.
  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  /// Flutterwave's reference for the bill we then paid on their behalf.
  providerReference String?
  providerStatus    String?
  failureReason     String?

  status      FulfilmentStatus @default(pending)
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?

  /// Set only by the operator refund endpoint, which RECORDS a refund that was
  /// actually paid back to the customer by hand. Nothing in this codebase can
  /// move money back to a card — there is no Flutterwave refund adapter — so
  /// `refundReference` is the real-world reference of that manual refund and
  /// `status = refunded` is never written without one.
  refundReference String?
  refundedAt      DateTime?

  @@index([buyerWawuId])
  @@index([status])
  @@index([status, createdAt])
}

/// WAWUCare. A WellaHealth (Zoi) health plan subscription bought in-app.
model HealthSubscription {
  id         String @id @default(uuid())
  wawuUserId String

  planCode String
  planName String
  price    Int

  /// WellaHealth keys the enrollee on phone number, so it is required here.
  phoneNumber String
  firstName   String
  lastName    String
  gender      String
  dateOfBirth String
  email       String?

  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  policyNumber      String?
  providerReference String?
  failureReason     String?

  status    FulfilmentStatus @default(pending)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime         @default(now())

  /// Same contract as BillPayment: written only when a human has actually
  /// refunded the customer, and never without the reference of that refund.
  refundReference String?
  refundedAt      DateTime?

  @@index([wawuUserId])
  @@index([status])
}

/// WAWU Legal routes on this. `simple` is form-in, document-out with no lawyer
/// in the loop; `consultation` requires a paid consultation before WAWU can
/// even quote the work.
enum LegalPath {
  simple
  consultation
}

enum ConsultationMedium {
  chat
  zoom
  physical
}

/// The full lifecycle of a legal request. A `simple` request skips straight
/// from awaiting_payment to in_progress; a `consultation` one walks the whole
/// ladder, and can never reach in_progress without a signed contract.
enum LegalRequestStatus {
  draft
  /// Submitted, price to be agreed. Simple services whose fee WAWU sets after
  /// looking at the request rather than off a price list.
  awaiting_quote
  awaiting_consultation_payment
  consultation_scheduled
  consultation_done
  quoted
  contract_signed
  awaiting_service_payment
  in_progress
  delivered
  cancelled
}

model LegalRequest {
  id          String             @id @default(uuid())
  wawuUserId  String
  serviceCode String
  serviceName String
  category    String
  path        LegalPath
  status      LegalRequestStatus @default(draft)

  /// Whatever the service's intake form collected.
  details   Json?
  documents String[] @default([])

  consultationMedium ConsultationMedium?
  consultationFee    Int?
  consultationTxRef  String?             @unique
  consultationPaidAt DateTime?
  scheduledFor       DateTime?
  consultationNotes  String?

  /// What WAWU quotes after the consultation.
  quoteAmount Int?
  quoteNote   String?

  /// Signing is a liability record, so it keeps the exact text agreed to
  /// rather than a pointer to a template that may later change.
  contractText     String?
  contractSignedAs String?
  contractSignedAt DateTime?
  contractSignedIp String?

  serviceTxRef   String?   @unique
  servicePaidAt  DateTime?
  deliverableUrl String?
  deliveredAt    DateTime?

  /// Why WAWU closed the matter without delivering it. Required by the ops
  /// cancel endpoint, because "cancelled" with no reason is what strands a
  /// client who has already paid. It does NOT imply a refund: money already
  /// taken is refunded by hand, and nothing here claims otherwise.
  cancellationReason String?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wawuUserId])
  @@index([status])
  @@index([serviceCode])
}

// -----------------------------------------------------------------------------
// Admin identity (admin-surface-extension Phase 5) — ADDITIVE ONLY
//
// This is the first admin identity this backend has ever had. It is
// deliberately a table of its own rather than a role on any existing row:
// user identity lives in WAWU ID (SSO) and this backend has no local User
// table at all, so there is nothing to hang an `isAdmin` flag off even if we
// wanted to — and we do not. An operator account and a customer account are
// different things with different lifecycles, different credentials and
// different blast radius.
//
// Nothing above this line is touched by the migration that introduces these
// two enums and this table.
// -----------------------------------------------------------------------------

/// Operator sub-roles. See src/admin/auth/admin-auth.module.ts for the
/// capability matrix these map to — the matrix is the contract every later
/// admin resource gates against.
enum AdminRole {
  superadmin
  reviewer
  support
  finance
}

enum AdminUserStatus {
  active
  suspended
}

model AdminUser {
  id           String          @id @default(uuid())
  email        String          @unique
  /// argon2id. Never selected into any response — every read goes through
  /// toAdminUserView() in src/admin/auth/admin-user-view.type.ts.
  passwordHash String
  name         String
  role         AdminRole
  status       AdminUserStatus @default(active)

  /// Bumped to revoke every outstanding token for this admin without a
  /// session table: the value is stamped into both the access and the
  /// refresh token and re-checked on every request.
  tokenVersion Int @default(0)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([role])
  @@index([status])
}

enum AdminContentDecision {
  approved
  rejected
}

/// Moderation audit trail for ContentPiece — admin-surface-extension Phase 6.
///
/// A SIDE TABLE, not columns on ContentPiece, and that is not a style
/// preference: protected-surface hazard H-1 records that 28 of 39 wire types
/// in src/common/types are bare re-exports of their Prisma model returned by
/// spread, so a `moderationReason` column on ContentPiece would appear
/// verbatim in the shipped app's content responses the moment it existed.
///
/// No FK to ContentPiece or AdminUser, matching the idiom every
/// cross-boundary reference in this schema already uses (KycSubmission
/// .wawuUserId, Purchase.buyerWawuId): a relation field would have to be
/// added to the ContentPiece model block, and an audit row must outlive the
/// thing it audits anyway. Reviewer email and role are SNAPSHOTS for the same
/// reason — "who approved this" has to stay answerable after that admin is
/// renamed, suspended, or deleted.
model AdminContentReview {
  id            String @id @default(uuid())
  contentId     String
  /// Snapshot: which creator this decision landed on.
  creatorWawuId String

  decision       AdminContentDecision
  /// The status the piece held immediately before this decision, and the one
  /// written by it. Stored rather than inferred so the trail still reads
  /// correctly after a later decision moves the piece again.
  previousStatus ContentStatus
  newStatus      ContentStatus
  /// Required on a rejection (enforced in the DTO + service), null on approval.
  reason         String?
  /// Whether this decision handed the creator's upload slot back
  /// (CreatorState.slotsUsed decrement). Recorded per row so a slot ledger can
  /// be reconstructed from the audit trail alone.
  slotReturned   Boolean              @default(false)

  reviewedByAdminId    String
  reviewedByAdminEmail String
  reviewedByAdminRole  AdminRole
  reviewedAt           DateTime  @default(now())

  @@index([contentId])
  @@index([reviewedByAdminId])
  @@index([reviewedAt])
}

enum AdminKycAction {
  document_viewed
  identifiers_revealed
  approved
  rejected
}

/// Audit trail for the admin KYC-review surface — admin-surface-extension
/// Phase 6.
///
/// A SIDE TABLE for the same reason AdminContentReview is one: protected-
/// surface hazard H-1 records that 28 of 39 wire types in src/common/types
/// are bare re-exports of their Prisma model returned by spread, so a
/// `reviewedByAdminId` column on KycSubmission would appear verbatim in the
/// shipped app's `GET /kyc` response the moment it existed — and that
/// response goes to the creator, who has no business seeing which reviewer
/// looked at their file.
///
/// Unlike AdminContentReview this table records READS as well as decisions,
/// because a read here is a disclosure: `document_viewed` is someone opening
/// a government ID, and `identifiers_revealed` is someone unmasking a BVN,
/// NIN or payout account number. Those are the rows a breach investigation
/// needs, and they are exactly the ones a decision-only trail would not have.
/// `previousStatus` / `newStatus` / `reason` are therefore null on a read row.
///
/// No FK to KycSubmission or AdminUser, matching every cross-boundary
/// reference in this schema (KycSubmission.wawuUserId, Purchase.buyerWawuId).
/// Reviewer email and role are SNAPSHOTS: "who opened this ID" must stay
/// answerable after that admin is renamed, suspended, or deleted.
///
/// The signed URL itself is NEVER stored here. It is a bearer token for a
/// government ID; the audit records that a fetch happened, never the means to
/// repeat it.
model AdminKycAudit {
  id                String @id @default(uuid())
  submissionId      String
  /// Snapshot of whose earning gate this action touched.
  subjectWawuUserId String

  action         AdminKycAction
  /// Both null unless this row is a decision — a view or a reveal moves
  /// nothing. Stored rather than inferred so the trail still reads correctly
  /// after a later resubmission moves the creator on.
  previousStatus ReviewStatus?
  newStatus      ReviewStatus?
  /// Required on a rejection (enforced in the DTO and again by the existing
  /// KycSubmissionService.review); null on every other action.
  reason         String?

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([submissionId])
  @@index([subjectWawuUserId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

enum AdminVerificationAction {
  document_viewed
  approved
  rejected
}

/// Audit trail for the admin verification-TIER review surface —
/// admin-surface-extension Phase 6.
///
/// A SEPARATE table from AdminKycAudit, deliberately, and not a shared
/// "review audit" with a resource discriminator. CLAUDE.md's non-negotiables
/// and the derived-surface guardrails both say the earning gate (KYC) and the
/// public trust badge (this ladder) are two independent systems, and this has
/// already shipped as a bug once — the app described "Government ID submitted
/// and approved by hand" on a rung of this ladder. One table would put a BVN
/// disclosure and a business-certificate view in the same query, which is how
/// the two get conflated again.
///
/// There is no `identifiers_revealed` action here because this resource holds
/// no identifiers to reveal: a VerificationSubmission is a tier and a list of
/// document keys, nothing more.
model AdminVerificationAudit {
  id                String           @id @default(uuid())
  submissionId      String
  /// Snapshot of whose badge this action touched.
  subjectWawuUserId String
  /// Snapshot of the rung applied for. Stored because the row it describes is
  /// history the moment a later submission supersedes it.
  tier              VerificationTier

  action               AdminVerificationAction
  previousStatus       ReviewStatus?
  newStatus            ReviewStatus?
  reason               String?
  /// Which entry of VerificationSubmission.documents was fetched. Null on a
  /// decision row.
  documentIndex        Int?
  /// True only on an approval that actually reached WAWU ID. The existing
  /// VerificationSubmissionService elevates the tier BEFORE writing the local
  /// approval precisely so a failed callback leaves the submission pending and
  /// retryable — so an approval row can only exist once the elevation
  /// succeeded, and recording it makes that ordering auditable rather than
  /// merely commented.
  tierElevatedAtWawuId Boolean                 @default(false)

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([submissionId])
  @@index([subjectWawuUserId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

/// Inbound Flutterwave webhook deliveries — audit trail AND the exactly-once
/// claim for settlement driven by the provider rather than by the browser.
///
/// A NEW table on purpose. 28 of the 39 wire types are bare Prisma re-exports
/// returned by spread, so adding a column to Purchase / PendingCharge /
/// BillPayment to track webhook state would silently widen a live app
/// response. Nothing here is ever returned to the app.
model PaymentWebhookReceipt {
  id String @id @default(uuid())

  /// `${event}:${txRef}` — one settlement attempt per event per charge.
  /// UNIQUE, and the atomic `create` against it IS the claim: a duplicate
  /// delivery loses the insert race (P2002) and never reaches settlement.
  deliveryKey String @unique

  /// Flutterwave's event name, e.g. `charge.completed`.
  event         String
  /// The `tx_ref` this backend issued when the charge was opened.
  txRef         String
  /// Flutterwave's own transaction id from the payload. Only ever used as the
  /// id to re-verify AGAINST Flutterwave — never as proof of anything.
  transactionId String?

  /// received | settled | rejected | unmatched | ignored | failed.
  /// `received` and `failed` are non-terminal: a redelivery may reclaim them
  /// so a transient outage cannot permanently swallow a real payment.
  status String @default("received")

  /// Which money flow the tx_ref resolved to (`tip`, `credit-purchase`,
  /// `subscription`, `dm`, `bill`, `health`, `legal-consultation`, …).
  flow   String?
  /// Why it ended where it did — refusal reason, biller error, etc.
  detail String?

  /// The raw body as delivered, kept for reconciliation with Flutterwave.
  payload Json

  receivedAt DateTime  @default(now())
  settledAt  DateTime?

  @@index([txRef])
  @@index([status])
  @@index([receivedAt])
}

/// Which operator surface an AdminOpsAudit row belongs to.
enum AdminOpsResource {
  legal_request
  service_application
  bill_payment
  health_subscription
}

/// Every consequential ops action that used to be anonymous behind
/// AdminKeyGuard, named for what it did rather than for the route that did it.
enum AdminOpsAction {
  legal_quoted
  legal_consultation_completed
  legal_delivered
  legal_cancelled
  application_progressed
  application_rejected
  application_approved
  /// The one READ that is audited on this surface. GET
  /// /services/ops/applications/:id hands an operator another person's
  /// uploaded ID, signature and passport photograph (see
  /// ServiceApplication.documents) plus the business details they typed —
  /// which is precisely what AdminKycAudit's `document_viewed` exists for.
  /// The QUEUE read is not audited: it carries no document URL and no
  /// intake answers, so it discloses nothing beyond "this person has an
  /// application", the same as the legal and bills queue reads.
  application_documents_viewed
  bill_reconciled
  bill_refund_recorded
  care_enrolment_retried
  care_refund_recorded
}

/// Attribution for the operator surfaces that moved from AdminKeyGuard onto
/// the real admin identity — WAWU Legal, ServiceApplication, WAWUPay and
/// WAWUCare.
///
/// A SIDE TABLE, for the same reason AdminContentReview and AdminKycAudit are
/// side tables: protected-surface hazard H-1 records that most wire types in
/// src/common/types are bare Prisma re-exports returned by spread, so an
/// `actedByAdminId` column on LegalRequest, ServiceApplication, BillPayment or
/// HealthSubscription would appear verbatim in a live app response the moment
/// it existed. A client looking at their own legal matter has no business
/// seeing which WAWU staff member priced or cancelled it.
///
/// ONE table across four resources rather than four tables, and that is a
/// departure from AdminContentReview / AdminKycAudit. Those two carry
/// resource-specific TYPED columns (ContentStatus transitions, a slot-return
/// flag, an AdminKycAction) that only make sense for their own entity. These
/// eleven handlers share exactly one shape — "an admin did a named thing to
/// one row, and here is what changed" — so four near-identical tables would be
/// four places to look for one question ("what has this admin done?").
///
/// `detail` is the per-action payload as JSON rather than as columns: a quote
/// amount, a cancellation reason, a refund reference and a provider status are
/// not the same field, and inventing a nullable column for each would make the
/// table wider than the four it replaces.
///
/// No FK to the audited row or to AdminUser, matching every cross-boundary
/// reference in this schema (KycSubmission.wawuUserId, Purchase.buyerWawuId).
/// Admin email and role are SNAPSHOTS: "who cancelled this ₦120,000 matter"
/// has to stay answerable after that admin is renamed, suspended or deleted.
model AdminOpsAudit {
  id            String           @id @default(uuid())
  resource      AdminOpsResource
  resourceId    String
  /// Snapshot of whose money or matter this action touched. Empty string only
  /// where the audited row genuinely has no owner.
  subjectWawuId String

  action AdminOpsAction
  /// What actually changed — the quote amount, the refund reference, the new
  /// status. Shape varies by `action`; see src/common/audit.
  detail Json?

  actedByAdminId    String
  actedByAdminEmail String
  actedByAdminRole  AdminRole
  actedAt           DateTime  @default(now())

  @@index([resource, resourceId])
  @@index([actedByAdminId])
  @@index([actedAt])
}

// -----------------------------------------------------------------------------
// Events — reinstated 22 Aug 2026 by product-owner decision.
//
// WAWU-Web/CLAUDE.md and docs/00_PLATFORM_MAP.md previously listed Events under
// what was cut. Both documents have been amended with today's date to record
// the reversal rather than leaving them contradicting this schema.
//
// ── THE LINE THAT DOES NOT MOVE ──────────────────────────────────────────────
// What the spec cut was event TICKETS, and that stays cut. There is no price
// column, no currency, no ticket, no purchase, no payment reference, no revenue
// split and no credit cost anywhere in the three tables below, and none may be
// added. "Going" is an INTEREST SIGNAL: a row exists or it does not.
// Registration, if the organiser sells one at all, happens on their own site
// behind `Event.externalUrl` — off this platform, off this schema, and no money
// crosses this backend for it. That is precisely why reinstating Events is
// low-risk, so anything that starts to look like ticketing is a spec conflict
// (CLAUDE.md: "If a task conflicts with docs/01_SPEC.md, the spec wins").
//
// ── WHY THREE NEW TABLES AND NOT ONE COLUMN ANYWHERE ELSE ────────────────────
// Same reason AdminContentReview is a side table: protected-surface hazard H-1
// — most wire types in src/common/types are bare re-exports of their Prisma
// model returned by spread, so a new column on an EXISTING table silently
// widens a live app response. Everything here is new tables, and every wire
// shape is a DECLARED view in src/event/event-view.type.ts and
// src/admin/events/admin-event-view.type.ts. Nothing re-exports these models.
// -----------------------------------------------------------------------------

/// In-Person / Online in the UI. Hybrid is deliberately absent: the old admin
/// screen offered it, the old public filter chips never did, so an event
/// created as Hybrid was unreachable by every filter a user could tap.
enum EventFormat {
  in_person
  online
}

/// Exactly the five the public filter row offers (old EVENT_FILTERS, minus the
/// two format chips and the "All" chip). A sixth kind would be a chip nobody
/// can tap, i.e. an event nobody can find.
enum EventType {
  workshop
  summit
  webinar
  meetup
  competition
}

/// Every state here has an exit, and that is a hard requirement rather than a
/// nicety — a `pending` row no endpoint can move is the worst bug this
/// codebase has shipped (see AdminContentReview's header).
///
///   pending   -> published   POST /admin/events/:id/approve
///   pending   -> rejected    POST /admin/events/:id/reject   (reason required)
///   rejected  -> pending     PATCH /events/:id               (host resubmits)
///   published -> pending     PATCH /events/:id               (host edits; see below)
///   published -> removed     POST /admin/events/:id/remove   (reason required)
///   removed   -> published   POST /admin/events/:id/restore
///
/// A host's edit ALWAYS returns the event to `pending`. One rule, no tiers of
/// "material" versus "cosmetic" fields: a two-tier policy is a bypass waiting
/// to be found (submit something benign, get approved, edit it into whatever
/// you actually wanted). `removed` is the one status a host cannot edit out
/// of — a takedown is an admin decision, and its exit is an admin restore.
enum EventStatus {
  pending
  published
  rejected
  removed
}

/// A user-submitted event. Created `pending`; invisible on every public read
/// until an admin approves it.
///
/// `hostWawuId` is the submitting WAWU ID user — a plain indexed String, never
/// a relation, exactly as every other cross-boundary reference in this schema.
/// Creation is NOT gated on the paid creator subscription: an event costs no
/// upload slot and earns nobody anything, so the moderation queue is the only
/// gate it needs.
model Event {
  id         String @id @default(uuid())
  hostWawuId String

  name        String
  description String
  /// The organisation running it ("org" in the old EventItem), and its blurb.
  hostOrg     String
  hostOrgBio  String?

  format EventFormat
  type   EventType

  /// The authoritative instant, and the only thing upcoming/past is decided
  /// on. The old shape stored month/day/dow as pre-rendered strings, which
  /// made "is this event over" unanswerable in SQL.
  startsAt  DateTime
  endsAt    DateTime?
  /// Host-supplied DISPLAY strings — "10:00 AM", "WAT". Deliberately not
  /// derived from `startsAt` server-side: rendering a local time needs the
  /// event's own zone, and guessing it in UTC is how a 9am Lagos workshop
  /// becomes an 8am one on every card.
  timeLabel String?
  timezone  String?

  /// City or venue name (always shown), and the street address (detail only).
  location String
  address  String?

  /// The organiser's own page. Registration — including any paid registration
  /// the organiser runs — lives THERE, never here. This backend takes no
  /// money for an event.
  externalUrl String?

  /// Past-event recap, written by the host after the fact. `hasRecap` on the
  /// wire is derived from these, matching the old EventItem.recap boolean.
  recapUrl  String?
  recapText String?

  /// Admin-controlled pin. A host cannot set it — POST /admin/events/:id/feature
  /// is the only writer, and a takedown clears it (a featured-but-removed
  /// event is a rail pointing at a 404).
  featured Boolean     @default(false)
  status   EventStatus @default(pending)

  /// Why the last rejection or takedown happened, denormalised from the audit
  /// trail so the host's own GET /events/mine can show it without reading an
  /// admin table. The trail in AdminEventReview stays authoritative.
  lastDecisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  speakers EventSpeaker[]
  going    EventGoing[]

  @@index([hostWawuId])
  @@index([status])
  /// The public list is always "published, ordered by when it starts".
  @@index([status, startsAt])
  @@index([status, featured])
  @@index([format])
  @@index([type])
}

/// A billed speaker on an event. A child table rather than a Json column, the
/// same shape CourseLesson has under ContentPiece, so the rows validate and
/// order like anything else here. Initials are derived on the wire from
/// `name`; storing them would be a second definition of the same fact.
model EventSpeaker {
  id      String  @id @default(uuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  title   String?
  order   Int

  @@index([eventId])
}

/// The interest signal, and NOT a ticket. One row per (event, user): the
/// unique constraint is the idempotency, so POSTing "going" ten times is the
/// same one signal, and DELETE withdraws it. No amount, no status, no
/// reference — there is nothing to pay for.
model EventGoing {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userWawuId String
  markedAt   DateTime @default(now())

  @@unique([eventId, userWawuId])
  @@index([eventId])
  @@index([userWawuId])
}

enum AdminEventAction {
  approved
  rejected
  featured
  unfeatured
  removed
  restored
}

/// Moderation audit trail for Event — the same side-table idiom as
/// AdminContentReview, deliberately not a second moderation idiom.
///
/// No FK to Event or AdminUser: an audit row has to outlive the thing it
/// audits, and every cross-boundary reference in this schema is already a
/// plain String. Admin email and role are SNAPSHOTS so "who took this event
/// down" stays answerable after that admin is renamed or deleted. Both the
/// status and the featured flag are recorded before/after, because
/// feature/unfeature changes no status and would otherwise leave an audit row
/// that appears to have done nothing.
model AdminEventReview {
  id         String @id @default(uuid())
  eventId    String
  /// Snapshot: whose event this decision landed on.
  hostWawuId String

  action           AdminEventAction
  previousStatus   EventStatus
  newStatus        EventStatus
  previousFeatured Boolean
  newFeatured      Boolean
  /// Required on `rejected` and `removed` (enforced in the DTO and again in
  /// the service); null on the others. The host is shown it.
  reason           String?

  reviewedByAdminId    String
  reviewedByAdminEmail String
  reviewedByAdminRole  AdminRole
  reviewedAt           DateTime  @default(now())

  @@index([eventId])
  @@index([reviewedByAdminId])
  @@index([reviewedAt])
}

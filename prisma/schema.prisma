// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// WAWU Hub API — Prisma schema
//
// Built from .pipeline/registry.json (frozen, 39 resources) + dep-graph.json
// + conventions.md. See the schema-agent report for the full rationale;
// summarized judgment calls are called out inline as `// JUDGMENT:` comments.
//
// Auth model: this backend has NO local User table. Every `*WawuId` /
// `*WawuUserId` field below is a plain, indexed String holding WAWU ID's own
// `sub` claim — never a Prisma relation() to a local model, even where the
// referenced concept (e.g. CreatorState) happens to be keyed by wawuUserId.
// Identity lives in WAWU ID; this backend only stores WAWUAfrica-specific
// state keyed by that foreign identity string. Relations are only modeled
// between resources this backend actually owns end-to-end (ContentPiece ->
// CourseLesson, Community -> CommunityMessage, etc).
//
// Four resources in the registry are NOT modeled as tables here:
//   - SearchResponse: fields: [] — pure computed aggregate, no storage.
//   - Account: fields: [] — DELETE /account acts on wawuUserId directly,
//     nothing to store; BlockedAccount does not need a real FK to it.
//   - CreatorEarnings: registry's own endpoint note says explicitly "not a
//     running ledger balance" — it's a flat aggregate computed at request
//     time across Purchase + DirectMessage + CreditSpend + CreatorSubscription.
//     Modeled as a wire-response interface only (src/common/types/).
//   - LearnEntitlement: every field (tier, freeCoursesTotal, freeCoursesUsed,
//     enrolledCourseIds) is fully derivable from CreatorState.tier +
//     CourseEnrollment rows — no independent state to persist. Wire-response
//     interface only.
// =============================================================================

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum AccountType {
  user
  creator
}

enum CreatorTier {
  basic
  pro
}

/// Shared by CreatorState.kycStatus, KycSubmission.status and
/// VerificationSubmission.status — all three are the same pending/approved/
/// rejected review lifecycle.
enum ReviewStatus {
  pending
  approved
  rejected
}

enum VerificationTier {
  basic
  verified_user
  verified_business
  certified_professional
  trusted_partner
}

enum ContentType {
  video
  course
  audio
  pdf
  image
  template
}

enum AccessType {
  free
  paid
}

enum ContentStatus {
  pending
  live
  rejected
}

enum PurchaseType {
  content
  tip
}

/// Shared by Purchase.status and CreditPurchase.status.
enum TransactionStatus {
  pending
  completed
  failed
}

enum DmStatus {
  awaiting_response
  responded
  refunded
}

enum PenaltyState {
  none
  warned
  disabled_7d
  disabled_30d
}

enum CommunityKind {
  open
  private
}

enum MembershipStatus {
  joined
  pending
}

enum CreditPack {
  starter
  popular
  pro
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
  expired
}

enum PartnerServiceStatus {
  live
  coming
}

enum ServiceApplicationKind {
  cac
  nepc
  mentor_request @map("mentor-request")
  /// Carried over from the previous platform. Each is a short request a
  /// partner then reviews (ARM Pension, WEMA Bank, WAWUAfrica).
  ///
  /// `easybuy` is retained only because dropping a Postgres enum value means
  /// rewriting the type and every column using it. The CredPal partnership
  /// behind it has ended and no code path accepts it any more.
  easybuy
  pension
  banking
  grants
  loans
}

enum GuideKind {
  country
  article
  template
}

enum ShopKind {
  basket
  beauty
}

// -----------------------------------------------------------------------------
// Identity / profile / creator gates
// -----------------------------------------------------------------------------

/// One row per WAWU user who has completed onboarding on this app. Created on
/// first PATCH /users/me (post-signup onboarding), updated thereafter.
model UserProfile {
  wawuUserId      String      @id
  accountType     AccountType
  handle          String?     @unique
  bio             String?
  interests       String[]
  instagramHandle String?
  whatsappHandle  String?
  websiteUrl      String?
  /// Where else a creator can be reached. Handles are stored without the "@";
  /// the full URLs are stored as given.
  xHandle         String?
  tiktokHandle    String?
  youtubeUrl      String?
  facebookUrl     String?
  linkedinUrl     String?
  createdAt       DateTime    @default(now())

  @@index([accountType])
}

/// Creator-only entitlement/gate state. Two independent gates per CLAUDE.md:
/// subscriptionPaid gates uploading, kycStatus=approved gates earning.
/// `slotsTotal` is deliberately NOT a column — it derives from `tier`
/// (registry's own example of a derived field) and is computed in the wire
/// response / service layer, never stored.
model CreatorState {
  wawuUserId       String       @id
  tier             CreatorTier
  subscriptionPaid Boolean      @default(false)
  kycStatus        ReviewStatus @default(pending)
  slotsUsed        Int          @default(0)
  dmPrice          Int?
  dmEnabled        Boolean      @default(false)

  @@index([tier])
  @@index([kycStatus])
}

/// WAWU ID verification-tier ladder (Basic -> Verified User -> Verified
/// Business -> Certified Professional -> Trusted Partner). This backend owns
/// only the submission/review workflow; the resulting tier value is written
/// back to WAWU ID (conventions.md § Auth model) and is NOT this table's
/// concern to keep in sync. Multiple rows per user over time are expected
/// (resubmission), so no unique on wawuUserId — history is a business
/// requirement.
model VerificationSubmission {
  id              String           @id @default(uuid())
  wawuUserId      String
  tier            VerificationTier
  status          ReviewStatus     @default(pending)
  documents       String[]
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?
  rejectionReason String?

  @@index([wawuUserId])
  @@index([status])
}

/// Creator KYC (BVN/NIN or national-ID equivalent + payout bank details).
/// Fully owned by this backend, entirely separate from verification tier
/// (CLAUDE.md non-negotiable — never collapse the two). One "active"
/// submission per wawuUserId is a business rule enforced in service logic,
/// NOT a DB unique — resubmission needs history, per the task brief.
model KycSubmission {
  id                   String       @id @default(uuid())
  wawuUserId           String
  country              String
  bvn                  String?
  nin                  String?
  nationalIdEquivalent String?
  idDocumentType       String
  idDocumentUrl        String
  payoutBankName       String
  payoutAccountNumber  String
  status               ReviewStatus @default(pending)
  rejectionReason      String?
  submittedAt          DateTime     @default(now())
  reviewedAt           DateTime?

  @@index([wawuUserId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Content
// -----------------------------------------------------------------------------

/// `fullAssetLocked` (registry: "derived") is intentionally not a column —
/// it's computed at read time from accessType/price + whether the requester
/// has a completed Purchase. `fullAssetUrl` IS a real stored column (the
/// actual asset location); the derivation only governs whether it's *returned*
/// to a given requester, which is a wire-layer / service-layer concern.
///
/// JUDGMENT: `tags: String[]` is added even though it's absent from this
/// resource's top-level `fields` array in registry.json — it appears in the
/// POST /content request body (`tags: string[], nullable: true`) with no
/// other place to land it. Treated as a registry omission (endpoint contract
/// vs. resource field list drift), not a deliberate exclusion.
model ContentPiece {
  id                     String        @id @default(uuid())
  slug                   String        @unique
  creatorWawuId          String
  contentType            ContentType
  title                  String
  description            String
  category               String
  tags                   String[]      @default([])
  accessType             AccessType
  price                  Int
  durationLabel          String?
  pageCount              Int?
  previewAssetUrl        String
  fullAssetUrl           String?
  creatorFirstUploadFree Boolean       @default(false)
  status                 ContentStatus @default(pending)
  views                  Int           @default(0)
  ratingPct              Int?
  commentCount           Int           @default(0)
  likes                  Int           @default(0)
  createdAt              DateTime      @default(now())

  lessons   CourseLesson[]
  comments  Comment[]
  purchases Purchase[]
  savedBy   SavedItem[]

  @@index([creatorWawuId])
  @@index([status])
  @@index([category])
  @@index([contentType])
  /// Feed/explore reads are always "approved content, newest first" — the
  /// single-column status index still left Postgres sorting the whole
  /// approved set.
  @@index([status, createdAt])
}

/// `locked` (registry: "derived from purchase state") intentionally not a
/// column — computed per-requester at read time.
model CourseLesson {
  id            String       @id @default(uuid())
  contentId     String
  content       ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  title         String
  order         Int
  durationLabel String?

  @@index([contentId])
}

model Comment {
  id           String       @id @default(uuid())
  contentId    String
  content      ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  authorWawuId String
  text         String
  replyToId    String?
  /// onDelete: SetNull — `NoAction` meant deleting a parent comment blew up
  /// on the FK from its own replies (a 500 on a perfectly ordinary delete).
  /// `replyToId` is already nullable, so an orphaned reply simply becomes a
  /// top-level comment rather than disappearing with the parent.
  replyTo      Comment?     @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Comment[]    @relation("CommentReplies")
  likes        Int          @default(0)
  createdAt    DateTime     @default(now())

  @@index([contentId])
  @@index([authorWawuId])
}

// -----------------------------------------------------------------------------
// Transactions
// -----------------------------------------------------------------------------

/// Covers both content purchases and tips (`contentId` null for tips, per
/// registry note). `commissionRate` is snapshotted at transaction time —
/// never recomputed from the creator's current tier later (conventions.md).
model Purchase {
  id               String            @id @default(uuid())
  contentId        String?
  /// Restrict, not SetNull: a Purchase is a financial record of what a buyer
  /// paid for. SetNull let a content deletion silently blank that link on
  /// every buyer's row — the payment survived but no longer said what it
  /// bought, breaking entitlement checks and receipts. Content that has been
  /// sold must be unpublished, never hard-deleted.
  content          ContentPiece?     @relation(fields: [contentId], references: [id], onDelete: Restrict)
  type             PurchaseType
  buyerWawuId      String
  creatorWawuId    String
  amount           Int
  commissionRate   Decimal           @db.Decimal(5, 4)
  /// Payment lookup key — every Flutterwave verify/webhook finds the row by
  /// this. Unique both because a duplicate here means a double-credited
  /// payment, and because the lookup was a sequential scan without it.
  flutterwaveTxRef String            @unique
  flutterwaveTxId  String?
  status           TransactionStatus @default(pending)
  note             String?
  purchasedAt      DateTime          @default(now())

  @@index([buyerWawuId])
  @@index([creatorWawuId])
  @@index([contentId])
  @@index([status])
  @@index([type])
}

model SavedItem {
  id         String       @id @default(uuid())
  userWawuId String
  contentId  String
  content    ContentPiece @relation(fields: [contentId], references: [id], onDelete: Cascade)
  savedAt    DateTime     @default(now())

  @@unique([userWawuId, contentId])
  @@index([userWawuId])
  @@index([contentId])
}

model FollowRelationship {
  id              String   @id @default(uuid())
  followerWawuId  String
  followingWawuId String
  createdAt       DateTime @default(now())

  @@unique([followerWawuId, followingWawuId])
  @@index([followerWawuId])
  @@index([followingWawuId])
}

// -----------------------------------------------------------------------------
// Direct messages (paid DMs)
// -----------------------------------------------------------------------------

model DirectMessage {
  id               String    @id @default(uuid())
  creatorWawuId    String
  senderWawuId     String
  text             String
  amount           Int
  status           DmStatus  @default(awaiting_response)
  sentAt           DateTime  @default(now())
  deadlineAt       DateTime
  respondedAt      DateTime?
  responseText     String?
  /// Payment lookup key — see Purchase.flutterwaveTxRef.
  flutterwaveTxRef String    @unique

  reports DmReport[]

  @@index([creatorWawuId])
  @@index([senderWawuId])
  @@index([status, deadlineAt])
}

/// Rolling per-creator stats maintained by the DM-deadline-sweep cron job
/// (conventions.md § Scheduled/background jobs). Single evolving row per
/// creator, not a history log.
model CreatorNoResponseTracker {
  creatorWawuId     String       @id
  noResponseRatePct Decimal      @default(0) @db.Decimal(5, 2)
  penaltyState      PenaltyState @default(none)
  dmDisabledUntil   DateTime?
}

/// JUDGMENT: added `@@unique([threadId, reporterWawuId])` — not specified in
/// the registry, but a sensible constraint (one report per reporter per
/// thread) consistent with the "sensible uniques" instruction.
model DmReport {
  id             String        @id @default(uuid())
  threadId       String
  thread         DirectMessage @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reporterWawuId String
  createdAt      DateTime      @default(now())

  @@unique([threadId, reporterWawuId])
  @@index([threadId])
  @@index([reporterWawuId])
}

// -----------------------------------------------------------------------------
// Communities & credits
// -----------------------------------------------------------------------------

/// `memberCount` / `messagesToday` (registry: "derived") intentionally not
/// columns — computed via count() over CommunityMembership / CommunityMessage
/// at read time.
model Community {
  id          String        @id @default(uuid())
  name        String
  description String
  hostWawuId  String
  kind        CommunityKind

  memberships  CommunityMembership[]
  messages     CommunityMessage[]
  creditSpends CreditSpend[]

  @@index([hostWawuId])
  @@index([kind])
}

model CommunityMembership {
  id          String           @id @default(uuid())
  userWawuId  String
  communityId String
  community   Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  status      MembershipStatus @default(joined)
  joinedAt    DateTime?

  @@unique([userWawuId, communityId])
  @@index([userWawuId])
  @@index([communityId])
}

model CommunityMessage {
  id            String    @id @default(uuid())
  communityId   String
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  senderWawuId  String
  text          String
  costInCredits Int       @default(1)
  sentAt        DateTime  @default(now())

  @@index([communityId])
  @@index([senderWawuId])
}

model CreditsState {
  userWawuId    String   @id
  creditBalance Int      @default(0)
  trialEndsAt   DateTime
}

model CreditPurchase {
  id               String            @id @default(uuid())
  userWawuId       String
  pack             CreditPack
  creditsGranted   Int
  /// Payment lookup key — see Purchase.flutterwaveTxRef.
  flutterwaveTxRef String            @unique
  amount           Int
  status           TransactionStatus @default(pending)
  purchasedAt      DateTime          @default(now())

  @@index([userWawuId])
  @@index([status])
}

/// JUDGMENT: registry lists no `id` field for CreditSpend (append-only
/// per-message ledger row, analogous to Purchase). A synthetic UUID PK is
/// added since there is no natural key — (userWawuId, communityId, spentAt)
/// is not guaranteed unique to the second.
model CreditSpend {
  id            String    @id @default(uuid())
  userWawuId    String
  communityId   String
  community     Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creditsSpent  Int       @default(1)
  creatorWawuId String
  spentAt       DateTime  @default(now())

  @@index([userWawuId])
  @@index([communityId])
  @@index([creatorWawuId])
}

// -----------------------------------------------------------------------------
// Creator subscription / earnings / scoring
// -----------------------------------------------------------------------------

/// Single evolving row per creator (not a billing-history ledger — that's
/// GET /creator-subscription/billing-history, served from CreditPurchase-
/// shaped rows / Flutterwave data, not modeled as its own table since the
/// registry gives it no dedicated resource).
/// A charge that has been initiated with Flutterwave but not yet verified.
///
/// This bridge used to be a process-local `Map` in CreatorSubscriptionService
/// and DirectMessageService. Any deploy, crash or second replica between the
/// checkout popup opening and its callback firing lost the record entirely:
/// the customer was charged at Flutterwave and this backend had nothing to
/// reconcile against. Railway scales by default, so that window was real.
///
/// Rows are short-lived — deleted on successful verify, and safe to sweep
/// after a day or so once reconciled.
model PendingCharge {
  /// The Flutterwave tx_ref. One charge, one row.
  txRef          String   @id
  /// Which flow created it: 'subscribe' | 'upgrade' | 'dm'.
  kind           String
  /// The caller the charge belongs to. Verify must match this.
  wawuUserId     String
  /// Naira the SERVER intended to charge. Verification enforces
  /// `amount >= expectedAmount` — the client supplies the amount to the
  /// inline SDK, so this is what stops a ₦1 payment buying a ₦18,999 tier.
  expectedAmount Int
  /// Flow-specific context (tier + planId for subscriptions, threadId/text
  /// for a paid DM). Kept as JSON so one table serves every money flow.
  context        Json
  createdAt      DateTime @default(now())

  @@index([wawuUserId])
  @@index([createdAt])
}

model CreatorSubscription {
  creatorWawuId          String             @id
  tier                   CreatorTier
  status                 SubscriptionStatus @default(active)
  commissionRateOverride Decimal?           @db.Decimal(5, 4)
  flutterwaveCustomerRef String?
  flutterwavePlanId      String?
  currentPeriodEnd       DateTime
  renewalAttempts        Int                @default(0)
  cancelsAt              DateTime?
  cardLast4              String?

  @@index([status])
  @@index([currentPeriodEnd])
}

/// `score` is a periodically-recomputed cache (views + purchases*weight +
/// comments, per registry note) — the row itself IS stored (hence
/// `updatedAt`), even though the computation reads across multiple tables.
model EvgScore {
  creatorWawuId String   @id
  score         Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Notifications
// -----------------------------------------------------------------------------

model Notification {
  id           String   @id @default(uuid())
  userWawuId   String
  kind         String
  title        String
  body         String
  tone         String
  amount       Int?
  creditsCount Int?
  actionLabel  String?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userWawuId])
  @@index([userWawuId, read])
  @@index([createdAt])
}

model NotificationSettings {
  userWawuId      String  @id
  newReplies      Boolean @default(true)
  newFollowers    Boolean @default(true)
  dmReminders     Boolean @default(true)
  refunds         Boolean @default(true)
  promotions      Boolean @default(false)
  communityDigest Boolean @default(true)
}

// -----------------------------------------------------------------------------
// Services hub (partner services, applications, mentors)
// -----------------------------------------------------------------------------

/// Reference/seed data, admin-managed later per registry note.
model PartnerService {
  id          String               @id @default(uuid())
  /// Stable routing key. The app used to match services by name to work out
  /// where a card should go, which only ever handled CAC and NEPC and broke
  /// silently for everything else.
  slug        String               @unique
  name        String
  tagline     String
  blurb       String
  icon        String
  status      PartnerServiceStatus
  turnaround  String?
  priceFrom   String?
  partner     String?
  comingNote  String?
  /// Carried over from the previous platform, which showed each partner
  /// service with what you need before applying and what you get.
  eligibility String[]             @default([])
  benefits    String[]             @default([])
  /// [label, description] pairs.
  steps       Json?
  ctaLabel    String?
  ctaHref     String?
}

/// `status` (free-text machine state, e.g. "submitted"/"in_review"/"issued")
/// and `statusLabel` (its human-readable display twin) are both typed as
/// plain `string` in the registry with no enumerated value set given, so
/// left as String rather than invented enums. `timeline` (registry:
/// "object[]") is kept as Json — no filter/query value in modeling a
/// free-form status-history array relationally, per the task brief's own
/// example (ServiceApplication.timeline).
model ServiceApplication {
  id                    String                 @id @default(uuid())
  applicantWawuId       String
  kind                  ServiceApplicationKind
  title                 String
  reference             String
  appliedDate           DateTime               @default(now())
  status                String
  statusLabel           String
  amountPaid            Int?
  certificateExpectedBy DateTime?              @db.Date
  timeline              Json
  rejection             String?
  /// URLs of supporting documents the applicant uploaded (ID, signature,
  /// passport photograph). Object-storage URLs produced by POST
  /// /uploads/presign — the application flow used to collect nothing.
  documents             String[]               @default([])

  @@index([applicantWawuId])
  @@index([kind])
}

model Mentor {
  id              String   @id @default(uuid())
  name            String
  handle          String   @unique
  field           String
  category        String
  tagline         String
  bio             String
  topics          String[]
  verification    String
  openForRequests Boolean  @default(true)
  fullUntil       String?
  yearsExperience Int
  sessions        Int      @default(0)
  languages       String[]

  requests MentorRequest[]

  @@index([category])
}

/// FREE — mentors volunteer their time, no payment step (product-truths.json,
/// per registry note). `status` left as plain String — no enumerated value
/// set given in the registry.
model MentorRequest {
  id              String   @id @default(uuid())
  mentorId        String
  mentor          Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  requesterWawuId String
  topics          String[]
  note            String
  slot            String
  status          String   @default("pending")
  createdAt       DateTime @default(now())

  @@index([mentorId])
  @@index([requesterWawuId])
}

// -----------------------------------------------------------------------------
// Learn (courses, enrollment, guides, playbook)
// -----------------------------------------------------------------------------

model LearnCourse {
  id              String   @id @default(uuid())
  title           String
  category        String
  hours           Int
  certificate     Boolean  @default(false)
  overview        String
  whatItCovers    String[]
  externalHostUrl String

  enrollments CourseEnrollment[]

  @@index([category])
}

/// JUDGMENT: registry lists no `id` field for CourseEnrollment (an
/// enrollment fact, analogous to CommunityMembership). Synthetic UUID PK +
/// compound unique added, mirroring CommunityMembership's treatment.
model CourseEnrollment {
  id          String      @id @default(uuid())
  userWawuId  String
  courseId    String
  course      LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime    @default(now())
  progressPct Int?

  @@unique([userWawuId, courseId])
  @@index([userWawuId])
  @@index([courseId])
}

/// `chapters` / `readingSections` (registry: "object[]") kept as Json — the
/// single global playbook's content tree has no cross-row filter/query need.
model Playbook {
  id              String @id @default(uuid())
  title           String
  pages           Int
  format          String
  description     String
  chapters        Json
  readingSections Json
}

/// `sections` (registry: "object[]", nullable) kept as Json for the same
/// reason as Playbook — free-form nested content, no relational query value.
model LearnGuide {
  id          String    @id @default(uuid())
  kind        GuideKind
  title       String
  updated     DateTime  @db.Date
  country     String?
  subtitle    String
  readMinutes Int
  sections    Json?
  fileCount   Int?

  @@index([kind])
  @@index([country])
}

// -----------------------------------------------------------------------------
// Marketplace handoff (WAWUBasket / WAWUBeauty — external, save-only)
// -----------------------------------------------------------------------------

/// JUDGMENT: registry lists no `id` field. Synthetic UUID PK + compound
/// unique added, same pattern as other save/join-style resources.
/// `productId` is intentionally NOT a relation — external id, opaque to this
/// backend per registry note (supersede S-5).
model MarketplaceSave {
  id         String   @id @default(uuid())
  userWawuId String
  productId  String
  shop       ShopKind
  savedAt    DateTime @default(now())

  @@unique([userWawuId, productId, shop])
  @@index([userWawuId])
}

// -----------------------------------------------------------------------------
// Settings / privacy / account lifecycle
// -----------------------------------------------------------------------------

model PrivacySettings {
  userWawuId        String  @id
  showPurchases     Boolean @default(true)
  showSavedItems    Boolean @default(true)
  showFollowing     Boolean @default(true)
  showInMemberLists Boolean @default(true)
}

/// JUDGMENT: `@@unique([userWawuId, blockedWawuId])` added — not specified
/// in the registry, but a sensible constraint (can't block the same account
/// twice) per the "sensible uniques" instruction.
model BlockedAccount {
  id            String   @id @default(uuid())
  userWawuId    String
  blockedWawuId String
  blockedAt     DateTime @default(now())

  @@unique([userWawuId, blockedWawuId])
  @@index([userWawuId])
  @@index([blockedWawuId])
}

model DataExportRequest {
  id          String   @id @default(uuid())
  userWawuId  String
  status      String   @default("pending")
  requestedAt DateTime @default(now())

  @@index([userWawuId])
}

// ---------------------------------------------------------------------------
// Lifestyle Services — WAWUPay (bills), WAWUCare (health), WAWU Legal.
//
// All three follow the same shape: the user pays WAWU through Flutterwave
// checkout, the server verifies that payment, and only then does WAWU call the
// partner to fulfil. Fulfilment is therefore a second step that can fail on its
// own, which is why every one of these carries a status separate from the
// payment and keeps the provider's own reference for reconciliation.
// ---------------------------------------------------------------------------

/// Payment taken, fulfilment still owed. `paid` means WAWU has the money but
/// the partner has not delivered yet — the state a refund sweep looks for.
enum FulfilmentStatus {
  pending
  paid
  delivered
  failed
  refunded
}

/// WAWUPay. One row per bill the user pays through Flutterwave's Bills API.
model BillPayment {
  id          String @id @default(uuid())
  buyerWawuId String
  /// Flutterwave bill category slug (AIRTIME, DATA_BUNDLE, POWER, CABLEBILLS…).
  category    String
  billerCode  String
  itemCode    String
  billerName  String
  /// Phone number, meter number or smartcard number, depending on the biller.
  customerRef String
  amount      Int
  fee         Int    @default(0)

  /// The user's card payment to WAWU.
  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  /// Flutterwave's reference for the bill we then paid on their behalf.
  providerReference String?
  providerStatus    String?
  failureReason     String?

  status      FulfilmentStatus @default(pending)
  createdAt   DateTime         @default(now())
  deliveredAt DateTime?

  @@index([buyerWawuId])
  @@index([status])
  @@index([status, createdAt])
}

/// WAWUCare. A WellaHealth (Zoi) health plan subscription bought in-app.
model HealthSubscription {
  id         String @id @default(uuid())
  wawuUserId String

  planCode String
  planName String
  price    Int

  /// WellaHealth keys the enrollee on phone number, so it is required here.
  phoneNumber String
  firstName   String
  lastName    String
  gender      String
  dateOfBirth String
  email       String?

  flutterwaveTxRef String  @unique
  flutterwaveTxId  String?

  policyNumber      String?
  providerReference String?
  failureReason     String?

  status    FulfilmentStatus @default(pending)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime         @default(now())

  @@index([wawuUserId])
  @@index([status])
}

/// WAWU Legal routes on this. `simple` is form-in, document-out with no lawyer
/// in the loop; `consultation` requires a paid consultation before WAWU can
/// even quote the work.
enum LegalPath {
  simple
  consultation
}

enum ConsultationMedium {
  chat
  zoom
  physical
}

/// The full lifecycle of a legal request. A `simple` request skips straight
/// from awaiting_payment to in_progress; a `consultation` one walks the whole
/// ladder, and can never reach in_progress without a signed contract.
enum LegalRequestStatus {
  draft
  /// Submitted, price to be agreed. Simple services whose fee WAWU sets after
  /// looking at the request rather than off a price list.
  awaiting_quote
  awaiting_consultation_payment
  consultation_scheduled
  consultation_done
  quoted
  contract_signed
  awaiting_service_payment
  in_progress
  delivered
  cancelled
}

model LegalRequest {
  id          String             @id @default(uuid())
  wawuUserId  String
  serviceCode String
  serviceName String
  category    String
  path        LegalPath
  status      LegalRequestStatus @default(draft)

  /// Whatever the service's intake form collected.
  details   Json?
  documents String[] @default([])

  consultationMedium ConsultationMedium?
  consultationFee    Int?
  consultationTxRef  String?             @unique
  consultationPaidAt DateTime?
  scheduledFor       DateTime?
  consultationNotes  String?

  /// What WAWU quotes after the consultation.
  quoteAmount Int?
  quoteNote   String?

  /// Signing is a liability record, so it keeps the exact text agreed to
  /// rather than a pointer to a template that may later change.
  contractText     String?
  contractSignedAs String?
  contractSignedAt DateTime?
  contractSignedIp String?

  serviceTxRef   String?   @unique
  servicePaidAt  DateTime?
  deliverableUrl String?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wawuUserId])
  @@index([status])
  @@index([serviceCode])
}

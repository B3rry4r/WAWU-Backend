// Settings / privacy / account lifecycle
// -----------------------------------------------------------------------------

model PrivacySettings {
  userWawuId        String  @id
  showPurchases     Boolean @default(true)
  showSavedItems    Boolean @default(true)
  showFollowing     Boolean @default(true)
  showInMemberLists Boolean @default(true)
}

/// JUDGMENT: `@@unique([userWawuId, blockedWawuId])` added — not specified
/// in the registry, but a sensible constraint (can't block the same account
/// twice) per the "sensible uniques" instruction.
model BlockedAccount {
  id            String   @id @default(uuid())
  userWawuId    String
  blockedWawuId String
  blockedAt     DateTime @default(now())

  @@unique([userWawuId, blockedWawuId])
  @@index([userWawuId])
  @@index([blockedWawuId])

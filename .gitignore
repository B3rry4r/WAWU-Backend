mock-wawu-id/node_modules/
# The mock WAWU ID's signing pair. BOTH halves: the server makes them on
# first run and derives the public one from the private one every start, so
# committing either is how they end up disagreeing.
mock-wawu-id/private.pem
mock-wawu-id/public.pem

# Deploy SSH keypair (DigitalOcean). The PRIVATE half of this must never be
# committed — it is root access to the droplet. Generated locally, downloaded
# by the operator, and kept in GitHub Actions secrets. Both halves are ignored
# so a stray `git add -A` cannot pick either up.
wawu_do_deploy
wawu_do_deploy.pub

# Python bytecode from running the gates harness locally.
scripts/gates/**/__pycache__/

# Local run state from scripts/local/up.sh (pids and logs).
.local/

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wawu_hub_dev?schema=public"
HUB_API_PORT=3001
CORS_ORIGIN=http://localhost:3000
WAWU_ID_JWKS_URL=http://localhost:4001/.well-known/jwks.json
WAWU_ID_BASE_URL=http://localhost:4001
WAWU_ID_INTERNAL_SERVICE_KEY=dev-internal-service-key-not-secret
# How long one call to WAWU ID may take before it is aborted (FIX-10), in whole
# milliseconds. Optional: unset means 3000 for the name lookup and 8000 for the
# writes (a tick, a name, a tier). See src/common/auth/wawu-id-exchange.ts.
# WAWU_ID_READ_TIMEOUT_MS=3000
# WAWU_ID_WRITE_TIMEOUT_MS=8000
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-placeholder
# Leave empty for local dev/test -- every payment-shaped module's Flutterwave
# DI factory selects MockFlutterwaveAdapter when this is absent, and
# RealFlutterwaveAdapter (which will 502 against a placeholder key) whenever
# it's set to any non-empty value. Only set a real key in an environment
# that actually has real Flutterwave credentials.
FLUTTERWAVE_SECRET_KEY=
# Inbound webhook secret. Flutterwave echoes this VERBATIM in the `verif-hash`
# header of every delivery to POST /api/hub/webhooks/flutterwave, and
# FlutterwaveSignatureGuard compares it in constant time -- it is the only
# authentication that endpoint has. Set the SAME value here and in the
# Flutterwave dashboard (Settings -> Webhooks -> "Secret hash"), and point the
# dashboard's webhook URL at https://<host>/api/hub/webhooks/flutterwave.
# Unset means the webhook is UNREACHABLE (401), not open: payment confirmation
# then falls back to the browser's /verify calls alone, which is the failure
# this endpoint exists to fix.
FLUTTERWAVE_SECRET_HASH=dev-webhook-hash-placeholder

# --- Admin dashboard identity (/api/hub/admin/*) -----------------------------
# Separate from every WAWU_ID_* value above on purpose: admin auth does not go
# through WAWU ID. Admin tokens are HS256 signed with these local secrets,
# while user tokens are RS256 verified against WAWU ID's JWKS, so neither
# verifier can be satisfied by the other's token. Never reuse a WAWU ID key
# here, and never reuse ADMIN_JWT_SECRET as ADMIN_JWT_REFRESH_SECRET.
#
# Both are REQUIRED for the admin surface to work and are deliberately left
# empty here: unset means every admin route 401s ("fails closed"), which is
# the right default for an environment that has no admins. Generate with
# `openssl rand -hex 32`. Minimum 32 characters.
ADMIN_JWT_SECRET=
ADMIN_JWT_REFRESH_SECRET=
# Optional. Defaults: 30m access, 7d refresh.
ADMIN_JWT_ACCESS_TTL=30m
ADMIN_JWT_REFRESH_TTL=7d
#
# Read only by `npm run admin:seed` (scripts/seed-admin.ts), which creates the
# first superadmin. Nothing is defaulted -- the script refuses to run without
# all three, and refuses a password under 12 characters. Set them for the one
# command and do not leave a real password in a committed file.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# Gemini, for the legal-intake brief. Required — the API refuses to generate a
# brief without it, and there is no offline mode. Use a non-production key
# outside production, the same way FLUTTERWAVE_SECRET_KEY works.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.7-flash. Note that the 2.0 models were shut
# down on 1 June 2026 — do not pin one here.
GEMINI_MODEL=

# --- Wallet provider (MONEY-20, NUV-01) --------------------------------------
# Which company holds the naira wallets: `fintava` (also when left empty) or
# `nuvion`. Every money service reaches the provider through one interface
# (src/wallet-provider/); this setting picks the adapter at boot. `nuvion`
# builds the Nuvion adapter (src/nuvion/, NUV-01) and needs the NUVION_*
# settings below; any other value stops the server. ROLLBACK is changing this
# value and restarting: a server acts only on wallets, openings and ledger
# rows of the provider it runs (their `provider` column), so the other
# provider's rows wait untouched. Both webhook receivers stay mounted
# whichever is picked. Under nuvion a wrong Fintava client setting
# (FINTAVA_BASE_URL, FINTAVA_API_KEY, the FINTAVA_*_TIMEOUT_MS and
# FINTAVA_RESEND_SAFETY_MS) no longer stops the server (Fintava starts
# unconfigured); the FINTAVA_FEE_* schedule is still checked at boot under
# any provider. Under fintava the NUVION_* values are never read.
WALLET_PROVIDER=

# --- Nuvion (NUV-01; used only when WALLET_PROVIDER=nuvion) -------------------
# Never commit a key here. NUVION_BASE_URL is exactly https://api.nuvion.dev
# (sandbox) or https://api.nuvion.co (production): anything else stops the
# server, so the key cannot be sent elsewhere. NUVION_API_KEY goes in
# `Authorization: Bearer` (a sandbox key from app.nuvion.dev for the sandbox).
# NUVION_API_VERSION may stay empty: it is pinned to 2026-02-06, and any
# other value stops the server. NUVION_WEBHOOK_SECRET is the secret Nuvion
# shows once when the endpoint https://<host>/api/hub/webhooks/nuvion is
# registered (POST /entity-webhooks, NUV-10); it checks the HMAC-SHA256
# `x-nuvion-event-signature` of every delivery, and is read under any
# WALLET_PROVIDER: left empty, every delivery is refused (401).
# NUVION_OPERATIONAL_ACCOUNT_ID is WAWU's own `operational` account at Nuvion
# (held money, R-42). Under nuvion the first four are required: a missing one
# stops the server at boot, naming it.
NUVION_BASE_URL=
NUVION_API_KEY=
NUVION_API_VERSION=
NUVION_WEBHOOK_SECRET=
NUVION_OPERATIONAL_ACCOUNT_ID=
# How long the client waits for Nuvion, in milliseconds (reads, then money
# and anything that creates something, then identity checks), and the resend
# safety window. Left empty: 15000, 30000, 30000 and 600000
# (PROVISIONAL(NUVION-TIMEOUTS), PROVISIONAL(NUVION-RESEND-SAFETY),
# src/nuvion/nuvion-config.ts). Out of range stops the server under nuvion.
NUVION_TIMEOUT_MS=
NUVION_MONEY_TIMEOUT_MS=
NUVION_CHECK_TIMEOUT_MS=
NUVION_RESEND_SAFETY_MS=
# The hosted selfie (NUV-03, R-39): `on` makes Nuvion's own selfie page a step
# of opening (it must pass before the opening is sent for review); empty or
# `off` leaves it out. Nuvion's docs do not list the selfie API, so whether
# it can start a session for a child entity is only known once the sandbox
# key works: it stays off until then. When on, only an answer that says
# Nuvion's API is not available to this key (no such endpoint, no permission)
# turns it off, for everyone and for an hour, logged as an error; a refusal
# about one person's request or entity is theirs to retry and never lets them
# skip the step.
# NUVION_LIVENESS_REDIRECT_ORIGINS lists where the selfie page may send the
# person back to (the app's link and the website), comma separated. Each entry
# is an https origin and, usually, a path prefix: https://app.example/open
# allows /open and anything under /open/ on that host, nothing else; an entry
# with no path allows the whole origin. EMPTY ALLOWS NO ADDRESS AT ALL.
# Credentials, a query or a fragment in an entry stop the server under nuvion.
NUVION_HOSTED_LIVENESS=
NUVION_LIVENESS_REDIRECT_ORIGINS=
# The bank, licence and deposit-insurance lines shown with a Nuvion wallet's
# account number (and on receipts and About) when WALLET_PROVIDER=nuvion: the
# owner's wording, filled in by NUV-10. Left empty, the bank name is empty
# and each line is hidden. Under fintava the WALLET_* lines below are shown.
NUVION_WALLET_BANK_NAME=
NUVION_WALLET_LICENCE_LINE=
NUVION_WALLET_DEPOSIT_INSURANCE_LINE=

# --- Fintava (naira wallets, bank sends, bills) ------------------------------
# Real values live only in your own .env (sandbox keys locally, live keys on
# the server). Never commit a key here. Base URL: sandbox
# https://dev.fintavapay.com/api/dev, live https://live.fintavapay.com/api/dev.
# Left empty, the client (src/fintava/, MONEY-06) uses the sandbox, except in
# production, where it must be set: live is never assumed. Any other host is
# refused, so the key cannot be sent anywhere else.
# FINTAVA_API_KEY goes in `Authorization: Bearer`. Left empty, every Fintava
# call fails with `not_configured` and nothing is sent. FINTAVA_WEBHOOK_SECRET
# is the dashboard's webhook secret, used to check the HMAC-SHA512
# `x-fintava-signature` on every delivery to POST /api/hub/webhooks/fintava
# (MONEY-07, src/fintava/webhook/); the URL registered in Fintava's dashboard
# is https://<host>/api/hub/webhooks/fintava. Left empty, every delivery is
# refused (401) and Fintava retries it for 72 hours. See docs/LOCAL.md for
# how a local backend receives Fintava's webhooks.
FINTAVA_BASE_URL=
FINTAVA_API_KEY=
FINTAVA_WEBHOOK_SECRET=
# How long the client waits for Fintava, in milliseconds: reads, then anything
# that moves money or changes an account, then the BVN, selfie and phone
# checks. Left empty: 15000, 30000 and 30000 (PROVISIONAL(FINTAVA-TIMEOUTS),
# src/fintava/fintava-config.ts). A value outside 50 to 300000 stops the app
# at boot.
FINTAVA_TIMEOUT_MS=
FINTAVA_MONEY_TIMEOUT_MS=
FINTAVA_CHECK_TIMEOUT_MS=
# A send whose answer was lost is never sent again sooner than the money
# timeout plus this window, in milliseconds, and only when Fintava has no
# record of it (its own 404, and no row in history): Fintava keeps working
# after the client gives up. Left empty: 600000, ten minutes
# (PROVISIONAL(FINTAVA-RESEND-SAFETY), src/fintava/fintava-config.ts). Below
# 60000 or above 86400000 stops the app at boot.
FINTAVA_RESEND_SAFETY_MS=
# The bill catalogue (BILLS-01, src/bills-catalogue/), on Fintava whichever wallet
# provider runs (R-45). BILLS_AMOUNT_PRESETS_KOBO: the quick amounts S4 offers,
# up to four whole-naira amounts in kobo, comma separated; each company is
# offered the ones that fit its own minimum and maximum. Left empty:
# 200000,500000,1000000,2000000 (PROVISIONAL(BILLS-PRESETS)).
# BILLS_CATALOGUE_CACHE_SECONDS: how long Fintava's disco list is kept before it
# is asked again, 0 to 3600; 0 asks every time. Left empty: 60
# (PROVISIONAL(BILLS-CACHE-SECONDS)). BILLS_PREVIEW_PER_MINUTE: the meter checks
# one person may make a minute, 1 to 600. Left empty: 30
# (PROVISIONAL(BILLS-PREVIEW-PER-MINUTE)). BILLS_PROVIDER_TEXT_MAX_BYTES: the most
# bytes of an owner's name or address read before the text is cut to 200
# characters, 64 to 65536. Left empty: 1024 (PROVISIONAL(BILLS-TEXT-BYTES)). A
# value that is set but wrong stops the app at boot. With no Fintava key the
# catalogue answers `available: false` (S13).
BILLS_AMOUNT_PRESETS_KOBO=
BILLS_CATALOGUE_CACHE_SECONDS=
BILLS_PREVIEW_PER_MINUTE=
BILLS_PROVIDER_TEXT_MAX_BYTES=
# The ledger (MONEY-10, src/money/ledger/) reads each stored Fintava delivery
# on a 30-second sweep. One it cannot place yet (Fintava's lookup answered an
# empty body, or a reversal's debit is not recorded) is tried again for this
# many hours. Left empty: 72 (PROVISIONAL(LEDGER-CONFIRM-WINDOW),
# src/money/ledger/ledger-config.ts). Outside 1 to 720 stops the app at boot.
LEDGER_CONFIRM_WINDOW_HOURS=
# How many days a provider's webhook delivery (Fintava's and Nuvion's) keeps its
# raw body and parsed copy, counted from the time it was received (FIX-20,
# src/webhook-retention/). A daily job at 02:40 clears them from a finished
# delivery that is older; the row stays with its hash, so a delivery sent again
# is still a repeat. A pending, failed or unrecognised delivery keeps its body.
# Left empty: 90 (PROVISIONAL(WEBHOOK-RETENTION-DAYS),
# src/webhook-retention/webhook-retention-config.ts). Outside 7 to 3650 stops
# the app at boot.
WEBHOOK_RETENTION_DAYS=
# The pending sweep (MONEY-08, src/money/ledger/ledger-status.service.ts)
# asks Fintava every minute how each `pending` ledger row older than this
# many minutes ended, when its webhook has not said, and settles it; it never
# sends money. Left empty: 2 (PROVISIONAL(LEDGER-STATUS-CHECK-AFTER),
# src/money/ledger/ledger-config.ts). Outside 1 to 1440 stops the app at boot.
LEDGER_STATUS_CHECK_AFTER_MINUTES=
# Money in, told once (WALLET-10, src/money/money-in-notice/): every 10
# seconds a sweep turns each completed money-in ledger row (a bank transfer
# into a person's account) into one "Money received" notification, which the
# push sender then sends to the person's phones. It looks only at credits the
# Hub first wrote to the ledger this many hours ago or less. Left empty: 72
# (PROVISIONAL(MONEY-IN-NOTICE-WINDOW), src/money/money-in-notice/money-in-notice-config.ts).
# Outside 1 to 720 stops the app at boot.
MONEY_IN_NOTICE_WINDOW_HOURS=
# The most WAWU's Fintava merchant wallet moves in one transaction, in kobo:
# ₦10,000,000 (Fintava's wallet policy, mobile repo docs/fintava/limits.md).
# Applies only to money that goes through WAWU's merchant wallet: wallet
# payments, holds and their release or refund, and payouts from WAWU. Never
# to a customer's own send. Above it the request is refused with
# `amount_out_of_range` and `maximumKobo`, never split (Lead ruling, 2 Oct
# 2026, docs/contract/WALLET.md). Read by MONEY-17, MONEY-18 and WALLET-17.
MERCHANT_MAX_PER_TXN_KOBO=1000000000
# What a Fintava wallet may send in a day, by the tier Fintava reports on every
# balance read, in kobo (WALLET-23; src/fintava/fintava-account-limits.ts):
# TIER_1:5000000,TIER_2:50000000,TIER_3:500000000. Left empty it is exactly
# that, Fintava's wallet policy of 2 Oct 2026 (mobile repo docs/fintava/limits.md).
# A value that is set replaces the whole table, and a tier left out has no
# limit of WAWU's. Fintava's own limit is whatever it enforces. Under nuvion
# this is not read: Nuvion names no account limit.
FINTAVA_TIER_DAILY_LIMITS_KOBO=
# The fee schedule the fee quote is built from (WALLET-15; R-10, R-31;
# src/money/fees/fee-config.ts). Left empty, each takes the ruled figure:
# Fintava's dashboard rates (mobile repo docs/fintava/fees.md, final) and
# WAWU's fees from R-10. All in kobo, whole numbers from 0 to 1000000. Set one
# only when Fintava or the owner changes that fee, and change the dashboard's
# merchant charge to match (OPS-09). A value that is not a whole number of
# kobo stops the app at boot.
#   Fintava's balance-transfer charge by band, from:fee pairs:
#   empty = 0:2325,500000:1575,5000000:1575 (below ₦5,000 ₦23.25, then ₦15.75)
FINTAVA_FEE_BALANCE_TRANSFER_BANDS=
#   Fintava's charge on a send to a bank: empty = 4000 (₦40)
FINTAVA_FEE_BANK_TRANSFER_KOBO=
#   Fintava's bill charges: empty = 10000, 10000, 0, 0
FINTAVA_FEE_ELECTRICITY_KOBO=
FINTAVA_FEE_CABLE_KOBO=
FINTAVA_FEE_AIRTIME_KOBO=
FINTAVA_FEE_DATA_KOBO=
#   WAWU's fees on top: a send to a WAWU user (empty = 1000, ₦10), to a bank
#   or a withdrawal (empty = 2500, ₦25), a bill (empty = 0). Purchases carry
#   none: WAWU's share is the 85/15 split.
WAWU_FEE_WAWU_TRANSFER_KOBO=
WAWU_FEE_BANK_TRANSFER_KOBO=
WAWU_FEE_BILL_KOBO=
# Nuvion's charges (NUV-07; R-42; src/money/fees/nuvion-fee-config.ts), read
# only when WALLET_PROVIDER=nuvion. NO default and no figure here: the owner
# fills them in when Nuvion answers (NUV-10). While any of the three is empty
# under nuvion, every fee quote and every money-moving route answers
# 503 fees_not_set and nothing is sent to Nuvion; the balance, the history and
# the account number still work. Each is kobo: one whole number for any
# amount, or from:fee bands (comma separated, the first from 0, each from
# higher than the one before). A value that is set but unusable stops the
# server at boot. WAWU's fees above are added on top, as under Fintava.
#   A book transfer between two Nuvion accounts (a send to a WAWU user, a
#   purchase into WAWU's operational account):
NUVION_FEE_BOOK_TRANSFER=
#   A payout to a Nigerian bank (a send to a bank, a withdrawal):
NUVION_FEE_BANK_PAYOUT=
#   Money arriving by bank transfer into a person's account number:
NUVION_FEE_INFLOW=
# Reconciliation with Nuvion (NUV-08; src/nuvion/handlers/reconcile-config.ts),
# only under WALLET_PROVIDER=nuvion. Tuning, not money: every one is optional
# and an empty or unusable value uses its default. Nuvion stops retrying a
# webhook after 15 minutes, so a sweep finds the movements whose delivery
# never came: NUVION_SWEEP_MINUTES is how often it runs (default 15),
# NUVION_SWEEP_LOOKBACK_HOURS how far back it reads statements (24),
# NUVION_SWEEP_MAX_ACCOUNTS how many accounts one pass reads at most (300; the
# rest are rotated through across passes). The same pass looks at the webhook
# subscription and reports one that is missing or not active (Nuvion's docs give
# no way to extend one). Nuvion's docs describe no fee simulation, so the fee
# check reports once that it is not available. See the NuvionReconcileFinding
# table for what was reported. (PROVISIONAL(NUVION-SWEEP-MINUTES),
# PROVISIONAL(NUVION-SWEEP-LOOKBACK-HOURS), PROVISIONAL(NUVION-SWEEP-MAX-ACCOUNTS)).
NUVION_SWEEP_MINUTES=
NUVION_SWEEP_LOOKBACK_HOURS=
NUVION_SWEEP_MAX_ACCOUNTS=
# WAWU's own limits on moving money (NUV-07; src/money/limits/), per person,
# per kind of movement and per limit, under either provider: one movement,
# the Lagos calendar day, the Lagos calendar month. Whole kobo, 1 or more.
# NO default and no figure here: empty means no WAWU limit (the provider's own
# still apply). Above one, the movement is refused with 403 limit_reached
# naming the limit, before anything is sent. A value that is set but
# unusable, or a smaller window set above a larger one, stops the server at
# boot. What counts toward a day or a month is the person's own pending and
# completed movements of that kind, before fees.
#   A send to a WAWU user:
WAWU_LIMIT_WAWU_TRANSFER_PER_TRANSACTION_KOBO=
WAWU_LIMIT_WAWU_TRANSFER_DAILY_KOBO=
WAWU_LIMIT_WAWU_TRANSFER_MONTHLY_KOBO=
#   A send to a bank, or a withdrawal:
WAWU_LIMIT_BANK_TRANSFER_PER_TRANSACTION_KOBO=
WAWU_LIMIT_BANK_TRANSFER_DAILY_KOBO=
WAWU_LIMIT_BANK_TRANSFER_MONTHLY_KOBO=
#   A purchase from the wallet:
WAWU_LIMIT_PURCHASE_PER_TRANSACTION_KOBO=
WAWU_LIMIT_PURCHASE_DAILY_KOBO=
WAWU_LIMIT_PURCHASE_MONTHLY_KOBO=
#   A bill (bills are off at launch, R-42):
WAWU_LIMIT_BILL_PER_TRANSACTION_KOBO=
WAWU_LIMIT_BILL_DAILY_KOBO=
WAWU_LIMIT_BILL_MONTHLY_KOBO=
# How long a fee quote can be paid at, in seconds (WALLET-15).
# PROVISIONAL(FEE-QUOTE-SECONDS). Left empty: 300 (60 to 3600).
FEE_QUOTE_SECONDS=
# The server secret fee quotes are signed under (WALLET-15), so the request
# that pays a quote can tell it is this server's and not expired. At least 32
# characters: `openssl rand -hex 32`. Left empty, the server makes one at boot
# and logs one warning; quotes given before a restart are then re-quoted
# (409 quote_changed with the new quote), never charged wrongly. Set it when
# more than one server answers. A value shorter than 32 characters stops the
# app at boot.
FEE_QUOTE_KEY=
# The bounds of the price a host sets on a private community's pass (R-63,
# INBOX-24), in whole kobo. Left empty: 10000 (N100) and 50000000 (N500,000).
# Read on every request. They move to the admin settings with TIER-06's.
COMMUNITY_PASS_MIN_KOBO=
COMMUNITY_PASS_MAX_KOBO=
# How long the stored answer to a money-moving request is kept, in whole hours
# (MONEY-17; docs/contract/CONVENTIONS.md section 4): a retry with the same
# Idempotency-Key within it gets the first answer and never pays twice.
# PROVISIONAL(IDEMPOTENCY-KEY-HOURS). Left empty: 48 (24 to 720; outside stops
# the app at boot).
IDEMPOTENCY_KEY_HOURS=
# How long a payment whose outcome Fintava has not settled is asked about
# before it goes to manual review, in whole hours (MONEY-17). It stays
# pending either way; absence at Fintava never means no money moved.
# PROVISIONAL(PAYMENT-REVIEW-AFTER-HOURS). Left empty: 72 (1 to 720).
PAYMENT_REVIEW_AFTER_HOURS=
# How far above the QUOTED provider charge a payment's real charge may be and
# still be believed, in whole kobo (MONEY-18, the N2 finding of MONEY-17). A
# charge above the quote by more than this, or below 0, is not trusted: the
# payment goes to review with both figures and is not completed or delivered
# until a person looks. PROVISIONAL(PAYMENT-CHARGE-REVIEW-ABOVE-KOBO). Left
# empty: 100000 (0 to 100000000; outside stops the app at boot).
PAYMENT_CHARGE_REVIEW_ABOVE_KOBO=
# The nightly check against the wallet provider (MONEY-16, src/money/check/).
# Once a night it compares every wallet's debits and balance, WAWU's own
# account, the money held for payers and payees, and WAWU's charge on each
# send with the ledger, lists what a person must look at, and has the report
# emailed through WAWU ID. It only reads and reports. `npm run money:check`
# makes it by hand. Every setting is optional; a value that is set but cannot
# be used stops the app at boot, naming it.
# When it starts, as HH:MM Lagos time, or `off`.
# PROVISIONAL(MONEY-CHECK-TIME). Left empty: 02:30.
MONEY_CHECK_TIME=
# How many hours after its time a night's run may still start (a Hub that was
# down at 02:30 and is back by 05:00 still makes the night). 1 to 23, empty: 6.
MONEY_CHECK_CATCH_UP_HOURS=
# Who is told: WAWU ids separated by commas. WAWU ID owns each address and the
# wording (POST /internal/users/:userId/money-check-report, BACKEND_GAPS G-690),
# so the Hub holds no address. Empty: nobody is mailed; the run is still made
# and the result is in the log and in the MoneyCheckRun table.
# PROVISIONAL(MONEY-CHECK-RECIPIENTS): the owner names who is told.
MONEY_CHECK_RECIPIENT_WAWU_IDS=
# How far before the last finished run the next one reads debits (hours, 1 to
# 720, empty: 96, the ledger's 72-hour confirm window and a day) and the
# furthest back any run reads (days, 1 to 366, empty: 35). Balances are
# cumulative, so older rows are still covered.
MONEY_CHECK_OVERLAP_HOURS=
MONEY_CHECK_MAX_LOOKBACK_DAYS=
# A movement younger than this is left to the next night (minutes, 5 to 720,
# empty: 30): the provider's merchant history is cached for about five minutes.
MONEY_CHECK_SETTLE_MINUTES=
# Pages of 100 rows read for one wallet before its history counts as too long
# (1 to 500, empty: 30), the pause between two calls to the provider (ms, 0 to
# 10000, empty: 100), the longest a run may go on (minutes, 10 to 720, empty:
# 180), the most by-id lookups it makes to check WAWU's charge on sends (0 to
# 100000, empty: 2000) and how long finished runs are kept (days, 7 to 3650,
# empty: 120).
MONEY_CHECK_HISTORY_PAGES=
MONEY_CHECK_CALL_GAP_MS=
MONEY_CHECK_MAX_MINUTES=
MONEY_CHECK_FEE_LOOKUPS=
MONEY_CHECK_KEEP_DAYS=
# How long the transaction PIN stays locked after 5 wrong tries in a row, in
# whole minutes (MONEY-09; docs/contract/CONVENTIONS.md section 5). PROVISIONAL:
# no ruling names a length, so 30 is the build default for the owner to confirm.
# Left out, the app uses 30; a value that is not a whole number of 1 or more
# stops the app at boot.
PIN_LOCK_MINUTES=30
# Resetting the PIN by a code texted to the phone the BVN check proved
# (MONEY-14; docs/contract/CONVENTIONS.md section 5). PROVISIONAL(PIN-RESET-LIMITS),
# src/money/pin/pin-reset-config.ts. Left empty: the code lives 300 seconds
# (60 to 3600), Resend opens after 60 (30 to 3600, never longer than the
# code), and 5 texts in any 24 hours per person and per phone (1 to 20; each
# text costs 7 naira). A value outside its range stops the app at boot.
PIN_RESET_CODE_SECONDS=
PIN_RESET_RESEND_SECONDS=
PIN_RESET_TEXTS_PER_DAY=
# How long a challenge for a fingerprint or face approval can be used, in
# seconds (MONEY-14). PROVISIONAL(DEVICE-APPROVAL-SECONDS). Left empty: 120
# (30 to 600). Each challenge works once.
DEVICE_APPROVAL_SECONDS=
# The server secret the BVN and NIN are hashed under (KYC-01): only a keyed
# hash (HMAC-SHA256) and the last 4 digits of each are stored. At least 32
# characters: `openssl rand -hex 32`. Set it once and never change it: every
# stored hash would stop matching and people would have to check their BVN
# again. Left empty, the server starts and the BVN check and the selfie match
# (KYC-02) answer 503; a value shorter than 32 characters stops the app at
# boot. scripts/local/up.sh writes a random one into a local .env.
IDENTITY_HASH_KEY=
# BVN checks one person may run in any 24 hours (each is charged by Fintava).
# PROVISIONAL(BVN-CHECKS-PER-DAY), src/money/identity/identity-config.ts. Left
# empty: 3. A value that is not a whole number from 1 to 50 stops the app.
# Under WALLET_PROVIDER=nuvion there is no BVN check: the same number is the
# opening tries one person may make in any 24 hours (NUV-02).
BVN_CHECKS_PER_DAY=
# Bank name checks one signed-in person may run in an hour (WALLET-37, R-51,
# G-764) is the admin setting `name_check_per_hour` (launch value 30, 1 to 1,000),
# read at every check (HOME-17). The key NAME_CHECK_PER_HOUR that stood in for it
# is retired: nothing reads it. The same goes for POPULAR_COMMUNITY_MIN_MEMBERS
# (now `popular_community_min_members`) and TGIF_NOTIFICATION_TIME (now
# `tgif_notification_time`). Change them in the admin settings.
# Under WALLET_PROVIDER=nuvion (NUV-02 round 3): the days an opening left at
# "documents needed" (or refused only about its documents) may hold a BVN
# without the person doing anything before it expires, lets go of the BVN and
# tells the person. PROVISIONAL(IDENTITY-HOLD-DAYS),
# src/money/identity/identity-config.ts. Left empty: 14. A value that is not a
# whole number from 1 to 365 stops the app.
IDENTITY_HOLD_DAYS=
# Under WALLET_PROVIDER=nuvion (NUV-03 round 4): the most days one account may
# hold one BVN while its opening is unfinished, counted from the day it took
# the claim on that number and moved by nothing it does after (a file sent
# every 13 days is progress for IDENTITY_HOLD_DAYS and does nothing for this).
# When it ends the opening is expired like an idle one: the BVN is let go and
# the person is told once and starts again. PROVISIONAL(IDENTITY-HOLD-LIFETIME-DAYS),
# src/money/identity/identity-config.ts. Left empty: 30. A value that is not a
# whole number from 1 to 365, or is shorter than IDENTITY_HOLD_DAYS, stops the app.
IDENTITY_HOLD_LIFETIME_DAYS=
# Under WALLET_PROVIDER=nuvion: opening tries one address may make in an
# hour, across every account (a plain 429 with open_address_limited).
# PROVISIONAL(OPEN-ATTEMPTS-PER-ADDRESS). Left empty: 10. A value that is not
# a whole number from 1 to 100000 stops the app.
OPEN_ATTEMPTS_PER_ADDRESS_PER_HOUR=
# Selfie matches against the BVN photo one person may run in any 24 hours
# (KYC-02; each is charged by Fintava, a failed one too).
# PROVISIONAL(SELFIE-CHECKS-PER-DAY), src/money/identity/identity-config.ts.
# Left empty: 3. A value that is not a whole number from 1 to 50 stops the app.
SELFIE_CHECKS_PER_DAY=
# The wallet's bank as shown beside the account number (MONEY-12; W1, W15,
# A8). Fintava's create answer names no bank; its transaction records for
# these wallets say "Loma Bank". Left empty: "Loma Bank"
# (PROVISIONAL(WALLET-BANK-NAME), src/money/opening/wallet-opening-config.ts).
WALLET_BANK_NAME=
# The licence and deposit-insurance lines under the account details (R-1):
# the owner's wording. Left empty, the app hides each line.
WALLET_LICENCE_LINE=
WALLET_DEPOSIT_INSURANCE_LINE=
# Receipts (WALLET-18): where a receipt's code opens, without the code,
# e.g. https://<the API's public host>/api/hub/r. Left empty, receipts print
# wawu/r/<code> and give no link (the owner names the public host). Must be
# https in production. Receipts print WALLET_BANK_NAME and WALLET_LICENCE_LINE.
RECEIPT_VERIFY_BASE_URL=
# Receipt images and PDFs drawn at once (WALLET-18; 1 to 8, empty: 2,
# PROVISIONAL(RECEIPT-RENDER-CONCURRENCY)). A PDF in flight holds about
# 45 MB; a request waits up to 10 s for a turn, then gets 503 with Retry-After.
RECEIPT_RENDER_CONCURRENCY=
# Where About's "Contact support" sends mail (SETTINGS-02): the owner's fact,
# no default. Left empty, the app says the address is not available yet.
SUPPORT_EMAIL=
# The link written on a shared TGIF card and in the text sent to WhatsApp
# (HOME-09, H35): the owner's fact, no default. Left empty, the card and the
# message carry no link.
TGIF_SHARE_LINK=

# --- Cardex (Fintava's crypto partner) ---------------------------------------
# Base URL https://cardex.live/api; `cdx_test_` keys are the sandbox. Every
# call carries CARDEX_API_KEY as a bearer token, every call with a body is
# signed with CARDEX_SIGNING_SECRET, and webhooks are checked with
# CARDEX_WEBHOOK_SECRET. Never commit a key here.
CARDEX_BASE_URL=
CARDEX_API_KEY=
CARDEX_SIGNING_SECRET=
CARDEX_WEBHOOK_SECRET=

# --- Data export (SETTINGS-04) ------------------------------------------------
# The public address of this API, used to write the link in the "your data is
# ready" email: https://api.wawuafrica.com in production. WAWU ID only accepts
# an https link. Unset in production, no export email can be sent. Locally it
# defaults to http://localhost:<port>.
HUB_PUBLIC_URL=

# --- Phone push (INBOX-03, docs/contract/PUSH.md) ----------------------------
# Off unless PUSH_ENABLED is exactly `true`. Leave it empty on a developer
# machine: nothing is then sent to Expo. EXPO_ACCESS_TOKEN is only for an Expo
# project with enhanced push security. EXPO_PUSH_BASE_URL defaults to
# https://exp.host; only that host or a local address is accepted.
PUSH_ENABLED=
EXPO_ACCESS_TOKEN=
EXPO_PUSH_BASE_URL=

# --- Legal deliveries (FIX-24) -----------------------------------------------
# The legal team's WAWU accounts, as WAWU ids separated by commas. A delivered
# legal document must be a file the client uploaded themselves, or one an
# account in this list uploaded (POST /uploads/presign, legal/document);
# any other file is refused on delivery and never signed on read. Empty means
# no legal-team account: only a client's own files can be delivered back to
# them. A value that is set but is not WAWU ids separated by commas stops the
# server at boot, naming this setting.
# PROVISIONAL(LEGAL-DELIVERY-UPLOADERS, owner=YOU, why=the owner supplies the legal team's account ids)
# (src/legal/legal-delivery-settings.ts).
LEGAL_DELIVERY_UPLOADER_IDS=

# --- Email campaigns (EMAIL-01, EMAIL-02; admin dashboard > Notifications > Email) --
# Campaign email goes out through WAWU ID's mail relay (POST /internal/mail/send),
# which sends with WAWU ID's own Resend key and its own MAIL_FROM. It needs only
# WAWU_ID_BASE_URL and WAWU_ID_INTERNAL_SERVICE_KEY (both set at the top of this
# file), so there is nothing to add here. Unless neither is set, the start and
# test-send routes answer 409 and nothing is sent.
# Optional: a Resend key of the Hub's own. When it is set the Hub sends straight
# to Resend instead of through WAWU ID, from EMAIL_CAMPAIGN_FROM below. Leave it
# empty to use WAWU ID. Never commit a key here.
RESEND_API_KEY=
# The From line when the Hub sends straight to Resend (RESEND_API_KEY above).
# Unset, it is the address WAWU ID already sends from: Who Made This?
# <noreply@wawuafrica.com>. The domain must be verified in Resend. Through
# WAWU ID the From is WAWU ID's MAIL_FROM and this setting is not used.
EMAIL_CAMPAIGN_FROM=Who Made This? <noreply@wawuafrica.com>
# Optional, for tests only: send to a local stand-in instead of Resend. Only
# api.resend.com or a local address is accepted.
# RESEND_BASE_URL=http://127.0.0.1:6494
# The unsubscribe link in each email points at HUB_PUBLIC_URL (set above, in
# the data export section) and is signed with ADMIN_JWT_SECRET.

# WALLET-16 (lead ruling 17 Oct 2026): the earnings sweep pays only sales made on or
# after this moment (ISO 8601 with a zone, e.g. 2026-10-25T09:00:00Z). Unset: the moment
# the code first reached the environment, stored once in the database. Sales made before
# it are never paid by the sweep and are listed at GET /admin/money/earnings/before-start.
EARNINGS_SWEEP_START=
# R-55 (owner, 16 Oct 2026): a creator's earnings go to their wallet once a day, in
# one transfer. A day's total under this many kobo waits and is added to the next
# day's. Left empty: 20000 (N200). 0 to 100000000; outside stops the app at boot.
EARNINGS_MOVE_MIN_KOBO=
# R-55: an earning the wallet refuses goes in front of a person this many hours after
# its FIRST refusal (later refusals do not restart the count). Left empty: 72 (1 to 720).
EARNINGS_REFUSED_REVIEW_AFTER_HOURS=


# WALLET-17: hours after an event's end before its ticket money is paid to the host
# (the hold's release, 85% to the host). Unset or 0: at the event's end.
EVENT_PAYOUT_DELAY_HOURS=

# --- Flix movies (FLIX-01, R-74, R-75) ----------------------------------------
# Which movie partner the Hub talks to: `off` (the default; empty is off) or
# `standin` (made-up titles on this machine, no network) or `flixora` (FLIX-02,
# Flixora's partner API; it needs the six FLIXORA_ settings below and a server
# without all of them stops at boot, naming each missing one).
# Off hides every movie rail and screen (GET /movies answers enabled: false),
# stops every call and every link, and changes nothing else; stored rows stay.
# `soon` (FLIX-04, R-77) keeps Flix movies visible but doing nothing until
# business talks finish: no adapter is built, no sync runs, GET /movies answers
# { enabled: false, soon: true, hero: null, rails: [] } and the app shows "not
# live yet"; every other movies route answers 404 movies_off, as off does.
# Change it and restart.
MOVIE_PARTNER=
# When the updated terms that name the movie partner went live (an ISO date,
# for example 2026-11-01T00:00:00Z). Someone who signed up on or after it has
# agreed at sign-up; everyone else, and everyone while this is empty, ticks the
# agreement box before their first "Watch on Flixora". Empty is safe.
FLIXORA_TERMS_FROM=
# The catalog copy's refresh (all optional; none is a secret):
#   MOVIE_SYNC_INTERVAL_MINUTES  minutes between passes (default 15)
#   MOVIE_SYNC_FULL_EVERY_HOURS  hours between full passes, which also remove
#                                titles the partner dropped (default 24)
#   MOVIE_SYNC_PAGE_SIZE         titles per request, 1 to 100 (default 100)
#   MOVIE_SYNC_MAX_PAGES         most requests one pass may make (default 100)
MOVIE_SYNC_INTERVAL_MINUTES=
MOVIE_SYNC_FULL_EVERY_HOURS=
MOVIE_SYNC_PAGE_SIZE=
MOVIE_SYNC_MAX_PAGES=
# Flixora (FLIX-02), needed only with MOVIE_PARTNER=flixora. The key and the
# sign-in secret are SECRETS: set them on the server, never commit them, never
# put them in the app. A flx_test_ key reaches Flixora's test environment (test
# sign-ins make sandbox accounts, plays never count); a flx_live_ key is set by
# the lead at release, after Flixora approves the account. Every answer's
# X-Flixora-Environment header is checked against the key's prefix.
#   FLIXORA_API_BASE_URL  https://prime-pit-backend-production-3a1f.up.railway.app/api/partners
#   FLIXORA_API_KEY       flx_test_... or flx_live_... (secret)
#   FLIXORA_SSO_SECRET    the environment's sign-in secret (secret)
#   FLIXORA_PARTNER_SLUG  the partner slug from the Flixora partner portal
#   FLIXORA_SITE_URL      https://www.flixora.com
#   FLIXORA_REGION        NG, UK or US (optional; default NG)
FLIXORA_API_BASE_URL=
FLIXORA_API_KEY=
FLIXORA_SSO_SECRET=
FLIXORA_PARTNER_SLUG=
FLIXORA_SITE_URL=
FLIXORA_REGION=

# ---------------------------------------------------------------------------
# Foreign-currency accounts, swaps and crypto sends (WALLET-21, R-83, R-84).
# Per currency CODE: USD EUR GBP CAD AED GHS USDT USDC RLUSD, and NGN for the
# naira side of a swap. Every figure is an integer in the currency's smallest
# unit. All are optional; none set means no WAWU fee and no WAWU limit.
# ---------------------------------------------------------------------------
# WAWU's fee on a swap out of the currency, charged on top (R-10). Default 0.
# FX_SWAP_FEE_USD_MINOR=0
# WAWU's fee on a crypto send. Default 0.
# FX_SEND_FEE_USDT_MINOR=0
# Where a nonzero fee is paid: a Nuvion account WAWU holds in that currency.
# The server refuses to start with a fee and no collector. Not for NGN: a naira
# fee goes to WAWU's operational account, as a naira send's fee does.
# FX_FEE_COLLECTOR_USD_BAN=
# The most one person moves out of the currency in a Lagos day, swaps and sends together.
# FX_DAILY_LIMIT_USD_MINOR=
# Places in a currency's smallest unit, to override the catalogue (a stablecoin
# is 2 as Nuvion's dev counts it; Nuvion's docs say 6: BACKEND_GAPS G-WALLET-21-1).
# FX_DECIMALS_USDT=2

# Send abroad (NUV-11, R-10): what the payment partner charges on top of a send, shown before the PIN and counted in the funds check.
# The partner's quote has no fee, so it is named here per destination currency and rail: ABROAD_PROVIDER_FEE_<CURRENCY>_<BANK|MOBILE_MONEY>,
# a whole number in USD cents (the plain figure is the dollar one); a fee that differs by the sending account is named _FROM_<SOURCE>
# (in that currency's smallest unit). A corridor with no figure is not estimated: the receipt then names the fee. When the real fee is
# not the one shown the send is flagged for admin (feeDiffers). Dev measured 24 Oct 2026: USD to Ghana mobile money 150 (USD 1.50);
# NGN to an Australian bank 0.
ABROAD_PROVIDER_FEE_GHS_MOBILE_MONEY=150
ABROAD_PROVIDER_FEE_AUD_BANK_FROM_NGN=0

